{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "ozanozdil-com",
	"main": "worker.ts",
	"compatibility_date": "2026-09-01",
	"routes": [
		{ "pattern": "ozanozdil.com/*", "zone_name": "ozanozdil.com" },
		{ "pattern": "www.ozanozdil.com/*", "zone_name": "ozanozdil.com" }
	],
	"assets": {
		"directory": "./dist",
		"binding": "ASSETS",
		"not_found_handling": "404-page",
		"run_worker_first": true
	},
	"ai": {
		"binding": "AI"
	},
	"observability": {
		"enabled": true
	},
	"kv_namespaces": [
		{
			"binding": "BLOG_VIEWS",
			"id": "b33f300b346e4878b8c9f5fe15ab8935"
		}
	]
}