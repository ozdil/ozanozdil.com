---
const currentYear = new Date().getFullYear();
---

<footer class="border-t border-zinc-200/70 dark:border-zinc-800/70 mt-20 py-10 text-xs text-zinc-500 dark:text-zinc-400">
  <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 flex flex-col sm:flex-row items-center justify-between gap-4">
    <div class="flex items-center space-x-2.5">
      <span class="w-2 h-2 rounded-full bg-emerald-500"></span>
      <span class="font-medium text-zinc-700 dark:text-zinc-300">© {currentYear} Ozan Özdil</span>
      <span class="text-zinc-300 dark:text-zinc-700">•</span>
      <span>Açık Kaynak & Bağımsız Mühendislik</span>
    </div>

    <div class="flex flex-wrap items-center justify-center gap-x-4 gap-y-2">
      <a href="https://github.com/ozdil" target="_blank" rel="noopener noreferrer" class="hover:text-zinc-900 dark:hover:text-zinc-100 transition-colors">GitHub</a>
      <a href="https://nsosyal.com/ozanozdil" target="_blank" rel="noopener noreferrer" class="hover:text-zinc-900 dark:hover:text-zinc-100 transition-colors">NSosyal</a>
      <a href="https://www.flickr.com/photos/204447030@N04/" target="_blank" rel="noopener noreferrer" class="hover:text-zinc-900 dark:hover:text-zinc-100 transition-colors">Flickr</a>
      <a href="/rss.xml" class="hover:text-zinc-900 dark:hover:text-zinc-100 transition-colors">RSS</a>
      <a href="/sitemap-index.xml" class="hover:text-zinc-900 dark:hover:text-zinc-100 transition-colors">Sitemap</a>
    </div>
  </div>
</footer>
