---
const currentYear = new Date().getFullYear();
---

<footer class="border-t border-zinc-200/60 dark:border-zinc-800/60 mt-20 py-8 text-xs text-zinc-500 dark:text-zinc-400">
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 flex flex-col sm:flex-row items-center justify-between gap-4">
    <div class="flex items-center space-x-2">
      <span>© {currentYear} Ozan Özdil</span>
      <span class="text-zinc-300 dark:text-zinc-700">•</span>
      <span>Kastamonu</span>
    </div>

    <div class="flex flex-wrap items-center justify-center gap-x-4 gap-y-2">
      <a href="https://github.com/ozdil" target="_blank" rel="noopener noreferrer" class="hover:text-zinc-900 dark:hover:text-zinc-100 transition-colors">GitHub</a>
      <a href="https://nsosyal.com/ozanozdil" target="_blank" rel="noopener noreferrer" class="hover:text-zinc-900 dark:hover:text-zinc-100 transition-colors">NSosyal</a>
      <a href="/rss.xml" class="hover:text-zinc-900 dark:hover:text-zinc-100 transition-colors">RSS</a>
      <a href="/sitemap-index.xml" class="hover:text-zinc-900 dark:hover:text-zinc-100 transition-colors">Sitemap</a>
    </div>
  </div>
</footer>
