---
const currentYear = new Date().getFullYear();
---

<footer class="border-t border-zinc-200/60 dark:border-zinc-800/60 mt-20 py-8 text-xs text-zinc-500 dark:text-zinc-400">
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 flex flex-col sm:flex-row items-center justify-between gap-4">
    <!-- İmza & Açık Kaynak Depo -->
    <div class="flex flex-wrap items-center justify-center sm:justify-start gap-x-2 gap-y-1">
      <span>© {currentYear} Ozan Özdil</span>
      <span class="text-zinc-300 dark:text-zinc-700">•</span>
      <span>Kastamonu</span>
      <span class="text-zinc-300 dark:text-zinc-700">•</span>
      <a
        href="https://github.com/ozdil/ozanozdil.com"
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-1 font-mono text-[11px] text-zinc-600 dark:text-zinc-400 hover:text-zinc-950 dark:hover:text-zinc-100 transition-colors underline underline-offset-2"
        title="ozanozdil.com GitHub Açık Kaynak Deposu"
      >
        <svg class="w-3 h-3 fill-current opacity-80" viewBox="0 0 16 16" aria-hidden="true">
          <path d="M8 0c4.42 0 8 3.58 8 8a8.013 8.013 0 0 1-5.45 7.59c-.4.08-.55-.17-.55-.38 0-.27.01-1.13.01-2.2 0-.75-.25-1.23-.54-1.48 1.78-.2 3.65-.88 3.65-3.95 0-.88-.31-1.59-.82-2.15.08-.2.36-1.02-.08-2.12 0 0-.67-.22-2.2.82-.64-.18-1.32-.27-2-.27-.68 0-1.36.09-2 .27-1.53-1.03-2.2-.82-2.2-.82-.44 1.1-.16 1.92-.08 2.12-.51.56-.82 1.28-.82 2.15 0 3.06 1.86 3.75 3.64 3.95-.23.2-.44.55-.51 1.07-.46.21-1.61.55-2.33-.66-.15-.24-.6-.83-1.23-.82-.67.01-.27.38.01.53.34.19.73.9.82 1.13.16.45.68 1.31 2.69.94 0 .67.01 1.3.01 1.49 0 .21-.15.45-.55.38A7.995 7.995 0 0 1 0 8c0-4.42 3.58-8 8-8Z"></path>
        </svg>
        <span>ozanozdil.com</span>
      </a>
    </div>

    <!-- Alt Bağlantılar -->
    <div class="flex flex-wrap items-center justify-center gap-x-4 gap-y-2">
      <a href="https://github.com/ozdil" target="_blank" rel="noopener noreferrer" class="hover:text-zinc-900 dark:hover:text-zinc-100 transition-colors">GitHub</a>
      <a href="https://nsosyal.com/ozanozdil" target="_blank" rel="noopener noreferrer" class="hover:text-zinc-900 dark:hover:text-zinc-100 transition-colors">NSosyal</a>
      <a href="https://github.com/ozdil/ozanozdil.com" target="_blank" rel="noopener noreferrer" class="hover:text-zinc-900 dark:hover:text-zinc-100 transition-colors">Kaynak Kod</a>
      <a href="/rss.xml" class="hover:text-zinc-900 dark:hover:text-zinc-100 transition-colors">RSS</a>
      <a href="/sitemap-index.xml" class="hover:text-zinc-900 dark:hover:text-zinc-100 transition-colors">Sitemap</a>
