---
const currentYear = new Date().getFullYear();
---

<footer class="border-t border-zinc-200/80 dark:border-white/10 mt-20 py-6 text-xs font-mono text-zinc-500 dark:text-zinc-400 bg-zinc-50/50 dark:bg-[#0b0e12]/60 transition-colors">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 flex flex-col md:flex-row items-center justify-between gap-3 text-center md:text-left">
    <!-- Left: Location -->
    <div class="flex flex-wrap items-center justify-center md:justify-start gap-2 text-[11px] text-zinc-500 dark:text-zinc-400">
      <span>Kastamonu, TR</span>
    </div>

    <!-- Center: Signature -->
    <div class="text-[11px] text-zinc-600 dark:text-zinc-400">
      <span>© {currentYear} Ozan Özdil</span>
    </div>

    <!-- Right: Quick Shell Links -->
    <div class="flex flex-wrap items-center justify-center gap-2 text-[11px]">
      <a href="https://github.com/ozdil/ozanozdil.com" target="_blank" rel="noopener noreferrer" class="px-2 py-0.5 rounded hover:bg-zinc-200 dark:hover:bg-zinc-800 hover:text-zinc-900 dark:hover:text-zinc-100 transition-colors border border-transparent hover:border-zinc-300 dark:hover:border-zinc-700">
        [repo]
      </a>
      <a href="/rss.xml" class="px-2 py-0.5 rounded hover:bg-zinc-200 dark:hover:bg-zinc-800 hover:text-zinc-900 dark:hover:text-zinc-100 transition-colors border border-transparent hover:border-zinc-300 dark:hover:border-zinc-700">
        [rss]
      </a>
      <a href="/sitemap-index.xml" class="px-2 py-0.5 rounded hover:bg-zinc-200 dark:hover:bg-zinc-800 hover:text-zinc-900 dark:hover:text-zinc-100 transition-colors border border-transparent hover:border-zinc-300 dark:hover:border-zinc-700">
        [sitemap]
      </a>
      <a href="#top" class="px-2 py-0.5 rounded hover:bg-zinc-200 dark:hover:bg-zinc-800 hover:text-sky-600 dark:hover:text-[#00ffcc] transition-colors border border-transparent hover:border-zinc-300 dark:hover:border-zinc-700">
        [top ↑]
      </a>
    </div>
  </div>
</footer>
