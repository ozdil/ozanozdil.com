          </svg>
        </a>

        <!-- NSosyal Launcher (Desktop Only) -->
        <a
          href="https://nsosyal.com/ozanozdil"
          target="_blank"
          rel="noopener noreferrer"
          class="p-1.5 sm:p-2 rounded-md text-[#a1a1aa] hover:text-[#ffffff] hover:bg-[#27272a] border border-[#27272a] transition-all hidden sm:inline-flex"
          title="NSosyal: @ozanozdil"
          aria-label="NSosyal"
        >
          <svg class="w-3.5 h-3.5 sm:w-4 sm:h-4 fill-current" viewBox="0 0 24 24" aria-hidden="true">
            <path d="M5 4h3.5l7 10.5V4H19v16h-3.5L8.5 9.5V20H5V4z"/>
          </svg>
        </a>

        <!-- RSS Feed (Desktop Only) -->
        <a
          href="/rss.xml"
          class="p-1.5 sm:p-2 rounded-md text-[#a1a1aa] hover:text-[#ffffff] hover:bg-[#27272a] border border-[#27272a] transition-all hidden sm:inline-flex"
          title="RSS Beslemesi"
          aria-label="RSS Feed"
        >
          <svg class="w-3.5 h-3.5 sm:w-4 sm:h-4 fill-current" viewBox="0 0 24 24">
            <path d="M6.18 15.64a2.18 2.18 0 0 1 2.18 2.18C8.36 19 7.38 20 6.18 20C5 20 4 19 4 17.82a2.18 2.18 0 0 1 2.18-2.18M4 4.44A15.56 15.56 0 0 1 19.56 20h-2.83A12.73 12.73 0 0 0 4 7.27V4.44m0 5.66a9.9 9.9 0 0 1 9.9 9.9h-2.83A7.07 7.07 0 0 0 4 12.93V10.1Z"/>
          </svg>
        </a>

        <!-- Language Selector -->
        <LanguageSelector />

        <!-- Theme Toggle -->
        <ThemeToggle />

        <!-- Mobile Menu Toggle Button (Hamburger) -->
        <button
          type="button"
          id="mobile-menu-btn"
          class="p-1.5 sm:p-2 rounded-md text-[#a1a1aa] hover:text-[#ffffff] hover:bg-[#27272a] border border-[#27272a] transition-colors md:hidden focus:outline-none"
          aria-label="Menüyü Aç/Kapat"
          aria-expanded="false"
        >
          <svg id="menu-icon-bars" class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
          </svg>
          <svg id="menu-icon-close" class="w-4 h-4 hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
          </svg>
        </button>
      </div>
  </div>

  <!-- Mobile Dropdown Menu -->
  <div
    id="mobile-menu"
    class="hidden md:hidden border-t border-[#27272a] bg-[#121215] px-4 py-4 transition-all font-mono text-xs shadow-2xl"
  >
    <!-- Navigation Links -->
    <div class="space-y-1">
      {navItems.map((item) => {
        const isActive = item.href === '/' ? currentPath === '/' : currentPath.startsWith(item.href);
        return (
          <a
            href={item.href}
            class={`block px-3 py-2 rounded-lg transition-colors ${
              isActive
                ? 'bg-[#27272a] text-[#ffffff] font-medium border border-[#3f3f46]'
                : 'text-[#a1a1aa] hover:text-[#ffffff] hover:bg-[#18181b]'
            }`}
          >
            {item.label}
          </a>
        );
      })}
    </div>

    <!-- Mobile Social Links -->
    <div class="pt-3 border-t border-[#27272a] space-y-1.5">
      <div class="text-[10px] uppercase font-semibold text-[#71717a] px-3">
        Bağlantılar
      </div>
      <div class="grid grid-cols-2 gap-2 text-[11px]">
        <!-- GitHub -->
        <a
          href="https://github.com/ozdil"
          target="_blank"
          rel="noopener noreferrer"
          class="flex items-center justify-between px-3 py-2 rounded-lg text-[#a1a1aa] bg-[#18181b] border border-[#27272a] hover:text-[#ffffff] transition-colors"
        >
          <span class="flex items-center gap-2">
            <svg class="w-3.5 h-3.5 fill-current" viewBox="0 0 16 16">
              <path d="M8 0c4.42 0 8 3.58 8 8a8.013 8.013 0 0 1-5.45 7.59c-.4.08-.55-.17-.55-.38 0-.27.01-1.13.01-2.2 0-.75-.25-1.23-.54-1.48 1.78-.2 3.65-.88 3.65-3.95 0-.88-.31-1.59-.82-2.15.08-.2.36-1.02-.08-2.12 0 0-.67-.22-2.2.82-.64-.18-1.32-.27-2-.27-.68 0-1.36.09-2 .27-1.53-1.03-2.2-.82-2.2-.82-.44 1.1-.16 1.92-.08 2.12-.51.56-.82 1.28-.82 2.15 0 3.06 1.86 3.75 3.64 3.95-.23.2-.44.55-.51 1.07-.46.21-1.61.55-2.33-.66-.15-.24-.6-.83-1.23-.82-.67.01-.27.38.01.53.34.19.73.9.82 1.13.16.45.68 1.31 2.69.94 0 .67.01 1.3.01 1.49 0 .21-.15.45-.55.38A7.995 7.995 0 0 1 0 8c0-4.42 3.58-8 8-8Z"/>
            </svg>
            <span>GitHub</span>
          </span>
          <span class="text-[#71717a]">↗</span>
        </a>

        <!-- Buy Me a Coffee -->
        <a
          href="https://buymeacoffee.com/ozdil"
          target="_blank"
          rel="noopener noreferrer"
          class="flex items-center justify-between px-3 py-2 rounded-lg text-[#a1a1aa] bg-[#18181b] border border-[#27272a] hover:text-[#ffffff] transition-colors"
        >
          <span class="flex items-center gap-2">
            <svg class="w-3.5 h-3.5 fill-current" viewBox="0 0 24 24">
              <path d="M20 3H4v10c0 2.21 1.79 4 4 4h6c2.21 0 4-1.79 4-4v-3h2c1.1 0 2-.9 2-2V5c0-1.1-.9-2-2-2zm0 5h-2V5h2v3zM2 19h18v2H2v-2z" />
            </svg>
            <span>Destek</span>
          </span>
          <span class="text-[#71717a]">↗</span>
        </a>

        <!-- Steam -->
        <a
          href="https://steamcommunity.com/id/ozanozdil"
          target="_blank"
          rel="noopener noreferrer"
          class="flex items-center justify-between px-3 py-2 rounded-lg text-[#a1a1aa] bg-[#18181b] border border-[#27272a] hover:text-[#ffffff] transition-colors"
        >
          <span class="flex items-center gap-2">
            <svg class="w-3.5 h-3.5 fill-current" viewBox="0 0 24 24">
              <path d="M11.979 0C5.678 0 .511 4.86.022 11.037l6.432 2.658c.545-.371 1.203-.59 1.912-.59.063 0 .125.004.188.006l2.861-4.142V8.91c0-2.495 2.028-4.524 4.524-4.524 2.494 0 4.524 2.031 4.524 4.527s-2.03 4.525-4.524 4.525h-.105l-4.076 2.911c0 .052.004.105.004.159 0 1.875-1.515 3.396-3.39 3.396-1.635 0-3.016-1.173-3.331-2.727L.436 15.27C1.862 20.307 6.486 24 11.979 24c6.627 0 11.999-5.373 11.999-12S18.605 0 11.979 0zM7.54 18.21l-1.473-.61c.262.543.714.999 1.314 1.25 1.297.539 2.793-.076 3.332-1.375.263-.63.264-1.319.005-1.949s-.75-1.121-1.377-1.383c-.624-.26-1.29-.249-1.878-.03l1.523.63c.956.4 1.409 1.5 1.009 2.455-.397.957-1.497 1.41-2.454 1.012H7.54zm11.415-9.303c0-1.662-1.353-3.015-3.015-3.015-1.665 0-3.015 1.353-3.015 3.015 0 1.665 1.35 3.015 3.015 3.015 1.663 0 3.015-1.35 3.015-3.015zm-5.273-.005c0-1.252 1.013-2.266 2.265-2.266 1.249 0 2.266 1.014 2.266 2.266 0 1.251-1.017 2.265-2.266 2.265-1.253 0-2.265-1.014-2.265-2.265z"/>
            </svg>
            <span>Steam</span>
          </span>
          <span class="text-[#71717a]">↗</span>
        </a>

        <!-- nSosyal -->
        <a
          href="https://nsosyal.com/ozanozdil"
          target="_blank"
          rel="noopener noreferrer"
          class="flex items-center justify-between px-3 py-2 rounded-lg text-[#a1a1aa] bg-[#18181b] border border-[#27272a] hover:text-[#ffffff] transition-colors"
        >
          <span class="flex items-center gap-2">
            <svg class="w-3.5 h-3.5 fill-current" viewBox="0 0 24 24">
              <path d="M5 4h3.5l7 10.5V4H19v16h-3.5L8.5 9.5V20H5V4z"/>
            </svg>
            <span>nSosyal</span>
          </span>
          <span class="text-[#71717a]">↗</span>
        </a>

        <!-- RSS -->
        <a
          href="/rss.xml"
          class="flex items-center justify-between px-3 py-2 rounded-lg text-[#a1a1aa] bg-[#18181b] border border-[#27272a] hover:text-[#ffffff] transition-colors"
        >
          <span class="flex items-center gap-2">
            <svg class="w-3.5 h-3.5 fill-current" viewBox="0 0 24 24">
              <path d="M6.18 15.64a2.18 2.18 0 0 1 2.18 2.18C8.36 19 7.38 20 6.18 20C5 20 4 19 4 17.82a2.18 2.18 0 0 1 2.18-2.18M4 4.44A15.56 15.56 0 0 1 19.56 20h-2.83A12.73 12.73 0 0 0 4 7.27V4.44m0 5.66a9.9 9.9 0 0 1 9.9 9.9h-2.83A7.07 7.07 0 0 0 4 12.93V10.1Z"/>
            </svg>
