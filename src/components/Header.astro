---
import ThemeToggle from './ThemeToggle.astro';

interface Props {
  currentPath?: string;
}

const { currentPath = '/' } = Astro.props;

const navItems = [
  { href: '/blog', label: 'Yazılar' },
  { href: '/projeler', label: 'Projeler' },
  { href: '/galeri', label: 'Galeri' },
  { href: '/hakkimda', label: 'Hakkımda' },
];
---

<header class="sticky top-0 z-50 backdrop-blur-md bg-[#fafafa]/80 dark:bg-[#09090b]/80 border-b border-zinc-200/60 dark:border-zinc-800/60 transition-colors">
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex items-center justify-between h-16 gap-4">
      <!-- Brand -->
      <a href="/" class="flex items-center space-x-2.5 group">
        <div class="w-7 h-7 rounded-full overflow-hidden border border-zinc-200 dark:border-zinc-800 shadow-xs bg-zinc-100 dark:bg-zinc-800 flex-shrink-0">
          <img src="/avatar.jpg" alt="Ozan Özdil" class="w-full h-full object-cover" />
        </div>
        <span class="font-medium text-sm tracking-tight text-zinc-900 dark:text-zinc-100 group-hover:text-zinc-600 dark:group-hover:text-zinc-300 transition-colors">
          Ozan Özdil
        </span>
      </a>

      <!-- Navigation Links -->
      <nav class="flex items-center space-x-1 sm:space-x-2 overflow-x-auto no-scrollbar py-1" aria-label="Ana Navigasyon">
        {navItems.map((item) => {
          const isActive = currentPath.startsWith(item.href);
          return (
            <a
              href={item.href}
              class={`px-3 py-1.5 rounded-lg text-xs sm:text-sm transition-colors whitespace-nowrap ${
                isActive
                  ? 'text-zinc-950 dark:text-zinc-50 font-medium'
                  : 'text-zinc-500 dark:text-zinc-400 hover:text-zinc-900 dark:hover:text-zinc-100'
              }`}
            >
              {item.label}
            </a>
          );
        })}
      </nav>

      <!-- Right Actions & Theme Toggle -->
      <div class="flex items-center space-x-1.5 sm:space-x-2 flex-shrink-0">
        <!-- GitHub -->
        <a
          href="https://github.com/ozdil"
          target="_blank"
          rel="noopener noreferrer"
          class="p-2 rounded-lg text-zinc-500 dark:text-zinc-400 hover:text-zinc-900 dark:hover:text-zinc-100 hover:bg-zinc-100 dark:hover:bg-zinc-800/60 border border-zinc-200/70 dark:border-zinc-800/70 transition-all"
          title="GitHub: @ozdil"
          aria-label="GitHub"
        >
          <svg class="w-4 h-4 fill-current" viewBox="0 0 16 16" aria-hidden="true">
            <path d="M8 0c4.42 0 8 3.58 8 8a8.013 8.013 0 0 1-5.45 7.59c-.4.08-.55-.17-.55-.38 0-.27.01-1.13.01-2.2 0-.75-.25-1.23-.54-1.48 1.78-.2 3.65-.88 3.65-3.95 0-.88-.31-1.59-.82-2.15.08-.2.36-1.02-.08-2.12 0 0-.67-.22-2.2.82-.64-.18-1.32-.27-2-.27-.68 0-1.36.09-2 .27-1.53-1.03-2.2-.82-2.2-.82-.44 1.1-.16 1.92-.08 2.12-.51.56-.82 1.28-.82 2.15 0 3.06 1.86 3.75 3.64 3.95-.23.2-.44.55-.51 1.07-.46.21-1.61.55-2.33-.66-.15-.24-.6-.83-1.23-.82-.67.01-.27.38.01.53.34.19.73.9.82 1.13.16.45.68 1.31 2.69.94 0 .67.01 1.3.01 1.49 0 .21-.15.45-.55.38A7.995 7.995 0 0 1 0 8c0-4.42 3.58-8 8-8Z"></path>
          </svg>
        </a>

        <!-- RSS -->
        <a
          href="/rss.xml"
          class="p-2 rounded-lg text-zinc-500 dark:text-zinc-400 hover:text-amber-600 dark:hover:text-amber-400 hover:bg-zinc-100 dark:hover:bg-zinc-800/60 border border-zinc-200/70 dark:border-zinc-800/70 transition-all hidden sm:inline-flex"
          title="RSS Beslemesi"
          aria-label="RSS Feed"
        >
          <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24">
            <path d="M6.18 15.64a2.18 2.18 0 0 1 2.18 2.18C8.36 19 7.38 20 6.18 20C5 20 4 19 4 17.82a2.18 2.18 0 0 1 2.18-2.18M4 4.44A15.56 15.56 0 0 1 19.56 20h-2.83A12.73 12.73 0 0 0 4 7.27V4.44m0 5.66a9.9 9.9 0 0 1 9.9 9.9h-2.83A7.07 7.07 0 0 0 4 12.93V10.1Z"/>
          </svg>
        </a>

        <!-- Theme Toggle -->
        <ThemeToggle />
      </div>
    </div>
  </div>
</header>
