---
import ThemeToggle from './ThemeToggle.astro';

interface Props {
  currentPath?: string;
}

const { currentPath = '/' } = Astro.props;

const navItems = [
  { href: '/', label: 'Overview', icon: 'overview' },
  { href: '/blog', label: 'Articles', icon: 'articles' },
  { href: '/projeler', label: 'Repositories', icon: 'repos' },
  { href: '/hakkimda', label: 'README.md', icon: 'readme' },
];
---

<header class="border-b border-gh-border bg-gh-subtle sticky top-0 z-40">
  <div class="max-w-6xl mx-auto px-4 sm:px-6">
    <!-- Top Bar -->
    <div class="flex items-center justify-between h-14">
      <div class="flex items-center space-x-3">
        <a href="/" class="flex items-center space-x-2 text-gh-text font-semibold hover:text-gh-link transition-colors">
          <!-- Terminal / Wolf Icon in GitHub style -->
          <span class="w-8 h-8 rounded-full bg-gh-border flex items-center justify-center text-sm shadow-sm overflow-hidden border border-gh-border">
            <img src="/avatar.jpg" alt="Ozan Özdil" class="w-full h-full object-cover" />
          </span>
          <span class="font-mono text-sm tracking-tight text-gh-text">
            ozdil <span class="text-gh-textMuted font-normal">/</span> <strong class="font-semibold text-gh-text">ozanozdil.com</strong>
          </span>
        </a>
        <span class="hidden sm:inline-flex items-center px-2 py-0.5 rounded-full text-xs font-mono font-medium bg-gh-badge text-gh-textMuted border border-gh-border">
          Public
        </span>
      </div>

      <div class="flex items-center space-x-3">
        <!-- Quick Links -->
        <a
          href="https://github.com/ozdil"
          target="_blank"
          rel="noopener noreferrer"
          class="text-gh-textMuted hover:text-gh-text p-1.5 rounded-md hover:bg-gh-bg transition-colors"
          title="GitHub Profili: @ozdil"
        >
          <svg class="w-5 h-5 fill-current" viewBox="0 0 16 16" aria-hidden="true">
            <path d="M8 0c4.42 0 8 3.58 8 8a8.013 8.013 0 0 1-5.45 7.59c-.4.08-.55-.17-.55-.38 0-.27.01-1.13.01-2.2 0-.75-.25-1.23-.54-1.48 1.78-.2 3.65-.88 3.65-3.95 0-.88-.31-1.59-.82-2.15.08-.2.36-1.02-.08-2.12 0 0-.67-.22-2.2.82-.64-.18-1.32-.27-2-.27-.68 0-1.36.09-2 .27-1.53-1.03-2.2-.82-2.2-.82-.44 1.1-.16 1.92-.08 2.12-.51.56-.82 1.28-.82 2.15 0 3.06 1.86 3.75 3.64 3.95-.23.2-.44.55-.51 1.07-.46.21-1.61.55-2.33-.66-.15-.24-.6-.83-1.23-.82-.67.01-.27.38.01.53.34.19.73.9.82 1.13.16.45.68 1.31 2.69.94 0 .67.01 1.3.01 1.49 0 .21-.15.45-.55.38A7.995 7.995 0 0 1 0 8c0-4.42 3.58-8 8-8Z"></path>
          </svg>
        </a>

        <a
          href="https://nsosyal.com/ozanozdil"
          target="_blank"
          rel="noopener noreferrer"
          class="hidden sm:inline-flex items-center text-xs font-mono px-2 py-1 rounded-md border border-gh-border text-gh-text hover:bg-gh-bg transition-colors"
        >
          NSosyal: @ozanozdil
        </a>

        <a
          href="/rss.xml"
          class="text-gh-textMuted hover:text-amber-500 p-1.5 rounded-md hover:bg-gh-bg transition-colors"
          title="RSS Beslemesi"
        >
          <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24">
            <path d="M6.18 15.64a2.18 2.18 0 0 1 2.18 2.18C8.36 19 7.38 20 6.18 20C5 20 4 19 4 17.82a2.18 2.18 0 0 1 2.18-2.18M4 4.44A15.56 15.56 0 0 1 19.56 20h-2.83A12.73 12.73 0 0 0 4 7.27V4.44m0 5.66a9.9 9.9 0 0 1 9.9 9.9h-2.83A7.07 7.07 0 0 0 4 12.93V10.1Z"/>
          </svg>
        </a>

        <ThemeToggle />
      </div>
    </div>

    <!-- GitHub Sub-navigation Tabs -->
    <nav class="flex space-x-1 sm:space-x-4 -mb-px overflow-x-auto no-scrollbar pt-1 text-sm font-medium" aria-label="Tabs">
      {navItems.map((item) => {
        const isActive = item.href === '/' ? currentPath === '/' : currentPath.startsWith(item.href);
        return (
          <a
            href={item.href}
            class={`inline-flex items-center space-x-2 px-3 py-2 border-b-2 font-medium text-xs sm:text-sm whitespace-nowrap transition-colors ${
              isActive
                ? 'border-[#fd8c73] text-gh-text font-semibold'
                : 'border-transparent text-gh-textMuted hover:text-gh-text hover:border-gh-border'
            }`}
          >
            {item.icon === 'overview' && (
              <svg class="w-4 h-4" viewBox="0 0 16 16" fill="currentColor">
                <path d="M0 1.75A.75.75 0 0 1 .75 1h4.253a1 1 0 0 1 .707.293L7.414 3H15.25a.75.75 0 0 1 .75.75v10.5a.75.75 0 0 1-.75.75H.75a.75.75 0 0 1-.75-.75ZM1.5 4.5v8.75c0 .138.112.25.25.25h12.5a.25.25 0 0 0 .25-.25V4.5Z"></path>
              </svg>
            )}
            {item.icon === 'articles' && (
              <svg class="w-4 h-4" viewBox="0 0 16 16" fill="currentColor">
                <path d="M0 2.75C0 1.784.784 1 1.75 1h12.5c.966 0 1.75.784 1.75 1.75v10.5A1.75 1.75 0 0 1 14.25 15H1.75A1.75 1.75 0 0 1 0 13.25Zm1.75-.25a.25.25 0 0 0-.25.25v10.5c0 .138.112.25.25.25h12.5a.25.25 0 0 0 .25-.25V2.75a.25.25 0 0 0-.25-.25ZM3 4.5h10v1.5H3Zm0 3h10V9H3Zm0 3h6v1.5H3Z"></path>
              </svg>
            )}
            {item.icon === 'repos' && (
              <svg class="w-4 h-4" viewBox="0 0 16 16" fill="currentColor">
                <path d="M2 2.5A2.5 2.5 0 0 1 4.5 0h8.75a.75.75 0 0 1 .75.75v12.5a.75.75 0 0 1-.75.75h-2.5a.75.75 0 0 1 0-1.5h1.75v-2h-8a1 1 0 0 0-.714 1.7.75.75 0 1 1-1.072 1.05A2.495 2.495 0 0 1 2 11.5Zm10.5-1h-8a1 1 0 0 0-1 1v6.708A2.486 2.486 0 0 1 4.5 9h8ZM5 12.25a.25.25 0 0 1 .25-.25h3.5a.25.25 0 0 1 .25.25v3.25a.25.25 0 0 1-.4.2l-1.6-1.2-1.6 1.2a.25.25 0 0 1-.4-.2Z"></path>
              </svg>
            )}
            {item.icon === 'readme' && (
              <svg class="w-4 h-4" viewBox="0 0 16 16" fill="currentColor">
                <path d="M8 1.5a6.5 6.5 0 1 0 0 13 6.5 6.5 0 0 0 0-13ZM0 8a8 8 0 1 1 16 0A8 8 0 0 1 0 8Zm6.5-2a1.5 1.5 0 1 1 3 0 1.5 1.5 0 0 1-3 0ZM8 7.5a.75.75 0 0 1 .75.75v3.5a.75.75 0 0 1-1.5 0v-3.5A.75.75 0 0 1 8 7.5Z"></path>
              </svg>
            )}
            <span>{item.label}</span>
          </a>
        );
      })}
    </nav>
  </div>
</header>
