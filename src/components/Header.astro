---
import ThemeToggle from './ThemeToggle.astro';
import LanguageSelector from './LanguageSelector.astro';

interface Props {
  currentPath?: string;
}

const { currentPath = '/' } = Astro.props;

const navItems = [
  { href: '/', id: '01', code: 'hakkimda', label: 'Hakkımda' },
  { href: '/blog', id: '02', code: 'yazilar', label: 'Yazılar' },
  { href: '/projeler', id: '03', code: 'projeler', label: 'Projeler' },
  { href: '/galeri', id: '04', code: 'galeri', label: 'Galeri' },
];
---

<header class="fixed top-0 left-0 right-0 w-full z-50 backdrop-blur-md bg-white/90 dark:bg-[#08090b]/90 border-b border-zinc-200/80 dark:border-white/10 transition-colors">
  <div class="max-w-[1720px] mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex items-center justify-between h-14 gap-2 sm:gap-4">
      <!-- Left: Branding & Desktop Navigation -->
      <div class="flex items-center space-x-3 sm:space-x-6 min-w-0">
        <!-- Branding -->
        <a href="/" class="flex items-center space-x-2 group flex-shrink-0" title="Ozan Özdil">
          <div class="relative w-7 h-7 rounded-lg overflow-hidden border border-zinc-300 dark:border-zinc-700 bg-zinc-100 dark:bg-zinc-800 flex-shrink-0 p-0.5">
            <img src="/avatar.webp" alt="Ozan Özdil" width="28" height="28" decoding="async" class="w-full h-full object-cover rounded-md" />
          </div>
          <div class="flex flex-col text-left">
            <span class="text-xs sm:text-sm font-medium tracking-tight text-zinc-900 dark:text-zinc-100 group-hover:text-zinc-950 dark:group-hover:text-[#00ffcc] transition-colors whitespace-nowrap">
              Ozan Özdil
            </span>
          </div>
        </a>

        <!-- Navigation Menu (Desktop Only) -->
        <nav class="hidden sm:flex items-center space-x-1 sm:space-x-1.5 py-1 text-xs font-mono" aria-label="Menü">
          {navItems.map((item) => {
            const isActive = item.href === '/' ? currentPath === '/' : currentPath.startsWith(item.href);
            return (
              <a
                href={item.href}
                class={`px-2.5 sm:px-3 py-1 sm:py-1.5 rounded-md transition-all whitespace-nowrap flex items-center gap-1 border ${
                  isActive
                    ? 'border-zinc-900 dark:border-[#00ffcc]/60 bg-zinc-100 dark:bg-[#141820] text-zinc-950 dark:text-[#00ffcc] font-medium shadow-2xs'
                    : 'border-transparent text-zinc-600 dark:text-zinc-400 hover:border-zinc-300 dark:hover:border-zinc-700/60 hover:bg-zinc-100/70 dark:hover:bg-zinc-900/40 hover:text-zinc-900 dark:hover:text-zinc-200'
                }`}
              >
                <span>{item.label}</span>
              </a>
            );
          })}
        </nav>
      </div>

      <!-- Right: Actions, Language, Theme & Mobile Menu Button -->
      <div class="flex items-center space-x-1 sm:space-x-1.5 flex-shrink-0 font-mono text-xs">

        <!-- Buy Me a Coffee (Desktop Only) -->
        <a
          href="https://buymeacoffee.com/ozdil"
          target="_blank"
          rel="noopener noreferrer"
          class="p-1.5 sm:p-2 rounded-md text-amber-600 dark:text-amber-400 hover:text-amber-700 dark:hover:text-amber-300 hover:bg-amber-100/60 dark:hover:bg-amber-950/40 border border-amber-300/60 dark:border-amber-700/50 transition-all hidden sm:flex items-center justify-center"
          title="Buy Me a Coffee: ozdil"
          aria-label="Buy Me a Coffee"
        >
          <svg class="w-3.5 h-3.5 sm:w-4 sm:h-4 fill-current" viewBox="0 0 24 24" aria-hidden="true">
            <path d="M20 3H4v10c0 2.21 1.79 4 4 4h6c2.21 0 4-1.79 4-4v-3h2c1.1 0 2-.9 2-2V5c0-1.1-.9-2-2-2zm0 5h-2V5h2v3zM2 19h18v2H2v-2z" />
          </svg>
        </a>

        <!-- GitHub Launcher (Desktop Only) -->
        <a
          href="https://github.com/ozdil"
          target="_blank"
          rel="noopener noreferrer"
          class="p-1.5 sm:p-2 rounded-md text-zinc-600 dark:text-zinc-400 hover:text-zinc-950 dark:hover:text-white hover:bg-zinc-100 dark:hover:bg-[#141820] border border-zinc-200 dark:border-zinc-800 transition-all hidden sm:inline-flex"
          title="GitHub: @ozdil"
          aria-label="GitHub"
        >
          <svg class="w-3.5 h-3.5 sm:w-4 sm:h-4 fill-current" viewBox="0 0 16 16" aria-hidden="true">
            <path d="M8 0c4.42 0 8 3.58 8 8a8.013 8.013 0 0 1-5.45 7.59c-.4.08-.55-.17-.55-.38 0-.27.01-1.13.01-2.2 0-.75-.25-1.23-.54-1.48 1.78-.2 3.65-.88 3.65-3.95 0-.88-.31-1.59-.82-2.15.08-.2.36-1.02-.08-2.12 0 0-.67-.22-2.2.82-.64-.18-1.32-.27-2-.27-.68 0-1.36.09-2 .27-1.53-1.03-2.2-.82-2.2-.82-.44 1.1-.16 1.92-.08 2.12-.51.56-.82 1.28-.82 2.15 0 3.06 1.86 3.75 3.64 3.95-.23.2-.44.55-.51 1.07-.46.21-1.61.55-2.33-.66-.15-.24-.6-.83-1.23-.82-.67.01-.27.38.01.53.34.19.73.9.82 1.13.16.45.68 1.31 2.69.94 0 .67.01 1.3.01 1.49 0 .21-.15.45-.55.38A7.995 7.995 0 0 1 0 8c0-4.42 3.58-8 8-8Z"></path>
          </svg>
        </a>

        <!-- Steam Launcher (Desktop Only) -->
        <a
          href="https://steamcommunity.com/id/ozanozdil"
          target="_blank"
          rel="noopener noreferrer"
          class="p-1.5 sm:p-2 rounded-md text-zinc-600 dark:text-zinc-400 hover:text-zinc-950 dark:hover:text-white hover:bg-zinc-100 dark:hover:bg-[#141820] border border-zinc-200 dark:border-zinc-800 transition-all hidden sm:inline-flex"
          title="Steam: ozanozdil"
          aria-label="Steam"
        >
          <svg class="w-3.5 h-3.5 sm:w-4 sm:h-4 fill-current" viewBox="0 0 24 24" aria-hidden="true">
            <path d="M11.979 0C5.678 0 .511 4.86.022 11.037l6.432 2.658c.545-.371 1.203-.59 1.912-.59.063 0 .125.004.188.006l2.861-4.142V8.91c0-2.495 2.028-4.524 4.524-4.524 2.494 0 4.524 2.031 4.524 4.527s-2.03 4.525-4.524 4.525h-.105l-4.076 2.911c0 .052.004.105.004.159 0 1.875-1.515 3.396-3.39 3.396-1.635 0-3.016-1.173-3.331-2.727L.436 15.27C1.862 20.307 6.486 24 11.979 24c6.627 0 11.999-5.373 11.999-12S18.605 0 11.979 0zM7.54 18.21l-1.473-.61c.262.543.714.999 1.314 1.25 1.297.539 2.793-.076 3.332-1.375.263-.63.264-1.319.005-1.949s-.75-1.121-1.377-1.383c-.624-.26-1.29-.249-1.878-.03l1.523.63c.956.4 1.409 1.5 1.009 2.455-.397.957-1.497 1.41-2.454 1.012H7.54zm11.415-9.303c0-1.662-1.353-3.015-3.015-3.015-1.665 0-3.015 1.353-3.015 3.015 0 1.665 1.35 3.015 3.015 3.015 1.663 0 3.015-1.35 3.015-3.015zm-5.273-.005c0-1.252 1.013-2.266 2.265-2.266 1.249 0 2.266 1.014 2.266 2.266 0 1.251-1.017 2.265-2.266 2.265-1.253 0-2.265-1.014-2.265-2.265z"/>
          </svg>
        </a>

        <!-- NSosyal Launcher (Desktop Only) -->
        <a
          href="https://nsosyal.com/ozanozdil"
          target="_blank"
          rel="noopener noreferrer"
          class="p-1.5 sm:p-2 rounded-md text-zinc-600 dark:text-zinc-400 hover:text-zinc-950 dark:hover:text-white hover:bg-zinc-100 dark:hover:bg-[#141820] border border-zinc-200 dark:border-zinc-800 transition-all hidden sm:inline-flex"
          title="NSosyal: @ozanozdil"
          aria-label="NSosyal"
        >
          <svg class="w-3.5 h-3.5 sm:w-4 sm:h-4 fill-current" viewBox="0 0 24 24" aria-hidden="true">
            <path d="M5 4h3.5l7 10.5V4H19v16h-3.5L8.5 9.5V20H5V4z"/>
          </svg>
        </a>

        <!-- RSS Feed (Desktop Only) -->
        <a
          href="/rss.xml"
          class="p-1.5 sm:p-2 rounded-md text-zinc-600 dark:text-zinc-400 hover:text-zinc-900 dark:hover:text-[#00ffcc] hover:bg-zinc-100 dark:hover:bg-[#141820] border border-zinc-200 dark:border-zinc-800 transition-all hidden sm:inline-flex"
          title="RSS Beslemesi"
          aria-label="RSS Feed"
        >
          <svg class="w-3.5 h-3.5 sm:w-4 sm:h-4 fill-current" viewBox="0 0 24 24">
            <path d="M6.18 15.64a2.18 2.18 0 0 1 2.18 2.18C8.36 19 7.38 20 6.18 20C5 20 4 19 4 17.82a2.18 2.18 0 0 1 2.18-2.18M4 4.44A15.56 15.56 0 0 1 19.56 20h-2.83A12.73 12.73 0 0 0 4 7.27V4.44m0 5.66a9.9 9.9 0 0 1 9.9 9.9h-2.83A7.07 7.07 0 0 0 4 12.93V10.1Z"/>
          </svg>
        </a>

        <!-- Language Selector -->
        <LanguageSelector />

        <!-- Theme Toggle -->
        <ThemeToggle />

        <!-- Mobile Menu Toggle Button -->
        <button
          id="mobile-menu-btn"
          type="button"
          aria-expanded="false"
          aria-controls="mobile-menu"
          aria-label="Menüyü Aç/Kapat"
          class="sm:hidden p-2 rounded-lg text-zinc-600 dark:text-zinc-400 hover:text-zinc-950 dark:hover:text-[#00ffcc] hover:bg-zinc-100 dark:hover:bg-[#141820] border border-zinc-200 dark:border-zinc-800 transition-all focus:outline-none flex items-center justify-center cursor-pointer shadow-2xs"
        >
          <!-- Hamburger Bars Icon -->
          <svg id="menu-icon-bars" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16" />
          </svg>
          <!-- Close Cross Icon -->
          <svg id="menu-icon-close" class="w-4 h-4 hidden" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
          </svg>
        </button>
      </div>
    </div>
  </div>

  <!-- Mobile Navigation Drawer -->
  <div
    id="mobile-menu"
    class="hidden sm:hidden border-t border-zinc-200/80 dark:border-zinc-800/80 bg-white/95 dark:bg-[#0c0e12]/95 backdrop-blur-xl px-4 py-4 space-y-4 shadow-2xl transition-all"
  >
    <!-- Navigation Links -->
    <div class="space-y-1">
      <div class="text-[10px] font-mono text-zinc-400 dark:text-zinc-500 uppercase tracking-wider px-2 py-0.5">
        // Menü
      </div>
      {navItems.map((item) => {
        const isActive = item.href === '/' ? currentPath === '/' : currentPath.startsWith(item.href);
        return (
          <a
            href={item.href}
            class={`flex items-center justify-between px-3.5 py-2.5 rounded-lg font-mono text-xs transition-all border ${
              isActive
                ? 'border-zinc-900 dark:border-[#00ffcc]/60 bg-zinc-100 dark:bg-[#141820] text-zinc-950 dark:text-[#00ffcc] font-semibold shadow-2xs'
                : 'border-transparent text-zinc-700 dark:text-zinc-300 hover:bg-zinc-100 dark:hover:bg-zinc-800/60 hover:text-zinc-950 dark:hover:text-white'
            }`}
          >
            <span class="flex items-center gap-2.5">
              <span class="text-[10px] text-zinc-400 dark:text-zinc-500">{item.id}</span>
              <span class="text-sm font-sans">{item.label}</span>
            </span>
            {isActive ? (
              <span class="text-[10px] font-mono text-[#00ffcc] flex items-center gap-1.5">
                <span class="w-1.5 h-1.5 rounded-full bg-[#00ffcc] animate-pulse"></span>
                aktif
              </span>
            ) : (
              <span class="text-zinc-400 text-xs">→</span>
            )}
          </a>
        );
      })}
    </div>

    <!-- Quick Action / Social Links -->
    <div class="pt-2 border-t border-zinc-100 dark:border-zinc-800/80 space-y-2">
      <div class="text-[10px] font-mono text-zinc-400 dark:text-zinc-500 uppercase tracking-wider px-2 py-0.5">
        // Hızlı Bağlantılar & Destek
      </div>
      <div class="grid grid-cols-2 gap-2 font-mono text-xs">
        <!-- Buy Me a Coffee -->
        <a
          href="https://buymeacoffee.com/ozdil"
          target="_blank"
          rel="noopener noreferrer"
          class="flex items-center gap-2 px-3 py-2.5 rounded-lg text-amber-600 dark:text-amber-400 bg-amber-50/80 dark:bg-amber-950/30 border border-amber-200 dark:border-amber-800/60 hover:bg-amber-100 dark:hover:bg-amber-900/40 transition-colors col-span-2 justify-center font-medium"
        >
          <span>☕</span>
          <span>Kahve Ismarla (Buy Me a Coffee)</span>
          <span>↗</span>
        </a>

        <!-- GitHub -->
        <a
          href="https://github.com/ozdil"
          target="_blank"
          rel="noopener noreferrer"
          class="flex items-center justify-between px-3 py-2 rounded-lg text-zinc-700 dark:text-zinc-300 bg-zinc-50 dark:bg-zinc-900/50 border border-zinc-200 dark:border-zinc-800 hover:border-zinc-400 dark:hover:border-zinc-600 transition-colors"
        >
          <span class="flex items-center gap-2">
            <svg class="w-3.5 h-3.5 fill-current" viewBox="0 0 16 16">
              <path d="M8 0c4.42 0 8 3.58 8 8a8.013 8.013 0 0 1-5.45 7.59c-.4.08-.55-.17-.55-.38 0-.27.01-1.13.01-2.2 0-.75-.25-1.23-.54-1.48 1.78-.2 3.65-.88 3.65-3.95 0-.88-.31-1.59-.82-2.15.08-.2.36-1.02-.08-2.12 0 0-.67-.22-2.2.82-.64-.18-1.32-.27-2-.27-.68 0-1.36.09-2 .27-1.53-1.03-2.2-.82-2.2-.82-.44 1.1-.16 1.92-.08 2.12-.51.56-.82 1.28-.82 2.15 0 3.06 1.86 3.75 3.64 3.95-.23.2-.44.55-.51 1.07-.46.21-1.61.55-2.33-.66-.15-.24-.6-.83-1.23-.82-.67.01-.27.38.01.53.34.19.73.9.82 1.13.16.45.68 1.31 2.69.94 0 .67.01 1.3.01 1.49 0 .21-.15.45-.55.38A7.995 7.995 0 0 1 0 8c0-4.42 3.58-8 8-8Z"></path>
            </svg>
            <span>GitHub</span>
          </span>
          <span class="text-zinc-400">↗</span>
        </a>

        <!-- Steam -->
        <a
          href="https://steamcommunity.com/id/ozanozdil"
          target="_blank"
          rel="noopener noreferrer"
          class="flex items-center justify-between px-3 py-2 rounded-lg text-zinc-700 dark:text-zinc-300 bg-zinc-50 dark:bg-zinc-900/50 border border-zinc-200 dark:border-zinc-800 hover:border-zinc-400 dark:hover:border-zinc-600 transition-colors"
        >
          <span class="flex items-center gap-2">
            <svg class="w-3.5 h-3.5 fill-current" viewBox="0 0 24 24">
              <path d="M11.979 0C5.678 0 .511 4.86.022 11.037l6.432 2.658c.545-.371 1.203-.59 1.912-.59.063 0 .125.004.188.006l2.861-4.142V8.91c0-2.495 2.028-4.524 4.524-4.524 2.494 0 4.524 2.031 4.524 4.527s-2.03 4.525-4.524 4.525h-.105l-4.076 2.911c0 .052.004.105.004.159 0 1.875-1.515 3.396-3.39 3.396-1.635 0-3.016-1.173-3.331-2.727L.436 15.27C1.862 20.307 6.486 24 11.979 24c6.627 0 11.999-5.373 11.999-12S18.605 0 11.979 0zM7.54 18.21l-1.473-.61c.262.543.714.999 1.314 1.25 1.297.539 2.793-.076 3.332-1.375.263-.63.264-1.319.005-1.949s-.75-1.121-1.377-1.383c-.624-.26-1.29-.249-1.878-.03l1.523.63c.956.4 1.409 1.5 1.009 2.455-.397.957-1.497 1.41-2.454 1.012H7.54zm11.415-9.303c0-1.662-1.353-3.015-3.015-3.015-1.665 0-3.015 1.353-3.015 3.015 0 1.665 1.35 3.015 3.015 3.015 1.663 0 3.015-1.35 3.015-3.015zm-5.273-.005c0-1.252 1.013-2.266 2.265-2.266 1.249 0 2.266 1.014 2.266 2.266 0 1.251-1.017 2.265-2.266 2.265-1.253 0-2.265-1.014-2.265-2.265z"/>
            </svg>
            <span>Steam</span>
          </span>
          <span class="text-zinc-400">↗</span>
        </a>

        <!-- nSosyal -->
        <a
          href="https://nsosyal.com/ozanozdil"
          target="_blank"
          rel="noopener noreferrer"
          class="flex items-center justify-between px-3 py-2 rounded-lg text-zinc-700 dark:text-zinc-300 bg-zinc-50 dark:bg-zinc-900/50 border border-zinc-200 dark:border-zinc-800 hover:border-zinc-400 dark:hover:border-zinc-600 transition-colors"
        >
          <span class="flex items-center gap-2">
            <svg class="w-3.5 h-3.5 fill-current" viewBox="0 0 24 24">
              <path d="M5 4h3.5l7 10.5V4H19v16h-3.5L8.5 9.5V20H5V4z"/>
            </svg>
            <span>nSosyal</span>
          </span>
          <span class="text-zinc-400">↗</span>
        </a>

        <!-- RSS -->
        <a
          href="/rss.xml"
          class="flex items-center justify-between px-3 py-2 rounded-lg text-zinc-700 dark:text-zinc-300 bg-zinc-50 dark:bg-zinc-900/50 border border-zinc-200 dark:border-zinc-800 hover:border-zinc-400 dark:hover:border-zinc-600 transition-colors"
        >
          <span class="flex items-center gap-2">
            <svg class="w-3.5 h-3.5 fill-current" viewBox="0 0 24 24">
              <path d="M6.18 15.64a2.18 2.18 0 0 1 2.18 2.18C8.36 19 7.38 20 6.18 20C5 20 4 19 4 17.82a2.18 2.18 0 0 1 2.18-2.18M4 4.44A15.56 15.56 0 0 1 19.56 20h-2.83A12.73 12.73 0 0 0 4 7.27V4.44m0 5.66a9.9 9.9 0 0 1 9.9 9.9h-2.83A7.07 7.07 0 0 0 4 12.93V10.1Z"/>
            </svg>
            <span>RSS Akışı</span>
          </span>
          <span class="text-zinc-400">↗</span>
        </a>
      </div>
    </div>
  </div>
</header>

<script is:inline>
  (function initMobileMenu() {
    const btn = document.getElementById('mobile-menu-btn');
    const menu = document.getElementById('mobile-menu');
    const iconBars = document.getElementById('menu-icon-bars');
    const iconClose = document.getElementById('menu-icon-close');

    if (!btn || !menu) return;

    function toggleMenu(show) {
      if (show) {
        menu.classList.remove('hidden');
        btn.setAttribute('aria-expanded', 'true');
        iconBars?.classList.add('hidden');
        iconClose?.classList.remove('hidden');

        // Close language dropdown if open
        const langDropdown = document.getElementById('lang-dropdown');
        if (langDropdown && !langDropdown.classList.contains('hidden')) {
          langDropdown.classList.add('hidden');
          const langBtn = document.getElementById('lang-selector-btn');
          langBtn?.setAttribute('aria-expanded', 'false');
          const chevron = document.getElementById('lang-chevron');
          chevron?.classList.remove('rotate-180');
        }
      } else {
        menu.classList.add('hidden');
        btn.setAttribute('aria-expanded', 'false');
        iconBars?.classList.remove('hidden');
        iconClose?.classList.add('hidden');
      }
    }

    btn.addEventListener('click', (e) => {
      e.stopPropagation();
      const isHidden = menu.classList.contains('hidden');
      toggleMenu(isHidden);
    });

    // Close on navigation link click
    menu.querySelectorAll('a').forEach((link) => {
      link.addEventListener('click', () => {
        toggleMenu(false);
      });
    });

    // Close on outside click
    document.addEventListener('click', (e) => {
      if (!menu.contains(e.target) && !btn.contains(e.target)) {
        toggleMenu(false);
      }
    });

    // Close on Escape key
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') {
        toggleMenu(false);
      }
    });

    // If language button is clicked, close mobile menu
    const langBtn = document.getElementById('lang-selector-btn');
    langBtn?.addEventListener('click', () => {
      toggleMenu(false);
    });
  })();
</script>
