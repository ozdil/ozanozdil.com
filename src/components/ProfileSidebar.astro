---
---

<aside class="w-full lg:w-72 flex-shrink-0">
  <div class="flex flex-col items-start">
    <!-- Avatar and Status -->
    <div class="relative mb-4 group">
      <div class="w-40 h-40 sm:w-48 sm:h-48 lg:w-64 lg:h-64 rounded-full overflow-hidden border-2 border-gh-border shadow-sm bg-gh-subtle">
        <img
          src="/avatar.jpg"
          alt="Ozan Özdil"
          class="w-full h-full object-cover"
          loading="eager"
        />
      </div>

      <!-- Status Indicator -->
      <div class="absolute bottom-2 right-2 sm:bottom-3 sm:right-3 bg-gh-bg border border-gh-border text-xs px-2.5 py-1 rounded-full shadow-md flex items-center space-x-1.5 cursor-default" title="Çalışma Durumu">
        <span class="w-2 h-2 rounded-full bg-emerald-500 inline-block"></span>
        <span class="text-[11px] font-mono text-gh-textMuted font-medium">Ar-Ge & Sistem</span>
      </div>
    </div>

    <!-- Names -->
    <div class="mb-3">
      <h1 class="text-2xl font-bold text-gh-text tracking-tight">Ozan Özdil</h1>
      <h2 class="text-sm font-medium text-gh-textMuted font-mono">@ozdil</h2>
    </div>

    <!-- Professional Bio -->
    <div class="mb-5 text-xs sm:text-sm text-gh-text leading-relaxed font-normal">
      Stratejist ve Teknoloji Araştırmacısı. Kamu yönetimi, kitle iletişimi ve kurumsal bilişim tecrübesi; açık kaynak Linux sistem mimarisi, ağ güvenliği ve yapay zekâ entegrasyonları.
    </div>

    <!-- Action Buttons -->
    <div class="w-full mb-6 flex flex-col gap-2">
      <a
        href="https://nsosyal.com/ozanozdil"
        target="_blank"
        rel="noopener noreferrer"
        class="w-full py-1.5 px-3 text-center text-xs font-semibold rounded-md border border-gh-border bg-gh-subtle text-gh-text hover:bg-gh-borderMuted transition-colors shadow-sm"
      >
        NSosyal Profili
      </a>
      <a
        href="https://github.com/ozdil"
        target="_blank"
        rel="noopener noreferrer"
        class="w-full py-1.5 px-3 text-center text-xs font-semibold rounded-md border border-gh-border bg-gh-subtle text-gh-text hover:bg-gh-borderMuted transition-colors shadow-sm flex items-center justify-center space-x-1.5"
      >
        <svg class="w-3.5 h-3.5 fill-current" viewBox="0 0 16 16">
          <path d="M8 0c4.42 0 8 3.58 8 8a8.013 8.013 0 0 1-5.45 7.59c-.4.08-.55-.17-.55-.38 0-.27.01-1.13.01-2.2 0-.75-.25-1.23-.54-1.48 1.78-.2 3.65-.88 3.65-3.95 0-.88-.31-1.59-.82-2.15.08-.2.36-1.02-.08-2.12 0 0-.67-.22-2.2.82-.64-.18-1.32-.27-2-.27-.68 0-1.36.09-2 .27-1.53-1.03-2.2-.82-2.2-.82-.44 1.1-.16 1.92-.08 2.12-.51.56-.82 1.28-.82 2.15 0 3.06 1.86 3.75 3.64 3.95-.23.2-.44.55-.51 1.07-.46.21-1.61.55-2.33-.66-.15-.24-.6-.83-1.23-.82-.67.01-.27.38.01.53.34.19.73.9.82 1.13.16.45.68 1.31 2.69.94 0 .67.01 1.3.01 1.49 0 .21-.15.45-.55.38A7.995 7.995 0 0 1 0 8c0-4.42 3.58-8 8-8Z"></path>
        </svg>
        <span>GitHub: @ozdil</span>
      </a>
    </div>

    <!-- Metadata Details -->
    <div class="w-full space-y-2.5 text-xs text-gh-text">
      <div class="flex items-center space-x-2">
        <svg class="w-4 h-4 text-gh-textMuted flex-shrink-0" viewBox="0 0 16 16" fill="currentColor">
          <path d="M1.75 2h12.5c.966 0 1.75.784 1.75 1.75v8.5A1.75 1.75 0 0 1 14.25 14H1.75A1.75 1.75 0 0 1 0 12.25v-8.5C0 2.784.784 2 1.75 2ZM1.5 6.75v5.5c0 .138.112.25.25.25h12.5a.25.25 0 0 0 .25-.25v-5.5Zm0-1.5h13v-1.5a.25.25 0 0 0-.25-.25H1.75a.25.25 0 0 0-.25.25Z"></path>
        </svg>
        <span>Sistem Güvenliği & Açık Kaynak</span>
      </div>

      <div class="flex items-center space-x-2">
        <svg class="w-4 h-4 text-gh-textMuted flex-shrink-0" viewBox="0 0 16 16" fill="currentColor">
          <path d="m12.596 11.596-3.535 3.536a1.5 1.5 0 0 1-2.122 0l-3.535-3.536a6.5 6.5 0 1 1 9.192-9.193 6.5 6.5 0 0 1 0 9.193Zm-1.06-8.132a5 5 0 1 0-7.072 7.072L8 14.07l3.536-3.534a5 5 0 0 0 0-7.072ZM8 9a2 2 0 1 1 0-4 2 2 0 0 1 0 4Z"></path>
        </svg>
        <span>Kastamonu, Türkiye</span>
      </div>

      <div class="flex items-center space-x-2">
        <svg class="w-4 h-4 text-gh-textMuted flex-shrink-0" viewBox="0 0 16 16" fill="currentColor">
          <path d="m7.775 3.275 1.25-1.25a3.5 3.5 0 1 1 4.95 4.95l-2.5 2.5a3.5 3.5 0 0 1-4.95 0 .751.751 0 0 1 .018-1.042.751.751 0 0 1 1.042-.018 1.998 1.998 0 0 0 2.83 0l2.5-2.5a2.002 2.002 0 0 0-2.83-2.83l-1.25 1.25a.751.751 0 0 1-1.042-.018.751.751 0 0 1-.018-1.042Zm-1.2 8.725-1.25 1.25a3.5 3.5 0 1 1-4.95-4.95l2.5-2.5a3.5 3.5 0 0 1 4.95 0 .751.751 0 0 1-.018 1.042.751.751 0 0 1-1.042.018 1.998 1.998 0 0 0-2.83 0l-2.5 2.5a2.002 2.002 0 0 0 2.83 2.83l1.25-1.25a.751.751 0 0 1 1.042.018.751.751 0 0 1 .018 1.042Z"></path>
        </svg>
        <a href="https://ozanozdil.com" class="text-gh-link hover:underline font-mono truncate">ozanozdil.com</a>
      </div>
    </div>

    <!-- Separator -->
    <div class="w-full my-5 border-t border-gh-border"></div>

    <!-- Focus Tags -->
    <div class="w-full">
      <h3 class="text-xs font-semibold text-gh-text uppercase tracking-wider mb-2.5 font-mono">Çalışma Alanları</h3>
      <div class="flex flex-wrap gap-1.5">
        <span class="px-2 py-0.5 text-[11px] font-mono rounded bg-gh-badge text-gh-textMuted border border-gh-border">Sistem Mimarisi</span>
        <span class="px-2 py-0.5 text-[11px] font-mono rounded bg-gh-badge text-gh-textMuted border border-gh-border">Ağ Savunması</span>
        <span class="px-2 py-0.5 text-[11px] font-mono rounded bg-gh-badge text-gh-textMuted border border-gh-border">Arch Linux</span>
        <span class="px-2 py-0.5 text-[11px] font-mono rounded bg-gh-badge text-gh-textMuted border border-gh-border">Omarchy</span>
        <span class="px-2 py-0.5 text-[11px] font-mono rounded bg-gh-badge text-gh-textMuted border border-gh-border">Lokal Yapay Zekâ</span>
        <span class="px-2 py-0.5 text-[11px] font-mono rounded bg-gh-badge text-gh-textMuted border border-gh-border">Stratejik İletişim</span>
      </div>
    </div>
  </div>
</aside>
