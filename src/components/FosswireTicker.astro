---
import fosswireLatestFallback from '../data/fosswire_latest.json';

interface NewsItem {
  title: string;
  url: string;
  category?: string;
  source?: string;
  published_at?: string;
}

const fallbackNews: NewsItem[] = (fosswireLatestFallback as NewsItem[]).slice(0, 30);
---

<div
  id="fosswire-ticker-bar"
  class="relative w-full overflow-hidden select-none font-mono text-xs z-30 transition-colors border-b duration-200"
  aria-label="FOSSWire Canlı Haber Akışı"
>
  <!-- Üst İnce Yanar Döner Siber Işıltı Çizgisi -->
  <div class="ticker-shimmer-line absolute top-0 left-0 right-0 h-[1.5px] z-20"></div>

  <div class="max-w-5xl mx-auto px-4 sm:px-6 flex items-center h-10 gap-2">
    <!-- Sabit Sol Başlık Rozeti: Yanar Döner Neon Efekti -->
    <a
      href="https://fosswire.org"
      target="_blank"
      rel="noopener noreferrer"
      class="ticker-badge relative flex items-center gap-2 px-3 py-1 rounded-full text-xs font-mono font-medium transition-all flex-shrink-0 z-20 group whitespace-nowrap shadow-xs"
      title="FOSSWire.org — Açık Kaynak ve Açık Donanım Haberleri"
    >
      <!-- Canlı Nabız Göstergesi -->
      <span class="relative flex h-2 w-2 items-center justify-center flex-shrink-0">
        <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-emerald-500 opacity-75"></span>
        <span class="relative inline-flex rounded-full h-1.5 w-1.5 bg-emerald-500"></span>
      </span>

      <!-- Başlık Metni -->
      <span class="ticker-badge-text font-bold tracking-wider text-[11px] uppercase transition-colors">
        FOSSWire'dan Son Haberler
      </span>

      <!-- CANLI Rozeti -->
      <span class="ticker-live-pill text-[9px] px-1.5 py-0.2 rounded font-semibold uppercase tracking-wider">
        CANLI
      </span>
    </a>

    <!-- Kayan Haber Alanı (Viewport) -->
    <div
      class="relative flex-1 overflow-hidden flex items-center group/ticker h-full min-w-0"
      id="ticker-viewport"
    >
      <!-- Sol ve Sağ Maske Geçişleri -->
      <div class="ticker-fade-left pointer-events-none absolute left-0 top-0 bottom-0 w-8 z-10"></div>
      <div class="ticker-fade-right pointer-events-none absolute right-0 top-0 bottom-0 w-12 z-10"></div>

      <!-- Kayan Şerit (Kesintisiz Marquee Döngüsü) -->
      <div
        id="ticker-track"
        class="flex items-center whitespace-nowrap will-change-transform animate-ticker group-hover/ticker:pause-animation"
      >
        <!-- SSR Başlangıç Şeridi 1 -->
        <div class="flex items-center space-x-6 pr-6 ticker-chunk" id="ticker-chunk-1">
          {fallbackNews.map((item) => (
            <a
              href={item.url}
              target="_blank"
              rel="noopener noreferrer"
              class="ticker-news-link inline-flex items-center gap-2 text-xs py-1 transition-colors group/item"
            >
              <span class="ticker-bullet w-1.5 h-1.5 rounded-full transition-transform group-hover/item:scale-125"></span>
              {item.source && (
                <span class="ticker-source-tag text-[10px] px-1.5 py-0.5 rounded transition-colors">
                  {item.source}
                </span>
              )}
              <span class="ticker-news-title font-medium transition-colors">
                {item.title}
              </span>
            </a>
          ))}
        </div>

        <!-- SSR Başlangıç Şeridi 2 (Sonsuz Kesintisiz Döngü) -->
        <div class="flex items-center space-x-6 pr-6 ticker-chunk" id="ticker-chunk-2" aria-hidden="true">
          {fallbackNews.map((item) => (
            <a
              href={item.url}
              target="_blank"
              rel="noopener noreferrer"
              tabindex="-1"
              class="ticker-news-link inline-flex items-center gap-2 text-xs py-1 transition-colors group/item"
            >
              <span class="ticker-bullet w-1.5 h-1.5 rounded-full transition-transform group-hover/item:scale-125"></span>
              {item.source && (
                <span class="ticker-source-tag text-[10px] px-1.5 py-0.5 rounded transition-colors">
                  {item.source}
                </span>
              )}
              <span class="ticker-news-title font-medium transition-colors">
                {item.title}
              </span>
            </a>
          ))}
        </div>
      </div>
    </div>
  </div>
</div>

<style>
  /* ========================================================================= */
  /* KOYU TEMA (DARK MODE - DEFAULT)                                          */
  /* ========================================================================= */
  #fosswire-ticker-bar {
    background-color: rgba(18, 18, 21, 0.95);
    border-color: #27272a;
  }

  .ticker-shimmer-line {
    background: linear-gradient(90deg, #10b981, #06b6d4, #6366f1, #d946ef, #10b981);
    background-size: 200% 100%;
    animation: shimmer 6s ease infinite;
    opacity: 0.85;
  }

  .ticker-badge {
    background: #18181b;
    border: 1px solid #27272a;
    color: #ffffff;
  }

  .ticker-badge:hover {
    background: #27272a;
    border-color: #3f3f46;
  }

  .ticker-badge-text {
    background: linear-gradient(90deg, #34d399, #38bdf8, #818cf8);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
  }

  .ticker-live-pill {
    background-color: rgba(16, 185, 129, 0.15);
    color: #34d399;
    border: 1px solid rgba(16, 185, 129, 0.3);
  }

  .ticker-fade-left {
    background: linear-gradient(to right, #121215, transparent);
  }

  .ticker-fade-right {
    background: linear-gradient(to left, #121215, transparent);
  }

  .ticker-news-link {
    color: #a1a1aa;
  }

  .ticker-news-link:hover {
    color: #ffffff;
  }

  .ticker-bullet {
    background-color: rgba(16, 185, 129, 0.6);
  }

  .ticker-news-link:hover .ticker-bullet {
    background-color: #34d399;
    box-shadow: 0 0 6px rgba(52, 211, 153, 0.6);
  }

  .ticker-source-tag {
    background-color: #18181b;
    color: #71717a;
    border: 1px solid #27272a;
  }

  .ticker-news-link:hover .ticker-source-tag {
    color: #38bdf8;
    border-color: rgba(56, 189, 248, 0.3);
  }

  .ticker-news-title:hover {
    color: #f4f4f5;
  }

  /* ========================================================================= */
  /* AÇIK TEMA (LIGHT MODE)                                                    */
  /* ========================================================================= */
  :global(html:not(.dark)) #fosswire-ticker-bar {
    background-color: rgba(255, 255, 255, 0.96) !important;
    border-color: #e4e4e7 !important;
    box-shadow: 0 1px 3px 0 rgba(0, 0, 0, 0.05) !important;
  }

  :global(html:not(.dark)) .ticker-shimmer-line {
    background: linear-gradient(90deg, #059669, #0284c7, #4f46e5, #c026d3, #059669) !important;
    background-size: 200% 100% !important;
    animation: shimmer 6s ease infinite !important;
    opacity: 0.95 !important;
  }

  :global(html:not(.dark)) .ticker-badge {
    background: #f4f4f5 !important;
    border-color: #e4e4e7 !important;
    color: #09090b !important;
  }

  :global(html:not(.dark)) .ticker-badge:hover {
    background: #e4e4e7 !important;
    border-color: #d4d4d8 !important;
  }

  :global(html:not(.dark)) .ticker-badge-text {
    background: linear-gradient(90deg, #047857, #0369a1, #4338ca) !important;
    -webkit-background-clip: text !important;
    -webkit-text-fill-color: transparent !important;
  }

  :global(html:not(.dark)) .ticker-live-pill {
    background-color: rgba(5, 150, 105, 0.12) !important;
    color: #047857 !important;
    border-color: rgba(5, 150, 105, 0.25) !important;
  }

  :global(html:not(.dark)) .ticker-fade-left {
    background: linear-gradient(to right, #ffffff, transparent) !important;
  }

  :global(html:not(.dark)) .ticker-fade-right {
    background: linear-gradient(to left, #ffffff, transparent) !important;
  }

  :global(html:not(.dark)) .ticker-news-link {
    color: #52525b !important;
  }

  :global(html:not(.dark)) .ticker-news-link:hover {
    color: #09090b !important;
  }

  :global(html:not(.dark)) .ticker-bullet {
    background-color: rgba(5, 150, 105, 0.7) !important;
  }

  :global(html:not(.dark)) .ticker-news-link:hover .ticker-bullet {
    background-color: #059669 !important;
    box-shadow: 0 0 6px rgba(5, 150, 105, 0.4) !important;
  }

  :global(html:not(.dark)) .ticker-source-tag {
    background-color: #f4f4f5 !important;
    color: #71717a !important;
    border-color: #e4e4e7 !important;
  }

  :global(html:not(.dark)) .ticker-news-link:hover .ticker-source-tag {
    color: #0284c7 !important;
    border-color: rgba(2, 132, 199, 0.3) !important;
  }

  :global(html:not(.dark)) .ticker-news-title:hover {
    color: #09090b !important;
  }

  /* ========================================================================= */
  /* ANİMASYONLAR                                                              */
  /* ========================================================================= */
  @keyframes ticker {
    0% {
      transform: translateX(0);
    }
    100% {
      transform: translateX(-50%);
    }
  }

  @keyframes shimmer {
    0% {
      background-position: 0% 50%;
    }
    50% {
      background-position: 100% 50%;
    }
    100% {
      background-position: 0% 50%;
    }
  }

  .animate-ticker {
    display: inline-flex;
    animation: ticker 90s linear infinite;
  }

  .pause-animation {
    animation-play-state: paused !important;
  }
</style>

<script is:inline>
  (function initFosswireTicker() {
    async function refreshNews() {
      try {
        var res = await fetch('https://fosswire.org/api/v1/news.json', { cache: 'no-cache' });
        if (!res.ok) return;
        var data = await res.json();
        var articles = (data.articles || []).slice(0, 30);
        if (!articles.length) return;

        function buildHtml(list, isAriaHidden) {
          return list.map(function(item) {
            var title = item.title_tr || item.title;
            var url = item.canonical_url || ('https://fosswire.org/news/' + item.slug + '.html');
            var src = item.source ? '<span class="ticker-source-tag text-[10px] px-1.5 py-0.5 rounded transition-colors">' + item.source + '</span>' : '';
            var tabAttr = isAriaHidden ? ' tabindex="-1"' : '';
            return '<a href="' + url + '" target="_blank" rel="noopener noreferrer"' + tabAttr + ' class="ticker-news-link inline-flex items-center gap-2 text-xs py-1 transition-colors group/item"><span class="ticker-bullet w-1.5 h-1.5 rounded-full transition-transform group-hover/item:scale-125"></span>' + src + '<span class="ticker-news-title font-medium transition-colors">' + title + '</span></a>';
          }).join('');
        }

        var chunk1 = document.getElementById('ticker-chunk-1');
        var chunk2 = document.getElementById('ticker-chunk-2');
        if (chunk1 && chunk2) {
          chunk1.innerHTML = buildHtml(articles, false);
          chunk2.innerHTML = buildHtml(articles, true);
        }
      } catch (err) {
        // Fallback SSR verisi kullanılmaya devam eder
      }
    }

    if (document.readyState === 'complete') {
      refreshNews();
    } else {
      window.addEventListener('load', refreshNews);
    }
  })();
</script>
