---
// AiChatModal.astro
// Floating AI Chat Assistant powered by Cloudflare Workers AI
---

<div id="ai-chat-root" class="fixed bottom-5 right-5 z-40 font-sans print:hidden">
  <!-- Trigger Button -->
  <button
    id="ai-chat-trigger"
    type="button"
    aria-label="Ozan AI Asistanı Aç"
    class="group flex items-center gap-2.5 px-3.5 py-2.5 rounded-full bg-[#280205] border border-[#e5c158]/35 hover:border-[#e5c158] shadow-2xl transition-all duration-300 focus:outline-none focus:ring-2 focus:ring-[#e5c158]/50"
  >
    <div class="relative flex items-center justify-center w-7 h-7 rounded-full bg-[#190102] text-[#e5c158] border border-[#e5c158]/30 overflow-hidden">
      <!-- Glow pulse -->
      <span class="absolute inline-flex h-full w-full rounded-full bg-[#e5c158] opacity-20 group-hover:animate-ping"></span>
      <svg class="w-4 h-4 z-10" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M8 10h.01M12 10h.01M16 10h.01M9 16H5a2 2 0 01-2-2V6a2 2 0 012-2h14a2 2 0 012 2v8a2 2 0 01-2 2h-5l-5 5v-5z" />
      </svg>
    </div>
    <div class="flex flex-col text-left">
      <span class="text-xs font-semibold tracking-tight text-[#ffffff] flex items-center gap-1.5 font-mono">
        Ozan AI
        <span class="inline-block w-1.5 h-1.5 rounded-full bg-[#e5c158] animate-pulse"></span>
      </span>
      <span class="text-[10px] text-[#c5cbd3] font-mono hidden sm:inline">
        Dijital İkiz
      </span>
    </div>
  </button>

  <!-- Chat Window Modal -->
  <div
    id="ai-chat-window"
    role="dialog"
    aria-modal="true"
    aria-labelledby="ai-chat-title"
    class="hidden opacity-0 scale-95 fixed sm:absolute bottom-0 right-0 sm:bottom-14 sm:right-0 w-[calc(100vw-2rem)] sm:w-[400px] h-[540px] max-h-[85vh] bg-[#190102]/95 backdrop-blur-xl border border-[#e5c158]/35 rounded-2xl shadow-2xl flex flex-col overflow-hidden transition-all duration-200 origin-bottom-right z-50"
  >
    <!-- Modal Header -->
    <div class="flex items-center justify-between px-4 py-3 border-b border-[#e5c158]/20 bg-[#280205]">
      <div class="flex items-center gap-2.5">
        <div class="relative w-8 h-8 rounded-full overflow-hidden border border-[#e5c158]/30 bg-[#190102]">
          <img src="/avatar.jpg" alt="Ozan Özdil" class="w-full h-full object-cover" />
          <span class="absolute bottom-0 right-0 w-2.5 h-2.5 rounded-full bg-[#e5c158] ring-2 ring-[#280205]"></span>
        </div>
        <div>
          <h2 id="ai-chat-title" class="text-xs font-semibold text-[#ffffff] font-mono flex items-center gap-1.5">
            Ozan Özdil (AI)
            <span class="text-[9px] px-1.5 py-0.2 rounded bg-[#190102] text-[#e5c158] font-mono border border-[#e5c158]/30">
              Llama 3.1
            </span>
          </h2>
          <p class="text-[10px] text-[#c5cbd3] font-mono">
            Açık Kaynak & Sistem Asistanı
          </p>
        </div>
      </div>
      <div class="flex items-center gap-1">
        <button
          id="ai-chat-clear"
          type="button"
          title="Sohbeti Temizle"
          class="p-1.5 rounded-lg text-[#c5cbd3] hover:text-[#e5c158] hover:bg-[#380407] transition-colors"
        >
          <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" />
          </svg>
        </button>
        <button
          id="ai-chat-close"
          type="button"
          aria-label="Kapat"
          class="p-1.5 rounded-lg text-[#c5cbd3] hover:text-[#e5c158] hover:bg-[#380407] transition-colors"
        >
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
          </svg>
        </button>
      </div>
    </div>

    <!-- Messages Container -->
    <div id="ai-chat-messages" class="flex-1 overflow-y-auto p-4 space-y-3.5 text-xs font-mono">
      <!-- Default Welcome Message -->
      <div class="flex gap-2.5 items-start">
        <div class="w-6 h-6 rounded-full bg-[#190102] text-[#e5c158] border border-[#e5c158]/30 flex-shrink-0 flex items-center justify-center font-mono text-[10px] font-bold mt-0.5">
          AI
        </div>
        <div class="flex-1 space-y-2">
          <div class="p-3 rounded-2xl rounded-tl-sm bg-[#280205] text-[#ffffff] border border-[#e5c158]/20 leading-relaxed shadow-sm">
            Merhaba! Ben Ozan Özdil'in web sitesindeki yapay zeka dijital asistanıyım.
            <br/><br/>
            Geliştirdiğim açık kaynak projeler, Omarchy Linux çekirdek optimizasyonları, OmaStudio orta format RAW motoru veya makalelerim hakkında merak ettiğin her şeyi sorabilirsin.
          </div>

          <!-- Suggested Chips -->
          <div class="pt-1 flex flex-wrap gap-1.5" id="ai-suggested-chips">
            <button type="button" class="chip-btn px-2.5 py-1 rounded-full text-[11px] font-mono bg-[#190102] border border-[#e5c158]/25 hover:border-[#e5c158] text-[#c5cbd3] hover:text-[#e5c158] transition-all cursor-pointer">
              Omarchy eklentilerin neler?
            </button>
            <button type="button" class="chip-btn px-2.5 py-1 rounded-full text-[11px] font-mono bg-[#190102] border border-[#e5c158]/25 hover:border-[#e5c158] text-[#c5cbd3] hover:text-[#e5c158] transition-all cursor-pointer">
              OmaStudio nedir?
            </button>
            <button type="button" class="chip-btn px-2.5 py-1 rounded-full text-[11px] font-mono bg-[#190102] border border-[#e5c158]/25 hover:border-[#e5c158] text-[#c5cbd3] hover:text-[#e5c158] transition-all cursor-pointer">
              Kamu ve belediyecilik tecrüben
            </button>
            <button type="button" class="chip-btn px-2.5 py-1 rounded-full text-[11px] font-mono bg-[#190102] border border-[#e5c158]/25 hover:border-[#e5c158] text-[#c5cbd3] hover:text-[#e5c158] transition-all cursor-pointer">
              Ozan ile nasıl iletişime geçerim?
            </button>
          </div>
        </div>
      </div>
    </div>

    <!-- Typing indicator (hidden by default) -->
    <div id="ai-chat-typing" class="hidden px-4 py-2 flex items-center gap-2 text-[#c5cbd3] text-[11px] font-mono">
      <div class="w-5 h-5 rounded-full bg-[#190102] border border-[#e5c158]/30 flex items-center justify-center text-[9px] font-bold text-[#e5c158]">
        AI
      </div>
      <div class="flex items-center gap-1 py-1 px-2.5 rounded-full bg-[#280205] border border-[#e5c158]/20">
        <span class="w-1.5 h-1.5 rounded-full bg-[#e5c158] animate-bounce"></span>
        <span class="w-1.5 h-1.5 rounded-full bg-[#e5c158] animate-bounce [animation-delay:0.2s]"></span>
        <span class="w-1.5 h-1.5 rounded-full bg-[#e5c158] animate-bounce [animation-delay:0.4s]"></span>
      </div>
      <span>düşünüyor...</span>
    </div>

    <!-- Input Form -->
    <form id="ai-chat-form" class="p-3 border-t border-[#e5c158]/20 bg-[#280205] flex items-center gap-2">
      <input
        id="ai-chat-input"
        type="text"
        placeholder="Ozan hakkında bir soru sor..."
        autocomplete="off"
        maxlength="500"
        class="flex-1 bg-[#190102] text-[#ffffff] placeholder-[#c5cbd3]/60 text-xs px-3.5 py-2.5 rounded-xl border border-[#e5c158]/30 focus:outline-none focus:border-[#e5c158] transition-colors"
      />
      <button
        id="ai-chat-send"
        type="submit"
        aria-label="Gönder"
        class="p-2.5 rounded-xl bg-[#e5c158] hover:bg-[#f3e5ab] text-[#190102] transition-colors flex items-center justify-center disabled:opacity-40 disabled:cursor-not-allowed cursor-pointer font-bold"
      >
        <svg class="w-3.5 h-3.5 transform rotate-90" fill="currentColor" viewBox="0 0 20 20">
          <path d="M10.894 2.553a1 1 0 00-1.788 0l-7 14a1 1 0 001.169 1.409l5-1.429A1 1 0 009 15.571V11a1 1 0 112 0v4.571a1 1 0 00.725.962l5 1.428a1 1 0 001.17-1.408l-7-14z" />
        </svg>
      </button>
    </form>
  </div>
</div>

<script is:inline>
  (function initAiChat() {
    const trigger = document.getElementById('ai-chat-trigger');
    const windowEl = document.getElementById('ai-chat-window');
    const closeBtn = document.getElementById('ai-chat-close');
    const clearBtn = document.getElementById('ai-chat-clear');
    const form = document.getElementById('ai-chat-form');
    const input = document.getElementById('ai-chat-input');
    const sendBtn = document.getElementById('ai-chat-send');
    const messagesContainer = document.getElementById('ai-chat-messages');
    const typingIndicator = document.getElementById('ai-chat-typing');

    if (!trigger || !windowEl || !form || !input) return;

    let isOpen = false;
    let isLoading = false;
    let chatHistory = [];

    function openChat() {
      isOpen = true;
      windowEl.classList.remove('hidden');
      requestAnimationFrame(() => {
        windowEl.classList.remove('opacity-0', 'scale-95');
        windowEl.classList.add('opacity-100', 'scale-100');
        input.focus();
      });
    }

    function closeChat() {
      isOpen = false;
      windowEl.classList.remove('opacity-100', 'scale-100');
      windowEl.classList.add('opacity-0', 'scale-95');
      setTimeout(() => {
        if (!isOpen) {
          windowEl.classList.add('hidden');
        }
      }, 200);
    }

    trigger.addEventListener('click', () => {
      if (isOpen) {
        closeChat();
      } else {
        openChat();
      }
    });

    closeBtn?.addEventListener('click', closeChat);

    // Format safe markdown into HTML
    function formatMarkdown(rawText) {
      if (!rawText) return '';
      let text = rawText
        .replace(/&/g, '&amp;')
        .replace(/</g, '&lt;')
        .replace(/>/g, '&gt;');

      // Bold **text**
      text = text.replace(/\*\*(.*?)\*\*/g, '<strong class="font-semibold text-[#ffffff]">$1</strong>');
      // Italic *text*
      text = text.replace(/\*(.*?)\*/g, '<em class="italic">$1</em>');
      // Inline code `code`
      text = text.replace(/`([^`]+)`/g, '<code class="px-1.5 py-0.5 rounded bg-[#190102] text-[11px] font-mono text-[#e5c158] border border-[#e5c158]/25">$1</code>');
      // Markdown links [label](url)
      text = text.replace(
        /\[([^\]]+)\]\((https?:\/\/[^\s\)]+)\)/g,
        '<a href="$2" target="_blank" rel="noopener noreferrer" class="text-[#e5c158] font-medium underline underline-offset-2 hover:text-[#f3e5ab] transition-colors">$1 ↗</a>'
      );
      // Newlines
      text = text.replace(/\n\n/g, '<br/><br/>').replace(/\n/g, '<br/>');

      return text;
    }

    function scrollToBottom() {
      if (messagesContainer) {
        messagesContainer.scrollTop = messagesContainer.scrollHeight;
      }
    }

    function appendUserMessage(msg) {
      const wrapper = document.createElement('div');
      wrapper.className = 'flex justify-end';

      const bubble = document.createElement('div');
      bubble.className = 'max-w-[85%] p-3 rounded-2xl rounded-tr-sm bg-[#e5c158] text-[#190102] font-semibold leading-relaxed shadow-sm break-words';
      bubble.textContent = msg;

      wrapper.appendChild(bubble);
      messagesContainer.appendChild(wrapper);
      scrollToBottom();
    }

    function appendAssistantMessage(htmlContent) {
      const wrapper = document.createElement('div');
      wrapper.className = 'flex gap-2.5 items-start';

      const avatar = document.createElement('div');
      avatar.className = 'w-6 h-6 rounded-full bg-[#190102] text-[#e5c158] border border-[#e5c158]/30 flex-shrink-0 flex items-center justify-center font-mono text-[10px] font-bold mt-0.5';
      avatar.textContent = 'AI';

      const contentDiv = document.createElement('div');
      contentDiv.className = 'flex-1 space-y-1';

      const bubble = document.createElement('div');
      bubble.className = 'p-3 rounded-2xl rounded-tl-sm bg-[#280205] text-[#ffffff] border border-[#e5c158]/20 leading-relaxed shadow-sm break-words';
      bubble.innerHTML = htmlContent;

      contentDiv.appendChild(bubble);
      wrapper.appendChild(avatar);
      wrapper.appendChild(contentDiv);

      messagesContainer.appendChild(wrapper);
      scrollToBottom();
    }

    async function handleSend(query) {
      const text = (query || input.value || '').trim();
      if (!text || isLoading) return;

      input.value = '';
      appendUserMessage(text);
      chatHistory.push({ role: 'user', content: text });

      isLoading = true;
      input.disabled = true;
      if (sendBtn) sendBtn.disabled = true;
      if (typingIndicator) typingIndicator.classList.remove('hidden');
      scrollToBottom();

      try {
        const response = await fetch('/api/chat', {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json',
          },
          body: JSON.stringify({
            message: text,
            history: chatHistory.slice(-6),
          }),
        });

        const data = await response.json();
        const answer = data.answer || 'Üzgünüm, şu anda yanıt üretemedim.';
        chatHistory.push({ role: 'assistant', content: answer });

        appendAssistantMessage(formatMarkdown(answer));
      } catch (err) {
        console.error('Chat error:', err);
        appendAssistantMessage(
          'Bağlantı hatası oluştu. Lütfen tekrar deneyin veya doğrudan <a href="/projeler" class="underline text-[#e5c158]">Projeler</a> sayfamızı inceleyin.'
        );
      } finally {
        isLoading = false;
        input.disabled = false;
        if (sendBtn) sendBtn.disabled = false;
        if (typingIndicator) typingIndicator.classList.add('hidden');
        input.focus();
        scrollToBottom();
      }
    }

    form.addEventListener('submit', (e) => {
      e.preventDefault();
      handleSend();
    });

    // Chip buttons click handler
    document.querySelectorAll('.chip-btn').forEach((btn) => {
      btn.addEventListener('click', () => {
        const query = btn.textContent?.trim() || '';
        handleSend(query);
      });
    });

    // Clear chat
    clearBtn?.addEventListener('click', () => {
      chatHistory = [];
      messagesContainer.innerHTML = `
        <div class="flex gap-2.5 items-start">
          <div class="w-6 h-6 rounded-full bg-[#190102] text-[#e5c158] border border-[#e5c158]/30 flex-shrink-0 flex items-center justify-center font-mono text-[10px] font-bold mt-0.5">
            AI
          </div>
          <div class="flex-1 space-y-2">
            <div class="p-3 rounded-2xl rounded-tl-sm bg-[#280205] text-[#ffffff] border border-[#e5c158]/20 leading-relaxed shadow-sm">
              Sohbet geçmişi temizlendi. Ozan Özdil'in çalışmaları hakkında yeni bir soru sorabilirsin.
            </div>
          </div>
        </div>
      `;
    });
  })();
</script>
