---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Fotoğraf Galerisi (Flickr) — Ozan Özdil"
  description="Kastamonu, tarihi yapılar ve doğa fotoğraflarından oluşan dinamik Flickr fotoğraf koleksiyonu."
  currentPath="/galeri"
>
  <div class="mb-6">
    <div class="flex flex-col sm:flex-row sm:items-center justify-between pb-4 border-b border-gh-border gap-3">
      <div>
        <h1 class="text-xl font-bold text-gh-text flex items-center gap-2">
          <span>Fotoğraf Koleksiyonu & Arşiv</span>
          <span class="text-xs font-mono font-normal px-2 py-0.5 rounded-full bg-gh-badge text-gh-textMuted border border-gh-border">
            Flickr API Live
          </span>
        </h1>
        <p class="text-xs text-gh-textMuted mt-1">
          Kastamonu tarihi dokusu, ahşap mimari, kaleler ve doğa belgeseli fotoğraf serileri.
        </p>
      </div>

      <a
        href="https://www.flickr.com/photos/204447030@N04/"
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center space-x-1.5 text-xs font-mono px-3 py-1.5 rounded-md border border-gh-border bg-gh-subtle text-gh-text hover:bg-gh-borderMuted transition-colors flex-shrink-0 self-start sm:self-auto"
      >
        <span>Flickr Profili</span>
        <svg class="w-3.5 h-3.5 text-gh-textMuted" viewBox="0 0 16 16" fill="currentColor">
          <path d="M3.75 2h3.5a.75.75 0 0 1 0 1.5h-3.5a.25.25 0 0 0-.25.25v8.5c0 .138.112.25.25.25h8.5a.25.25 0 0 0 .25-.25v-3.5a.75.75 0 0 1 1.5 0v3.5A1.75 1.75 0 0 1 12.25 14h-8.5A1.75 1.75 0 0 1 2 12.25v-8.5C2 2.784 2.784 2 3.75 2Zm6.75-.75a.75.75 0 0 1 .75-.75h3.5a.75.75 0 0 1 .75.75v3.5a.75.75 0 0 1-1.5 0V3.56L8.53 8.03a.75.75 0 0 1-1.06-1.06l4.47-4.47h-1.19a.75.75 0 0 1-.75-.75Z"></path>
        </svg>
      </a>
    </div>
  </div>

  <!-- VIEW 1: ALBUMS GRID (DEFAULT) -->
  <div id="album-view">
    <div id="album-grid" class="grid grid-cols-1 md:grid-cols-2 gap-4">
      <!-- Loading Skeleton -->
      <div class="p-4 rounded-md border border-gh-border bg-gh-subtle animate-pulse h-64 flex flex-col justify-end">
        <div class="h-4 bg-gh-border rounded w-3/4 mb-2"></div>
        <div class="h-3 bg-gh-border rounded w-1/2"></div>
      </div>
      <div class="p-4 rounded-md border border-gh-border bg-gh-subtle animate-pulse h-64 flex flex-col justify-end">
        <div class="h-4 bg-gh-border rounded w-3/4 mb-2"></div>
        <div class="h-3 bg-gh-border rounded w-1/2"></div>
      </div>
    </div>
  </div>

  <!-- VIEW 2: PHOTOS IN SELECTED ALBUM (HIDDEN INITIALLY) -->
  <div id="photo-view" class="hidden">
    <div class="flex items-center justify-between mb-4 pb-3 border-b border-gh-border">
      <button
        id="btn-back-albums"
        type="button"
        class="inline-flex items-center space-x-1.5 text-xs font-mono px-3 py-1.5 rounded-md border border-gh-border bg-gh-subtle text-gh-text hover:bg-gh-borderMuted transition-colors"
      >
        <span>← Tüm Albümlere Dön</span>
      </button>
      <h2 id="album-active-title" class="text-sm font-semibold text-gh-text truncate max-w-md font-mono"></h2>
    </div>

    <div id="photos-container" class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-4">
      <!-- Photos injected dynamically here -->
    </div>
  </div>

  <!-- LIGHTBOX / PHOTO MODAL -->
  <dialog
    id="photoModal"
    class="backdrop:bg-black/85 bg-gh-bg text-gh-text border border-gh-border rounded-lg max-w-5xl w-full p-0 shadow-2xl overflow-hidden m-auto"
  >
    <div class="flex items-center justify-between px-4 py-2.5 bg-gh-subtle border-b border-gh-border text-xs font-mono">
      <span id="photoModalTitle" class="truncate text-gh-textMuted">Fotoğraf Detayı</span>
      <button
        id="btnCloseModal"
        type="button"
        class="text-gh-textMuted hover:text-gh-text p-1 rounded hover:bg-gh-bg transition-colors"
      >
        ✕ Kapat
      </button>
    </div>

    <div class="relative bg-black flex items-center justify-center min-h-[300px] max-h-[75vh] overflow-hidden group">
      <img
        id="photoModalImg"
        src=""
        alt="Ozan Özdil Fotoğraf"
        class="max-w-full max-h-[75vh] object-contain transition-opacity duration-200"
      />

      <!-- Navigation Arrows -->
      <button
        id="btnPrevPhoto"
        type="button"
        class="absolute left-3 top-1/2 -translate-y-1/2 bg-black/60 hover:bg-black/90 text-white p-2.5 rounded-full border border-white/20 transition-all opacity-80 hover:opacity-100"
        title="Önceki (Sol Ok)"
      >
        ‹
      </button>
      <button
        id="btnNextPhoto"
        type="button"
        class="absolute right-3 top-1/2 -translate-y-1/2 bg-black/60 hover:bg-black/90 text-white p-2.5 rounded-full border border-white/20 transition-all opacity-80 hover:opacity-100"
        title="Sonraki (Sağ Ok)"
      >
        ›
      </button>
    </div>

    <!-- EXIF Telemetry Footer -->
    <div class="p-3.5 bg-gh-subtle border-t border-gh-border flex flex-col sm:flex-row items-center justify-between gap-2 text-xs font-mono">
      <div id="photoModalExif" class="text-gh-textMuted truncate">
        Telemetri taranıyor...
      </div>
      <div class="text-[11px] text-gh-textMuted flex-shrink-0">
        Klavye: [← / →] Geçiş • [ESC] Kapat
      </div>
    </div>
  </dialog>
</BaseLayout>

<script is:inline>
  const apiKey = "3954ec9c533459f470080bf24178df16";
  const userID = "204447030@N04";
  const exifStore = new Map();
  let photoList = [];
  let activePhotoIdx = 0;

  document.addEventListener('DOMContentLoaded', fetchFlickrAlbums);

  async function fetchFlickrAlbums() {
    const grid = document.getElementById('album-grid');
    if (!grid) return;

    const url = `https://www.flickr.com/services/rest/?method=flickr.photosets.getList&api_key=${apiKey}&user_id=${userID}&format=json&nojsoncallback=1`;

    try {
      const res = await fetch(url);
      const data = await res.json();

      if (data.photosets && data.photosets.photoset) {
        let html = '';
        data.photosets.photoset.forEach((set) => {
          const thumb = `https://live.staticflickr.com/${set.server}/${set.primary}_${set.secret}_z.jpg`;
          const title = escapeHtml(set.title._content);
          const count = set.photos;

          html += `
            <div
              class="rounded-md border border-gh-border bg-gh-bg overflow-hidden hover:border-gh-textMuted transition-all cursor-pointer group flex flex-col justify-between"
              onclick="displayAlbumPhotos('${set.id}', '${encodeURIComponent(title)}')"
            >
              <div class="relative aspect-video w-full overflow-hidden bg-gh-subtle">
                <img
                  loading="lazy"
                  src="${thumb}"
                  alt="${title}"
                  class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300"
                />
                <span class="absolute bottom-2 right-2 px-2 py-0.5 rounded text-[11px] font-mono bg-black/75 text-white backdrop-blur-sm border border-white/20">
                  ${count} Fotoğraf
                </span>
              </div>
              <div class="p-4">
                <h3 class="text-sm font-semibold text-gh-text group-hover:text-gh-link transition-colors font-mono">
                  ${title}
                </h3>
                <p class="text-xs text-gh-textMuted mt-1 line-clamp-2 leading-relaxed">
                  ${escapeHtml(set.description._content || 'Koleksiyon detayları ve yüksek çözünürlüklü fotoğraflar.')}
                </p>
              </div>
            </div>
          `;
        });
        grid.innerHTML = html;
      } else {
        grid.innerHTML = '<div class="p-4 text-xs font-mono text-gh-textMuted border border-gh-border rounded">Albümler sunucudan alınamadı.</div>';
      }
    } catch {
      grid.innerHTML = '<div class="p-4 text-xs font-mono text-gh-textMuted border border-gh-border rounded">Flickr bağlantısı kurulamadı.</div>';
    }
  }

  window.displayAlbumPhotos = async function(setID, encodedTitle) {
    const albumView = document.getElementById('album-view');
    const photoView = document.getElementById('photo-view');
    const container = document.getElementById('photos-container');
    const titleEl = document.getElementById('album-active-title');

    albumView.classList.add('hidden');
    photoView.classList.remove('hidden');
    titleEl.textContent = decodeURIComponent(encodedTitle);
    container.innerHTML = '<div class="col-span-full p-8 text-center text-xs font-mono text-gh-textMuted">Fotoğraflar indeksleniyor...</div>';

    const url = `https://www.flickr.com/services/rest/?method=flickr.photosets.getPhotos&api_key=${apiKey}&photoset_id=${setID}&user_id=${userID}&format=json&nojsoncallback=1`;

    try {
      const res = await fetch(url);
      const data = await res.json();

      if (data.photoset && data.photoset.photo) {
        photoList = data.photoset.photo;
        let html = '';
        photoList.forEach((photo, idx) => {
          const thumb = `https://live.staticflickr.com/${photo.server}/${photo.id}_${photo.secret}_z.jpg`;
          html += `
            <div
              class="photo-cell rounded-md border border-gh-border bg-gh-bg overflow-hidden hover:border-gh-textMuted transition-all group flex flex-col justify-between"
              data-photo-id="${photo.id}"
            >
              <div
                class="relative aspect-video w-full overflow-hidden bg-gh-subtle cursor-pointer"
                onclick="openPhotoModal(${idx})"
              >
                <img
                  loading="lazy"
                  src="${thumb}"
                  alt="${escapeHtml(photo.title || 'Ozan Özdil')}"
                  class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300"
                />
              </div>
              <div id="exif-${photo.id}" class="p-2.5 bg-gh-subtle border-t border-gh-border text-[11px] font-mono text-gh-textMuted truncate">
                Telemetri taranıyor...
              </div>
            </div>
          `;
        });
        container.innerHTML = html;
        attachExifObserver();
      }
    } catch {
      container.innerHTML = '<div class="col-span-full p-4 text-xs font-mono text-gh-textMuted">Fotoğraflar alınamadı.</div>';
    }
  };

  document.getElementById('btn-back-albums')?.addEventListener('click', () => {
    document.getElementById('photo-view').classList.add('hidden');
    document.getElementById('album-view').classList.remove('hidden');
  });

  function attachExifObserver() {
    if (!('IntersectionObserver' in window)) return;
    const obs = new IntersectionObserver((entries, observer) => {
      entries.forEach(entry => {
        if (entry.isIntersecting) {
          const pid = entry.target.getAttribute('data-photo-id');
          if (pid) {
            getExifTelemetry(pid, `exif-${pid}`);
            observer.unobserve(entry.target);
          }
        }
      });
    }, { rootMargin: '100px' });

    document.querySelectorAll('.photo-cell').forEach(cell => obs.observe(cell));
  }

  async function getExifTelemetry(photoID, targetDomId) {
    const el = targetDomId ? document.getElementById(targetDomId) : null;

    if (exifStore.has(photoID)) {
      const val = exifStore.get(photoID);
      if (el) el.innerHTML = val;
      return val;
    }

    const url = `https://www.flickr.com/services/rest/?method=flickr.photos.getExif&api_key=${apiKey}&photo_id=${photoID}&format=json&nojsoncallback=1`;
    try {
      const res = await fetch(url);
      const data = await res.json();
      if (data.photo && data.photo.exif) {
        let iso = "-", f = "-", s = "-", camera = "-", lens = "-";
        data.photo.exif.forEach(e => {
          if (e.tag === "Model") camera = e.raw._content;
          if (e.tag === "LensModel") lens = e.raw._content;
          if (e.tag === "ISO") iso = e.raw._content;
          if (e.tag === "FNumber") f = "f/" + e.raw._content;
          if (e.tag === "ExposureTime") s = e.raw._content + "s";
        });
        const hud = `<span class="text-gh-text font-semibold">${camera}</span> • ${f} • ${s} • ISO ${iso}`;
        exifStore.set(photoID, hud);
        if (el) el.innerHTML = hud;
        return hud;
      }
    } catch {}

    const fallback = 'EXIF bilgisi bulunamadı';
    exifStore.set(photoID, fallback);
    if (el) el.textContent = fallback;
    return fallback;
  }

  const pModal = document.getElementById('photoModal');

  window.openPhotoModal = async function(index) {
    if (!photoList[index]) return;
    activePhotoIdx = index;
    const p = photoList[index];
    const fullUrl = `https://live.staticflickr.com/${p.server}/${p.id}_${p.secret}_b.jpg`;

    document.getElementById('photoModalImg').src = fullUrl;
    document.getElementById('photoModalTitle').textContent = p.title || 'Fotoğraf Detayı';
    const exifArea = document.getElementById('photoModalExif');
    exifArea.textContent = 'Telemetri okunuyor...';

    if (typeof pModal.showModal === 'function') {
      pModal.showModal();
    } else {
      pModal.setAttribute('open', '');
    }

    const info = await getExifTelemetry(p.id);
    exifArea.innerHTML = info;
  };

  function closeModal() {
    if (typeof pModal.close === 'function') {
      pModal.close();
    } else {
      pModal.removeAttribute('open');
    }
    document.getElementById('photoModalImg').src = '';
  }

  document.getElementById('btnCloseModal')?.addEventListener('click', closeModal);
  document.getElementById('btnPrevPhoto')?.addEventListener('click', () => shiftPhoto(-1));
  document.getElementById('btnNextPhoto')?.addEventListener('click', () => shiftPhoto(1));

  function shiftPhoto(offset) {
    let next = activePhotoIdx + offset;
    if (next < 0) next = photoList.length - 1;
    if (next >= photoList.length) next = 0;
    openPhotoModal(next);
  }

  window.addEventListener('keydown', (e) => {
    if (pModal && pModal.open) {
      if (e.key === 'ArrowLeft') shiftPhoto(-1);
      if (e.key === 'ArrowRight') shiftPhoto(1);
      if (e.key === 'Escape') closeModal();
    }
  });

  pModal?.addEventListener('click', (e) => {
    const r = pModal.getBoundingClientRect();
    const inside = (r.top <= e.clientY && e.clientY <= r.top + r.height && r.left <= e.clientX && e.clientX <= r.left + r.width);
    if (!inside) closeModal();
  });

  function escapeHtml(str) {
    return String(str).replace(/[&<>"']/g, function(m) {
      return { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[m];
    });
  }
</script>
