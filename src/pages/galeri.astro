---
import BaseLayout from '../layouts/BaseLayout.astro';

interface ShowcaseItem {
  id: string;
  title: string;
  category: 'temalar' | 'bilesenler' | 'gaming' | 'guvenlik' | 'mimari';
  categoryLabel: string;
  src: string;
  badge: string;
  description: string;
  specs: string[];
}

const galleryItems: ShowcaseItem[] = [
  {
    id: 'qs-arch',
    title: 'Quickshell Tek Süreçli Kabuk Mimarisi',
    category: 'mimari',
    categoryLabel: 'Mimari',
    src: '/images/quickshell/quickshell-architecture.svg',
    badge: 'C++ & QML Çekirdeği',
    description: 'Tüm masaüstü arayüzünü tek bir uzun ömürlü süreçte toplayan, çocuk süreç çatallama maliyetini sıfırlayan modern kabuk mimarisi.',
    specs: ['RAM: < 35 MB', 'Protokol: Wayland IPC', 'Çizim: Qt Quick GPU'],
  },
  {
    id: 'qs-bar',
    title: 'Modüler Üst Bar ve QML Bileşenleri',
    category: 'bilesenler',
    categoryLabel: 'Bileşenler',
    src: '/images/quickshell/quickshell-bar-widget.svg',
    badge: 'Wayland Layer Shell',
    description: 'Hyprland çalışma alanları, aktif pencere başlığı, pil ve saat modüllerini içeren donanım hızlandırmalı üst panel.',
    specs: ['Yükseklik: 36px', 'Katman: WlrLayer.Top', 'Yenileme: 144Hz VSync'],
  },
  {
    id: 'qs-oled',
    title: 'Dinamik OLED Renk Paletleri & Temalar',
    category: 'temalar',
    categoryLabel: 'Temalar',
    src: '/images/quickshell/quickshell-oled-themes.svg',
    badge: 'Gerçek OLED #000000',
    description: 'Türkiye, Steam Machine, Ankara ve İstanbul temalarından oluşan göz yormayan, yüksek kontrastlı renk teorisi koleksiyonu.',
    specs: ['Kontrast: Sonsuz (OLED)', 'Format: QML Singleton', 'Değişim: 0ms Canlı'],
  },
  {
    id: 'qs-gaming',
    title: 'Linux Oyuncusu Game Mode & OSD HUD',
    category: 'gaming',
    categoryLabel: 'Oyun & OSD',
    src: '/images/quickshell/quickshell-game-mode.svg',
    badge: 'Proton & Steam',
    description: 'Tam ekran oyunlarda otomatik DND (rahatsız etme) modu, CPU governor kilidi ve şeffaf kare hızı/sıcaklık telemetri paneli.',
    specs: ['Gecikme: 0ms', 'Entegrasyon: gamemoded', 'Protokol: Gamescope'],
  },
  {
    id: 'qs-ipc',
    title: 'IPC Olay Akışı ve D-Bus Haberleşmesi',
    category: 'mimari',
    categoryLabel: 'Mimari',
    src: '/images/quickshell/quickshell-ipc-events.svg',
    badge: 'D-Bus & Soket Dinleyici',
    description: 'Hyprland UNIX soketleri ve WirePlumber sinyalleri ile masaüstü olaylarını mikrosaniye seviyesinde arayüze aktaran boru hattı.',
    specs: ['Tepki: < 0.4ms', 'Soket: /tmp/hypr/.socket2', 'Protokol: MPRIS2'],
  },
  {
    id: 'qs-plugins',
    title: 'Modüler Topluluk Eklenti Ekosistemi',
    category: 'bilesenler',
    categoryLabel: 'Bileşenler',
    src: '/images/quickshell/quickshell-plugins.svg',
    badge: 'plugins.omarchy.org',
    description: 'BadUSB Shield, CVE Radar ve DNS Leak Guard gibi sistem güvenliği ve verimlilik araçlarını barındıran modüler eklenti yapısı.',
    specs: ['Format: QML Module', 'İzolasyon: Sandbox', 'Yükleme: Hot-Reload'],
  },
  {
    id: 'qs-perf',
    title: 'Performans Analizi ve Bellek Benchmarkları',
    category: 'mimari',
    categoryLabel: 'Mimari',
    src: '/images/quickshell/quickshell-performance.svg',
    badge: '0ms & <35MB RAM',
    description: 'Ağır Electron ve JavaScript arayüzlerine kıyasla Quickshell çekirdeğinin bellek profili ve kare çizim süreleri.',
    specs: ['Çizim: 0.18 ms', 'Bellek: 32 MB', 'CPU: %0.1 Boşta'],
  },
  {
    id: 'qs-lock',
    title: 'OLED Kilit Ekranı & Bildirim Merkezi',
    category: 'guvenlik',
    categoryLabel: 'Güvenlik',
    src: '/images/quickshell/quickshell-lockscreen.svg',
    badge: 'PAM Kimlik Doğrulama',
    description: 'Wayland session lock protokolüyle korunan, akıcı saat animasyonlarına ve gruplandırılmış bildirim merkezine sahip kilit arayüzü.',
    specs: ['Protokol: ext-session-lock', 'Auth: Linux PAM', 'Stil: Minimal OLED'],
  },
];

const categories = [
  { id: 'all', label: 'Tümü' },
  { id: 'temalar', label: 'Temalar' },
  { id: 'bilesenler', label: 'Bileşenler' },
  { id: 'gaming', label: 'Oyun & OSD' },
  { id: 'guvenlik', label: 'Güvenlik' },
  { id: 'mimari', label: 'Mimari' },
];
---

<BaseLayout
  title="Galeri — Ozan Özdil"
  description="QuickShell ve Omarchy masaüstü arayüzleri, OLED temalar, QML bileşenleri ve görsel vitrin."
  currentPath="/galeri"
  maxWidthClass="max-w-6xl"
>
  <div class="py-2 sm:py-4">
    <!-- Header: QuickShell / Omarchy Style -->
    <header class="pb-8 text-center">
      <p class="font-mono text-xs font-medium tracking-[0.18em] text-sky-600 dark:text-[#00ffcc] uppercase sm:text-sm">
        Görsel Vitrin
      </p>
      <h1 class="mt-2 text-2xl sm:text-3xl font-semibold tracking-tight text-zinc-950 dark:text-zinc-50 font-sans">
        QuickShell & Omarchy Arayüz Galerisi
      </h1>
      <p class="mt-2 text-sm text-zinc-600 dark:text-zinc-400 max-w-lg mx-auto">
        Wayland masaüstü arayüzleri, OLED tema motoru, QML bileşenleri ve mimari şemaları.
      </p>

      <!-- Category Filter Pills -->
      <div id="qs-gallery-filters" class="flex flex-wrap items-center justify-center gap-1.5 mt-5 font-mono text-xs">
        {categories.map((cat) => (
          <button
            type="button"
            data-gallery-filter={cat.id}
            class={`qs-gal-pill px-3 py-1 rounded text-xs transition-all cursor-pointer border ${
              cat.id === 'all'
                ? 'bg-zinc-900 text-white border-zinc-900 dark:bg-[#00ffcc] dark:text-zinc-950 dark:border-[#00ffcc] font-semibold'
                : 'bg-zinc-100 dark:bg-zinc-800/60 text-zinc-600 dark:text-zinc-400 border-zinc-200 dark:border-zinc-700/60 hover:text-zinc-950 dark:hover:text-zinc-200 hover:border-zinc-300 dark:hover:border-zinc-600'
            }`}
          >
            {cat.label}
          </button>
        ))}
      </div>
    </header>

    <!-- Grid of Showcase Items -->
    <div id="qs-gallery-grid" class="grid grid-cols-1 md:grid-cols-2 gap-6 pt-4 border-t border-zinc-200 dark:border-zinc-800">
      {galleryItems.map((item) => (
        <article
          class="qs-gal-card group flex flex-col rounded-xl overflow-hidden border border-zinc-200/80 dark:border-zinc-800 bg-white dark:bg-[#0e1117] transition-all hover:border-sky-500 dark:hover:border-[#00ffcc]/60 shadow-2xs"
          data-category={item.category}
        >
          <!-- Image preview container -->
          <div class="relative w-full aspect-[16/9] overflow-hidden bg-zinc-950 border-b border-zinc-200/80 dark:border-zinc-800 flex items-center justify-center">
            <img
              src={item.src}
              alt={item.title}
              class="w-full h-full object-cover transition-transform duration-300 ease-out group-hover:scale-[1.02]"
              loading="lazy"
            />
            <span class="absolute top-3 right-3 px-2 py-0.5 rounded font-mono text-[10px] uppercase font-semibold tracking-wider bg-zinc-900/90 text-[#00ffcc] border border-[#00ffcc]/30 backdrop-blur-xs">
              {item.badge}
            </span>
          </div>

          <!-- Card Content -->
          <div class="p-5 flex flex-col flex-1 justify-between gap-3">
            <div>
              <div class="flex items-center justify-between gap-2 mb-1.5 font-mono text-[11px]">
                <span class="text-sky-600 dark:text-[#00ffcc] font-medium uppercase tracking-wider">
                  [{item.categoryLabel}]
                </span>
                <span class="text-zinc-400 dark:text-zinc-500">Vector SVG</span>
              </div>
              <h2 class="text-base sm:text-lg font-semibold text-zinc-950 dark:text-zinc-50 font-sans group-hover:text-sky-600 dark:group-hover:text-[#00ffcc] transition-colors">
                {item.title}
              </h2>
              <p class="mt-1.5 text-xs sm:text-sm text-zinc-600 dark:text-zinc-400 leading-relaxed font-sans">
                {item.description}
              </p>
            </div>

            <!-- Specs Tag Badges -->
            <div class="flex flex-wrap gap-1.5 pt-2 border-t border-zinc-100 dark:border-zinc-800/80 font-mono text-[10px]">
              {item.specs.map((spec) => (
                <span class="px-2 py-0.5 rounded bg-zinc-100 dark:bg-zinc-800/70 text-zinc-600 dark:text-zinc-400 border border-zinc-200 dark:border-zinc-700/60">
                  {spec}
                </span>
              ))}
            </div>
          </div>
        </article>
      ))}
    </div>
  </div>
</BaseLayout>

<script is:inline>
  function setupGalleryFilter() {
    const pills = document.querySelectorAll('[data-gallery-filter]');
    const cards = document.querySelectorAll('.qs-gal-card');

    pills.forEach((pill) => {
      pill.addEventListener('click', () => {
        const cat = pill.getAttribute('data-gallery-filter');

        // Toggle visibility
        cards.forEach((card) => {
          const itemCat = card.getAttribute('data-category');
          if (cat === 'all' || itemCat === cat) {
            card.classList.remove('hidden');
          } else {
            card.classList.add('hidden');
          }
        });

        // Toggle active styling
        pills.forEach((p) => {
          if (p === pill) {
            p.className = 'qs-gal-pill px-3 py-1 rounded text-xs transition-all cursor-pointer border bg-zinc-900 text-white border-zinc-900 dark:bg-[#00ffcc] dark:text-zinc-950 dark:border-[#00ffcc] font-semibold';
          } else {
            p.className = 'qs-gal-pill px-3 py-1 rounded text-xs transition-all cursor-pointer border bg-zinc-100 dark:bg-zinc-800/60 text-zinc-600 dark:text-zinc-400 border-zinc-200 dark:border-zinc-700/60 hover:text-zinc-950 dark:hover:text-zinc-200 hover:border-zinc-300 dark:hover:border-zinc-600';
          }
        });
      });
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', setupGalleryFilter);
  } else {
    setupGalleryFilter();
  }
</script>
