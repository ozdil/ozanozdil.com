---
import BaseLayout from '../layouts/BaseLayout.astro';
import galleryData from '../data/gallery.json';

const { albums, years, cameras, lenses, totalAlbums, totalPhotos } = galleryData;

// Structured Data for Google Images & Search
const imageGallerySchema = {
  "@context": "https://schema.org",
  "@type": "ImageGallery",
  "name": "Ozan Özdil — Fotoğraf Galerisi & Mimari Arşiv",
  "description": "Kastamonu tarihi yapıları, ahşap camileri (Mahmutbey Camii UNESCO), Ağlı Kalesi, Cide & Gideros Koyu ve kadim coğrafi rotaları. Orta format Fujifilm GFX sistemiyle çekilmiş fotoğraf sergisi.",
  "url": "https://ozanozdil.com/galeri",
  "copyrightNotice": "© 2026 Ozan Özdil. Tüm hakları saklıdır. İzinsiz kopyalanamaz veya çoğaltılamaz.",
  "author": {
    "@type": "Person",
    "name": "Ozan Özdil",
    "jobTitle": "YZ Kodcusu",
    "url": "https://ozanozdil.com",
    "sameAs": [
      "https://github.com/ozdil",
      "https://steamcommunity.com/id/ozanozdil",
      "https://nsosyal.com/ozanozdil"
    ]
  },
  "publisher": {
    "@type": "Person",
    "name": "Ozan Özdil"
  },
  "image": albums.flatMap((album) =>
    album.photos.map((photo) => ({
      "@type": "ImageObject",
      "name": `${photo.title} - ${album.locationFull}`,
      "caption": photo.caption,
      "description": photo.caption,
      "contentUrl": `https://ozanozdil.com${photo.src}`,
      "thumbnailUrl": `https://ozanozdil.com${photo.thumb}`,
      "width": photo.width,
      "height": photo.height,
      "dateCreated": photo.dateTaken,
      "contentLocation": {
        "@type": "Place",
        "name": album.locationFull
      },
      "creator": {
        "@type": "Person",
        "name": "Ozan Özdil"
      },
      "copyrightNotice": "© 2026 Ozan Özdil. Tüm hakları saklıdır.",
      "acquireLicensePage": "https://ozanozdil.com/"
    }))
  )
};
---

<BaseLayout
  title="Fotoğraf Galerisi — Ozan Özdil"
  description="Kastamonu tarihi ahşap mimarisi, çivisiz camiler (UNESCO), Ağlı Kalesi ve kadim coğrafi rotalar. Fujifilm GFX orta format sistemiyle çekilmiş fotoğraf koleksiyonu."
  currentPath="/galeri"
  image="/gallery/agli-kalesi/01_55199063062.webp"
  maxWidthClass="max-w-5xl"
>
  <!-- Schema.org ImageGallery JSON-LD -->
  <script type="application/ld+json" set:html={JSON.stringify(imageGallerySchema)} />

  <div class="pt-10 sm:pt-16 pb-16 space-y-12 sm:space-y-16">
    <!-- Header: Editorial & Airy -->
    <header class="rounded-[28px] border border-[#e5c158]/25 bg-[#280205] p-8 sm:p-14 text-center shadow-xl space-y-4">
      <div class="inline-flex items-center gap-2 font-mono text-xs text-[#e5c158] uppercase tracking-wider font-semibold">
        <span class="w-2 h-2 rounded-full bg-[#e5c158] animate-pulse"></span>
        <span>// GÖRSEL KÜLTÜR & BELGESEL ARŞİV</span>
      </div>
      <h1 class="text-4xl sm:text-6xl font-serif font-normal text-[#e5c158] leading-[1.32] pb-1">
        Orta Format Mimari & Doğa Galerisi
      </h1>
      <p class="text-base sm:text-xl text-[#c5cbd3] max-w-2xl mx-auto font-serif leading-relaxed font-normal">
        Kastamonu tarihi ahşap mimarisi, çivisiz camiler (UNESCO), Ağlı Kalesi ve kadim coğrafi rotalar. Fujifilm GFX 100 & 50R sistemiyle 16-bit fotonik kayıtlar.
      </p>
      <div class="inline-flex flex-wrap items-center justify-center gap-2 pt-2 font-mono text-xs text-[#c5cbd3]">
        <span class="px-3 py-1 rounded-full bg-[#190102] border border-[#c5cbd3]/20">
          {totalAlbums} Konum
        </span>
        <span class="px-3 py-1 rounded-full bg-[#190102] border border-[#c5cbd3]/20">
          {totalPhotos} Kare
        </span>
        <span class="px-3 py-1 rounded-full bg-[#190102] border border-[#e5c158]/30 text-[#e5c158]">
          Sensör: 43.8×32.9mm Orta Format
        </span>
      </div>
    </header>

    <!-- Filter Deck: Sleek Museum Pills -->
    <div class="p-6 sm:p-8 rounded-[24px] border border-[#e5c158]/25 bg-[#280205] text-xs font-mono space-y-4 shadow-xl">
      <!-- Year Filter Row -->
      <div class="flex flex-wrap items-center gap-2">
        <span class="text-[#e5c158] w-20 flex-shrink-0 text-[11px] uppercase tracking-wider font-semibold">Yıllar:</span>
        <button
          type="button"
          class="filter-tag-btn active-tag px-3 py-1 rounded-full text-xs font-mono border border-[#e5c158] bg-[#e5c158] text-[#190102] font-semibold cursor-pointer transition-all"
          data-type="year"
          data-val="all"
        >
          Tümü ({totalAlbums})
        </button>
        {years.map((y) => (
          <button
            type="button"
            class="filter-tag-btn px-3 py-1 rounded-full text-xs font-mono border border-[#c5cbd3]/20 bg-[#190102] text-[#c5cbd3] hover:text-[#e5c158] hover:border-[#e5c158]/40 cursor-pointer transition-all"
            data-type="year"
            data-val={y}
          >
            {y}
          </button>
        ))}
      </div>

      <!-- Camera Filter Row -->
      <div class="flex flex-wrap items-center gap-2 pt-2 border-t border-[#e5c158]/20">
        <span class="text-[#e5c158] w-20 flex-shrink-0 text-[11px] uppercase tracking-wider font-semibold">Gövdeler:</span>
        <button
          type="button"
          class="filter-tag-btn active-tag px-3 py-1 rounded-full text-xs font-mono border border-[#e5c158] bg-[#e5c158] text-[#190102] font-semibold cursor-pointer transition-all"
          data-type="camera"
          data-val="all"
        >
          Tümü
        </button>
        {cameras.map((c) => (
          <button
            type="button"
            class="filter-tag-btn px-3 py-1 rounded-full text-xs font-mono border border-[#c5cbd3]/20 bg-[#190102] text-[#c5cbd3] hover:text-[#e5c158] hover:border-[#e5c158]/40 cursor-pointer transition-all"
            data-type="camera"
            data-val={c}
          >
            {c}
          </button>
        ))}
      </div>

      <!-- Lens Filter Row -->
      <div class="flex flex-wrap items-center gap-2 pt-2 border-t border-[#e5c158]/20">
        <span class="text-[#e5c158] w-20 flex-shrink-0 text-[11px] uppercase tracking-wider font-semibold">Lensler:</span>
        <button
          type="button"
          class="filter-tag-btn active-tag px-3 py-1 rounded-full text-xs font-mono border border-[#e5c158] bg-[#e5c158] text-[#190102] font-semibold cursor-pointer transition-all"
          data-type="lens"
          data-val="all"
        >
          Tümü
        </button>
        {lenses.map((l) => {
          const label = l.replace(' R LM WR', '').replace(' R WR', '').replace('GF', 'GF ').replace('mmF', 'mm f/');
          return (
            <button
              type="button"
              class="filter-tag-btn px-3 py-1 rounded-full text-xs font-mono border border-[#c5cbd3]/20 bg-[#190102] text-[#c5cbd3] hover:text-[#e5c158] hover:border-[#e5c158]/40 cursor-pointer transition-all"
              data-type="lens"
              data-val={l}
            >
              {label}
            </button>
          );
        })}
      </div>
    </div>

    <!-- VIEW 1: ALBUMS / LOCATIONS GRID (2-Column Fine Art Presentation) -->
    <div id="album-view" class="space-y-12">
      <div id="albums-container" class="grid grid-cols-1 md:grid-cols-2 gap-8 sm:gap-12">
        {albums.map((album, idx) => {
          const albumCameras = Array.from(new Set(album.photos.map((p) => p.exif.camera))).join(', ');
          const albumLenses = Array.from(new Set(album.photos.map((p) => p.exif.lens.trim()))).join(', ');
          return (
            <article
              class="album-card pcb-card group rounded-[26px] sm:rounded-[32px] overflow-hidden transition-all duration-300 cursor-pointer flex flex-col justify-between shadow-xl select-none relative"
              data-slug={album.slug || album.id}
              data-year={album.year}
              data-camera={albumCameras}
              data-lens={albumLenses}
            >
              <div class="pcb-via pcb-via-tl"></div>
              <div class="pcb-via pcb-via-tr"></div>
              <!-- Media Preview Area (Large & Cinematic Aspect) -->
              <div class="relative aspect-[16/10] w-full overflow-hidden bg-[#190102]">
                <img
                  src={album.coverPhoto || album.coverThumb || album.cover || album.photos[0]?.thumb || album.photos[0]?.src}
                  alt={`${album.title} - ${album.locationFull} fotoğraf serisi - Ozan Özdil`}
                  loading={idx < 2 ? "eager" : "lazy"}
                  decoding="async"
                  width="1200"
                  height="750"
                  draggable="false"
                  class="w-full h-full object-cover group-hover:scale-103 transition-transform duration-700 ease-out opacity-95 group-hover:opacity-100 pointer-events-none"
                />
                <div class="absolute inset-0 bg-gradient-to-t from-black/70 via-transparent to-transparent opacity-60 group-hover:opacity-40 transition-opacity pointer-events-none"></div>

                <!-- Anti-Copy Transparent Shield -->
                <div class="absolute inset-0 z-10" oncontextmenu="return false;"></div>

                <!-- Top Badges: Clean Glass Pills -->
                <div class="absolute top-3.5 left-3.5 right-3.5 flex items-center justify-between z-20 pointer-events-none font-mono text-xs">
                  <span class="px-3 py-1 rounded-full bg-black/75 backdrop-blur-md text-[#ffffff] border border-white/20 flex items-center gap-1.5">
                    <span>{album.location}</span>
                  </span>

                  <span class="px-3 py-1 rounded-full bg-black/75 backdrop-blur-md text-[#ffffff] border border-white/20 font-medium">
                    {album.year}
                  </span>
                </div>

                <!-- Bottom Badges -->
                <div class="absolute bottom-3.5 left-3.5 right-3.5 flex items-center justify-between text-xs font-mono text-[#ffffff] z-20 pointer-events-none">
                  <span class="bg-black/75 px-3 py-1 rounded-full backdrop-blur-md border border-white/20">
                    {album.photoCount} Kare
                  </span>
                  <span class="px-3 py-1 rounded-full bg-black/80 backdrop-blur-md text-[#e5c158] border border-[#e5c158]/40 font-medium">
                    Fujifilm GFX
                  </span>
                </div>
              </div>

              <!-- Card Details -->
              <div class="p-6 sm:p-7 flex-1 flex flex-col justify-between gap-4">
                <div class="space-y-3">
                  <div class="flex items-baseline justify-between gap-2">
                    <span class="text-xs font-mono text-[#c5cbd3]">
                      {album.dateFormatted}
                    </span>
                    <span class="text-[11px] font-mono text-[#e5c158]">
                      16-Bit RAW
                    </span>
                  </div>

                  <h2 class="font-serif text-2xl sm:text-3xl font-normal text-[#ffffff] group-hover:text-[#e5c158] transition-colors leading-[1.25]">
                    {album.title}
                  </h2>

                  <p class="font-serif text-sm sm:text-base text-[#c5cbd3] line-clamp-3 leading-relaxed">
                    {album.description.split('\n\n')[0]}
                  </p>
                </div>

                <!-- Bottom Equipment & CTA Row -->
                <div class="pt-4 border-t border-[#e5c158]/20 flex items-center justify-between text-xs font-mono">
                  <span class="text-[#c5cbd3] truncate max-w-[200px]" title={album.equipment}>
                    {album.equipment}
                  </span>
                  <span class="text-[#e5c158] group-hover:text-[#f3e5ab] font-medium flex items-center gap-1.5 whitespace-nowrap transition-transform group-hover:translate-x-1">
                    <span>Albümü İncele</span>
                    <span>→</span>
                  </span>
                </div>
              </div>
            </article>
          );
        })}
      </div>
    </div>

    <!-- VIEW 2: ALBUM PHOTOS (Opened Collection View) -->
    <div id="photo-view" class="hidden space-y-8">
      <!-- Back & Navigation Ribbon -->
      <div class="p-6 sm:p-10 rounded-[28px] border border-[#e5c158]/25 bg-[#280205] space-y-6 shadow-xl">
        <div class="flex flex-wrap items-center justify-between gap-4 font-mono text-xs">
          <button
            id="btn-back-albums"
            type="button"
            class="inline-flex items-center gap-2 px-4 py-2 rounded-full border border-[#e5c158]/30 bg-[#190102] text-[#ffffff] hover:text-[#e5c158] hover:border-[#e5c158] transition-colors cursor-pointer"
          >
            <span>← Tüm Koleksiyonlara Dön</span>
          </button>

          <div class="flex flex-wrap items-center gap-2">
            <span id="album-location-badge" class="px-3 py-1 rounded-full bg-[#190102] border border-[#e5c158]/25 text-[#c5cbd3]"></span>
            <span id="album-photo-count-badge" class="px-3 py-1 rounded-full bg-[#190102] border border-[#e5c158]/25 text-[#e5c158] font-medium"></span>
          </div>
        </div>

        <div class="space-y-3 pt-4 border-t border-[#e5c158]/20">
          <div id="album-equipment-badge" class="font-mono text-xs text-[#e5c158]"></div>
          <h2 id="album-active-title" class="text-3xl sm:text-5xl font-serif font-normal text-[#ffffff] leading-tight"></h2>
          <div id="album-essay-container" class="mt-4 text-base sm:text-lg text-[#f8fafc] leading-relaxed w-full space-y-4 font-serif"></div>
        </div>
      </div>

      <!-- Photos Grid (Ascending by dateTaken) -->
      <div id="photos-grid" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
        <!-- Injected dynamically from JSON -->
      </div>
    </div>
  </div>

  <!-- LIGHTBOX / FOTOĞRAF VE EXIF MODAL -->
  <dialog
    id="photoModal"
    class="backdrop:bg-black/95 backdrop:backdrop-blur-xl bg-[#190102] text-[#f8fafc] border border-[#e5c158]/35 rounded-[28px] max-w-6xl w-[95vw] sm:w-full p-0 shadow-2xl overflow-y-auto max-h-[92vh] m-auto select-none"
  >
    <!-- Modal Top Window Titlebar -->
    <div class="sticky top-0 z-40 flex items-center justify-between px-4 sm:px-6 py-3.5 bg-[#280205] border-b border-[#e5c158]/20 text-xs font-mono">
      <div class="flex items-center gap-3">
        <span id="modalPhotoIndex" class="px-2.5 py-0.5 rounded-full bg-[#190102] text-[#e5c158] border border-[#e5c158]/30 text-[11px] font-medium">01 / 09</span>
        <span id="photoModalTitle" class="truncate text-[#ffffff] max-w-md font-serif text-sm hidden sm:inline"></span>
      </div>

      <div class="flex items-center gap-3">
        <span class="hidden md:inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-[#190102] border border-[#c5cbd3]/20 text-[#c5cbd3] text-[11px]">
          <span>© Ozan Özdil • Telif Hakları Saklıdır</span>
        </span>
        <button
          id="btnCloseModal"
          type="button"
          class="text-[#c5cbd3] hover:text-[#e5c158] px-3 py-1 rounded-full bg-[#190102] hover:bg-[#380407] border border-[#c5cbd3]/20 transition-colors cursor-pointer text-xs font-mono"
        >
          [ESC] Kapat
        </button>
      </div>
    </div>

    <!-- Modal Viewport with Image & Transparent Protection Shield -->
    <div class="relative bg-black flex items-center justify-center min-h-[220px] sm:min-h-[360px] max-h-[55vh] sm:max-h-[70vh] overflow-hidden select-none group">
      <img
        id="photoModalImg"
        src=""
        alt="Fotoğraf"
        draggable="false"
        class="max-w-full max-h-[55vh] sm:max-h-[70vh] object-contain transition-opacity duration-200 pointer-events-none"
      />

      <!-- Invisible Click / Protection Overlay -->
      <div class="absolute inset-0 z-10" oncontextmenu="return false;"></div>

      <!-- Watermark Badge overlay -->
      <div class="absolute bottom-3 right-3 sm:bottom-4 sm:right-4 z-20 pointer-events-none flex items-center gap-2">
        <span class="px-3 py-1 rounded-full text-[10px] font-mono bg-black/80 backdrop-blur-md text-white/90 border border-white/15 shadow-xl flex items-center gap-1.5">
          <span class="text-[#e5c158]">●</span>
          <span>FUJIFILM GFX 16-BIT MEDIUM FORMAT</span>
        </span>
      </div>

      <!-- Navigation Arrows -->
      <button
        id="btnPrevPhoto"
        type="button"
        class="absolute left-2 sm:left-4 top-1/2 -translate-y-1/2 z-30 bg-black/60 hover:bg-black/80 text-white p-3 sm:p-4 rounded-full border border-white/20 transition-all opacity-80 hover:opacity-100 cursor-pointer shadow-xl text-lg leading-none"
        title="Önceki (Sol Ok)"
      >
        ‹
      </button>
      <button
        id="btnNextPhoto"
        type="button"
        class="absolute right-2 sm:right-4 top-1/2 -translate-y-1/2 z-30 bg-black/60 hover:bg-black/80 text-white p-3 sm:p-4 rounded-full border border-white/20 transition-all opacity-80 hover:opacity-100 cursor-pointer shadow-xl text-lg leading-none"
        title="Sonraki Sağ Ok"
      >
        ›
      </button>
    </div>

    <!-- Contextual Caption & EXIF Details -->
    <div class="p-5 sm:p-6 bg-[#190102] border-t border-[#e5c158]/20 space-y-4 font-mono text-xs">
      <div id="photoModalCaption" class="text-sm text-[#f8fafc] leading-relaxed bg-[#280205] p-4 rounded-2xl border border-[#e5c158]/20 font-serif"></div>

      <div class="pt-2 border-t border-[#e5c158]/20">
        <div class="flex items-center justify-between text-[11px] font-mono uppercase tracking-wider text-[#c5cbd3] mb-3 font-semibold">
          <span>Kamera & EXIF Bilgileri (Fujifilm GFX)</span>
          <span class="text-[#e5c158]">© OZAN ÖZDİL</span>
        </div>

        <div id="photoModalExifGrid" class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-6 gap-2.5 text-xs font-mono"></div>
      </div>
    </div>
  </dialog>

  <!-- Copyright Toast Alert -->
  <div
    id="copyrightToast"
    class="fixed bottom-6 right-6 z-50 transform translate-y-20 opacity-0 transition-all duration-300 pointer-events-none"
  >
    <div class="px-4 py-3 rounded-2xl bg-[#280205] text-[#ffffff] border border-[#e5c158]/40 shadow-2xl font-mono text-xs flex items-center gap-2.5">
      <svg class="w-4 h-4 text-[#e5c158] flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
      </svg>
      <span>Fotoğraflar telif hakları ile korunmaktadır. İzinsiz kopyalanamaz.</span>
    </div>
  </div>
</BaseLayout>

<script is:inline define:vars={{ albums }}>
  let currentAlbum = null;
  let activeIndex = 0;

  const currentFilter = {
    year: 'all',
    camera: 'all',
    lens: 'all'
  };

  const albumView = document.getElementById('album-view');
  const photoView = document.getElementById('photo-view');
  const photosGrid = document.getElementById('photos-grid');
  const activeTitle = document.getElementById('album-active-title');
  const activeLocationBadge = document.getElementById('album-location-badge');
  const activeCountBadge = document.getElementById('album-photo-count-badge');
  const activeEquipmentBadge = document.getElementById('album-equipment-badge');
  const essayContainer = document.getElementById('album-essay-container');

  const modal = document.getElementById('photoModal');
  const modalImg = document.getElementById('photoModalImg');
  const modalTitle = document.getElementById('photoModalTitle');
  const modalIndex = document.getElementById('modalPhotoIndex');
  const modalCaption = document.getElementById('photoModalCaption');
  const modalExifGrid = document.getElementById('photoModalExifGrid');
  const copyrightToast = document.getElementById('copyrightToast');

  const inactiveBtnClass = 'filter-tag-btn px-3 py-1 rounded-full text-xs font-mono border border-[#c5cbd3]/20 bg-[#190102] text-[#c5cbd3] hover:text-[#e5c158] hover:border-[#e5c158]/40 cursor-pointer transition-all';
  const activeBtnClass = 'filter-tag-btn active-tag px-3 py-1 rounded-full text-xs font-mono border border-[#e5c158] bg-[#e5c158] text-[#190102] font-semibold cursor-pointer transition-all';

  // Filter Tag Click Handlers
  document.querySelectorAll('.filter-tag-btn').forEach((btn) => {
    btn.addEventListener('click', () => {
      const type = btn.getAttribute('data-type');
      const val = btn.getAttribute('data-val');

      document.querySelectorAll(`.filter-tag-btn[data-type="${type}"]`).forEach((b) => {
        b.className = inactiveBtnClass;
      });

      btn.className = activeBtnClass;

      currentFilter[type] = val;
      applyFilters();
    });
  });

  function applyFilters() {
    document.querySelectorAll('.album-card').forEach((card) => {
      const cYear = card.getAttribute('data-year');
      const cCamera = card.getAttribute('data-camera') || '';
      const cLens = card.getAttribute('data-lens') || '';

      const matchYear = currentFilter.year === 'all' || cYear === currentFilter.year;
      const matchCamera = currentFilter.camera === 'all' || cCamera.includes(currentFilter.camera);
      const matchLens = currentFilter.lens === 'all' || cLens.includes(currentFilter.lens);

      if (matchYear && matchCamera && matchLens) {
        card.classList.remove('hidden');
      } else {
        card.classList.add('hidden');
      }
    });
  }

  // Album Card Click Handlers
  document.querySelectorAll('.album-card').forEach((card) => {
    card.addEventListener('click', () => {
      const slug = card.getAttribute('data-slug');
      openAlbum(slug);
    });
  });

  // Back to Albums View
  document.getElementById('btn-back-albums')?.addEventListener('click', () => {
    showAlbumsView();
    history.pushState(null, '', '/galeri');
  });

  function showAlbumsView() {
    photoView.classList.add('hidden');
    albumView.classList.remove('hidden');
    window.scrollTo({ top: 0, behavior: 'smooth' });
  }

  function openAlbum(slug) {
    const found = albums.find((a) => a.slug === slug || a.id === slug);
    if (!found) return;

    currentAlbum = found;
    history.replaceState(null, '', `/galeri#${slug}`);

    activeTitle.textContent = currentAlbum.title;
    activeLocationBadge.textContent = currentAlbum.locationFull;
    activeCountBadge.textContent = `${currentAlbum.photoCount} Kare`;
    activeEquipmentBadge.textContent = currentAlbum.equipment;

    // Format essay description
    const paragraphs = currentAlbum.description.split('\n\n').filter(Boolean);
    essayContainer.innerHTML = paragraphs.map((p) => `<p>${escapeHtml(p)}</p>`).join('');

    // Render Photos Grid
    let gridHtml = '';
    currentAlbum.photos.forEach((photo, idx) => {
      const e = photo.exif;
      gridHtml += `
        <figure
          class="photo-card group rounded-[22px] border border-[#e5c158]/25 bg-[#280205] overflow-hidden hover:border-[#e5c158]/60 transition-all duration-300 cursor-pointer flex flex-col justify-between shadow-xl select-none"
          onclick="window.openLightbox(${idx})"
        >
          <div class="relative aspect-[16/10] w-full overflow-hidden bg-[#190102]">
            <img
              src="${photo.thumb}"
              alt="${escapeHtml(photo.title)} - ${escapeHtml(currentAlbum.locationFull)} - Ozan Özdil"
              loading="lazy"
              decoding="async"
              width="800"
              height="500"
              draggable="false"
              class="w-full h-full object-cover group-hover:scale-103 transition-transform duration-700 ease-out opacity-95 group-hover:opacity-100 pointer-events-none"
            />
            <div class="absolute inset-0 bg-gradient-to-t from-black/70 via-transparent to-transparent opacity-60 group-hover:opacity-40 transition-opacity pointer-events-none"></div>
            <div class="absolute inset-0 z-10" oncontextmenu="return false;"></div>

            <div class="absolute top-3 left-3 z-20 pointer-events-none">
              <span class="px-2.5 py-0.5 rounded-full bg-black/75 backdrop-blur-md text-[#e5c158] text-[10px] font-mono border border-white/15">
                #${String(idx + 1).padStart(2, '0')}
              </span>
            </div>

            <div class="absolute bottom-3 left-3 right-3 z-20 pointer-events-none flex items-center justify-between text-[10px] font-mono text-white/90">
              <span class="px-2.5 py-0.5 rounded-full bg-black/75 backdrop-blur-md border border-white/15">
                ${escapeHtml(e.fNumber)} • ${escapeHtml(e.exposureTime)} • ISO ${escapeHtml(e.iso)}
              </span>
            </div>
          </div>

          <figcaption class="p-4 bg-[#280205] border-t border-[#e5c158]/20 space-y-2">
            <p class="text-sm font-serif font-normal text-[#ffffff] line-clamp-1">
              ${escapeHtml(photo.caption.split('.')[0])}
            </p>
            <div class="flex items-center justify-between text-[11px] font-mono text-[#c5cbd3] pt-1 border-t border-[#e5c158]/20">
              <span>${escapeHtml(photo.dateTaken ? photo.dateTaken.split(' ')[0] : '')}</span>
              <span class="text-[#e5c158] group-hover:text-[#f3e5ab] font-medium flex items-center gap-1">
                <span>Büyüt</span>
                <span>↗</span>
              </span>
            </div>
          </figcaption>
        </figure>
      `;
    });

    photosGrid.innerHTML = gridHtml;

    albumView.classList.add('hidden');
    photoView.classList.remove('hidden');
    window.scrollTo({ top: 0, behavior: 'smooth' });
  }

  // Lightbox functions
  window.openLightbox = function(index) {
    if (!currentAlbum || !currentAlbum.photos[index]) return;
    activeIndex = index;
    const photo = currentAlbum.photos[index];
    const e = photo.exif;

    modalImg.src = photo.src;
    modalTitle.textContent = photo.title || currentAlbum.title;
    modalIndex.textContent = `${String(index + 1).padStart(2, '0')} / ${String(currentAlbum.photos.length).padStart(2, '0')}`;

    modalCaption.innerHTML = `
      <div class="font-mono text-xs text-[#e59a7a] mb-1">// FOTOĞRAF NOTU</div>
      <p class="text-[#fef9ed] leading-relaxed font-serif text-base">${escapeHtml(photo.caption)}</p>
    `;

    modalExifGrid.innerHTML = `
      <div class="bg-[#1c1815] p-3 rounded-xl border border-[#2d2521]">
        <span class="text-[10px] text-[#8C7E74] block font-mono">Gövde</span>
        <span class="text-[#fef9ed] font-medium truncate block">${escapeHtml(e.camera)}</span>
      </div>
      <div class="bg-[#1c1815] p-3 rounded-xl border border-[#2d2521]">
        <span class="text-[10px] text-[#8C7E74] block font-mono">Lens</span>
        <span class="text-[#fef9ed] truncate block">${escapeHtml(e.lens !== '-' ? e.lens : 'Fujinon GF')}</span>
      </div>
      <div class="bg-[#1c1815] p-3 rounded-xl border border-[#2d2521]">
        <span class="text-[10px] text-[#8C7E74] block font-mono">Odak Uzaklığı</span>
        <span class="text-[#fef9ed] block">${escapeHtml(e.focalLength)} <span class="text-[#8C7E74] text-[10px]">(${escapeHtml(e.focalLength35mm || '-')})</span></span>
      </div>
      <div class="bg-[#1c1815] p-3 rounded-xl border border-[#2d2521]">
        <span class="text-[10px] text-[#8C7E74] block font-mono">Diyafram / Perde</span>
        <span class="text-[#e59a7a] font-medium block">${escapeHtml(e.fNumber)} • ${escapeHtml(e.exposureTime)}</span>
      </div>
      <div class="bg-[#1c1815] p-3 rounded-xl border border-[#2d2521]">
        <span class="text-[10px] text-[#8C7E74] block font-mono">Hassasiyet (ISO)</span>
        <span class="text-[#fef9ed] font-medium block">ISO ${escapeHtml(e.iso)}</span>
      </div>
      <div class="bg-[#1c1815] p-3 rounded-xl border border-[#2d2521]">
        <span class="text-[10px] text-[#8C7E74] block font-mono">Format</span>
        <span class="text-[#8C7E74] block">43.8×32.9mm</span>
      </div>
    `;

    if (typeof modal.showModal === 'function') {
      modal.showModal();
    } else {
      modal.setAttribute('open', '');
    }
  };

  function closeModal() {
    if (typeof modal.close === 'function') {
      modal.close();
    } else {
      modal.removeAttribute('open');
    }
    modalImg.src = '';
  }

  document.getElementById('btnCloseModal')?.addEventListener('click', closeModal);

  function stepPhoto(delta) {
    if (!currentAlbum) return;
    let next = activeIndex + delta;
    if (next < 0) next = currentAlbum.photos.length - 1;
    if (next >= currentAlbum.photos.length) next = 0;
    window.openLightbox(next);
  }

  document.getElementById('btnPrevPhoto')?.addEventListener('click', () => stepPhoto(-1));
  document.getElementById('btnNextPhoto')?.addEventListener('click', () => stepPhoto(1));

  window.addEventListener('keydown', (e) => {
    if (modal && modal.open) {
      if (e.key === 'ArrowLeft') stepPhoto(-1);
      if (e.key === 'ArrowRight') stepPhoto(1);
      if (e.key === 'Escape') closeModal();
    }
  });

  modal?.addEventListener('click', (e) => {
    const r = modal.getBoundingClientRect();
    const inside = (r.top <= e.clientY && e.clientY <= r.top + r.height && r.left <= e.clientX && e.clientX <= r.left + r.width);
    if (!inside) closeModal();
  });

  let toastTimer = null;
  function triggerCopyrightNotice(e) {
    e.preventDefault();
    if (!copyrightToast) return;
    copyrightToast.classList.remove('translate-y-20', 'opacity-0');
    copyrightToast.classList.add('translate-y-0', 'opacity-100');
    clearTimeout(toastTimer);
    toastTimer = setTimeout(() => {
      copyrightToast.classList.remove('translate-y-0', 'opacity-100');
      copyrightToast.classList.add('translate-y-20', 'opacity-0');
    }, 2800);
  }

  document.addEventListener('contextmenu', (e) => {
    if (e.target.closest('.album-card') || e.target.closest('.photo-card') || e.target.closest('#photoModal')) {
      triggerCopyrightNotice(e);
    }
  });

  function escapeHtml(str) {
    if (!str) return '';
    return String(str)
      .replace(/&/g, '&amp;')
      .replace(/</g, '&lt;')
      .replace(/>/g, '&gt;')
      .replace(/"/g, '&quot;')
      .replace(/'/g, '&#039;');
  }

  // Handle URL hash on load
  if (window.location.hash) {
    const slug = window.location.hash.replace('#', '');
    openAlbum(slug);
  }
</script>
