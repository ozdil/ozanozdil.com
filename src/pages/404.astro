---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="404 — Sayfa Bulunamadı | Ozan Özdil"
  description="Aradığınız sayfa bulunamadı veya taşınmış olabilir."
  currentPath="/404"
  maxWidthClass="max-w-3xl"
>
  <div class="py-16 text-center space-y-4">
    <div class="inline-flex items-center justify-center w-16 h-16 rounded-2xl bg-[#18181b] border border-[#27272a] mb-2 shadow-xl">
      <span class="font-mono text-2xl font-bold text-[#ffffff]">404</span>
    </div>

    <h1 class="text-2xl sm:text-3xl font-serif font-normal text-[#ffffff] tracking-tight">
      Sayfa Bulunamadı
    </h1>

    <p class="text-sm sm:text-base text-[#a1a1aa] max-w-md mx-auto font-serif leading-relaxed">
      Aradığınız içerik silinmiş, adı değiştirilmiş veya geçici olarak kullanım dışı kalmış olabilir.
    </p>

    <div class="flex flex-wrap items-center justify-center gap-3 font-mono text-xs pt-4">
      <a
        href="/"
        class="px-5 py-2.5 rounded-full bg-[#ffffff] text-[#09090b] font-semibold hover:bg-[#e4e4e7] transition-all shadow-md"
      >
        ← Ana Sayfaya Dön
      </a>
      <a
        href="/blog"
        class="px-5 py-2.5 rounded-full bg-[#18181b] text-[#ffffff] hover:text-[#ffffff] border border-[#27272a] hover:border-[#3f3f46] transition-all"
      >
        Yazılar & Notlar →
      </a>
    </div>
  </div>
</BaseLayout>
