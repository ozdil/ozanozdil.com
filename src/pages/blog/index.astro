---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const posts = await getCollection('blog', ({ data }) => !data.draft);
const sortedPosts = posts.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

const allTags = [...new Set(posts.flatMap((post) => post.data.tags || []).filter(Boolean))].sort((a, b) => a.localeCompare(b, 'tr'));
---

<BaseLayout
  title="Yazılar — Ozan Özdil"
  description="Teknoloji, açık kaynak, siber güvenlik, dijital egemenlik, yapay zekâ ve sistem mimarisi üzerine araştırmalar ve notlar."
  currentPath="/blog"
  maxWidthClass="max-w-[1720px]"
>
  <div class="py-2 sm:py-4 space-y-6">
    <!-- Header -->
    <header class="rounded-xl border border-zinc-200 dark:border-zinc-800 bg-white dark:bg-[#0c0e12] p-5 sm:p-7 text-center">
      <div class="inline-flex items-center gap-2 font-mono text-xs text-zinc-900 dark:text-[#00ffcc] uppercase tracking-wider mb-2">
        <span class="w-2 h-2 rounded-full bg-zinc-900 dark:bg-[#00ffcc]"></span>
        <span>// blog & arşiv</span>
      </div>
      <h1 class="text-2xl sm:text-3xl lg:text-4xl font-bold tracking-tight text-zinc-950 dark:text-zinc-50 font-sans">
        Yazılar & Notlar
      </h1>
      <p class="mt-2 text-sm sm:text-base text-zinc-600 dark:text-zinc-400 max-w-2xl mx-auto">
        Teknoloji, açık kaynak, siber güvenlik, dijital egemenlik, yapay zekâ, Linux ve sistem mimarisi üzerine araştırmalar ve notlar.
      </p>

      <!-- Topic Tags Filter Deck: Minimal Shell Pills -->
      {allTags.length > 0 && (
        <div id="qs-tag-filters" class="flex flex-wrap items-center justify-center gap-1.5 sm:gap-2 mt-6 font-mono text-xs w-full">
          <button
            type="button"
            data-filter-tag="all"
            class="qs-filter-pill px-3 py-1.5 rounded-lg text-xs transition-all cursor-pointer border bg-zinc-900 text-white border-zinc-900 dark:bg-[#00ffcc] dark:text-zinc-950 dark:border-[#00ffcc] font-semibold"
          >
            Tümü ({sortedPosts.length})
          </button>
          {allTags.map((tag) => (
            <button
              type="button"
              data-filter-tag={tag.toLowerCase()}
              class="qs-filter-pill px-2.5 py-1.5 rounded-lg text-xs transition-all cursor-pointer border bg-zinc-100 dark:bg-[#12151d] text-zinc-600 dark:text-zinc-400 border-zinc-200 dark:border-zinc-800 hover:text-zinc-950 dark:hover:text-[#00ffcc] hover:border-zinc-300 dark:hover:border-zinc-700"
            >
              #{tag}
            </button>
          ))}
        </div>
      )}
    </header>

    <!-- Filter & Status Bar -->
    <div class="px-4 py-3 rounded-xl bg-white dark:bg-[#0c0e12] border border-zinc-200 dark:border-zinc-800 flex flex-wrap items-center justify-between gap-3 text-xs font-mono text-zinc-500 dark:text-zinc-400">
      <div class="flex items-center gap-3">
        <span id="qs-stats-counter" class="text-zinc-800 dark:text-zinc-200 font-medium">Toplam {sortedPosts.length} yazı</span>
      </div>

      <div class="flex items-center gap-2">
        <span id="qs-page-info" class="text-zinc-600 dark:text-zinc-300 font-medium">Sayfa 1 / 1</span>
        <div class="flex items-center gap-1 ml-1">
          <button
            id="qs-prev-btn"
            type="button"
            class="px-2.5 py-1 rounded bg-zinc-100 dark:bg-zinc-800 hover:bg-zinc-200 dark:hover:bg-zinc-700 text-zinc-700 dark:text-zinc-300 disabled:opacity-40 disabled:cursor-not-allowed transition-colors cursor-pointer border border-zinc-200 dark:border-zinc-700"
            title="Önceki Sayfa"
          >
            ← Önceki
          </button>
          <button
            id="qs-next-btn"
            type="button"
            class="px-2.5 py-1 rounded bg-zinc-100 dark:bg-zinc-800 hover:bg-zinc-200 dark:hover:bg-zinc-700 text-zinc-700 dark:text-zinc-300 disabled:opacity-40 disabled:cursor-not-allowed transition-colors cursor-pointer border border-zinc-200 dark:border-zinc-700"
            title="Sonraki Sayfa"
          >
            Sonraki →
          </button>
        </div>
      </div>
    </div>

    <!-- Empty State for Tag Filter -->
    <div id="qs-empty-state" class="hidden py-16 text-center font-mono text-sm text-zinc-500 dark:text-zinc-400 border border-dashed border-zinc-300 dark:border-zinc-800 rounded-xl">
      <p>Seçili filtreye ait yazı bulunamadı.</p>
      <button
        id="qs-reset-filter"
        type="button"
        class="mt-3 inline-flex items-center gap-1.5 px-3 py-1.5 rounded bg-zinc-100 dark:bg-zinc-800 text-zinc-900 dark:text-[#00ffcc] hover:underline cursor-pointer font-medium text-xs border border-zinc-300 dark:border-zinc-700"
      >
        [Tüm yazıları göster]
      </button>
    </div>

    <!-- Articles Board Grid: Clean 1px stroke border cards (Omarchy minimalism) -->
    <div
      id="qs-posts-grid"
      class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 2xl:grid-cols-5 gap-4"
    >
      {sortedPosts.map((post) => (
        <article
          class="qs-post-item group rounded-xl border border-zinc-200 dark:border-zinc-800 hover:border-zinc-400 dark:hover:border-[#00ffcc]/60 bg-white dark:bg-[#0c0e12] p-4 sm:p-5 transition-all duration-200 flex flex-col justify-between h-full"
          data-tags={JSON.stringify((post.data.tags || []).map((t) => t.toLowerCase()))}
        >
          <div class="space-y-2.5">
            <!-- Top Tag & Date Line -->
            <div class="flex items-center justify-between text-[11px] font-mono text-zinc-400 dark:text-zinc-500 pb-2 border-b border-zinc-100 dark:border-zinc-800/60">
              <span class="text-zinc-900 dark:text-[#00ffcc] font-medium">
                #{(post.data.tags && post.data.tags[0]) || 'notlar'}
              </span>
              <time datetime={post.data.pubDate.toISOString()}>
                {post.data.pubDate.toLocaleDateString('tr-TR', { day: 'numeric', month: 'short', year: 'numeric' })}
              </time>
            </div>

            <!-- Title -->
            <h2 class="text-sm sm:text-[15px] font-bold text-zinc-950 dark:text-zinc-100 font-sans group-hover:text-zinc-950 dark:group-hover:text-[#00ffcc] transition-colors leading-snug line-clamp-2 min-h-[2.5rem]">
              <a href={`/blog/${post.slug}`} class="focus:outline-none">
                {post.data.title}
              </a>
            </h2>

            <!-- Preview Description -->
            {post.data.description && (
              <p class="text-xs leading-relaxed text-zinc-600 dark:text-zinc-400 font-sans line-clamp-3">
                {post.data.description}
              </p>
            )}
          </div>

          <!-- Bottom Action & Secondary Tags -->
          <div class="pt-3 mt-3 border-t border-zinc-100 dark:border-zinc-800/60 flex items-center justify-between text-xs font-mono">
            <div class="flex items-center gap-1">
              {post.data.tags && post.data.tags.slice(1, 3).map((tag) => (
                <button
                  type="button"
                  data-tag-button={tag.toLowerCase()}
                  class="px-1.5 py-0.5 rounded bg-zinc-100 dark:bg-zinc-800/80 text-zinc-500 dark:text-zinc-400 hover:text-zinc-900 dark:hover:text-[#00ffcc] text-[10px] cursor-pointer"
                  title={`#${tag}`}
                >
                  #{tag}
                </button>
              ))}
            </div>

            <a
              href={`/blog/${post.slug}`}
              class="inline-flex items-center gap-1 text-zinc-700 dark:text-[#00ffcc] font-medium group-hover:translate-x-0.5 transition-transform"
            >
              <span>Oku</span>
              <span>→</span>
            </a>
          </div>
        </article>
      ))}
    </div>

    <!-- Bottom Pagination Bar -->
    <div id="qs-pagination-container" class="pt-6 border-t border-zinc-200 dark:border-zinc-800 flex flex-wrap items-center justify-between gap-4 font-mono text-xs">
      <div class="text-zinc-500 dark:text-zinc-400">
        <span id="qs-page-summary">Sayfa 1 / 1 (36 yazı)</span>
      </div>

      <div id="qs-page-numbers" class="flex items-center gap-1.5">
        <!-- Dynamic page number buttons generated in JS -->
      </div>
    </div>
  </div>
</BaseLayout>

<script is:inline>
  function setupPanoBoard() {
    const PAGE_SIZE = 15;
    let currentPage = 1;
    let matchingItems = [];

    const filterPills = document.querySelectorAll('[data-filter-tag]');
    const postItems = Array.from(document.querySelectorAll('.qs-post-item'));
    const emptyState = document.getElementById('qs-empty-state');
    const resetBtn = document.getElementById('qs-reset-filter');
    const cardTagBtns = document.querySelectorAll('[data-tag-button]');

    const statsCounter = document.getElementById('qs-stats-counter');
    const pageInfo = document.getElementById('qs-page-info');
    const prevBtn = document.getElementById('qs-prev-btn');
    const nextBtn = document.getElementById('qs-next-btn');
    const pageSummary = document.getElementById('qs-page-summary');
    const pageNumbersContainer = document.getElementById('qs-page-numbers');
    const paginationContainer = document.getElementById('qs-pagination-container');

    function getSelectedTag() {
      const activePill = document.querySelector('.qs-filter-pill.border-zinc-900, .qs-filter-pill.dark\\:bg-\\[\\#00ffcc\\]');
      return activePill ? (activePill.getAttribute('data-filter-tag') || 'all') : 'all';
    }

    function filterPosts(tag) {
      tag = (tag || 'all').toLowerCase();
      matchingItems = [];

      postItems.forEach((card) => {
        let cardTags = [];
        try {
          cardTags = JSON.parse(card.getAttribute('data-tags') || '[]');
        } catch (e) {
          cardTags = [];
        }

        const match = tag === 'all' || cardTags.includes(tag);
        if (match) {
          matchingItems.push(card);
        } else {
          card.classList.add('hidden');
        }
      });

      const totalMatches = matchingItems.length;
      if (statsCounter) {
        statsCounter.textContent = `Toplam: ${totalMatches} yazı`;
      }

      if (totalMatches === 0) {
        if (emptyState) emptyState.classList.remove('hidden');
        if (paginationContainer) paginationContainer.classList.add('hidden');
      } else {
        if (emptyState) emptyState.classList.add('hidden');
        if (paginationContainer) paginationContainer.classList.remove('hidden');
      }

      currentPage = 1;
      renderPage();
    }

    function renderPage() {
      const totalMatches = matchingItems.length;
      const totalPages = Math.max(1, Math.ceil(totalMatches / PAGE_SIZE));

      if (currentPage > totalPages) currentPage = totalPages;
      if (currentPage < 1) currentPage = 1;

      const startIndex = (currentPage - 1) * PAGE_SIZE;
      const endIndex = startIndex + PAGE_SIZE;

      matchingItems.forEach((card, index) => {
        if (index >= startIndex && index < endIndex) {
          card.classList.remove('hidden');
        } else {
          card.classList.add('hidden');
        }
      });

      if (pageInfo) pageInfo.textContent = `Sayfa ${currentPage} / ${totalPages}`;
      if (pageSummary) pageSummary.textContent = `Sayfa ${currentPage} / ${totalPages} (${totalMatches} yazı)`;

      if (prevBtn) prevBtn.disabled = currentPage <= 1;
      if (nextBtn) nextBtn.disabled = currentPage >= totalPages;

      renderPageButtons(totalPages);
    }

    function renderPageButtons(totalPages) {
      if (!pageNumbersContainer) return;
      pageNumbersContainer.innerHTML = '';

      if (totalPages <= 1) return;

      for (let i = 1; i <= totalPages; i++) {
        const btn = document.createElement('button');
        btn.type = 'button';
        btn.textContent = `${i}`;
        btn.className = i === currentPage
          ? 'px-2.5 py-1 rounded bg-zinc-900 dark:bg-[#00ffcc] text-white dark:text-zinc-950 font-bold border border-zinc-900 dark:border-[#00ffcc] cursor-pointer'
          : 'px-2.5 py-1 rounded bg-zinc-100 dark:bg-zinc-800 text-zinc-600 dark:text-zinc-400 hover:text-zinc-950 dark:hover:text-[#00ffcc] border border-zinc-200 dark:border-zinc-700 cursor-pointer';
        
        btn.addEventListener('click', () => {
          currentPage = i;
          renderPage();
          window.scrollTo({ top: 0, behavior: 'smooth' });
        });
        pageNumbersContainer.appendChild(btn);
      }
    }

    filterPills.forEach((pill) => {
      pill.addEventListener('click', () => {
        const tag = pill.getAttribute('data-filter-tag') || 'all';

        filterPills.forEach((p) => {
          p.className = 'qs-filter-pill px-2.5 py-1.5 rounded-lg text-xs transition-all cursor-pointer border bg-zinc-100 dark:bg-[#12151d] text-zinc-600 dark:text-zinc-400 border-zinc-200 dark:border-zinc-800 hover:text-zinc-950 dark:hover:text-[#00ffcc] hover:border-zinc-300 dark:hover:border-zinc-700';
        });

        pill.className = 'qs-filter-pill px-3 py-1.5 rounded-lg text-xs transition-all cursor-pointer border bg-zinc-900 text-white border-zinc-900 dark:bg-[#00ffcc] dark:text-zinc-950 dark:border-[#00ffcc] font-semibold';

        filterPosts(tag);
      });
    });

    cardTagBtns.forEach((btn) => {
      btn.addEventListener('click', (e) => {
        e.preventDefault();
        e.stopPropagation();
        const tag = btn.getAttribute('data-tag-button');
        if (!tag) return;

        const targetPill = document.querySelector(`[data-filter-tag="${tag}"]`);
        if (targetPill) {
          targetPill.click();
        } else {
          filterPosts(tag);
        }
        window.scrollTo({ top: 0, behavior: 'smooth' });
      });
    });

    if (resetBtn) {
      resetBtn.addEventListener('click', () => {
        const allPill = document.querySelector('[data-filter-tag="all"]');
        if (allPill) allPill.click();
      });
    }

    if (prevBtn) {
      prevBtn.addEventListener('click', () => {
        if (currentPage > 1) {
          currentPage--;
          renderPage();
          window.scrollTo({ top: 0, behavior: 'smooth' });
        }
      });
    }

    if (nextBtn) {
      nextBtn.addEventListener('click', () => {
        const totalPages = Math.ceil(matchingItems.length / PAGE_SIZE);
        if (currentPage < totalPages) {
          currentPage++;
          renderPage();
          window.scrollTo({ top: 0, behavior: 'smooth' });
        }
      });
    }

    // Initial run
    filterPosts('all');
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', setupPanoBoard);
  } else {
    setupPanoBoard();
  }
</script>
