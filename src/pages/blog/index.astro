---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const posts = await getCollection('blog', ({ data }) => !data.draft);
const sortedPosts = posts.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

const allTags = [...new Set(posts.flatMap((post) => post.data.tags))];
---

<BaseLayout
  title="Yazılar — Ozan Özdil"
  description="Linux, açık kaynak, teknoloji ve kişisel notlar."
  currentPath="/blog"
  maxWidthClass="max-w-3xl"
>
  <div class="py-2 sm:py-4">
    <!-- Header: Omarchy / QuickShell Style -->
    <header class="pb-8 text-center">
      <p class="font-mono text-xs font-medium tracking-[0.18em] text-sky-600 dark:text-[#00ffcc] uppercase sm:text-sm">
        Arşiv
      </p>
      <h1 class="mt-2 text-2xl sm:text-3xl font-semibold tracking-tight text-zinc-950 dark:text-zinc-50 font-sans">
        Yazılar & Notlar
      </h1>
      <p class="mt-2 text-sm text-zinc-600 dark:text-zinc-400 max-w-lg mx-auto">
        Linux, açık kaynak, teknoloji ve kişisel notlar.
      </p>

      <!-- Topic Tags Bar -->
      {allTags.length > 0 && (
        <div class="flex flex-wrap items-center justify-center gap-1.5 mt-5 font-mono text-xs">
          {allTags.map((tag) => (
            <span class="px-2 py-0.5 rounded bg-zinc-100 dark:bg-zinc-800/60 text-zinc-600 dark:text-zinc-400 border border-zinc-200 dark:border-zinc-700/60 text-[11px]">
              #{tag}
            </span>
          ))}
        </div>
      )}
    </header>

    <!-- Articles List: Pure Omarchy.org/news/ style -->
    <ul class="divide-y divide-zinc-200 dark:divide-zinc-800 border-t border-zinc-200 dark:border-zinc-800">
      {sortedPosts.map((post) => (
        <li>
          <a
            href={`/blog/${post.slug}`}
            class="group flex flex-col gap-1.5 py-6 transition-colors"
          >
            <time datetime={post.data.pubDate.toISOString()} class="font-mono text-xs text-zinc-500 dark:text-zinc-400">
              {post.data.pubDate.toLocaleDateString('tr-TR', { day: 'numeric', month: 'long', year: 'numeric' })}
            </time>
            <span class="flex items-baseline gap-2 font-sans text-lg sm:text-xl font-medium text-zinc-950 dark:text-zinc-100 group-hover:text-sky-600 dark:group-hover:text-[#00ffcc] transition-colors">
              <span>{post.data.title}</span>
              <svg viewBox="0 0 24 24" fill="none" aria-hidden="true" class="w-4 h-4 shrink-0 self-center text-zinc-400 dark:text-zinc-500 transition-transform duration-150 ease-out group-hover:translate-x-1 group-hover:text-sky-600 dark:group-hover:text-[#00ffcc]">
                <path d="M14 5.75L20.25 12L14 18.25" stroke="currentColor" stroke-width="1.5" stroke-linecap="square" />
                <path d="M19.5 12H3.75" stroke="currentColor" stroke-width="1.5" stroke-linecap="square" />
              </svg>
            </span>
            {post.data.description && (
              <span class="text-sm leading-relaxed text-zinc-600 dark:text-zinc-400">
                {post.data.description}
              </span>
            )}
            {post.data.tags && post.data.tags.length > 0 && (
              <span class="flex flex-wrap gap-1.5 mt-1 font-mono text-[10px]">
                {post.data.tags.map((tag) => (
                  <span class="px-1.5 py-0.5 rounded bg-zinc-100 dark:bg-zinc-800/80 text-zinc-500 dark:text-zinc-400 border border-zinc-200/80 dark:border-zinc-800">
                    #{tag}
                  </span>
                ))}
              </span>
            )}
          </a>
        </li>
      ))}
    </ul>
  </div>
</BaseLayout>

