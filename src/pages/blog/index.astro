---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const posts = await getCollection('blog', ({ data }) => !data.draft);
const sortedPosts = posts.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

// Get all unique tags
const allTags = [...new Set(posts.flatMap((post) => post.data.tags))];
---

<BaseLayout
  title="Yazılar & Düşünceler — Ozan Özdil"
  description="Açık kaynak, Linux çekirdeği, siber güvenlik, yapay zekâ ve siyasal iletişim üzerine makaleler."
  currentPath="/blog"
>
  <div class="mb-6">
    <div class="flex items-center justify-between pb-4 border-b border-gh-border">
      <div>
        <h1 class="text-xl font-bold text-gh-text flex items-center gap-2">
          <span>Yazılar & Makaleler</span>
          <span class="text-xs font-mono font-normal px-2 py-0.5 rounded-full bg-gh-badge text-gh-textMuted border border-gh-border">
            {posts.length} yazı
          </span>
        </h1>
        <p class="text-xs text-gh-textMuted mt-1">
          Açık kaynak dünyası, siber güvenlik araştırmaları, siyasal strateji ve kişisel arşiv notları.
        </p>
      </div>
    </div>

    <!-- Tags Bar -->
    {allTags.length > 0 && (
      <div class="flex flex-wrap gap-1.5 pt-3">
        <span class="text-xs font-mono text-gh-textMuted py-0.5">Etiketler:</span>
        {allTags.map((tag) => (
          <span class="text-[11px] font-mono px-2 py-0.5 rounded-full bg-gh-badge text-gh-textMuted border border-gh-border">
            #{tag}
          </span>
        ))}
      </div>
    )}
  </div>

  <!-- Articles List (GitHub Issue/Commit Style) -->
  <div class="border border-gh-border rounded-md divide-y divide-gh-border bg-gh-bg overflow-hidden shadow-sm">
    {sortedPosts.map((post) => (
      <article class="p-5 hover:bg-gh-subtle transition-colors">
        <div class="flex flex-col sm:flex-row sm:items-baseline justify-between gap-1 mb-2">
          <h2 class="text-base font-semibold">
            <a href={`/blog/${post.slug}`} class="text-gh-text hover:text-gh-link">
              {post.data.title}
            </a>
          </h2>
          <time datetime={post.data.pubDate.toISOString()} class="text-xs font-mono text-gh-textMuted flex-shrink-0">
            {post.data.pubDate.toLocaleDateString('tr-TR', { day: 'numeric', month: 'long', year: 'numeric' })}
          </time>
        </div>

        <p class="text-xs text-gh-textMuted mb-3 line-clamp-2 leading-relaxed">
          {post.data.description}
        </p>

        <div class="flex items-center space-x-2">
          {post.data.tags.map((tag) => (
            <span class="text-[10px] font-mono px-1.5 py-0.5 rounded bg-gh-subtle border border-gh-border text-gh-textMuted">
              #{tag}
            </span>
          ))}
        </div>
      </article>
    ))}
  </div>
</BaseLayout>
