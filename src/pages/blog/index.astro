---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const posts = await getCollection('blog', ({ data }) => !data.draft);
const sortedPosts = posts.sort((a, b) => new Date(b.data.pubDate).getTime() - new Date(a.data.pubDate).getTime());

const allTags = [...new Set(posts.flatMap((post) => post.data.tags || []).filter(Boolean))].sort((a, b) => a.localeCompare(b, 'tr'));
---

<BaseLayout
  title="Yazılar — Ozan Özdil"
  description="Teknoloji, açık kaynak, siber güvenlik, dijital egemenlik, yapay zekâ ve sistem mimarisi üzerine araştırmalar ve notlar."
  currentPath="/blog"
  maxWidthClass="max-w-5xl"
>
  <div class="py-4 sm:py-8 space-y-10">
    <!-- Header -->
    <header class="rounded-[24px] border border-[#27272a] bg-[#121215] p-8 sm:p-12 text-center shadow-xl">
      <div class="inline-flex items-center gap-2 font-mono text-xs text-[#71717a] uppercase tracking-wider mb-3 font-semibold">
        <span class="w-2 h-2 rounded-full bg-[#52525b] animate-pulse"></span>
        <span>// EDİTORYAL ARŞİV & ARAŞTIRMALAR</span>
      </div>
      <h1 class="text-4xl sm:text-5xl lg:text-6xl font-serif font-normal text-[#ffffff] leading-[1.32] pb-1">
        Yazılar & Notlar
      </h1>
      <p class="mt-4 text-base sm:text-lg text-[#a1a1aa] max-w-2xl mx-auto font-serif leading-relaxed">
        Teknoloji, açık kaynak, siber güvenlik, dijital egemenlik, yapay zekâ, Linux ve sistem mimarisi üzerine araştırmalar ve notlar.
      </p>

      <!-- Live Search Box -->
      <div class="relative max-w-lg mx-auto mt-6">
        <input
          id="qs-search-input"
          type="search"
          placeholder="Yazılarda anlık ara... [/]"
          class="w-full px-4 py-2.5 pl-10 pr-9 rounded-xl border border-[#27272a] bg-[#18181b] text-[#ffffff] placeholder-[#71717a] font-mono text-xs focus:outline-none focus:border-[#52525b] transition-colors"
          autocomplete="off"
        />
        <svg class="absolute left-3.5 top-3 w-4 h-4 text-[#71717a] pointer-events-none" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
        </svg>
        <span class="absolute right-3.5 top-2.5 px-1.5 py-0.5 rounded border border-[#27272a] bg-[#121215] text-[10px] font-mono text-[#71717a] pointer-events-none hidden sm:inline-block">/</span>
      </div>

      <!-- Topic Tags Filter Deck: Minimal Shell Pills -->
      {allTags.length > 0 && (
        <div id="qs-tag-filters" class="flex flex-wrap items-center justify-center gap-1.5 sm:gap-2 mt-5 font-mono text-xs w-full">
          <button
            type="button"
            data-filter-tag="all"
            class="qs-filter-pill px-3 py-1.5 rounded-lg text-xs transition-all cursor-pointer border bg-[#ffffff] text-[#09090b] border-[#ffffff] font-semibold"
          >
            Tümü ({sortedPosts.length})
          </button>
          {allTags.map((tag) => (
            <button
              type="button"
              data-filter-tag={tag.toLowerCase()}
              class="qs-filter-pill px-2.5 py-1.5 rounded-lg text-xs transition-all cursor-pointer border bg-[#18181b] text-[#a1a1aa] border-[#27272a] hover:text-[#ffffff] hover:border-[#3f3f46]"
            >
              #{tag}
            </button>
          ))}
        </div>
      )}
    </header>

    <!-- Filter & Status Bar -->
    <div class="px-4 py-3 rounded-xl bg-[#121215] border border-[#27272a] flex flex-wrap items-center justify-between gap-3 text-xs font-mono text-[#71717a]">
      <div class="flex items-center gap-3">
        <span id="qs-stats-counter" class="text-[#ffffff] font-medium">Toplam {sortedPosts.length} yazı</span>
      </div>

      <div class="flex items-center gap-2">
        <span id="qs-page-info" class="text-[#a1a1aa] font-medium">Sayfa 1 / 1</span>
        <div class="flex items-center gap-1 ml-1">
          <button
            id="qs-prev-btn"
            type="button"
            class="px-2.5 py-1 rounded bg-[#18181b] hover:bg-[#27272a] text-[#ffffff] disabled:opacity-30 disabled:cursor-not-allowed transition-colors cursor-pointer border border-[#27272a]"
            title="Önceki Sayfa"
          >
            ← Önceki
          </button>
          <button
            id="qs-next-btn"
            type="button"
            class="px-2.5 py-1 rounded bg-[#18181b] hover:bg-[#27272a] text-[#ffffff] disabled:opacity-30 disabled:cursor-not-allowed transition-colors cursor-pointer border border-[#27272a]"
            title="Sonraki Sayfa"
          >
            Sonraki →
          </button>
        </div>
      </div>
    </div>

    <!-- Empty State for Tag Filter -->
    <div id="qs-empty-state" class="hidden py-16 text-center font-mono text-sm text-[#71717a] border border-dashed border-[#27272a] rounded-xl bg-[#121215]">
      <p>Arama kriterinize veya seçili filtreye ait yazı bulunamadı.</p>
      <button
        id="qs-reset-filter"
        type="button"
        class="mt-3 inline-flex items-center gap-1.5 px-3 py-1.5 rounded bg-[#18181b] text-[#ffffff] hover:underline cursor-pointer font-medium text-xs border border-[#27272a]"
      >
        [Filtreleri ve aramayı sıfırla]
      </button>
    </div>

    <!-- Articles Board Grid -->
    <div
      id="qs-posts-grid"
      class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6"
    >
      {sortedPosts.map((post) => (
        <article
          class="qs-post-item relative group rounded-[22px] clean-card bg-[#121215] border border-[#27272a] hover:border-[#3f3f46] p-6 transition-all duration-200 flex flex-col justify-between h-full shadow-xl overflow-hidden"
          data-title={post.data.title.toLowerCase()}
          data-desc={(post.data.description || '').toLowerCase()}
          data-tags={JSON.stringify((post.data.tags || []).map((t) => t.toLowerCase()))}
        >
          <div class="space-y-4">
            <!-- Top Tag & Date Line -->
            <div class="flex items-center justify-between text-[11px] font-mono text-[#71717a] pb-2.5 border-b border-[#27272a]">
              <span class="text-[#d4d4d8] font-medium flex items-center gap-1.5">
                <span class="w-1.5 h-1.5 rounded-full bg-[#52525b]"></span>
                <span>#{(post.data.tags && post.data.tags[0]) || 'notlar'}</span>
              </span>
              <time datetime={post.data.pubDate.toISOString()}>
                {post.data.pubDate.toLocaleDateString('tr-TR', { day: 'numeric', month: 'short', year: 'numeric' })}
              </time>
            </div>

            <!-- Title -->
            <h2 class="text-xl font-normal text-[#ffffff] font-serif group-hover:text-[#ffffff] transition-colors leading-[1.3] line-clamp-2">
              <a href={`/blog/${post.slug}`} class="focus:outline-none">
                {post.data.title}
              </a>
            </h2>

            <!-- Preview Description -->
            {post.data.description && (
              <p class="text-sm leading-relaxed text-[#a1a1aa] font-serif line-clamp-3">
                {post.data.description}
              </p>
            )}
          </div>

          <!-- Bottom Action & Secondary Tags -->
          <div class="pt-3 mt-3 border-t border-[#27272a] flex items-center justify-between text-xs font-mono">
            <div class="flex items-center gap-1">
              {post.data.tags && post.data.tags.slice(1, 3).map((tag) => (
                <button
                  type="button"
                  data-tag-button={tag.toLowerCase()}
                  class="px-1.5 py-0.5 rounded bg-[#18181b] text-[#71717a] hover:text-[#ffffff] text-[10px] cursor-pointer border border-[#27272a]"
                  title={`#${tag}`}
                >
                  #{tag}
                </button>
              ))}
            </div>

            <a
              href={`/blog/${post.slug}`}
              class="inline-flex items-center gap-1 text-[#d4d4d8] hover:text-[#ffffff] font-medium group-hover:translate-x-0.5 transition-all"
            >
              <span>Oku</span>
              <span>→</span>
            </a>
          </div>
        </article>
      ))}
    </div>

    <!-- Bottom Pagination Bar -->
    <div id="qs-pagination-container" class="pt-6 border-t border-[#27272a] flex flex-wrap items-center justify-between gap-4 font-mono text-xs">
      <div class="text-[#71717a]">
        <span id="qs-page-summary">Sayfa 1 / 1 (36 yazı)</span>
      </div>

      <div id="qs-page-numbers" class="flex items-center gap-1.5">
        <!-- Dynamic page number buttons generated in JS -->
      </div>
    </div>
  </div>
</BaseLayout>

<script is:inline>
  function setupPanoBoard() {
    const PAGE_SIZE = 15;
    let currentPage = 1;
    let matchingItems = [];
    let currentTag = 'all';
    let currentQuery = '';

    const filterPills = document.querySelectorAll('[data-filter-tag]');
    const postItems = Array.from(document.querySelectorAll('.qs-post-item'));
    const emptyState = document.getElementById('qs-empty-state');
    const resetBtn = document.getElementById('qs-reset-filter');
    const cardTagBtns = document.querySelectorAll('[data-tag-button]');
    const searchInput = document.getElementById('qs-search-input');

    const statsCounter = document.getElementById('qs-stats-counter');
    const pageInfo = document.getElementById('qs-page-info');
    const prevBtn = document.getElementById('qs-prev-btn');
    const nextBtn = document.getElementById('qs-next-btn');
    const pageSummary = document.getElementById('qs-page-summary');
    const pageNumbersContainer = document.getElementById('qs-page-numbers');
    const paginationContainer = document.getElementById('qs-pagination-container');

    function filterPosts(tag, query) {
      if (tag !== undefined) currentTag = (tag || 'all').toLowerCase();
      if (query !== undefined) currentQuery = (query || '').toLowerCase().trim();

      matchingItems = [];

      postItems.forEach((card) => {
        let cardTags = [];
        try {
          cardTags = JSON.parse(card.getAttribute('data-tags') || '[]');
        } catch (e) {
          cardTags = [];
        }
        const cardTitle = (card.getAttribute('data-title') || '').toLowerCase();
        const cardDesc = (card.getAttribute('data-desc') || '').toLowerCase();

        const tagMatch = currentTag === 'all' || cardTags.includes(currentTag);
        const queryMatch = !currentQuery ||
          cardTitle.includes(currentQuery) ||
          cardDesc.includes(currentQuery) ||
          cardTags.some((t) => t.includes(currentQuery));

        if (tagMatch && queryMatch) {
          matchingItems.push(card);
        } else {
          card.classList.add('hidden');
        }
      });

      const totalMatches = matchingItems.length;
      if (statsCounter) {
        statsCounter.textContent = `Toplam ${totalMatches} yazı`;
      }

      if (totalMatches === 0) {
        if (emptyState) emptyState.classList.remove('hidden');
        if (paginationContainer) paginationContainer.classList.add('hidden');
      } else {
        if (emptyState) emptyState.classList.add('hidden');
        if (paginationContainer) paginationContainer.classList.remove('hidden');
      }

      currentPage = 1;
      renderPage();
    }

    function renderPage() {
      const totalMatches = matchingItems.length;
      const totalPages = Math.max(1, Math.ceil(totalMatches / PAGE_SIZE));

      if (currentPage > totalPages) currentPage = totalPages;
      if (currentPage < 1) currentPage = 1;

      const startIndex = (currentPage - 1) * PAGE_SIZE;
      const endIndex = startIndex + PAGE_SIZE;

      matchingItems.forEach((card, index) => {
        if (index >= startIndex && index < endIndex) {
          card.classList.remove('hidden');
        } else {
          card.classList.add('hidden');
        }
      });

      if (pageInfo) pageInfo.textContent = `Sayfa ${currentPage} / ${totalPages}`;
      if (pageSummary) pageSummary.textContent = `Sayfa ${currentPage} / ${totalPages} (${totalMatches} yazı)`;

      if (prevBtn) prevBtn.disabled = currentPage <= 1;
      if (nextBtn) nextBtn.disabled = currentPage >= totalPages;

      renderPageButtons(totalPages);
    }

    function renderPageButtons(totalPages) {
      if (!pageNumbersContainer) return;
      pageNumbersContainer.innerHTML = '';

      if (totalPages <= 1) return;

      for (let i = 1; i <= totalPages; i++) {
        const btn = document.createElement('button');
        btn.type = 'button';
        btn.textContent = `${i}`;
        btn.className = i === currentPage
          ? 'px-2.5 py-1 rounded bg-[#ffffff] text-[#09090b] font-bold border border-[#ffffff] cursor-pointer'
          : 'px-2.5 py-1 rounded bg-[#18181b] text-[#a1a1aa] hover:text-[#ffffff] border border-[#27272a] cursor-pointer';
        
        btn.addEventListener('click', () => {
          currentPage = i;
          renderPage();
          window.scrollTo({ top: 0, behavior: 'smooth' });
        });
        pageNumbersContainer.appendChild(btn);
      }
    }

    filterPills.forEach((pill) => {
      pill.addEventListener('click', () => {
        const tag = pill.getAttribute('data-filter-tag') || 'all';

        filterPills.forEach((p) => {
          p.className = 'qs-filter-pill px-2.5 py-1.5 rounded-lg text-xs transition-all cursor-pointer border bg-[#18181b] text-[#a1a1aa] border-[#27272a] hover:text-[#ffffff] hover:border-[#3f3f46]';
        });

        pill.className = 'qs-filter-pill px-3 py-1.5 rounded-lg text-xs transition-all cursor-pointer border bg-[#ffffff] text-[#09090b] border-[#ffffff] font-semibold';

        filterPosts(tag, undefined);
      });
    });

    if (searchInput) {
      searchInput.addEventListener('input', (e) => {
        filterPosts(undefined, e.target.value);
      });

      window.addEventListener('keydown', (e) => {
        if (e.key === '/' && document.activeElement !== searchInput && !['INPUT', 'TEXTAREA'].includes(document.activeElement?.tagName)) {
          e.preventDefault();
          searchInput.focus();
        } else if (e.key === 'Escape' && document.activeElement === searchInput) {
          searchInput.value = '';
          searchInput.blur();
          filterPosts(undefined, '');
        }
      });
    }

    cardTagBtns.forEach((btn) => {
      btn.addEventListener('click', (e) => {
        e.preventDefault();
        e.stopPropagation();
        const tag = btn.getAttribute('data-tag-button');
        if (!tag) return;

        const targetPill = document.querySelector(`[data-filter-tag="${tag}"]`);
        if (targetPill) {
          targetPill.click();
        } else {
          filterPosts(tag, undefined);
        }
        window.scrollTo({ top: 0, behavior: 'smooth' });
      });
    });

    if (resetBtn) {
      resetBtn.addEventListener('click', () => {
        if (searchInput) searchInput.value = '';
        currentQuery = '';
        const allPill = document.querySelector('[data-filter-tag="all"]');
        if (allPill) allPill.click();
        else filterPosts('all', '');
      });
    }

    if (prevBtn) {
      prevBtn.addEventListener('click', () => {
        if (currentPage > 1) {
          currentPage--;
          renderPage();
          window.scrollTo({ top: 0, behavior: 'smooth' });
        }
      });
    }

    if (nextBtn) {
      nextBtn.addEventListener('click', () => {
        const totalPages = Math.ceil(matchingItems.length / PAGE_SIZE);
        if (currentPage < totalPages) {
          currentPage++;
          renderPage();
          window.scrollTo({ top: 0, behavior: 'smooth' });
        }
      });
    }

    // Initial run with URL query & tag support
    const urlParams = new URLSearchParams(window.location.search);
    const initialTag = urlParams.get('tag');
    const initialQuery = urlParams.get('q') || '';

    if (initialQuery && searchInput) {
      searchInput.value = initialQuery;
    }

    if (initialTag) {
      const targetPill = document.querySelector(`[data-filter-tag="${initialTag.toLowerCase()}"]`);
      if (targetPill) {
        filterPills.forEach((p) => {
          p.className = 'qs-filter-pill px-2.5 py-1.5 rounded-lg text-xs transition-all cursor-pointer border bg-[#18181b] text-[#a1a1aa] border-[#27272a] hover:text-[#ffffff] hover:border-[#3f3f46]';
        });
        targetPill.className = 'qs-filter-pill px-3 py-1.5 rounded-lg text-xs transition-all cursor-pointer border bg-[#ffffff] text-[#09090b] border-[#ffffff] font-semibold';
      }
      filterPosts(initialTag.toLowerCase(), initialQuery);
    } else {
      filterPosts('all', initialQuery);
    }
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', setupPanoBoard);
  } else {
    setupPanoBoard();
  }
</script>
