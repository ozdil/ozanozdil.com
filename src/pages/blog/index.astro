---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const posts = await getCollection('blog', ({ data }) => !data.draft);
const sortedPosts = posts.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

const allTags = [...new Set(posts.flatMap((post) => post.data.tags))];
---

<BaseLayout
  title="Yazılar — Ozan Özdil"
  description="Linux sistemleri, açık kaynak yazılımlar, dijital güvenlik ve kişisel araştırmalar."
  currentPath="/blog"
>
  <!-- Başlık -->
  <div class="mb-10 pb-6 border-b border-zinc-200/80 dark:border-zinc-800/80">
    <div class="flex items-baseline gap-2.5 mb-2">
      <h1 class="text-2xl sm:text-3xl font-semibold tracking-tight text-zinc-950 dark:text-zinc-50">
        Yazılar
      </h1>
      <span class="text-xs font-mono text-zinc-400 dark:text-zinc-500">
        ({posts.length})
      </span>
    </div>
    <p class="text-sm text-zinc-600 dark:text-zinc-400 max-w-2xl leading-relaxed font-normal">
      Linux sistemleri, açık kaynak yazılımlar, dijital güvenlik ve kişisel araştırmalar.
    </p>

    <!-- Konular -->
    {allTags.length > 0 && (
      <div class="flex flex-wrap items-center gap-2 pt-4">
        {allTags.map((tag) => (
          <span class="text-xs font-mono text-zinc-500 dark:text-zinc-400 hover:text-zinc-900 dark:hover:text-zinc-100 transition-colors">
            #{tag}
          </span>
        ))}
      </div>
    )}
  </div>

  <!-- Yazı Listesi -->
  <div class="divide-y divide-zinc-200/60 dark:divide-zinc-800/60">
    {sortedPosts.map((post) => (
      <article class="py-5 first:pt-0 group">
        <div class="flex flex-col sm:flex-row sm:items-baseline justify-between gap-1 mb-1.5">
          <h2 class="text-base sm:text-lg font-medium">
            <a href={`/blog/${post.slug}`} class="text-zinc-950 dark:text-zinc-50 group-hover:text-blue-600 dark:group-hover:text-blue-400 transition-colors">
              {post.data.title}
            </a>
          </h2>
          <time datetime={post.data.pubDate.toISOString()} class="text-xs font-mono text-zinc-400 dark:text-zinc-500 flex-shrink-0">
            {post.data.pubDate.toLocaleDateString('tr-TR', { day: 'numeric', month: 'long', year: 'numeric' })}
          </time>
        </div>

        <p class="text-sm text-zinc-600 dark:text-zinc-400 mb-2.5 line-clamp-2 leading-relaxed font-normal">
          {post.data.description}
        </p>

        {post.data.tags.length > 0 && (
          <div class="flex flex-wrap gap-2">
            {post.data.tags.map((tag) => (
              <span class="text-[11px] font-mono text-zinc-400 dark:text-zinc-500">
                #{tag}
              </span>
            ))}
          </div>
        )}
      </article>
    ))}
  </div>
</BaseLayout>
