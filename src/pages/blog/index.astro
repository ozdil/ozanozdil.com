---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const posts = await getCollection('blog', ({ data }) => !data.draft);
const sortedPosts = posts.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

const allTags = [...new Set(posts.flatMap((post) => post.data.tags || []).filter(Boolean))].sort((a, b) => a.localeCompare(b, 'tr'));
---

<BaseLayout
  title="Yazılar — Ozan Özdil"
  description="Quickshell, Omarchy ve Wayland masaüstü mimarisi üzerine araştırmalar ve notlar."
  currentPath="/blog"
  maxWidthClass="max-w-3xl"
>
  <div class="py-2 sm:py-4">
    <!-- Header: Omarchy / QuickShell Style -->
    <header class="pb-8 text-center">
      <p class="font-mono text-xs font-medium tracking-[0.18em] text-sky-600 dark:text-[#00ffcc] uppercase sm:text-sm">
        Arşiv
      </p>
      <h1 class="mt-2 text-2xl sm:text-3xl font-semibold tracking-tight text-zinc-950 dark:text-zinc-50 font-sans">
        Quickshell & Omarchy Notları
      </h1>
      <p class="mt-2 text-sm text-zinc-600 dark:text-zinc-400 max-w-lg mx-auto">
        Wayland masaüstü kabuğu, QML bileşenleri, eklentiler ve performans analizleri.
      </p>

      <!-- Topic Tags Interactive Filter Bar -->
      {allTags.length > 0 && (
        <div id="qs-tag-filters" class="flex flex-wrap items-center justify-center gap-1.5 mt-5 font-mono text-xs">
          <button
            type="button"
            data-filter-tag="all"
            class="qs-filter-pill px-2.5 py-1 rounded text-xs transition-all cursor-pointer border bg-zinc-900 text-white border-zinc-900 dark:bg-[#00ffcc] dark:text-zinc-950 dark:border-[#00ffcc] font-semibold"
          >
            Tümü ({sortedPosts.length})
          </button>
          {allTags.map((tag) => (
            <button
              type="button"
              data-filter-tag={tag.toLowerCase()}
              class="qs-filter-pill px-2.5 py-1 rounded text-xs transition-all cursor-pointer border bg-zinc-100 dark:bg-zinc-800/60 text-zinc-600 dark:text-zinc-400 border-zinc-200 dark:border-zinc-700/60 hover:text-zinc-950 dark:hover:text-zinc-200 hover:border-zinc-300 dark:hover:border-zinc-600"
            >
              #{tag}
            </button>
          ))}
        </div>
      )}
    </header>

    <!-- Empty State for Tag Filter -->
    <div id="qs-empty-state" class="hidden py-12 text-center font-mono text-xs text-zinc-500 dark:text-zinc-400 border-t border-zinc-200 dark:border-zinc-800">
      <p>Bu etikete ait yazı bulunamadı.</p>
      <button
        id="qs-reset-filter"
        type="button"
        class="mt-3 inline-flex items-center gap-1 text-sky-600 dark:text-[#00ffcc] hover:underline cursor-pointer font-medium"
      >
        [Tüm yazıları göster]
      </button>
    </div>

    <!-- Articles List: Pure Omarchy / QuickShell Style -->
    <div id="qs-posts-list" class="space-y-4 pt-2">
      {sortedPosts.map((post) => (
        <article
          class="qs-post-item group relative rounded-xl border border-zinc-200/90 dark:border-zinc-800/90 hover:border-sky-500/80 dark:hover:border-[#00ffcc]/70 bg-white dark:bg-[#0c0e12] overflow-hidden transition-all duration-200 shadow-2xs hover:shadow-md"
          data-tags={JSON.stringify((post.data.tags || []).map((t) => t.toLowerCase()))}
        >
          <!-- QuickShell QML Header Strip -->
          <div class="px-4 py-2 bg-zinc-50 dark:bg-[#12151d] border-b border-zinc-100 dark:border-zinc-800/80 flex items-center justify-between font-mono text-[11px]">
            <div class="flex items-center gap-2">
              <span class="flex items-center gap-1.5 opacity-80">
                <span class="w-2 h-2 rounded-full bg-rose-500/80"></span>
                <span class="w-2 h-2 rounded-full bg-amber-500/80"></span>
                <span class="w-2 h-2 rounded-full bg-emerald-500/80"></span>
              </span>
              <span class="text-zinc-500 dark:text-zinc-400 font-mono text-[11px] ml-1 truncate">
                qs://blog/{post.slug}.qml
              </span>
            </div>
            <div class="flex items-center gap-2 flex-shrink-0">
              <time datetime={post.data.pubDate.toISOString()} class="text-zinc-400 dark:text-zinc-500 text-[11px]">
                {post.data.pubDate.toLocaleDateString('tr-TR', { day: 'numeric', month: 'short', year: 'numeric' })}
              </time>
              <span class="px-1.5 py-0.5 rounded bg-zinc-200/60 dark:bg-zinc-800/80 text-zinc-600 dark:text-[#00ffcc] text-[10px] border border-zinc-300/40 dark:border-[#00ffcc]/30 font-semibold">
                QML
              </span>
            </div>
          </div>

          <!-- Card Body -->
          <div class="p-5 flex flex-col gap-3">
            <a
              href={`/blog/${post.slug}`}
              class="flex items-start justify-between gap-3 group/link"
            >
              <h2 class="text-base sm:text-lg font-semibold text-zinc-950 dark:text-zinc-100 font-sans group-hover/link:text-sky-600 dark:group-hover/link:text-[#00ffcc] transition-colors leading-snug">
                {post.data.title}
              </h2>
              <span class="shrink-0 inline-flex items-center gap-1 font-mono text-xs text-zinc-400 dark:text-zinc-500 group-hover/link:text-sky-600 dark:group-hover/link:text-[#00ffcc] transition-all group-hover/link:translate-x-0.5">
                <span>[Aç]</span>
                <svg viewBox="0 0 24 24" fill="none" class="w-3.5 h-3.5" stroke="currentColor" stroke-width="2">
                  <path d="M5 12h14M12 5l7 7-7 7" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
              </span>
            </a>

            {post.data.description && (
              <p class="text-xs sm:text-sm leading-relaxed text-zinc-600 dark:text-zinc-400 font-sans">
                {post.data.description}
              </p>
            )}

            <!-- Clickable Card Tags as QML Properties -->
            {post.data.tags && post.data.tags.length > 0 && (
              <div class="flex flex-wrap items-center gap-1.5 pt-1 font-mono text-[11px]">
                <span class="text-zinc-400 dark:text-zinc-600 text-[10px] mr-0.5">tags:</span>
                {post.data.tags.map((tag) => (
                  <button
                    type="button"
                    data-tag-button={tag.toLowerCase()}
                    class="px-2 py-0.5 rounded bg-zinc-100 hover:bg-sky-50 dark:bg-zinc-800/80 dark:hover:bg-[#00ffcc]/10 text-zinc-600 dark:text-zinc-400 hover:text-sky-600 dark:hover:text-[#00ffcc] border border-zinc-200 dark:border-zinc-700/60 hover:border-sky-300 dark:hover:border-[#00ffcc]/40 transition-colors cursor-pointer"
                  >
                    #{tag}
                  </button>
                ))}
              </div>
            )}
          </div>

          <!-- Bottom Telemetry Bar -->
          <div class="px-4 py-1.5 bg-zinc-50/60 dark:bg-[#080a0d]/60 border-t border-zinc-100 dark:border-zinc-800/60 flex items-center justify-between font-mono text-[10px] text-zinc-500 dark:text-zinc-500">
            <span class="flex items-center gap-1.5">
              <span class="w-1.5 h-1.5 rounded-full bg-emerald-500"></span>
              <span>Scope: Wayland Layer Shell</span>
            </span>
            <span class="text-zinc-400 dark:text-zinc-600 font-mono">
              exec(omarchy.read)
            </span>
          </div>
        </article>
      ))}
    </div>
  </div>
</BaseLayout>

<script is:inline>
  function setupTagFilter() {
    const filterPills = document.querySelectorAll('[data-filter-tag]');
    const postItems = document.querySelectorAll('.qs-post-item');
    const emptyState = document.getElementById('qs-empty-state');
    const resetBtn = document.getElementById('qs-reset-filter');
    const cardTagBtns = document.querySelectorAll('[data-tag-button]');

    function getSelectedTag() {
      const params = new URLSearchParams(window.location.search);
      return (params.get('tag') || 'all').trim().toLowerCase();
    }

    function applyFilter(selectedTag, updateUrl = true) {
      const normTag = (selectedTag || 'all').trim().toLowerCase();
      let visibleCount = 0;

      postItems.forEach((item) => {
        const itemTags = JSON.parse(item.getAttribute('data-tags') || '[]');
        const matches = normTag === 'all' || itemTags.includes(normTag);

        if (matches) {
          item.classList.remove('hidden');
          visibleCount++;
        } else {
          item.classList.add('hidden');
        }
      });

      // Update pills active styling
      filterPills.forEach((pill) => {
        const pillTag = pill.getAttribute('data-filter-tag');
        const isActive = (pillTag === 'all' && normTag === 'all') || (pillTag === normTag);

        if (isActive) {
          pill.className = 'qs-filter-pill px-2.5 py-1 rounded text-xs transition-all cursor-pointer border bg-zinc-900 text-white border-zinc-900 dark:bg-[#00ffcc] dark:text-zinc-950 dark:border-[#00ffcc] font-semibold';
        } else {
          pill.className = 'qs-filter-pill px-2.5 py-1 rounded text-xs transition-all cursor-pointer border bg-zinc-100 dark:bg-zinc-800/60 text-zinc-600 dark:text-zinc-400 border-zinc-200 dark:border-zinc-700/60 hover:text-zinc-950 dark:hover:text-zinc-200 hover:border-zinc-300 dark:hover:border-zinc-600';
        }
      });

      // Toggle empty state
      if (emptyState) {
        if (visibleCount === 0) {
          emptyState.classList.remove('hidden');
        } else {
          emptyState.classList.add('hidden');
        }
      }

      // Update URL query string without page reload
      if (updateUrl) {
        const url = new URL(window.location.href);
        if (normTag === 'all') {
          url.searchParams.delete('tag');
        } else {
          url.searchParams.set('tag', normTag);
        }
        window.history.pushState({ tag: normTag }, '', url.toString());
      }
    }

    // Top filter pills click
    filterPills.forEach((pill) => {
      pill.addEventListener('click', () => {
        const tag = pill.getAttribute('data-filter-tag');
        applyFilter(tag, true);
      });
    });

    // Card tags click
    cardTagBtns.forEach((btn) => {
      btn.addEventListener('click', (e) => {
        e.preventDefault();
        e.stopPropagation();
        const tag = btn.getAttribute('data-tag-button');
        applyFilter(tag, true);
        window.scrollTo({ top: 0, behavior: 'smooth' });
      });
    });

    // Reset button
    if (resetBtn) {
      resetBtn.addEventListener('click', () => {
        applyFilter('all', true);
      });
    }

    // Handle back / forward browser navigation
    window.addEventListener('popstate', () => {
      applyFilter(getSelectedTag(), false);
    });

    // Run on initial load if tag param exists
    const initialTag = getSelectedTag();
    if (initialTag !== 'all') {
      applyFilter(initialTag, false);
    }
  }

  // Initialize on load
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', setupTagFilter);
  } else {
    setupTagFilter();
  }
</script>
