---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

export async function getStaticPaths() {
  const posts = await getCollection('blog', ({ data }) => !data.draft);
  const sorted = posts.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
  return sorted.map((post, index) => ({
    params: { slug: post.slug },
    props: {
      post,
      prevPost: sorted[index + 1] || null,
      nextPost: sorted[index - 1] || null,
      currentIndex: sorted.length - index,
      totalPosts: sorted.length,
    },
  }));
}

const { post, prevPost, nextPost } = Astro.props;
const { Content } = await post.render();

const wordCount = post.body ? post.body.split(/\s+/).filter(Boolean).length : 0;
const readingTime = Math.max(1, Math.ceil(wordCount / 180));
---

<BaseLayout
  title={`${post.data.title} — Ozan Özdil`}
  description={post.data.description}
  image={post.data.heroImage || '/avatar.jpg'}
  currentPath="/blog"
  type="article"
  maxWidthClass="max-w-3xl"
  article={{
    pubDate: post.data.pubDate,
    updatedDate: post.data.updatedDate,
    tags: post.data.tags,
  }}
>
  <!-- Reading Progress Bar -->
  <div id="qs-read-progress-bar" class="fixed top-14 sm:top-15 left-0 h-[2px] bg-gradient-to-r from-sky-500 via-[#00ffcc] to-emerald-400 z-50 transition-all duration-75 w-0 pointer-events-none"></div>

  <article class="py-2 sm:py-4">
    <!-- Top Navigation / Back -->
    <div class="flex items-center justify-between gap-2 mb-6">
      <a
        href="/blog"
        class="inline-flex items-center gap-1.5 font-mono text-xs text-zinc-500 hover:text-zinc-950 dark:text-zinc-400 dark:hover:text-[#00ffcc] transition-colors"
      >
        <svg viewBox="0 0 24 24" fill="none" aria-hidden="true" class="w-4 h-4">
          <path d="M10 5.75L3.75 12L10 18.25" stroke="currentColor" stroke-width="1.5" stroke-linecap="square"/>
          <path d="M4.5 12H20.25" stroke="currentColor" stroke-width="1.5" stroke-linecap="square"/>
        </svg>
        <span>Yazılar & Notlar</span>
      </a>

      <button
        id="qs-copy-btn"
        type="button"
        class="inline-flex items-center gap-1 font-mono text-[11px] text-zinc-400 hover:text-zinc-900 dark:hover:text-[#00ffcc] transition-colors cursor-pointer"
        title="Bağlantıyı Kopyala"
      >
        <span>[bağlantıyı kopyala]</span>
      </button>
    </div>

    <!-- Article Header -->
    <header class="pb-6 border-b border-zinc-200/80 dark:border-zinc-800/80">
      <div class="flex flex-wrap items-center gap-2 font-mono text-xs text-zinc-500 dark:text-zinc-400">
        <span>By</span>
        <a href="/hakkimda" class="text-zinc-800 dark:text-zinc-200 font-medium hover:underline">
          Ozan Özdil
        </a>
        <span>on</span>
        <time datetime={post.data.pubDate.toISOString()}>
          {post.data.pubDate.toLocaleDateString('tr-TR', { day: 'numeric', month: 'long', year: 'numeric' })}
        </time>
        <span>•</span>
        <span>~{readingTime} dk okuma</span>
        {post.data.updatedDate && (
          <>
            <span>•</span>
            <span class="text-zinc-400 dark:text-zinc-500">
              Rev: {post.data.updatedDate.toLocaleDateString('tr-TR', { day: 'numeric', month: 'short', year: 'numeric' })}
            </span>
          </>
        )}
      </div>

      <h1 class="mt-3 text-3xl sm:text-4xl font-semibold tracking-tight text-zinc-950 dark:text-zinc-50 font-sans leading-tight">
        {post.data.title}
      </h1>

      {post.data.description && (
        <p class="mt-3 text-base text-zinc-600 dark:text-zinc-300 leading-relaxed font-sans">
          {post.data.description}
        </p>
      )}

      {post.data.tags && post.data.tags.length > 0 && (
        <div class="mt-4 flex flex-wrap gap-1.5 font-mono text-xs">
          {post.data.tags.map((tag) => (
            <span class="px-2 py-0.5 rounded bg-zinc-100 dark:bg-zinc-800/70 text-zinc-600 dark:text-zinc-400 border border-zinc-200 dark:border-zinc-700/60 text-[11px]">
              #{tag}
            </span>
          ))}
        </div>
      )}
    </header>

    <!-- Rendered Markdown Body -->
    <div class="mt-8 markdown-body leading-relaxed">
      <Content />
    </div>

    <!-- Article Navigation & Footer -->
    <footer class="mt-12 pt-8 border-t border-zinc-200/80 dark:border-zinc-800/80">
      <div class="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4 font-mono text-xs">
        <a
          href="/blog"
          class="inline-flex items-center gap-1.5 text-zinc-600 hover:text-zinc-950 dark:text-zinc-400 dark:hover:text-[#00ffcc] transition-colors"
        >
          <svg viewBox="0 0 24 24" fill="none" aria-hidden="true" class="w-4 h-4">
            <path d="M10 5.75L3.75 12L10 18.25" stroke="currentColor" stroke-width="1.5" stroke-linecap="square"/>
            <path d="M4.5 12H20.25" stroke="currentColor" stroke-width="1.5" stroke-linecap="square"/>
          </svg>
          <span>Tüm Yazılar</span>
        </a>

        <div class="flex items-center gap-4 text-zinc-400 dark:text-zinc-500">
          <a
            href="https://nsosyal.com/ozanozdil"
            target="_blank"
            rel="noopener noreferrer"
            class="hover:text-zinc-900 dark:hover:text-[#00ffcc] transition-colors"
          >
            [nsosyal]
          </a>
          <a
            href="https://github.com/ozdil"
            target="_blank"
            rel="noopener noreferrer"
            class="hover:text-zinc-900 dark:hover:text-[#00ffcc] transition-colors"
          >
            [github]
          </a>
          <a
            href="#top"
            class="hover:text-zinc-900 dark:hover:text-[#00ffcc] transition-colors"
          >
            [yukarı ↑]
          </a>
        </div>
      </div>

      <!-- Prev / Next Articles -->
      {(prevPost || nextPost) && (
        <div class="mt-8 grid grid-cols-1 sm:grid-cols-2 gap-3 pt-6 border-t border-zinc-200/60 dark:border-zinc-800/60">
          {prevPost ? (
            <a
              href={`/blog/${prevPost.slug}`}
              class="p-4 rounded-lg border border-zinc-200/80 dark:border-zinc-800 hover:border-sky-500 dark:hover:border-[#00ffcc]/60 bg-zinc-50/50 dark:bg-[#0e1117] transition-all group flex flex-col justify-between"
            >
              <span class="font-mono text-[10px] text-zinc-400 dark:text-zinc-500 mb-1">
                ← Önceki Yazı
              </span>
              <span class="font-sans font-medium text-sm text-zinc-900 dark:text-zinc-100 group-hover:text-sky-600 dark:group-hover:text-[#00ffcc] transition-colors line-clamp-1">
                {prevPost.data.title}
              </span>
            </a>
          ) : (
            <div></div>
          )}

          {nextPost ? (
            <a
              href={`/blog/${nextPost.slug}`}
              class="p-4 rounded-lg border border-zinc-200/80 dark:border-zinc-800 hover:border-sky-500 dark:hover:border-[#00ffcc]/60 bg-zinc-50/50 dark:bg-[#0e1117] transition-all group flex flex-col justify-between sm:text-right"
            >
              <span class="font-mono text-[10px] text-zinc-400 dark:text-zinc-500 mb-1">
                Sonraki Yazı →
              </span>
              <span class="font-sans font-medium text-sm text-zinc-900 dark:text-zinc-100 group-hover:text-sky-600 dark:group-hover:text-[#00ffcc] transition-colors line-clamp-1">
                {nextPost.data.title}
              </span>
            </a>
          ) : (
            <div></div>
          )}
        </div>
      )}
    </footer>
  </article>
</BaseLayout>

<script is:inline>
  // Reading Progress Bar
  function updateReadingProgress() {
    const bar = document.getElementById('qs-read-progress-bar');
    if (!bar) return;
    const scrollTop = window.scrollY || document.documentElement.scrollTop;
    const docHeight = document.documentElement.scrollHeight - document.documentElement.clientHeight;
    if (docHeight > 0) {
      const progress = Math.min(100, Math.max(0, (scrollTop / docHeight) * 100));
      bar.style.width = progress + '%';
    }
  }
  window.addEventListener('scroll', updateReadingProgress, { passive: true });
  updateReadingProgress();

  // Copy Link Action
  const copyBtn = document.getElementById('qs-copy-btn');
  if (copyBtn) {
    copyBtn.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(window.location.href);
        const orig = copyBtn.textContent;
        copyBtn.textContent = '[kopyalandı!]';
        copyBtn.classList.add('text-emerald-500');
        setTimeout(() => {
          copyBtn.textContent = orig;
          copyBtn.classList.remove('text-emerald-500');
        }, 2000);
      } catch (e) {
        console.error('Kopyalama hatası:', e);
      }
    });
  }
</script>
