---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map((post) => ({
    params: { slug: post.slug },
    props: post,
  }));
}

const post = Astro.props;
const { Content } = await post.render();
---

<BaseLayout
  title={`${post.data.title} — Ozan Özdil`}
  description={post.data.description}
  image={post.data.heroImage || '/avatar.jpg'}
  currentPath="/blog"
  type="article"
  maxWidthClass="max-w-3xl"
  article={{
    pubDate: post.data.pubDate,
    updatedDate: post.data.updatedDate,
    tags: post.data.tags,
  }}
>
  <article class="pt-2 sm:pt-4">
    <!-- Top Back Link -->
    <div class="mb-8">
      <a
        href="/blog"
        class="inline-flex items-center gap-1.5 text-xs font-mono text-zinc-500 dark:text-zinc-400 hover:text-zinc-950 dark:hover:text-zinc-100 transition-colors"
      >
        <svg class="w-3.5 h-3.5" viewBox="0 0 16 16" fill="currentColor">
          <path fill-rule="evenodd" d="M14 8a.75.75 0 0 1-.75.75H4.56l3.22 3.22a.75.75 0 1 1-1.06 1.06l-4.5-4.5a.75.75 0 0 1 0-1.06l4.5-4.5a.75.75 0 0 1 1.06 1.06L4.56 7.25h8.69A.75.75 0 0 1 14 8Z" clip-rule="evenodd"/>
        </svg>
        <span>Tüm Yazılar</span>
      </a>
    </div>

    <!-- Article Header -->
    <header class="mb-10 pb-8 border-b border-zinc-200/80 dark:border-zinc-800/80">
      <div class="flex flex-wrap items-center gap-3 text-xs font-mono text-zinc-500 dark:text-zinc-400 mb-4">
        <time datetime={post.data.pubDate.toISOString()}>
          {post.data.pubDate.toLocaleDateString('tr-TR', { day: 'numeric', month: 'long', year: 'numeric' })}
        </time>
        <span>•</span>
        <span>Ozan Özdil</span>
        {post.data.updatedDate && (
          <>
            <span>•</span>
            <span class="text-zinc-400 dark:text-zinc-500">
              Güncellendi: {post.data.updatedDate.toLocaleDateString('tr-TR', { day: 'numeric', month: 'short', year: 'numeric' })}
            </span>
          </>
        )}
      </div>

      <h1 class="text-3xl sm:text-4xl lg:text-4xl font-bold tracking-tight text-zinc-950 dark:text-zinc-50 leading-[1.2] mb-4">
        {post.data.title}
      </h1>

      <p class="text-base sm:text-lg text-zinc-600 dark:text-zinc-400 leading-relaxed font-normal mb-6">
        {post.data.description}
      </p>

      {post.data.tags.length > 0 && (
        <div class="flex flex-wrap gap-1.5">
          {post.data.tags.map((tag) => (
            <span class="text-[11px] font-mono px-2.5 py-0.5 rounded-full bg-zinc-100 dark:bg-zinc-800 text-zinc-600 dark:text-zinc-400 border border-zinc-200/80 dark:border-zinc-700/80">
              #{tag}
            </span>
          ))}
        </div>
      )}
    </header>

    <!-- Rendered Markdown Body -->
    <div class="markdown-body leading-relaxed">
      <Content />
    </div>

    <!-- Article Footer & Author Bio -->
    <footer class="mt-16 pt-8 border-t border-zinc-200/80 dark:border-zinc-800/80">
      <div class="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4">
        <div class="flex items-center space-x-3.5">
          <div class="w-10 h-10 rounded-full overflow-hidden border border-zinc-200 dark:border-zinc-800 flex-shrink-0 bg-zinc-100 dark:bg-zinc-800">
            <img src="/avatar.jpg" alt="Ozan Özdil" class="w-full h-full object-cover" />
          </div>
          <div>
            <h4 class="text-sm font-medium text-zinc-950 dark:text-zinc-50">Ozan Özdil</h4>
            <p class="text-xs text-zinc-500 dark:text-zinc-400 mt-0.5">
              Orman mühendisi & araştırmacı • Kastamonu
            </p>
          </div>
        </div>

        <div class="flex items-center space-x-3 text-xs">
          <a
            href="https://nsosyal.com/ozanozdil"
            target="_blank"
            rel="noopener noreferrer"
            class="text-zinc-500 dark:text-zinc-400 hover:text-zinc-900 dark:hover:text-zinc-100 hover:underline underline-offset-4 transition-colors"
          >
            NSosyal'de Tartış
          </a>
          <span class="text-zinc-300 dark:text-zinc-700">•</span>
          <a
            href="https://github.com/ozdil"
            target="_blank"
            rel="noopener noreferrer"
            class="text-zinc-500 dark:text-zinc-400 hover:text-zinc-900 dark:hover:text-zinc-100 hover:underline underline-offset-4 transition-colors"
          >
            GitHub
          </a>
        </div>
      </div>
    </footer>
  </article>
</BaseLayout>
