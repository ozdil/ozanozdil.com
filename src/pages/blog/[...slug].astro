---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

export async function getStaticPaths() {
  const posts = await getCollection('blog', ({ data }) => !data.draft);
  const sorted = posts.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
  return sorted.map((post, index) => ({
    params: { slug: post.slug },
    props: {
      post,
      prevPost: sorted[index + 1] || null,
      nextPost: sorted[index - 1] || null,
      currentIndex: sorted.length - index,
      totalPosts: sorted.length,
    },
  }));
}

const { post, prevPost, nextPost } = Astro.props;
const { Content, headings } = await post.render();
const tocHeadings = headings.filter((h) => h.depth === 2 || h.depth === 3);

const wordCount = post.body ? post.body.split(/\s+/).filter(Boolean).length : 0;
const readingTime = Math.max(1, Math.ceil(wordCount / 180));
const siteUrl = Astro.site ? Astro.site.toString().replace(/\/$/, '') : 'https://ozanozdil.com';
const postUrl = `${siteUrl}/blog/${post.slug}`;
---

<BaseLayout
  title={`${post.data.title} — Ozan Özdil`}
  description={post.data.description}
  image={post.data.heroImage || '/avatar.jpg'}
  currentPath="/blog"
  type="article"
  maxWidthClass="max-w-4xl"
  article={{
    pubDate: post.data.pubDate,
    updatedDate: post.data.updatedDate,
    tags: post.data.tags,
  }}
>
  <!-- Reading Progress Bar -->
  <div id="qs-read-progress-bar" class="fixed top-0 left-0 h-[2px] bg-[#e1734b] dark:bg-[#e59a7a] z-[51] transition-all duration-75 w-0 pointer-events-none"></div>

  <article class="py-6 sm:py-12 space-y-10 sm:space-y-14">
    <!-- Top Bar: Back & AI Raw Actions -->
    <div class="flex items-center justify-between font-mono text-xs text-[#8C7E74] dark:text-[#a89f91] pb-4 border-b border-[#ead9d2]/60 dark:border-[#2d2521]">
      <a
        href="/blog"
        class="inline-flex items-center gap-1.5 hover:text-[#2d2724] dark:hover:text-[#fef9ed] transition-colors"
      >
        <span>← Tüm Yazılar</span>
      </a>

      <div class="flex items-center gap-3">
        <button
          id="qs-copy-markdown-btn"
          type="button"
          class="hover:text-[#2d2724] dark:hover:text-[#fef9ed] transition-colors cursor-pointer"
          title="Yazıyı Markdown / AI Prompt olarak panoya kopyala"
        >
          <span>[ai için kopyala]</span>
        </button>

        <button
          id="qs-copy-btn"
          type="button"
          class="hover:text-[#2d2724] dark:hover:text-[#fef9ed] transition-colors cursor-pointer"
          title="Bağlantıyı Kopyala"
        >
          <span>[bağlantıyı kopyala]</span>
        </button>
      </div>
    </div>

    <script type="text/plain" id="qs-raw-markdown" set:html={JSON.stringify(
`# ${post.data.title}
Kaynak: ${postUrl}
Tarih: ${post.data.pubDate.toISOString().split('T')[0]}
Etiketler: ${(post.data.tags || []).join(', ')}

${post.body}`
    )} />

    <!-- Article Header (Airy & Centered - As in Microsoft AI Editorial Design) -->
    <header class="text-center space-y-6 pt-4 sm:pt-8">
      <h1 class="text-2xl sm:text-4xl lg:text-[46px] font-serif font-normal text-[#2d2724] dark:text-[#fef9ed] leading-[1.38] sm:leading-[1.36] lg:leading-[1.35] max-w-3xl mx-auto text-balance">
        {post.data.title}
      </h1>

      {post.data.description && (
        <p class="text-lg sm:text-xl text-[#5D524B] dark:text-[#a89f91] font-serif leading-relaxed max-w-2xl mx-auto font-normal">
          {post.data.description}
        </p>
      )}

      <!-- Metadata Line -->
      <div class="flex flex-wrap items-center justify-between gap-4 font-mono text-xs text-[#8C7E74] dark:text-[#a89f91] pt-6 pb-6 border-y border-[#ead9d2]/70 dark:border-[#2d2521] max-w-3xl mx-auto">
        <div>
          <time datetime={post.data.pubDate.toISOString()}>
            {post.data.pubDate.toLocaleDateString('tr-TR', { day: 'numeric', month: 'long', year: 'numeric' })}
          </time>
          {post.data.updatedDate && (
            <span class="ml-2 text-[11px] text-[#a67c52]">
              (güncelleme: {post.data.updatedDate.toLocaleDateString('tr-TR', { day: 'numeric', month: 'short' })})
            </span>
          )}
        </div>

        <div class="flex items-center gap-2">
          {post.data.tags && post.data.tags.length > 0 && (
            <span class="px-2.5 py-0.5 rounded-full bg-[#F5F0E4] dark:bg-[#26201c] text-[#5D524B] dark:text-[#a89f91] border border-[#ead9d2]/80 dark:border-[#2d2521]">
              {post.data.tags[0]}
            </span>
          )}
        </div>

        <div class="flex items-center gap-2">
          <span>~{readingTime} dk okuma</span>
          <span class="text-[#ead9d2] dark:text-[#3d332c]">•</span>
          <span id="qs-views-badge" class="inline-flex items-center gap-1 text-[#e1734b] dark:text-[#e59a7a]" data-slug={post.slug}>
            <svg class="w-3.5 h-3.5 opacity-80" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
              <path stroke-linecap="round" stroke-linejoin="round" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z" />
            </svg>
            <span id="qs-views-count">...</span>
            <span class="hidden sm:inline">okunma</span>
          </span>
        </div>
      </div>

      <!-- Hero Visual Frame (if available) -->
      {post.data.heroImage && (
        <div class="pt-4 max-w-4xl mx-auto">
          <div class="rounded-[24px] sm:rounded-[32px] overflow-hidden border border-[#ead9d2]/80 dark:border-[#2d2521] bg-[#F5F0E4] dark:bg-[#1f1a17] shadow-xs">
            <img
              src={post.data.heroImage}
              alt={post.data.title}
              class="w-full h-auto max-h-[550px] object-cover"
              loading="eager"
            />
          </div>
        </div>
      )}
    </header>

    <!-- Table of Contents (TOC) -->
    {tocHeadings.length >= 3 && (
      <details class="max-w-2xl mx-auto rounded-2xl border border-[#ead9d2]/80 dark:border-[#2d2521] bg-[#F5F0E4]/50 dark:bg-[#1c1815]/50 font-mono text-xs group" open>
        <summary class="flex items-center justify-between p-4 cursor-pointer select-none font-medium text-[#2d2724] dark:text-[#fef9ed] hover:text-[#e1734b] transition-colors">
          <span class="flex items-center gap-2">
            <span class="text-[#e1734b] dark:text-[#e59a7a]">#</span>
            <span>İçindekiler</span>
          </span>
          <span class="text-[11px] text-[#8C7E74]">
            {tocHeadings.length} Başlık ▾
          </span>
        </summary>
        <nav class="px-5 pb-5 pt-1 border-t border-[#ead9d2]/60 dark:border-[#2d2521]">
          <ul class="space-y-2 text-[#5D524B] dark:text-[#a89f91]">
            {tocHeadings.map((heading) => (
              <li class={heading.depth === 3 ? 'pl-4 text-[11px]' : ''}>
                <a
                  href={`#${heading.slug}`}
                  class="hover:text-[#e1734b] dark:hover:text-[#e59a7a] hover:underline transition-colors flex items-center gap-1.5"
                >
                  <span class="text-[#a67c52]">{heading.depth === 2 ? '→' : '↳'}</span>
                  <span>{heading.text}</span>
                </a>
              </li>
            ))}
          </ul>
        </nav>
      </details>
    )}

    <!-- Rendered Markdown Body (Max Width Reading Column with Spacious Typography) -->
    <div class="markdown-body max-w-3xl mx-auto font-serif text-lg sm:text-[19px] leading-[1.8] text-[#2d2724]/90 dark:text-[#fef9ed]/90">
      <Content />
    </div>

    <!-- Tags Deck -->
    {post.data.tags && post.data.tags.length > 0 && (
      <div class="max-w-3xl mx-auto pt-8 border-t border-[#ead9d2]/60 dark:border-[#2d2521] flex flex-wrap items-center gap-2 font-mono text-xs">
        <span class="text-[#8C7E74] dark:text-[#a89f91]">Etiketler:</span>
        {post.data.tags.map((tag) => (
          <a
            href={`/blog?tag=${encodeURIComponent(tag.toLowerCase())}`}
            class="px-3 py-1 rounded-full bg-[#F5F0E4] hover:bg-[#FBF4E5] dark:bg-[#1f1a17] dark:hover:bg-[#26201c] text-[#5D524B] dark:text-[#a89f91] border border-[#ead9d2] dark:border-[#2d2521] transition-colors"
          >
            #{tag}
          </a>
        ))}
      </div>
    )}

    <!-- Social Media Share Section -->
    <div class="max-w-3xl mx-auto p-6 rounded-2xl border border-[#ead9d2]/80 dark:border-[#2d2521] bg-[#F5F0E4]/60 dark:bg-[#1c1815]/60 flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4 font-mono text-xs shadow-2xs">
      <div class="space-y-1">
        <span class="text-[#2d2724] dark:text-[#fef9ed] font-medium block">
          Bu Yazıyı Paylaş
        </span>
        <span class="text-[11px] text-[#8C7E74] dark:text-[#a89f91]">
          Açık kaynak ve bağımsız teknolojiyi yaygınlaştırmaya destek olun.
        </span>
      </div>

      <div class="flex flex-wrap items-center gap-2">
        <!-- X -->
        <a
          href={`https://twitter.com/intent/tweet?text=${encodeURIComponent(post.data.title)}&url=${encodeURIComponent(postUrl)}`}
          target="_blank"
          rel="noopener noreferrer"
          class="px-3 py-1.5 rounded-full bg-[#fef9ed] dark:bg-[#141210] hover:bg-[#FBF4E5] text-[#2d2724] dark:text-[#fef9ed] border border-[#ead9d2] dark:border-[#2d2521] transition-colors"
        >
          X
        </a>

        <!-- LinkedIn -->
        <a
          href={`https://www.linkedin.com/sharing/share-offsite/?url=${encodeURIComponent(postUrl)}`}
          target="_blank"
          rel="noopener noreferrer"
          class="px-3 py-1.5 rounded-full bg-[#fef9ed] dark:bg-[#141210] hover:bg-[#FBF4E5] text-[#2d2724] dark:text-[#fef9ed] border border-[#ead9d2] dark:border-[#2d2521] transition-colors"
        >
          LinkedIn
        </a>

        <!-- Telegram -->
        <a
          href={`https://t.me/share/url?url=${encodeURIComponent(postUrl)}&text=${encodeURIComponent(post.data.title)}`}
          target="_blank"
          rel="noopener noreferrer"
          class="px-3 py-1.5 rounded-full bg-[#fef9ed] dark:bg-[#141210] hover:bg-[#FBF4E5] text-[#2d2724] dark:text-[#fef9ed] border border-[#ead9d2] dark:border-[#2d2521] transition-colors"
        >
          Telegram
        </a>

        <!-- Copy Link -->
        <button
          id="qs-share-copy-btn"
          type="button"
          class="px-3 py-1.5 rounded-full bg-[#2d2724] dark:bg-[#fef9ed] text-[#fef9ed] dark:text-[#2d2724] hover:opacity-90 transition-opacity cursor-pointer font-medium"
        >
          <span id="qs-share-copy-text">Kopyala</span>
        </button>
      </div>
    </div>

    <!-- Article Navigation & Footer -->
    <footer class="max-w-3xl mx-auto pt-8 border-t border-[#ead9d2]/60 dark:border-[#2d2521] space-y-8 font-mono text-xs">
      <div class="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4">
        <a
          href="/blog"
          class="text-[#8C7E74] dark:text-[#a89f91] hover:text-[#2d2724] dark:hover:text-[#fef9ed] transition-colors flex items-center gap-1.5"
        >
          <span>← Yazılar Arşivine Dön</span>
        </a>

        <div class="flex items-center gap-4 text-[#8C7E74] dark:text-[#a89f91]">
          <a href="https://github.com/ozdil" target="_blank" rel="noopener noreferrer" class="hover:underline">
            github ↗
          </a>
          <a href="#top" class="hover:underline text-[#e1734b]">
            başa dön ↑
          </a>
        </div>
      </div>

      <!-- Prev / Next Articles -->
      {(prevPost || nextPost) && (
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 pt-4 border-t border-[#ead9d2]/60 dark:border-[#2d2521]">
          {prevPost ? (
            <a
              href={`/blog/${prevPost.slug}`}
              class="p-5 rounded-2xl border border-[#ead9d2]/80 dark:border-[#2d2521] hover:border-[#5D524B]/30 bg-[#F5F0E4]/40 dark:bg-[#1c1815]/40 transition-all flex flex-col justify-between"
            >
              <span class="text-[10px] text-[#8C7E74] mb-1">
                ← Önceki Yazı
              </span>
              <span class="font-serif text-sm text-[#2d2724] dark:text-[#fef9ed] line-clamp-1">
                {prevPost.data.title}
              </span>
            </a>
          ) : (
            <div></div>
          )}

          {nextPost ? (
            <a
              href={`/blog/${nextPost.slug}`}
              class="p-5 rounded-2xl border border-[#ead9d2]/80 dark:border-[#2d2521] hover:border-[#5D524B]/30 bg-[#F5F0E4]/40 dark:bg-[#1c1815]/40 transition-all flex flex-col justify-between sm:text-right"
            >
              <span class="text-[10px] text-[#8C7E74] mb-1">
                Sonraki Yazı →
              </span>
              <span class="font-serif text-sm text-[#2d2724] dark:text-[#fef9ed] line-clamp-1">
                {nextPost.data.title}
              </span>
            </a>
          ) : (
            <div></div>
          )}
        </div>
      )}
    </footer>
  </article>
</BaseLayout>

<script is:inline>
  (function initArticleInteractions() {
    // 1. Reading Progress Bar
    const progressBar = document.getElementById('qs-read-progress-bar');
    if (progressBar) {
      window.addEventListener('scroll', () => {
        const scrollTop = window.scrollY || document.documentElement.scrollTop;
        const docHeight = document.documentElement.scrollHeight - document.documentElement.clientHeight;
        const progress = docHeight > 0 ? (scrollTop / docHeight) * 100 : 0;
        progressBar.style.width = Math.min(100, Math.max(0, progress)) + '%';
      }, { passive: true });
    }

    // 2. Copy Raw Markdown
    const copyMdBtn = document.getElementById('qs-copy-markdown-btn');
    const rawMdScript = document.getElementById('qs-raw-markdown');
    if (copyMdBtn && rawMdScript) {
      copyMdBtn.addEventListener('click', async () => {
        try {
          const rawText = JSON.parse(rawMdScript.textContent || '""');
          await navigator.clipboard.writeText(rawText);
          const orig = copyMdBtn.textContent;
          copyMdBtn.textContent = '✓ Kopyalandı!';
          setTimeout(() => {
            copyMdBtn.textContent = orig;
          }, 2000);
        } catch (err) {
          console.error('Kopyalama başarısız:', err);
        }
      });
    }

    // 3. Copy Link
    const copyBtn = document.getElementById('qs-copy-btn');
    const shareCopyBtn = document.getElementById('qs-share-copy-btn');
    const shareCopyText = document.getElementById('qs-share-copy-text');

    function handleCopyLink(btn, textElement) {
      if (!btn) return;
      btn.addEventListener('click', async () => {
        try {
          await navigator.clipboard.writeText(window.location.href);
          if (textElement) {
            const orig = textElement.textContent;
            textElement.textContent = '✓ Alındı!';
            setTimeout(() => {
              textElement.textContent = orig;
            }, 2000);
          } else {
            const orig = btn.textContent;
            btn.textContent = '✓ Kopyalandı!';
            setTimeout(() => {
              btn.textContent = orig;
            }, 2000);
          }
        } catch (err) {
          console.error('Bağlantı kopyalama başarısız:', err);
        }
      });
    }

    handleCopyLink(copyBtn, null);
    handleCopyLink(shareCopyBtn, shareCopyText);

    // 4. Live Article View Counter
    const viewsBadge = document.getElementById('qs-views-badge');
    const viewsCount = document.getElementById('qs-views-count');
    if (viewsBadge && viewsCount) {
      const slug = viewsBadge.getAttribute('data-slug');
      if (slug) {
        const sessionKey = 'viewed_' + slug;
        const hasViewed = typeof sessionStorage !== 'undefined' && sessionStorage.getItem(sessionKey);
        const method = hasViewed ? 'GET' : 'POST';
        const endpoint = method === 'GET' ? '/api/views?slug=' + encodeURIComponent(slug) : '/api/views';
        const fetchOpts = method === 'GET'
          ? { method: 'GET' }
          : {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({ slug }),
            };

        fetch(endpoint, fetchOpts)
          .then((res) => res.json())
          .then((data) => {
            if (data && typeof data.views === 'number') {
              viewsCount.textContent = data.views.toLocaleString('tr-TR');
              if (method === 'POST' && typeof sessionStorage !== 'undefined') {
                sessionStorage.setItem(sessionKey, '1');
              }
            }
          })
          .catch(() => {
            // Silently ignore if API unavailable
          });
      }
    }
  })();
</script>
