---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

export async function getStaticPaths() {
  const posts = await getCollection('blog', ({ data }) => !data.draft);
  const sorted = posts.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
  return sorted.map((post, index) => ({
    params: { slug: post.slug },
    props: {
      post,
      prevPost: sorted[index + 1] || null,
      nextPost: sorted[index - 1] || null,
      currentIndex: sorted.length - index,
      totalPosts: sorted.length,
    },
  }));
}

const { post, prevPost, nextPost, currentIndex, totalPosts } = Astro.props;
const { Content } = await post.render();

const wordCount = post.body ? post.body.split(/\s+/).filter(Boolean).length : 0;
const readingTime = Math.max(1, Math.ceil(wordCount / 180));
const lineEstimate = post.body ? post.body.split('\n').length : 0;
---

<BaseLayout
  title={`${post.data.title} — Ozan Özdil`}
  description={post.data.description}
  image={post.data.heroImage || '/avatar.jpg'}
  currentPath="/blog"
  type="article"
  maxWidthClass="max-w-4xl"
  article={{
    pubDate: post.data.pubDate,
    updatedDate: post.data.updatedDate,
    tags: post.data.tags,
  }}
>
  <!-- Top Reading Progress Indicator (Sticky) -->
  <div id="qs-read-progress-bar" class="fixed top-14 sm:top-15 left-0 h-[2px] bg-gradient-to-r from-sky-500 via-[#00ffcc] to-emerald-400 z-50 transition-all duration-75 w-0 pointer-events-none"></div>

  <div class="space-y-6 pt-1">
    <!-- QuickShell Master Document Window -->
    <article class="qs-window">
      <!-- QuickShell Document Buffer Bar -->
      <div class="qs-titlebar">
        <div class="flex items-center gap-2 overflow-hidden mr-2">
          <span class="text-sky-600 dark:text-[#00ffcc] font-semibold text-[11px] select-none flex-shrink-0">[buffer]</span>
          <span class="text-zinc-300 dark:text-zinc-700">/</span>
          <a
            href="/blog"
            class="hover:text-zinc-950 dark:hover:text-[#00ffcc] transition-colors flex items-center gap-1 text-zinc-500 dark:text-zinc-400 flex-shrink-0"
            title="Dizine Dön"
          >
            <span>~/blog</span>
          </a>
          <span class="text-zinc-300 dark:text-zinc-700">/</span>
          <span class="text-zinc-800 dark:text-zinc-200 font-semibold truncate">{post.slug}.md</span>
        </div>

        <div class="flex items-center gap-2 text-[11px] text-zinc-400 dark:text-zinc-500 flex-shrink-0 font-mono">
          <span class="px-1.5 py-0.5 rounded bg-zinc-200/60 dark:bg-zinc-800 text-zinc-600 dark:text-zinc-300 text-[10px]">
            BUF: {currentIndex}/{totalPosts}
          </span>
          <span class="px-1.5 py-0.5 rounded bg-zinc-200/60 dark:bg-zinc-800 text-[10px] text-zinc-600 dark:text-zinc-300 uppercase tracking-wider font-mono">RO</span>
          <span class="text-zinc-300 dark:text-zinc-700">|</span>
          <span class="text-zinc-400 dark:text-zinc-500 text-[10px] font-mono uppercase">UTF-8</span>
        </div>
      </div>

      <!-- QuickShell Document Telemetry Bar -->
      <div class="px-4 sm:px-6 py-2.5 bg-zinc-100/70 dark:bg-[#12161f] border-b border-zinc-200/80 dark:border-zinc-800/80 font-mono text-[11px] flex flex-wrap items-center justify-between gap-2 text-zinc-500 dark:text-zinc-400">
        <div class="flex flex-wrap items-center gap-3">
          <span class="inline-flex items-center gap-1.5 text-emerald-600 dark:text-emerald-400 font-semibold">
            <span class="w-1.5 h-1.5 rounded-full bg-emerald-500 animate-pulse"></span>
            <span>PUBLISHED</span>
          </span>
          <span>•</span>
          <span>LINES: ~{lineEstimate}</span>
          <span>•</span>
          <span>WORDS: ~{wordCount}</span>
          <span>•</span>
          <span>OKUMA: ~{readingTime} DK</span>
          <span>•</span>
          <span>UTF-8</span>
        </div>

        <!-- Quick Shell Actions -->
        <div class="flex items-center gap-1.5">
          <button
            id="qs-copy-btn"
            type="button"
            class="px-2 py-0.5 rounded border border-zinc-300/80 dark:border-zinc-700 bg-white dark:bg-[#151922] hover:text-zinc-900 dark:hover:text-[#00ffcc] hover:border-sky-500 dark:hover:border-[#00ffcc] transition-all cursor-pointer text-[10px]"
            title="Yazı Bağlantısını Kopyala"
          >
            [bağlantı kopyala]
          </button>
          <a
            href="/blog"
            class="px-2 py-0.5 rounded border border-zinc-300/80 dark:border-zinc-700 bg-white dark:bg-[#151922] hover:text-zinc-900 dark:hover:text-[#00ffcc] hover:border-sky-500 dark:hover:border-[#00ffcc] transition-all text-[10px]"
          >
            [arşiv]
          </a>
        </div>
      </div>

      <!-- Article Header Inside QuickShell Buffer -->
      <header class="p-6 sm:p-8 border-b border-zinc-200/80 dark:border-zinc-800/80 bg-zinc-50/40 dark:bg-[#0d1017]">
        <div class="flex flex-wrap items-center gap-2 sm:gap-3 text-xs font-mono text-zinc-500 dark:text-zinc-400 mb-3 pb-3 border-b border-zinc-200/60 dark:border-zinc-800/60 text-[11px]">
          <time datetime={post.data.pubDate.toISOString()}>
            TARİH: {post.data.pubDate.toLocaleDateString('tr-TR', { day: 'numeric', month: 'long', year: 'numeric' })}
          </time>
          <span>•</span>
          <span>YAZAR: Ozan Özdil</span>
          {post.data.updatedDate && (
            <>
              <span>•</span>
              <span class="text-zinc-400 dark:text-zinc-500">
                REV: {post.data.updatedDate.toLocaleDateString('tr-TR', { day: 'numeric', month: 'short', year: 'numeric' })}
              </span>
            </>
          )}
        </div>

        <h1 class="text-2xl sm:text-3xl lg:text-4xl font-bold tracking-tight text-zinc-950 dark:text-zinc-50 leading-[1.25] mb-4 font-sans">
          {post.data.title}
        </h1>

        {post.data.description && (
          <p class="text-sm sm:text-base text-zinc-600 dark:text-zinc-300 leading-relaxed font-normal mb-5 font-sans">
            {post.data.description}
          </p>
        )}

        {post.data.tags.length > 0 && (
          <div class="flex flex-wrap gap-1.5 font-mono text-xs">
            {post.data.tags.map((tag) => (
              <span class="px-2 py-0.5 rounded bg-zinc-200/70 dark:bg-zinc-800/80 text-zinc-700 dark:text-zinc-300 border border-zinc-300/80 dark:border-zinc-700/80 text-[10px]">
                --{tag}
              </span>
            ))}
          </div>
        )}
      </header>

      <!-- Rendered Markdown Body -->
      <div class="p-6 sm:p-10 markdown-body leading-relaxed">
        <Content />
      </div>

      <!-- QuickShell Document Pager (Prev / Next Buffer) -->
      <div class="p-4 sm:p-5 border-t border-zinc-200/80 dark:border-zinc-800/80 bg-zinc-50/50 dark:bg-[#0d1017] font-mono text-xs">
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
          {prevPost ? (
            <a
              href={`/blog/${prevPost.slug}`}
              class="p-3 rounded border border-zinc-200/80 dark:border-zinc-800 hover:border-sky-500 dark:hover:border-[#00ffcc]/60 bg-white dark:bg-[#12161f] transition-all group flex flex-col justify-between"
            >
              <span class="text-[10px] text-zinc-400 dark:text-zinc-500 mb-1 flex items-center gap-1">
                <span>← BUFFER PREV</span>
              </span>
              <span class="font-sans font-medium text-xs text-zinc-900 dark:text-zinc-100 group-hover:text-sky-600 dark:group-hover:text-[#00ffcc] transition-colors line-clamp-1">
                {prevPost.data.title}
              </span>
            </a>
          ) : (
            <div class="p-3 rounded border border-dashed border-zinc-200 dark:border-zinc-800/60 opacity-40 text-center text-[10px] text-zinc-400 flex items-center justify-center font-mono">
              [EOF: Son Doküman]
            </div>
          )}

          {nextPost ? (
            <a
              href={`/blog/${nextPost.slug}`}
              class="p-3 rounded border border-zinc-200/80 dark:border-zinc-800 hover:border-sky-500 dark:hover:border-[#00ffcc]/60 bg-white dark:bg-[#12161f] transition-all group flex flex-col justify-between sm:text-right"
            >
              <span class="text-[10px] text-zinc-400 dark:text-zinc-500 mb-1 flex items-center justify-start sm:justify-end gap-1">
                <span>BUFFER NEXT →</span>
              </span>
              <span class="font-sans font-medium text-xs text-zinc-900 dark:text-zinc-100 group-hover:text-sky-600 dark:group-hover:text-[#00ffcc] transition-colors line-clamp-1">
                {nextPost.data.title}
              </span>
            </a>
          ) : (
            <div class="p-3 rounded border border-dashed border-zinc-200 dark:border-zinc-800/60 opacity-40 text-center text-[10px] text-zinc-400 flex items-center justify-center font-mono">
              [BOF: İlk Doküman]
            </div>
          )}
        </div>
      </div>

      <!-- QuickShell Window Statusline -->
      <footer class="px-4 sm:px-6 py-2 bg-zinc-100 dark:bg-[#0a0d12] border-t border-zinc-200/80 dark:border-zinc-800/80 font-mono text-[11px] flex flex-wrap items-center justify-between gap-2 text-zinc-500 dark:text-zinc-400">
        <div class="flex items-center gap-2">
          <span class="px-1.5 py-0.5 rounded bg-zinc-900 text-white dark:bg-[#00ffcc] dark:text-black font-bold text-[10px]">
            NORMAL
          </span>
          <span class="text-zinc-400 dark:text-zinc-500">|</span>
          <span class="text-zinc-800 dark:text-zinc-200">{post.slug}.md</span>
          <span class="text-zinc-400 dark:text-zinc-500">|</span>
          <span id="qs-read-pct" class="text-sky-600 dark:text-[#00ffcc] font-bold">0%</span>
        </div>

        <div class="flex items-center gap-3 text-[11px]">
          <a
            href="https://nsosyal.com/ozanozdil"
            target="_blank"
            rel="noopener noreferrer"
            class="hover:text-zinc-900 dark:hover:text-[#00ffcc] transition-colors"
          >
            [nsosyal]
          </a>
          <a
            href="https://github.com/ozdil"
            target="_blank"
            rel="noopener noreferrer"
            class="hover:text-zinc-900 dark:hover:text-[#00ffcc] transition-colors"
          >
            [github]
          </a>
          <a
            href="#top"
            class="hover:text-sky-600 dark:hover:text-[#00ffcc] transition-colors"
          >
            [top ↑]
          </a>
        </div>
      </footer>
    </article>
  </div>
</BaseLayout>

<script is:inline>
  // Reading Progress Bar
  function updateReadingProgress() {
    const bar = document.getElementById('qs-read-progress-bar');
    if (!bar) return;
    const scrollTop = window.scrollY || document.documentElement.scrollTop;
    const docHeight = document.documentElement.scrollHeight - document.documentElement.clientHeight;
    if (docHeight > 0) {
      const progress = Math.min(100, Math.max(0, (scrollTop / docHeight) * 100));
      bar.style.width = progress + '%';
      const pctEl = document.getElementById('qs-read-pct');
      if (pctEl) {
        pctEl.textContent = Math.round(progress) + '%';
      }
    }
  }
  window.addEventListener('scroll', updateReadingProgress, { passive: true });
  updateReadingProgress();

  // Copy Link Action
  const copyBtn = document.getElementById('qs-copy-btn');
  if (copyBtn) {
    copyBtn.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(window.location.href);
        const orig = copyBtn.textContent;
        copyBtn.textContent = '[kopyalandı!]';
        copyBtn.classList.add('text-emerald-500');
        setTimeout(() => {
          copyBtn.textContent = orig;
          copyBtn.classList.remove('text-emerald-500');
        }, 2000);
      } catch (e) {
        console.error('Kopyalama hatası:', e);
      }
    });
  }
</script>
