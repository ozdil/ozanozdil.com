---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Ozan Özdil"
  description="Ozan Özdil: YZ Kodcusu ve Orman Mühendisi. Linux, açık kaynak sistem mimarisi, Omarchy, QuickShell ve orta format fotoğrafçılık."
  currentPath="/"
  maxWidthClass="max-w-[1720px]"
>
  <div class="space-y-6 py-2 sm:py-4">
    
    <!-- HERO / IDENTITY CARD — STRICT 2-COLOR SHELL MINIMALISM -->
    <section class="rounded-xl border border-zinc-200 dark:border-zinc-800 bg-white dark:bg-[#0c0e12] p-5 sm:p-7 lg:p-8 transition-colors" aria-label="Profil ve Kimlik">
      <!-- Minimal Shell Line Header -->
      <div class="flex items-center justify-between pb-4 mb-6 border-b border-zinc-100 dark:border-zinc-800 font-mono text-[11px] text-zinc-400 dark:text-zinc-500">
        <span class="text-zinc-600 dark:text-zinc-400 font-medium">// ozanozdil.com</span>
        <span class="flex items-center gap-1.5 text-zinc-700 dark:text-[#00ffcc] font-medium">
          <span class="w-2 h-2 rounded-full bg-zinc-900 dark:bg-[#00ffcc]"></span>
          <span>online</span>
        </span>
      </div>

      <div class="flex flex-col lg:flex-row lg:items-center justify-between gap-6">
        <!-- Identity -->
        <div class="flex flex-col sm:flex-row items-start sm:items-center gap-5">
          <div class="relative w-20 h-20 sm:w-24 sm:h-24 rounded-xl overflow-hidden border border-zinc-200 dark:border-zinc-700 flex-shrink-0 bg-zinc-100 dark:bg-zinc-800 p-0.5">
            <img
              src="/avatar.webp"
              alt="Ozan Özdil"
              width="96"
              height="96"
              fetchpriority="high"
              decoding="async"
              class="w-full h-full object-cover rounded-lg"
            />
            <span class="absolute bottom-1 right-1 w-3 h-3 rounded-full bg-zinc-900 dark:bg-[#00ffcc] border-2 border-white dark:border-[#0c0e12]"></span>
          </div>

          <div class="space-y-2">
            <div class="flex flex-wrap items-center gap-2">
              <span class="font-mono text-xs font-semibold text-zinc-900 dark:text-[#00ffcc] uppercase tracking-wider">
                YZ Kodcusu & Orman Mühendisi
              </span>
              <span class="text-zinc-300 dark:text-zinc-700 text-xs hidden sm:inline">•</span>
              <span class="font-mono text-xs text-zinc-500 dark:text-zinc-400 hidden sm:inline">
                KTÜ Orman
              </span>
            </div>

            <h1 class="text-2xl sm:text-3xl lg:text-4xl font-bold tracking-tight text-zinc-950 dark:text-zinc-50 font-sans">
              Ozan Özdil
            </h1>

            <p class="text-sm sm:text-base text-zinc-600 dark:text-zinc-300 leading-relaxed font-sans max-w-2xl">
              Linux, Omarchy, QuickShell, Açık Kaynak Sistem Mimarisi ve Orta Format Fotoğrafçılık.
            </p>

            <!-- Minimal Unified Badges (Monochrome + Accent) -->
            <div class="flex flex-wrap items-center gap-1.5 pt-1 font-mono text-[11px]">
              <span class="px-2 py-0.5 rounded border border-zinc-200 dark:border-zinc-800 text-zinc-700 dark:text-zinc-300 bg-zinc-50 dark:bg-zinc-900/40">
                Kastamonu, TR
              </span>
              <span class="px-2 py-0.5 rounded border border-zinc-200 dark:border-zinc-800 text-zinc-900 dark:text-[#00ffcc] bg-zinc-50 dark:bg-zinc-900/40 font-medium">
                YZ Kodcusu
              </span>
              <span class="px-2 py-0.5 rounded border border-zinc-200 dark:border-zinc-800 text-zinc-700 dark:text-zinc-300 bg-zinc-50 dark:bg-zinc-900/40">
                KTÜ Orman
              </span>
              <span class="px-2 py-0.5 rounded border border-zinc-200 dark:border-zinc-800 text-zinc-700 dark:text-zinc-300 bg-zinc-50 dark:bg-zinc-900/40">
                QuickShell & Wayland
              </span>
            </div>
          </div>
        </div>

        <!-- Telemetry Strip (Monochrome + Accent) -->
        <div class="font-mono text-xs rounded-lg p-4 border border-zinc-200 dark:border-zinc-800 bg-zinc-50/60 dark:bg-[#101319]/80 min-w-[280px] sm:min-w-[300px] space-y-2">
          <div class="text-[11px] font-semibold text-zinc-400 uppercase tracking-wider pb-1.5 border-b border-zinc-200/80 dark:border-zinc-800">
            Sistem Telemetrisi
          </div>
          <div class="space-y-1.5 text-[11px]">
            <div class="flex justify-between gap-2">
              <span class="text-zinc-500">İşletim Sistemi:</span>
              <span class="text-zinc-800 dark:text-zinc-200 font-medium">Arch Linux // Hyprland</span>
            </div>
            <div class="flex justify-between gap-2">
              <span class="text-zinc-500">Masaüstü Kabuğu:</span>
              <span class="text-zinc-900 dark:text-[#00ffcc] font-medium">QuickShell (C++/QML)</span>
            </div>
            <div class="flex justify-between gap-2">
              <span class="text-zinc-500">Optik Gövde:</span>
              <span class="text-zinc-800 dark:text-zinc-200 font-medium">Fujifilm GFX Orta Format</span>
            </div>
            <div class="flex justify-between gap-2">
              <span class="text-zinc-500">Tema Felsefesi:</span>
              <span class="text-zinc-800 dark:text-zinc-200 font-medium">OLED Black #000000</span>
            </div>
          </div>
        </div>
      </div>

      <!-- Quick Action Navigation -->
      <div class="mt-6 pt-5 border-t border-zinc-100 dark:border-zinc-800 flex flex-wrap items-center gap-2 font-mono text-xs">
        <a
          href="/blog"
          class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg border border-zinc-300 dark:border-zinc-700 bg-zinc-100 dark:bg-zinc-800 text-zinc-900 dark:text-[#00ffcc] hover:bg-zinc-200 dark:hover:bg-zinc-700 font-medium transition-colors"
        >
          <span>Yazılar</span>
          <span class="text-xs">→</span>
        </a>

        <a
          href="/galeri"
          class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg border border-zinc-300 dark:border-zinc-700 bg-zinc-100 dark:bg-zinc-800 text-zinc-900 dark:text-zinc-200 hover:bg-zinc-200 dark:hover:bg-zinc-700 font-medium transition-colors"
        >
          <span>Fotoğraf Galerisi</span>
          <span class="text-xs">→</span>
        </a>

        <a
          href="/projeler"
          class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg border border-zinc-300 dark:border-zinc-700 bg-zinc-100 dark:bg-zinc-800 text-zinc-900 dark:text-zinc-200 hover:bg-zinc-200 dark:hover:bg-zinc-700 font-medium transition-colors"
        >
          <span>Açık Kaynak Projeler</span>
          <span class="text-xs">→</span>
        </a>
      </div>
    </section>

    <!-- 12-COLUMN DASHBOARD GRID -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-6 items-start">
      
      <!-- LEFT / MAIN CONTENT AREA (8 Cols on Desktop) -->
      <div class="lg:col-span-8 space-y-6">
        
        <!-- BIOGRAPHY & FORMATION -->
        <section class="rounded-xl border border-zinc-200 dark:border-zinc-800 bg-white dark:bg-[#0c0e12] p-5 sm:p-6" aria-label="Biyografi ve Mimariler">
          <div class="flex items-center justify-between pb-3 mb-5 border-b border-zinc-100 dark:border-zinc-800 font-mono text-xs">
            <span class="text-zinc-700 dark:text-zinc-300 font-semibold tracking-wider uppercase">
              // 01_Biyografi_ve_Formasyon
            </span>
            <span class="text-zinc-400 text-[11px]">4 Modül</span>
          </div>

          <!-- Items Stack: Unified 2-Color Borders & Surfaces -->
          <div class="space-y-4">
            
            <!-- Item 1: AcademicFormation -->
            <article class="p-4 sm:p-5 rounded-lg border border-zinc-200 dark:border-zinc-800 bg-zinc-50/50 dark:bg-[#101319]/50 space-y-2">
              <div class="flex items-center justify-between font-mono text-xs pb-2 border-b border-zinc-100 dark:border-zinc-800">
                <span class="text-zinc-900 dark:text-[#00ffcc] font-semibold">[01] KTÜ Orman Fakültesi</span>
                <span class="text-zinc-400 text-[11px]">Orman Mühendisliği</span>
              </div>
              <p class="font-sans text-sm sm:text-base text-zinc-700 dark:text-zinc-300 leading-relaxed">
                Karadeniz Teknik Üniversitesi Orman Fakültesi mezunuyum. Orman mühendisliği formasyonunun kazandırdığı ekosistem dinamikleri ve analitik bakış açısı, teknolojiye ve yazılım dünyasına yaklaşımımın da temelini oluşturuyor.
              </p>
            </article>

            <!-- Item 2: ExecutiveExperience -->
            <article class="p-4 sm:p-5 rounded-lg border border-zinc-200 dark:border-zinc-800 bg-zinc-50/50 dark:bg-[#101319]/50 space-y-2">
              <div class="flex items-center justify-between font-mono text-xs pb-2 border-b border-zinc-100 dark:border-zinc-800">
                <span class="text-zinc-900 dark:text-[#00ffcc] font-semibold">[02] Kamu Yönetimi & Bilişim</span>
                <span class="text-zinc-400 text-[11px]">Yönetim & Koordinasyon</span>
              </div>
              <p class="font-sans text-sm sm:text-base text-zinc-700 dark:text-zinc-300 leading-relaxed">
                Kamu yönetimi, kurumsal iletişim ve yerel yönetim süreçlerinde görev aldım. Belediye başkan danışmanlığı ile Ar-Ge ve Bilgi İşlem yöneticiliği görevlerinde bulundum; dijital iletişim süreçleri, kriz yönetimi ve kurumsal bilişim altyapılarını koordine ettim.
              </p>
            </article>

            <!-- Item 3: SystemArchitecture (YZ Kodcusu) -->
            <article class="p-4 sm:p-5 rounded-lg border border-zinc-200 dark:border-zinc-800 bg-zinc-50/50 dark:bg-[#101319]/50 space-y-2">
              <div class="flex items-center justify-between font-mono text-xs pb-2 border-b border-zinc-100 dark:border-zinc-800">
                <span class="text-zinc-900 dark:text-[#00ffcc] font-semibold">[03] YZ Kodcusu // Omarchy & Wayland</span>
                <span class="text-zinc-400 text-[11px]">Sistem Mimarisi</span>
              </div>
              <p class="font-sans text-sm sm:text-base text-zinc-700 dark:text-zinc-300 leading-relaxed">
                Kendimi klasik bir yazılımcıdan ziyade yapay zeka ile kod üreten ve sistem inşa eden bir <strong>YZ Kodcusu</strong> olarak konumlandırıyorum. Açık kaynak ekosisteminde Arch Linux tabanlı kişisel masaüstü yapılandırmam (<a href="https://github.com/ozdil/omarchy" target="_blank" rel="noopener noreferrer" class="text-zinc-900 dark:text-[#00ffcc] font-medium underline underline-offset-4 hover:opacity-80">Omarchy</a>), C++/QML tabanlı QuickShell bileşenleri, Wayland katman protokolleri ve güvenlik araçlarını yapay zeka güdümlü modern mühendislik iş akışlarıyla hayata geçiriyorum.
              </p>
              <div class="pt-2 font-mono text-xs">
                <a
                  href="https://github.com/ozdil/omarchy"
                  target="_blank"
                  rel="noopener noreferrer"
                  class="inline-flex items-center gap-1 text-zinc-800 dark:text-[#00ffcc] hover:underline"
                >
                  <span>github.com/ozdil/omarchy</span>
                  <span>↗</span>
                </a>
              </div>
            </article>

            <!-- Item 4: LinuxGamingTelemetry -->
            <article class="p-4 sm:p-5 rounded-lg border border-zinc-200 dark:border-zinc-800 bg-zinc-50/50 dark:bg-[#101319]/50 space-y-2">
              <div class="flex items-center justify-between font-mono text-xs pb-2 border-b border-zinc-100 dark:border-zinc-800">
                <span class="text-zinc-900 dark:text-[#00ffcc] font-semibold">[04] Linux Oyun & Telemetri</span>
                <span class="text-zinc-400 text-[11px]">Wayland + Proton</span>
              </div>
              <p class="font-sans text-sm sm:text-base text-zinc-700 dark:text-zinc-300 leading-relaxed">
                Aynı zamanda bir Linux oyuncusu olarak Wayland ve Proton üzerinde düşük gecikmeli oyun deneyimi, simülasyon konfigürasyonları ve kare süresi (frametime) telemetrisi üzerine çalışıyorum.
              </p>
              <div class="pt-2 font-mono text-xs">
                <a
                  href="https://steamcommunity.com/id/ozanozdil"
                  target="_blank"
                  rel="noopener noreferrer"
                  class="inline-flex items-center gap-1 text-zinc-800 dark:text-[#00ffcc] hover:underline"
                >
                  <span>steamcommunity.com/id/ozanozdil</span>
                  <span>↗</span>
                </a>
              </div>
            </article>

          </div>
        </section>

        <!-- CORE FOCUS MODULES -->
        <section class="rounded-xl border border-zinc-200 dark:border-zinc-800 bg-white dark:bg-[#0c0e12] p-5 sm:p-6" aria-label="Odak Alanları">
          <div class="flex items-center justify-between pb-3 mb-5 border-b border-zinc-100 dark:border-zinc-800 font-mono text-xs">
            <span class="text-zinc-700 dark:text-zinc-300 font-semibold tracking-wider uppercase">
              // 02_Odak_Alanları
            </span>
            <span class="text-zinc-400 text-[11px]">4 Alan</span>
          </div>

          <div class="grid grid-cols-1 md:grid-cols-2 gap-4 font-mono text-xs">
            
            <!-- Area 1 -->
            <article class="p-4 rounded-lg border border-zinc-200 dark:border-zinc-800 bg-zinc-50/50 dark:bg-[#101319]/50 flex flex-col justify-between gap-3">
              <div class="space-y-1.5">
                <span class="text-[10px] text-zinc-400 uppercase tracking-wider block">Protokol & Kabuk</span>
                <h3 class="text-sm font-bold text-zinc-950 dark:text-zinc-100 font-sans">
                  Wayland & QuickShell
                </h3>
                <p class="text-xs text-zinc-600 dark:text-zinc-400 font-sans leading-relaxed">
                  Wayland katman kabuğu (layer-shell), Qt/QML tabanlı reaktif masaüstü widget'ları ve IPC mimarisi.
                </p>
              </div>
              <a href="/blog" class="text-zinc-900 dark:text-[#00ffcc] font-medium hover:underline text-[11px] pt-1">
                Yazıları İncele →
              </a>
            </article>

            <!-- Area 2 -->
            <article class="p-4 rounded-lg border border-zinc-200 dark:border-zinc-800 bg-zinc-50/50 dark:bg-[#101319]/50 flex flex-col justify-between gap-3">
              <div class="space-y-1.5">
                <span class="text-[10px] text-zinc-400 uppercase tracking-wider block">Güvenlik & Sertleştirme</span>
                <h3 class="text-sm font-bold text-zinc-950 dark:text-zinc-100 font-sans">
                  Omarchy & Siber Güvenlik
                </h3>
                <p class="text-xs text-zinc-600 dark:text-zinc-400 font-sans leading-relaxed">
                  Sistem sertleştirme, ağ anomalisi tespiti, USB kalkanı ve CVE güvenlik denetleyicileri.
                </p>
              </div>
              <a href="/projeler" class="text-zinc-900 dark:text-[#00ffcc] font-medium hover:underline text-[11px] pt-1">
                Projeleri İncele →
              </a>
            </article>

            <!-- Area 3 -->
            <article class="p-4 rounded-lg border border-zinc-200 dark:border-zinc-800 bg-zinc-50/50 dark:bg-[#101319]/50 flex flex-col justify-between gap-3">
              <div class="space-y-1.5">
                <span class="text-[10px] text-zinc-400 uppercase tracking-wider block">Görsel Arşiv</span>
                <h3 class="text-sm font-bold text-zinc-950 dark:text-zinc-100 font-sans">
                  Fujifilm GFX Fotoğrafçılık
                </h3>
                <p class="text-xs text-zinc-600 dark:text-zinc-400 font-sans leading-relaxed">
                  43.8×32.9mm orta format sensör, Kastamonu tarihi ahşap mimarisi, Ağlı Kalesi ve kadim coğrafi rotalar.
                </p>
              </div>
              <a href="/galeri" class="text-zinc-900 dark:text-[#00ffcc] font-medium hover:underline text-[11px] pt-1">
                Galeriye Git →
              </a>
            </article>

            <!-- Area 4 -->
            <article class="p-4 rounded-lg border border-zinc-200 dark:border-zinc-800 bg-zinc-50/50 dark:bg-[#101319]/50 flex flex-col justify-between gap-3">
              <div class="space-y-1.5">
                <span class="text-[10px] text-zinc-400 uppercase tracking-wider block">Oyun & Simülasyon</span>
                <h3 class="text-sm font-bold text-zinc-950 dark:text-zinc-100 font-sans">
                  Linux Oyun & Proton
                </h3>
                <p class="text-xs text-zinc-600 dark:text-zinc-400 font-sans leading-relaxed">
                  Wayland altında düşük gecikmeli render, simülasyon donanımları, MangoHud ve Proton optimizasyonları.
                </p>
              </div>
              <a href="https://steamcommunity.com/id/ozanozdil" target="_blank" rel="noopener noreferrer" class="text-zinc-900 dark:text-[#00ffcc] font-medium hover:underline text-[11px] pt-1">
                Steam Profili ↗
              </a>
            </article>

          </div>
        </section>

      </div>

      <!-- RIGHT / SIDEBAR AREA (4 Cols on Desktop) -->
      <aside class="lg:col-span-4 space-y-6">
        
        <!-- TIMELINE COMPONENT (2-Color Track) -->
        <section class="rounded-xl border border-zinc-200 dark:border-zinc-800 bg-white dark:bg-[#0c0e12] p-5" aria-label="Zaman Çizelgesi">
          <div class="flex items-center justify-between pb-3 mb-5 border-b border-zinc-100 dark:border-zinc-800 font-mono text-xs">
            <span class="text-zinc-700 dark:text-zinc-300 font-semibold tracking-wider uppercase">
              // 03_Kariyer_Çizelgesi
            </span>
          </div>

          <div class="space-y-4 font-mono text-xs">
            <!-- Stage 1 -->
            <div class="relative pl-5 pb-4 border-l border-zinc-300 dark:border-zinc-700">
              <span class="absolute -left-[4px] top-0 w-2 h-2 rounded-full bg-zinc-900 dark:bg-[#00ffcc]"></span>
              <div class="space-y-1">
                <div class="text-[11px] text-zinc-900 dark:text-[#00ffcc] font-semibold">
                  2024 - Günümüz
                </div>
                <h4 class="font-sans font-bold text-zinc-900 dark:text-zinc-100 text-xs">
                  Ar-Ge, Bilgi İşlem & YZ Kodlama
                </h4>
                <p class="font-sans text-zinc-600 dark:text-zinc-400 text-[11px] leading-relaxed">
                  Kurumsal bilişim altyapıları, Wayland kabuk mimarisi ve açık kaynak sistem geliştirme.
                </p>
              </div>
            </div>

            <!-- Stage 2 -->
            <div class="relative pl-5 pb-4 border-l border-zinc-300 dark:border-zinc-700">
              <span class="absolute -left-[4px] top-0 w-2 h-2 rounded-full bg-zinc-400 dark:bg-zinc-600"></span>
              <div class="space-y-1">
                <div class="text-[11px] text-zinc-700 dark:text-zinc-300 font-semibold">
                  2019 - 2024
                </div>
                <h4 class="font-sans font-bold text-zinc-900 dark:text-zinc-100 text-xs">
                  Belediye Başkan Danışmanlığı
                </h4>
                <p class="font-sans text-zinc-600 dark:text-zinc-400 text-[11px] leading-relaxed">
                  Kamu yönetimi, kurumsal iletişim, kriz yönetimi ve dijital dönüşüm süreçleri koordinasyonu.
                </p>
              </div>
            </div>

            <!-- Stage 3 -->
            <div class="relative pl-5 pb-4 border-l border-zinc-300 dark:border-zinc-700">
              <span class="absolute -left-[4px] top-0 w-2 h-2 rounded-full bg-zinc-400 dark:bg-zinc-600"></span>
              <div class="space-y-1">
                <div class="text-[11px] text-zinc-700 dark:text-zinc-300 font-semibold">
                  2018 - 2019
                </div>
                <h4 class="font-sans font-bold text-zinc-900 dark:text-zinc-100 text-xs">
                  Orman Mühendisliği & CBS
                </h4>
                <p class="font-sans text-zinc-600 dark:text-zinc-400 text-[11px] leading-relaxed">
                  Orman amenajmanı, Coğrafi Bilgi Sistemleri (CBS) ve saha modellemeleri.
                </p>
              </div>
            </div>

            <!-- Stage 4 -->
            <div class="relative pl-5">
              <span class="absolute -left-[4px] top-0 w-2 h-2 rounded-full bg-zinc-400 dark:bg-zinc-600"></span>
              <div class="space-y-1">
                <div class="text-[11px] text-zinc-500 font-semibold">
                  2013 - 2018
                </div>
                <h4 class="font-sans font-bold text-zinc-900 dark:text-zinc-100 text-xs">
                  KTÜ Orman Fakültesi
                </h4>
                <p class="font-sans text-zinc-600 dark:text-zinc-400 text-[11px] leading-relaxed">
                  Karadeniz Teknik Üniversitesi — Orman Mühendisliği Lisans Eğitimi.
                </p>
              </div>
            </div>
          </div>
        </section>

        <!-- SYSTEM LAUNCHERS -->
        <section class="rounded-xl border border-zinc-200 dark:border-zinc-800 bg-white dark:bg-[#0c0e12] p-5" aria-label="Bağlantılar">
          <div class="flex items-center justify-between pb-3 mb-4 border-b border-zinc-100 dark:border-zinc-800 font-mono text-xs">
            <span class="text-zinc-700 dark:text-zinc-300 font-semibold tracking-wider uppercase">
              // 04_Bağlantılar
            </span>
          </div>

          <div class="space-y-2 font-mono text-xs">
            <a
              href="https://github.com/ozdil"
              target="_blank"
              rel="noopener noreferrer"
              class="flex items-center justify-between p-2.5 rounded-lg border border-zinc-200 dark:border-zinc-800 bg-zinc-50/50 dark:bg-[#101319]/50 hover:border-zinc-400 dark:hover:border-zinc-600 transition-colors group"
            >
              <span class="text-zinc-800 dark:text-zinc-200 font-medium">GitHub: @ozdil</span>
              <span class="text-zinc-400 group-hover:text-zinc-950 dark:group-hover:text-[#00ffcc] transition-colors">↗</span>
            </a>

            <a
              href="https://steamcommunity.com/id/ozanozdil"
              target="_blank"
              rel="noopener noreferrer"
              class="flex items-center justify-between p-2.5 rounded-lg border border-zinc-200 dark:border-zinc-800 bg-zinc-50/50 dark:bg-[#101319]/50 hover:border-zinc-400 dark:hover:border-zinc-600 transition-colors group"
            >
              <span class="text-zinc-800 dark:text-zinc-200 font-medium">Steam: ozanozdil</span>
              <span class="text-zinc-400 group-hover:text-zinc-950 dark:group-hover:text-[#00ffcc] transition-colors">↗</span>
            </a>

            <a
              href="https://nsosyal.com/ozanozdil"
              target="_blank"
              rel="noopener noreferrer"
