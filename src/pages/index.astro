---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const allPosts = await getCollection('blog', ({ data }) => !data.draft);
const sortedPosts = allPosts.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()).slice(0, 5);

const pinnedProjects = [
  {
    name: 'omarchy',
    desc: 'Arch Linux tabanlı, optimize edilmiş yüksek performanslı sistem ekosistemi ve mimari yapılandırma paketi.',
    lang: 'Shell',
    langColor: '#89e051',
    stars: 'Açık Kaynak',
    url: 'https://github.com/ozdil/omarchy'
  },
  {
    name: 'omarchy-cyber-sentinel',
    desc: 'Canlı ağ trafiği analizi, tehdit tespiti ve kurumsal düzeyde proaktif sistem savunma modülü.',
    lang: 'Python / Bash',
    langColor: '#3572A5',
    stars: 'Açık Kaynak',
    url: 'https://github.com/ozdil/omarchy-cyber-sentinel'
  },
  {
    name: 'omarchy-badusb-shield',
    desc: 'Donanımsal USB ve harici çevre birimi tabanlı saldırılara karşı dinamik yetkilendirme ve port kalkanı.',
    lang: 'Shell',
    langColor: '#89e051',
    stars: 'Açık Kaynak',
    url: 'https://github.com/ozdil/omarchy-badusb-shield'
  },
  {
    name: 'omarchy-cve-radar',
    desc: 'Linux sistem paketleri ve uygulama bağımlılıkları için gerçek zamanlı güvenlik açığı (CVE) denetim motoru.',
    lang: 'Python',
    langColor: '#3572A5',
    stars: 'Açık Kaynak',
    url: 'https://github.com/ozdil/omarchy-cve-radar'
  },
  {
    name: 'omarchy-omasend',
    desc: 'Yerel ağ üzerinde uçtan uca şifreli, yüksek hızlı p2p dosya ve veri aktarım protokolü (AirBridge).',
    lang: 'Go / Shell',
    langColor: '#00ADD8',
    stars: 'Açık Kaynak',
    url: 'https://github.com/ozdil/omarchy-omasend'
  },
  {
    name: 'omarchy-omarank',
    desc: 'Linux çekirdeği ve donanım bileşenleri için kapsamlı sentetik kıyaslama (benchmark) ve performans analiz paketi.',
    lang: 'Rust / C',
    langColor: '#dea584',
    stars: 'Açık Kaynak',
    url: 'https://github.com/ozdil/omarchy-omarank'
  }
];

const pillars = [
  {
    title: 'Strateji & Kamu Yönetimi',
    desc: 'Veri odaklı kampanya tasarımı, siyasal kitle iletişimi koordinasyonu, kriz yönetimi ve kurumsal dijital dönüşüm liderliği.',
    badge: 'Stratejik Yönetim',
    badgeColor: 'border-blue-500/20 text-blue-600 dark:text-blue-400 bg-blue-500/5'
  },
  {
    title: 'Linux Çekirdek & Sistem Mimarisi',
    desc: 'Arch Linux sistem optimizasyonları, Omarchy ekosistemi, Hyprland mimarisi ve yüksek performanslı çalışma ortamları.',
    badge: 'Sistem Mimarisi',
    badgeColor: 'border-emerald-500/20 text-emerald-600 dark:text-emerald-400 bg-emerald-500/5'
  },
  {
    title: 'Ağ Savunması & Donanım Güvenliği',
    desc: 'BadUSB kalkanları, canlı trafik denetimi, sızma tespit mekanizmaları, tuzak belirteçler ve siber egemenlik araçları.',
    badge: 'Siber Savunma',
    badgeColor: 'border-amber-500/20 text-amber-600 dark:text-amber-400 bg-amber-500/5'
  },
  {
    title: 'Yerel Yapay Zekâ & Edge Modeller',
    desc: 'Donanım sınırlarını zorlayan lokal LLM çıkarımları, yerel yazılım ajanları ve kurumsal veri mahremiyeti modelleri.',
    badge: 'Edge AI',
    badgeColor: 'border-purple-500/20 text-purple-600 dark:text-purple-400 bg-purple-500/5'
  }
];
---

<BaseLayout title="Ozan Özdil — Stratejist & Teknoloji Araştırmacısı" currentPath="/">
  <!-- HERO SECTION -->
  <section class="mb-16 sm:mb-20 pt-4 sm:pt-8">
    <div class="flex flex-col sm:flex-row items-start sm:items-center gap-5 mb-8">
      <div class="relative group">
        <div class="w-20 h-20 sm:w-24 sm:h-24 rounded-2xl overflow-hidden border border-zinc-200 dark:border-zinc-800 shadow-sm bg-zinc-100 dark:bg-zinc-800">
          <img src="/avatar.jpg" alt="Ozan Özdil" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300" />
        </div>
        <span class="absolute -bottom-1 -right-1 w-4 h-4 rounded-full bg-emerald-500 border-2 border-white dark:border-zinc-950" title="Aktif Ar-Ge Durumu"></span>
      </div>

      <div class="space-y-1">
        <div class="flex flex-wrap items-center gap-2">
          <h1 class="text-2xl sm:text-3xl font-bold tracking-tight text-zinc-950 dark:text-zinc-50">
            Ozan Özdil
          </h1>
          <span class="px-2.5 py-0.5 rounded-full text-xs font-mono text-zinc-500 dark:text-zinc-400 bg-zinc-100 dark:bg-zinc-800/80 border border-zinc-200/80 dark:border-zinc-800/80">
            @ozdil
          </span>
        </div>
        <p class="text-sm font-medium text-zinc-600 dark:text-zinc-400">
          Stratejist • Teknoloji & Sistem Araştırmacısı • Kastamonu, Türkiye
        </p>
      </div>
    </div>

    <!-- Impact Statement -->
    <h2 class="text-3xl sm:text-4xl lg:text-5xl font-bold tracking-tight text-zinc-950 dark:text-zinc-50 leading-[1.15] mb-6">
      Sistemik düşünce, açık kaynak mimarileri ve stratejik yönetimle değer üretimi.
    </h2>

    <p class="text-base sm:text-lg text-zinc-600 dark:text-zinc-400 leading-relaxed max-w-3xl mb-8">
      Karadeniz Teknik Üniversitesi Orman Fakültesi formasyonunun kazandırdığı analitik ve sistematik bakış açısıyla; kamu yönetiminde siyasal iletişim koordinatörlüğü, başkan danışmanlığı, kurumsal Ar-Ge ve Bilgi İşlem yöneticiliği süreçlerini yönettik. Günümüzde bağımsız Linux sistem mimarisi (Omarchy), ağ güvenliği ve yerel yapay zekâ entegrasyonlarıyla bağımsız çözümler geliştiriyoruz.
    </p>

    <!-- Action Buttons & Socials -->
    <div class="flex flex-wrap items-center gap-3 pt-2">
      <a
        href="/blog"
        class="inline-flex items-center space-x-2 px-5 py-2.5 rounded-xl bg-zinc-900 dark:bg-zinc-100 text-white dark:text-zinc-950 text-sm font-medium hover:opacity-90 transition-all shadow-xs"
      >
        <span>Yazıları Oku ({allPosts.length})</span>
        <svg class="w-4 h-4" viewBox="0 0 20 20" fill="currentColor">
          <path fill-rule="evenodd" d="M3 10a.75.75 0 0 1 .75-.75h10.638L10.23 5.29a.75.75 0 1 1 1.04-1.08l5.5 5.25a.75.75 0 0 1 0 1.08l-5.5 5.25a.75.75 0 1 1-1.04-1.08l4.158-3.96H3.75A.75.75 0 0 1 3 10Z" clip-rule="evenodd" />
        </svg>
      </a>

      <a
        href="/projeler"
        class="inline-flex items-center space-x-2 px-5 py-2.5 rounded-xl bg-zinc-100 dark:bg-zinc-900 border border-zinc-200/80 dark:border-zinc-800 text-zinc-900 dark:text-zinc-100 text-sm font-medium hover:bg-zinc-200/60 dark:hover:bg-zinc-800/80 transition-all"
      >
        <span>Projeler</span>
      </a>

      <a
        href="https://github.com/ozdil"
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center space-x-2 px-4 py-2.5 rounded-xl border border-zinc-200/80 dark:border-zinc-800 text-zinc-600 dark:text-zinc-400 text-sm hover:text-zinc-950 dark:hover:text-zinc-100 hover:bg-zinc-50 dark:hover:bg-zinc-900/40 transition-all"
      >
        <span>GitHub</span>
      </a>

      <a
        href="https://nsosyal.com/ozanozdil"
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center space-x-2 px-4 py-2.5 rounded-xl border border-zinc-200/80 dark:border-zinc-800 text-zinc-600 dark:text-zinc-400 text-sm hover:text-zinc-950 dark:hover:text-zinc-100 hover:bg-zinc-50 dark:hover:bg-zinc-900/40 transition-all"
      >
        <span>NSosyal</span>
      </a>
    </div>
  </section>

  <!-- STRATEGIC PILLARS BENTO GRID -->
  <section class="mb-16 sm:mb-20">
    <div class="flex items-center justify-between mb-6">
      <h3 class="text-xs font-semibold text-zinc-500 dark:text-zinc-400 uppercase tracking-widest font-mono">
        Uzmanlık Alanları & Çalışma Vizyonu
      </h3>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
      {pillars.map((pillar) => (
        <div class="p-6 rounded-2xl border border-zinc-200/80 dark:border-zinc-800/80 bg-white/70 dark:bg-zinc-900/50 backdrop-blur-xs hover:border-zinc-300 dark:hover:border-zinc-700 transition-all duration-200">
          <span class={`inline-block px-2.5 py-0.5 rounded-md text-[11px] font-mono border font-medium mb-3 ${pillar.badgeColor}`}>
            {pillar.badge}
          </span>
          <h4 class="text-base font-semibold text-zinc-950 dark:text-zinc-50 mb-2">
            {pillar.title}
          </h4>
          <p class="text-xs sm:text-sm text-zinc-600 dark:text-zinc-400 leading-relaxed font-normal">
            {pillar.desc}
          </p>
        </div>
      ))}
    </div>
  </section>

  <!-- FEATURED PROJECTS SECTION -->
  <section class="mb-16 sm:mb-20">
    <div class="flex items-center justify-between mb-6">
      <div>
        <h3 class="text-xs font-semibold text-zinc-500 dark:text-zinc-400 uppercase tracking-widest font-mono">
          Öne Çıkan Açık Kaynak Projeler
        </h3>
      </div>
      <a href="/projeler" class="text-xs font-medium text-blue-600 dark:text-blue-400 hover:underline inline-flex items-center gap-1">
        <span>Tüm Depolar ({pinnedProjects.length})</span>
        <span>→</span>
      </a>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
      {pinnedProjects.map((p) => (
        <a
          href={p.url}
          target="_blank"
          rel="noopener noreferrer"
          class="group p-5 rounded-2xl border border-zinc-200/80 dark:border-zinc-800/80 bg-white/70 dark:bg-zinc-900/50 hover:border-zinc-300 dark:hover:border-zinc-700 transition-all duration-200 hover:-translate-y-0.5 flex flex-col justify-between"
        >
          <div>
            <div class="flex items-center justify-between mb-2">
              <h4 class="text-sm font-semibold font-mono text-zinc-950 dark:text-zinc-50 group-hover:text-blue-600 dark:group-hover:text-blue-400 transition-colors truncate">
                {p.name}
              </h4>
              <span class="text-[10px] font-mono px-2 py-0.5 rounded-full border border-zinc-200 dark:border-zinc-800 text-zinc-500 dark:text-zinc-400 bg-zinc-50 dark:bg-zinc-950 flex-shrink-0">
                {p.stars}
              </span>
            </div>
            <p class="text-xs text-zinc-600 dark:text-zinc-400 line-clamp-2 mb-4 leading-relaxed font-normal">
              {p.desc}
            </p>
          </div>

          <div class="flex items-center space-x-2 text-[11px] font-mono text-zinc-500 dark:text-zinc-400 pt-3 border-t border-zinc-100 dark:border-zinc-800/60">
            <span class="w-2 h-2 rounded-full" style={`background-color: ${p.langColor}`}></span>
            <span>{p.lang}</span>
          </div>
        </a>
      ))}
    </div>
  </section>

  <!-- RECENT ARTICLES SECTION -->
  <section>
    <div class="flex items-center justify-between mb-6">
      <div>
        <h3 class="text-xs font-semibold text-zinc-500 dark:text-zinc-400 uppercase tracking-widest font-mono">
          Son Makaleler & Analizler
        </h3>
      </div>
      <a href="/blog" class="text-xs font-medium text-blue-600 dark:text-blue-400 hover:underline inline-flex items-center gap-1">
        <span>Tüm Arşiv ({allPosts.length})</span>
        <span>→</span>
      </a>
    </div>

    <div class="divide-y divide-zinc-200/80 dark:divide-zinc-800/80 border border-zinc-200/80 dark:border-zinc-800/80 rounded-2xl bg-white/70 dark:bg-zinc-900/50 overflow-hidden">
      {sortedPosts.map((post) => (
        <article class="p-5 sm:p-6 hover:bg-zinc-50/80 dark:hover:bg-zinc-800/30 transition-colors">
          <div class="flex flex-col sm:flex-row sm:items-baseline justify-between gap-1 mb-2">
            <h4 class="text-base font-semibold">
              <a href={`/blog/${post.slug}`} class="text-zinc-950 dark:text-zinc-50 hover:text-blue-600 dark:hover:text-blue-400 transition-colors">
                {post.data.title}
              </a>
            </h4>
            <time datetime={post.data.pubDate.toISOString()} class="text-xs font-mono text-zinc-500 dark:text-zinc-400 flex-shrink-0">
              {post.data.pubDate.toLocaleDateString('tr-TR', { day: 'numeric', month: 'short', year: 'numeric' })}
            </time>
          </div>
          <p class="text-xs sm:text-sm text-zinc-600 dark:text-zinc-400 line-clamp-2 leading-relaxed font-normal mb-3">
            {post.data.description}
          </p>
          {post.data.tags.length > 0 && (
            <div class="flex flex-wrap gap-1.5">
              {post.data.tags.slice(0, 3).map((tag) => (
                <span class="text-[10px] font-mono px-2 py-0.5 rounded-md bg-zinc-100 dark:bg-zinc-800 text-zinc-600 dark:text-zinc-400 border border-zinc-200/60 dark:border-zinc-700/60">
                  #{tag}
                </span>
              ))}
            </div>
          )}
        </article>
      ))}
    </div>
  </section>
</BaseLayout>

