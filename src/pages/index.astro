---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Ozan Özdil"
  description="Ozan Özdil: Orman Mühendisi. Linux, açık kaynak, sistem araçları, QuickShell ve orta format fotoğrafçılık."
  currentPath="/"
  maxWidthClass="max-w-[1720px]"
>
  <div class="space-y-6 py-2 sm:py-4" id="qs-desktop-root">
    
    <!-- MASTER QUICKSHELL DESKTOP CORE // ROOT SCOPE -->
    <section class="rounded-xl border border-zinc-200/90 dark:border-zinc-800/90 bg-white dark:bg-[#0c0e12] overflow-hidden shadow-2xs" aria-label="QuickShell Oturum Kapsamı">
      <!-- Titlebar -->
      <div class="px-4 py-2.5 bg-zinc-50 dark:bg-[#12151d] border-b border-zinc-100 dark:border-zinc-800/80 flex flex-wrap items-center justify-between gap-2 font-mono text-[11px]">
        <div class="flex items-center gap-2">
          <span class="flex items-center gap-1.5 opacity-80" aria-hidden="true">
            <span class="w-2 h-2 rounded-full bg-rose-500/80"></span>
            <span class="w-2 h-2 rounded-full bg-amber-500/80"></span>
            <span class="w-2 h-2 rounded-full bg-emerald-500/80"></span>
          </span>
          <span class="text-purple-600 dark:text-purple-400 font-bold">Scope</span>
          <span class="text-zinc-400 dark:text-zinc-600">&#123;</span>
          <span class="text-sky-600 dark:text-sky-400">id</span>:
          <span class="text-amber-600 dark:text-amber-400 font-semibold">userSession</span>
          <span class="text-zinc-400 dark:text-zinc-600">;</span>
          <span class="text-zinc-500 dark:text-zinc-400 hidden sm:inline text-[10.5px]">qs://desktop/session.qml</span>
        </div>

        <div class="flex items-center gap-2">
          <span class="px-2 py-0.5 rounded bg-emerald-50 dark:bg-emerald-950/40 text-emerald-700 dark:text-emerald-400 border border-emerald-200/60 dark:border-emerald-800/60 text-[10px] font-mono font-semibold">
            STATUS: ACTIVE_IPC
          </span>
          <span class="text-zinc-400 dark:text-zinc-600 font-mono text-xs">&#125;</span>
        </div>
      </div>

      <!-- Scope Header & Identity Bindings -->
      <div class="p-5 sm:p-7 lg:p-8">
        <div class="flex flex-col lg:flex-row lg:items-center justify-between gap-6">
          <!-- Left: Identity & QML Property Bindings -->
          <div class="flex flex-col sm:flex-row items-start sm:items-center gap-5">
            <div class="relative w-20 h-20 sm:w-24 sm:h-24 lg:w-28 lg:h-28 rounded-xl overflow-hidden border border-zinc-300 dark:border-zinc-700 flex-shrink-0 bg-zinc-100 dark:bg-zinc-800 shadow-xs p-0.5">
              <img
                src="/avatar.webp"
                alt="Ozan Özdil"
                width="112"
                height="112"
                fetchpriority="high"
                decoding="async"
                class="w-full h-full object-cover rounded-lg"
              />
              <span class="absolute bottom-1 right-1 w-3 h-3 rounded-full bg-emerald-500 border-2 border-white dark:border-[#0c0e12]" title="Aktif Oturum"></span>
            </div>

            <div class="space-y-2">
              <div class="font-mono text-xs flex flex-wrap items-center gap-2">
                <span class="text-purple-600 dark:text-purple-400 font-semibold">property string</span>
                <span class="text-sky-600 dark:text-sky-400">role</span>:
                <span class="text-emerald-700 dark:text-emerald-400 font-medium">"Orman Mühendisi (KTÜ)"</span>
              </div>

              <h1 class="text-2xl sm:text-3xl lg:text-4xl font-bold tracking-tight text-zinc-950 dark:text-zinc-50 font-sans flex items-center gap-2">
                <span>Ozan Özdil</span>
                <span class="text-xs font-mono font-normal text-zinc-500 dark:text-zinc-400 px-2 py-0.5 rounded bg-zinc-100 dark:bg-zinc-800 border border-zinc-200 dark:border-zinc-700">
                  id: root
                </span>
              </h1>

              <div class="font-mono text-xs sm:text-[13px] text-zinc-600 dark:text-zinc-300 leading-relaxed max-w-2xl">
                <span class="text-purple-600 dark:text-purple-400 font-semibold">property string</span>
                <span class="text-sky-600 dark:text-sky-400">focus</span>:
                <span class="text-emerald-700 dark:text-emerald-400 font-sans">
                  "Linux, Omarchy, QuickShell, Açık Kaynak Sistem Mimarisi ve Orta Format Fotoğrafçılık."
                </span>
              </div>

              <!-- QML Property Badges -->
              <div class="flex flex-wrap items-center gap-1.5 pt-1 font-mono text-[11px]">
                <span class="px-2 py-0.5 rounded bg-purple-50 dark:bg-purple-950/40 text-purple-700 dark:text-purple-400 border border-purple-200/60 dark:border-purple-800/60">
                  <span class="text-sky-600 dark:text-sky-400">role</span>: <span class="text-emerald-700 dark:text-emerald-400">"YZ Kodcusu"</span>
                </span>
                <span class="px-2 py-0.5 rounded bg-zinc-100 dark:bg-zinc-800/80 text-zinc-700 dark:text-zinc-300 border border-zinc-200/80 dark:border-zinc-700/80">
                  <span class="text-sky-600 dark:text-sky-400">location</span>: <span class="text-emerald-700 dark:text-emerald-400">"Kastamonu, TR"</span>
                </span>
                <span class="px-2 py-0.5 rounded bg-emerald-50 dark:bg-emerald-950/40 text-emerald-700 dark:text-emerald-400 border border-emerald-200/60 dark:border-emerald-800/60">
                  <span class="text-sky-600 dark:text-sky-400">faculty</span>: <span class="text-emerald-700 dark:text-emerald-400">"KTÜ Orman"</span>
                </span>
                <span class="px-2 py-0.5 rounded bg-cyan-50 dark:bg-cyan-950/40 text-cyan-700 dark:text-[#00ffcc] border border-cyan-200/60 dark:border-cyan-800/60">
                  <span class="text-sky-600 dark:text-sky-400">shellEngine</span>: <span class="text-emerald-700 dark:text-emerald-400">"QuickShell"</span>
                </span>
                <span class="px-2 py-0.5 rounded bg-rose-50 dark:bg-rose-950/40 text-rose-700 dark:text-rose-400 border border-rose-200/60 dark:border-rose-800/60">
                  <span class="text-sky-600 dark:text-sky-400">gamingMode</span>: <span class="text-amber-600 dark:text-amber-400">true</span>
                </span>
              </div>
            </div>
          </div>

          <!-- Right: Telemetry Grid Object -->
          <div class="font-mono text-xs rounded-xl p-3.5 bg-zinc-50 dark:bg-[#101319] border border-zinc-200/90 dark:border-zinc-800/90 min-w-[320px] space-y-2 shadow-2xs">
            <div class="flex items-center justify-between pb-1.5 border-b border-zinc-200/80 dark:border-zinc-800/80 text-[11px]">
              <span class="text-purple-600 dark:text-purple-400 font-bold">TelemetryObject</span>
              <span class="text-zinc-400">&#123;</span>
            </div>
            <div class="pl-2.5 space-y-1.5 text-[11px]">
              <div>
                <span class="text-sky-600 dark:text-sky-400">osCompositor</span>:
                <span class="text-emerald-700 dark:text-emerald-400 font-medium">"Arch Linux // Hyprland"</span>
              </div>
              <div>
                <span class="text-sky-600 dark:text-sky-400">shellFramework</span>:
                <span class="text-sky-600 dark:text-[#00ffcc] font-semibold">"QuickShell (C++ / QML)"</span>
              </div>
              <div>
                <span class="text-sky-600 dark:text-sky-400">opticsSystem</span>:
                <span class="text-emerald-700 dark:text-emerald-400 font-medium">"Fujifilm GFX Orta Format"</span>
              </div>
              <div>
                <span class="text-sky-600 dark:text-sky-400">colorProfile</span>:
                <span class="text-purple-600 dark:text-purple-400 font-semibold">"OLED Black #000000"</span>
              </div>
            </div>
            <div class="pt-1 text-zinc-400 text-right text-[11px]">&#125;</div>
          </div>
        </div>

        <!-- Global Action Triggers -->
        <div class="mt-6 pt-5 border-t border-zinc-100 dark:border-zinc-800/80 flex flex-wrap items-center gap-3 font-mono text-xs">
          <span class="text-purple-600 dark:text-purple-400 font-bold">ActionTrigger</span>
          <span class="text-zinc-400">&#123;</span>
          <div class="flex flex-wrap items-center gap-2">
            <a
              href="/blog"
              class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg border border-sky-300/80 dark:border-[#00ffcc]/40 bg-sky-50 dark:bg-[#00ffcc]/10 text-sky-800 dark:text-[#00ffcc] hover:bg-sky-100 dark:hover:bg-[#00ffcc]/20 font-semibold transition-all cursor-pointer shadow-2xs"
            >
              <span class="text-sky-600 dark:text-zinc-400 font-normal">onClicked:</span>
              <span>qs.openArchive("/blog")</span>
              <span class="text-xs">↵</span>
            </a>

            <a
              href="/galeri"
              class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg border border-purple-300/80 dark:border-purple-500/40 bg-purple-50 dark:bg-purple-950/20 text-purple-800 dark:text-purple-300 hover:bg-purple-100 dark:hover:bg-purple-950/40 font-semibold transition-all cursor-pointer shadow-2xs"
            >
              <span class="text-purple-600 dark:text-zinc-400 font-normal">onClicked:</span>
              <span>qs.openGallery("/galeri")</span>
              <span class="text-xs">↵</span>
            </a>

            <a
              href="/projeler"
              class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg border border-zinc-300 dark:border-zinc-700 bg-zinc-100 dark:bg-zinc-800/70 text-zinc-800 dark:text-zinc-200 hover:bg-zinc-200 dark:hover:bg-zinc-800 font-semibold transition-all cursor-pointer shadow-2xs"
            >
              <span class="text-zinc-500 dark:text-zinc-400 font-normal">onClicked:</span>
              <span>qs.openProjects("/projeler")</span>
              <span class="text-xs">↵</span>
            </a>
          </div>
          <span class="text-zinc-400">&#125;</span>
        </div>
      </div>
    </section>

    <!-- 12-COLUMN DASHBOARD GRID -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-6 items-start">
      
      <!-- LEFT / MAIN CONTENT AREA (8 Cols on Desktop) -->
      <div class="lg:col-span-8 space-y-6">
        
        <!-- BIOGRAPHY & ACADEMIC/PROFESSIONAL ARCHITECTURE COMPONENT -->
        <section class="rounded-xl border border-zinc-200/90 dark:border-zinc-800/90 bg-white dark:bg-[#0c0e12] overflow-hidden shadow-2xs" aria-label="Biyografi ve Mimariler">
          <!-- Titlebar -->
          <div class="px-4 py-2.5 bg-zinc-50 dark:bg-[#12151d] border-b border-zinc-100 dark:border-zinc-800/80 flex items-center justify-between font-mono text-[11px]">
            <div class="flex items-center gap-2">
              <span class="w-2 h-2 rounded-full bg-sky-500"></span>
              <span class="text-purple-600 dark:text-purple-400 font-bold">BiographyScope</span>
              <span class="text-zinc-400 dark:text-zinc-600">&#123;</span>
              <span class="text-zinc-600 dark:text-zinc-400">id: biographyModel;</span>
              <span class="text-zinc-500 dark:text-zinc-500 hidden sm:inline">qs://desktop/biography.qml</span>
            </div>
            <span class="text-zinc-400 font-mono text-xs">&#125;</span>
          </div>

          <!-- QML Component Cards List -->
          <div class="p-5 sm:p-6 space-y-4 font-mono text-xs">
            
            <!-- Item 1: AcademicFormation -->
            <article class="p-4 sm:p-5 rounded-lg bg-zinc-50/80 dark:bg-[#101319] border border-zinc-200/80 dark:border-zinc-800/80 space-y-2">
              <div class="flex items-center justify-between pb-2 border-b border-zinc-200/60 dark:border-zinc-800/60 text-[11px]">
                <div class="flex items-center gap-2">
                  <span class="text-purple-600 dark:text-purple-400 font-bold">AcademicFormation</span>
                  <span class="text-zinc-400">&#123;</span>
                  <span class="text-sky-600 dark:text-sky-400">id</span>: <span class="text-amber-600 dark:text-amber-400">ktuForestFaculty</span>
                </div>
                <span class="px-2 py-0.5 rounded bg-emerald-50 dark:bg-emerald-950/40 text-emerald-700 dark:text-emerald-400 border border-emerald-200/50 dark:border-emerald-800/50 text-[10px]">
                  KTÜ ORMAN
                </span>
              </div>
              <div class="pl-3 sm:pl-4 space-y-1.5 border-l-2 border-purple-500/30 dark:border-purple-400/30">
                <div>
                  <span class="text-sky-600 dark:text-sky-400">faculty</span>:
                  <span class="text-emerald-700 dark:text-emerald-400 font-medium">"Karadeniz Teknik Üniversitesi (KTÜ) Orman Fakültesi"</span>
                </div>
                <div>
                  <span class="text-sky-600 dark:text-sky-400">discipline</span>:
                  <span class="text-emerald-700 dark:text-emerald-400 font-medium">"Orman Mühendisliği"</span>
                </div>
                <div class="pt-1">
                  <span class="text-sky-600 dark:text-sky-400">perspective</span>:
                  <p class="font-sans text-sm sm:text-base text-zinc-800 dark:text-zinc-200 leading-relaxed mt-1 pl-3 py-1 border-l-2 border-emerald-500/50 bg-white/70 dark:bg-[#151922] rounded-r-md">
                    Karadeniz Teknik Üniversitesi Orman Fakültesi mezunuyum. Orman mühendisliği formasyonunun kazandırdığı ekosistem dinamikleri ve analitik bakış açısı, teknolojiye ve yazılım dünyasına yaklaşımımın da temelini oluşturuyor.
                  </p>
                </div>
              </div>
              <div class="text-zinc-400 pt-1">&#125;</div>
            </article>

            <!-- Item 2: ExecutiveExperience -->
            <article class="p-4 sm:p-5 rounded-lg bg-zinc-50/80 dark:bg-[#101319] border border-zinc-200/80 dark:border-zinc-800/80 space-y-2">
              <div class="flex items-center justify-between pb-2 border-b border-zinc-200/60 dark:border-zinc-800/60 text-[11px]">
                <div class="flex items-center gap-2">
                  <span class="text-purple-600 dark:text-purple-400 font-bold">ExecutiveExperience</span>
                  <span class="text-zinc-400">&#123;</span>
                  <span class="text-sky-600 dark:text-sky-400">id</span>: <span class="text-amber-600 dark:text-amber-400">publicSectorAdmin</span>
                </div>
                <span class="px-2 py-0.5 rounded bg-sky-50 dark:bg-sky-950/40 text-sky-700 dark:text-sky-400 border border-sky-200/50 dark:border-sky-800/50 text-[10px]">
                  YÖNETİM & BİLİŞİM
                </span>
              </div>
              <div class="pl-3 sm:pl-4 space-y-1.5 border-l-2 border-purple-500/30 dark:border-purple-400/30">
                <div>
                  <span class="text-sky-600 dark:text-sky-400">domain</span>:
                  <span class="text-emerald-700 dark:text-emerald-400 font-medium">"Kamu Yönetimi, Kurumsal İletişim ve Yerel Yönetim"</span>
                </div>
                <div>
                  <span class="text-sky-600 dark:text-sky-400">executiveRoles</span>:
                  <span class="text-zinc-400">[</span>
                  <span class="text-emerald-700 dark:text-emerald-400">"Belediye Başkan Danışmanlığı"</span>,
                  <span class="text-emerald-700 dark:text-emerald-400">"Ar-Ge & Bilgi İşlem Yöneticiliği"</span>
                  <span class="text-zinc-400">]</span>
                </div>
                <div class="pt-1">
                  <span class="text-sky-600 dark:text-sky-400">narrative</span>:
                  <p class="font-sans text-sm sm:text-base text-zinc-800 dark:text-zinc-200 leading-relaxed mt-1 pl-3 py-1 border-l-2 border-sky-500/50 bg-white/70 dark:bg-[#151922] rounded-r-md">
                    Kamu yönetimi, kurumsal iletişim ve yerel yönetim süreçlerinde görev aldım. Belediye başkan danışmanlığı ile Ar-Ge ve Bilgi İşlem yöneticiliği görevlerinde bulundum; dijital iletişim süreçleri, kriz yönetimi ve kurumsal bilişim altyapılarını koordine ettim.
                  </p>
                </div>
              </div>
              <div class="text-zinc-400 pt-1">&#125;</div>
            </article>

            <!-- Item 3: SystemArchitecture (YZ Kodcusu) -->
            <article class="p-4 sm:p-5 rounded-lg bg-zinc-50/80 dark:bg-[#101319] border border-zinc-200/80 dark:border-zinc-800/80 space-y-2">
              <div class="flex items-center justify-between pb-2 border-b border-zinc-200/60 dark:border-zinc-800/60 text-[11px]">
                <div class="flex items-center gap-2">
                  <span class="text-purple-600 dark:text-purple-400 font-bold">SystemArchitecture</span>
                  <span class="text-zinc-400">&#123;</span>
                  <span class="text-sky-600 dark:text-sky-400">id</span>: <span class="text-amber-600 dark:text-amber-400">yzKodcusuOmarchyStack</span>
                </div>
                <span class="px-2 py-0.5 rounded bg-purple-50 dark:bg-purple-950/40 text-purple-700 dark:text-purple-400 border border-purple-200/50 dark:border-purple-800/50 text-[10px] font-bold">
                  YZ KODCUSU // OMARCHY
                </span>
              </div>
              <div class="pl-3 sm:pl-4 space-y-1.5 border-l-2 border-purple-500/30 dark:border-purple-400/30">
                <div>
                  <span class="text-sky-600 dark:text-sky-400">roleModel</span>:
                  <span class="text-sky-600 dark:text-[#00ffcc] font-semibold">"YZ Kodcusu (Yapay Zeka Destekli Mimari & Kodlama)"</span>
                </div>
                <div>
                  <span class="text-sky-600 dark:text-sky-400">operatingSystem</span>:
                  <span class="text-emerald-700 dark:text-emerald-400 font-medium">"Arch Linux // Hyprland Wayland Compositor"</span>
                </div>
                <div>
                  <span class="text-sky-600 dark:text-sky-400">shellCore</span>:
                  <span class="text-emerald-700 dark:text-emerald-400 font-medium">"C++ & Reactive QML QuickShell"</span>
                </div>
                <div class="pt-1">
                  <span class="text-sky-600 dark:text-sky-400">narrative</span>:
                  <p class="font-sans text-sm sm:text-base text-zinc-800 dark:text-zinc-200 leading-relaxed mt-1 pl-3 py-1 border-l-2 border-purple-500/50 bg-white/70 dark:bg-[#151922] rounded-r-md">
                    Kendimi klasik bir yazılımcıdan ziyade yapay zeka ile kod üreten ve sistem inşa eden bir <strong>YZ Kodcusu</strong> olarak konumlandırıyorum. Açık kaynak ekosisteminde Arch Linux tabanlı kişisel masaüstü yapılandırmam (<a href="https://github.com/ozdil/omarchy" target="_blank" rel="noopener noreferrer" class="text-sky-600 dark:text-[#00ffcc] font-medium underline underline-offset-4 hover:opacity-80">Omarchy</a>), C++/QML tabanlı QuickShell bileşenleri, Wayland katman protokolleri ve güvenlik araçlarını yapay zeka güdümlü modern mühendislik iş akışlarıyla hayata geçiriyorum.
                  </p>
                </div>
                <div class="pt-2">
                  <span class="text-purple-600 dark:text-purple-400">ActionTrigger</span> <span class="text-zinc-400">&#123;</span>
                  <a
                    href="https://github.com/ozdil/omarchy"
                    target="_blank"
                    rel="noopener noreferrer"
                    class="inline-flex items-center gap-1.5 ml-2 px-2.5 py-1 rounded bg-zinc-200/70 dark:bg-zinc-800 hover:bg-zinc-300 dark:hover:bg-zinc-700 text-zinc-900 dark:text-[#00ffcc] font-semibold text-[11px] transition-colors"
                  >
                    <span>onTriggered: qs.openRepo("github.com/ozdil/omarchy")</span>
                    <span>↗</span>
                  </a>
                  <span class="text-zinc-400">&#125;</span>
                </div>
              </div>
              <div class="text-zinc-400 pt-1">&#125;</div>
            </article>

            <!-- Item 4: LinuxGamingTelemetry -->
            <article class="p-4 sm:p-5 rounded-lg bg-zinc-50/80 dark:bg-[#101319] border border-zinc-200/80 dark:border-zinc-800/80 space-y-2">
              <div class="flex items-center justify-between pb-2 border-b border-zinc-200/60 dark:border-zinc-800/60 text-[11px]">
                <div class="flex items-center gap-2">
                  <span class="text-purple-600 dark:text-purple-400 font-bold">LinuxGamingTelemetry</span>
                  <span class="text-zinc-400">&#123;</span>
                  <span class="text-sky-600 dark:text-sky-400">id</span>: <span class="text-amber-600 dark:text-amber-400">protonWaylandStack</span>
                </div>
                <span class="px-2 py-0.5 rounded bg-rose-50 dark:bg-rose-950/40 text-rose-700 dark:text-rose-400 border border-rose-200/50 dark:border-rose-800/50 text-[10px]">
                  WAYLAND + PROTON
                </span>
              </div>
              <div class="pl-3 sm:pl-4 space-y-1.5 border-l-2 border-purple-500/30 dark:border-purple-400/30">
                <div>
                  <span class="text-sky-600 dark:text-sky-400">driverProfile</span>:
                  <span class="text-emerald-700 dark:text-emerald-400 font-medium">"Vulkan / RADV Low-Latency"</span>
                </div>
                <div>
                  <span class="text-sky-600 dark:text-sky-400">hudMonitoring</span>:
                  <span class="text-emerald-700 dark:text-emerald-400 font-medium">"MangoHud + QuickShell OSD Telemetry"</span>
                </div>
                <div class="pt-1">
                  <span class="text-sky-600 dark:text-sky-400">narrative</span>:
                  <p class="font-sans text-sm sm:text-base text-zinc-800 dark:text-zinc-200 leading-relaxed mt-1 pl-3 py-1 border-l-2 border-rose-500/50 bg-white/70 dark:bg-[#151922] rounded-r-md">
                    Aynı zamanda bir Linux oyuncusu olarak Wayland ve Proton üzerinde düşük gecikmeli oyun deneyimi, simülasyon konfigürasyonları ve kare süresi (frametime) telemetrisi üzerine çalışıyorum.
                  </p>
                </div>
                <div class="pt-2">
                  <span class="text-purple-600 dark:text-purple-400">ActionTrigger</span> <span class="text-zinc-400">&#123;</span>
                  <a
                    href="https://steamcommunity.com/id/ozanozdil"
                    target="_blank"
                    rel="noopener noreferrer"
                    class="inline-flex items-center gap-1.5 ml-2 px-2.5 py-1 rounded bg-zinc-200/70 dark:bg-zinc-800 hover:bg-zinc-300 dark:hover:bg-zinc-700 text-zinc-900 dark:text-[#00ffcc] font-semibold text-[11px] transition-colors"
                  >
                    <span>onTriggered: qs.openProfile("steam://ozanozdil")</span>
                    <span>↗</span>
                  </a>
                  <span class="text-zinc-400">&#125;</span>
                </div>
              </div>
              <div class="text-zinc-400 pt-1">&#125;</div>
            </article>

          </div>
        </section>

        <!-- CORE FOCUS MODULES (QML APPLET GRID) -->
        <section class="rounded-xl border border-zinc-200/90 dark:border-zinc-800/90 bg-white dark:bg-[#0c0e12] overflow-hidden shadow-2xs" aria-label="Odak Alanları">
