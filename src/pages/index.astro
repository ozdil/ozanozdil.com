  <script is:inline>
    (function initHud() {
      const screen = document.getElementById('terminal-screen');
      if (!screen) return;

      const moduleOutputs = {
        agents: [
          '<div class="text-[#71717a]">$ ax.io/v1alpha1 orchestrate --cluster=primary --protocol=3-phase</div>',
          '<div class="text-[#ffffff]">&gt; Konsorsiyum çalışma zamanı başlatıldı. 13 uzman model düğümü eşlendi.</div>',
          '<div class="text-[#a1a1aa]">  - Faz 1 (Çözümleme): Claude Code + Z.ai mimari analiz ve refactor topolojisi.</div>',
          '<div class="text-[#a1a1aa]">  - Faz 2 (İnşa &amp; Yama): Codex + Cursor Agent deterministik AST birleştirme döngüsü.</div>',
          '<div class="text-[#a1a1aa]">  - Faz 3 (Çift Kilitli Denetim): Jev Gate kabul kapısı + Gemma 4 çevrimdışı gizlilik filtresi.</div>',
          '<div class="text-[#ffffff] font-semibold">&gt; DURUM: Dağıtım hatasız tamamlandı. Doğrulama: 0 lint / 0 regresyon.</div>'
        ].join(''),

        kernel: [
          '<div class="text-[#71717a]">$ omarchy-kernel --subsystem=audio-ipc --profile=low-latency</div>',
          '<div class="text-[#ffffff]">&gt; Linux 6.13.x BORE/EEVDF çekirdek zamanlayıcısı devrede.</div>',
          '<div class="text-[#a1a1aa]">  - PipeWire 16-bit 192kHz ses arabelleği: 64 frames (0.33ms gecikme).</div>',
          '<div class="text-[#a1a1aa]">  - Slint Wayland grafik soketi: Donanımsal sıfır kopyalama (zero-copy buffer).</div>',
          '<div class="text-[#a1a1aa]">  - OmaStudio Rust arka plan hizmeti (daemon): Kilitlenmesiz SIMD matrisi devrede.</div>',
          '<div class="text-[#ffffff] font-semibold">&gt; DURUM: Çekirdek IPC hazır. Ortalama görev gecikmesi: 0.11ms.</div>'
        ].join(''),

        security: [
          '<div class="text-[#71717a]">$ security-audit --standard=STANAG-5066 --crypto=FIPS-204</div>',
          '<div class="text-[#ffffff]">&gt; Kastamonu Kurum Arşivi siber savunma doğrulaması yapılıyor.</div>',
          '<div class="text-[#a1a1aa]">  - Kuantum sonrası imzalama: NIST FIPS 204 ML-DSA kafes tabanlı anahtar doğrulaması [GEÇTİ].</div>',
          '<div class="text-[#a1a1aa]">  - İki Kişi Kuralı (Two-Man Rule): Kriptografik anahtar parçalama (Shamir SSS) [AKTİF].</div>',
          '<div class="text-[#a1a1aa]">  - Merkle Değişmezlik Ağacı: 142,890 blok WORM zinciri tahrifatsız doğrulandı [GEÇTİ].</div>',
          '<div class="text-[#ffffff] font-semibold">&gt; DURUM: DEFCON-1 kamu savunma standartları tam uyumlu.</div>'
        ].join(''),

        edge: [
          '<div class="text-[#71717a]">$ edge-worker --verify --rfc=9421 --region=global</div>',
          '<div class="text-[#ffffff]">&gt; Cloudflare Edge &amp; Workers KV uç ağ durumu sorgulanıyor.</div>',
          '<div class="text-[#a1a1aa]">  - RFC 9421 HTTP Message Signatures: Ajan istek doğrulama oranı %100.</div>',
          '<div class="text-[#a1a1aa]">  - llms.txt &amp; Açık Veri önbellek isabeti: %99.82 (ortalama uç gecikmesi 8ms).</div>',
          '<div class="text-[#a1a1aa]">  - Sunucu maliyeti: 0 TL / ay (Tamamen sunucusuz statik &amp; edge KV mimarisi).</div>',
          '<div class="text-[#ffffff] font-semibold">&gt; DURUM: 300+ global veri merkezinde dağıtık ve canlı.</div>'
        ].join('')
      };

      const cmdOutputs = {
        'ax.io --status': [
          '<div class="text-[#71717a]">$ ax.io --status</div>',
          '<div class="text-[#ffffff]">&gt; ÇALIŞMA ZAMANI: ax.io/v1alpha1 (Google AX Bildirimsel Dağıtım)</div>',
          '<div class="text-[#a1a1aa]">&gt; Konsorsiyum Düğümleri: Antigravity (Şef), Claude, Codex, Cursor, DeepSeek, Jev Gate.</div>',
          '<div class="text-[#ffffff] font-semibold">&gt; Yürütme: Dinamik 3-Faz Protokolü devrede. Deterministik kabul oranı: %100.</div>'
        ].join(''),

        'kernel --bench': [
          '<div class="text-[#71717a]">$ kernel --bench --loops=1000000</div>',
          '<div class="text-[#ffffff]">&gt; BORE/EEVDF kıyaslama testi tamamlandı.</div>',
          '<div class="text-[#a1a1aa]">&gt; Bağlam Değişimi: 0.082 mikrosaniye | IPC Kuyruk Gecikmesi: 0.12ms</div>',
          '<div class="text-[#ffffff] font-semibold">&gt; Karar: Gerçek zamanlı ses/video ve otonom ajan yükleri için optimal.</div>'
        ].join(''),

        'crypto --verify': [
          '<div class="text-[#71717a]">$ crypto --verify --algorithm=ML-DSA-87</div>',
          '<div class="text-[#ffffff]">&gt; Kuantum Sonrası Kafes Doğrulaması (NIST FIPS 204)</div>',
          '<div class="text-[#a1a1aa]">&gt; Değişmezlik Kanıtı: Merkle Root Hash 0x9f8c...3a1e doğrulandı.</div>',
          '<div class="text-[#ffffff] font-semibold">&gt; Sonuç: Tahrifat tespit edilmedi. Kriptografik güven tam.</div>'
        ].join(''),

        'edge --purge-cache': [
          '<div class="text-[#71717a]">$ edge --purge-cache --zone=ozanozdil.com</div>',
          '<div class="text-[#ffffff]">&gt; Workers KV ve Edge önbellekleri yenilendi.</div>',
          '<div class="text-[#a1a1aa]">&gt; Global yayılma süresi: 124ms (320 PoP noktası senkronize edildi).</div>',
          '<div class="text-[#ffffff] font-semibold">&gt; Sistem hazır. llms.txt ve açık veri katalogları güncel.</div>'
        ].join('')
      };

      const tabs = document.querySelectorAll('.hud-tab');
      tabs.forEach((tab) => {
        tab.addEventListener('click', () => {
          const mod = tab.getAttribute('data-module');
          if (!mod || !moduleOutputs[mod]) return;

          tabs.forEach((t) => {
            t.classList.remove('active', 'border-[#3f3f46]');
            t.classList.add('border-[#27272a]');
            const statusSpan = t.querySelector('span:last-child');
            if (statusSpan) statusSpan.textContent = '[IDLE]';
          });

          tab.classList.add('active', 'border-[#3f3f46]');
          tab.classList.remove('border-[#27272a]');
          const currentStatus = tab.querySelector('span:last-child');
          if (currentStatus) currentStatus.textContent = '[ACTIVE]';

          screen.innerHTML = moduleOutputs[mod];
        });
      });

      const cmdButtons = document.querySelectorAll('.hud-cmd-btn');
      cmdButtons.forEach((btn) => {
        btn.addEventListener('click', () => {
          const cmd = btn.getAttribute('data-cmd');
          if (cmd && cmdOutputs[cmd]) {
            screen.innerHTML = cmdOutputs[cmd];
          }
        });
      });
    })();
  </script>
