          — Ozan Özdil
        </div>
      </div>
    </section>

    <!-- ================================================================= -->
    <!-- 4. MICROSOFT AI STYLE PERSPECTIVES & UPDATES (LATEST POSTS)       -->
    <!-- ================================================================= -->
    <section class="space-y-8" aria-label="Son Araştırmalar ve Makaleler">
      <div class="flex items-center justify-between pb-4 border-b border-[#e5c158]/20">
        <div>
          <div class="font-mono text-xs text-[#e5c158] uppercase tracking-wider font-semibold">
            // EDİTORYAL İNCELEMELER & ANALİZLER
          </div>
          <h2 class="font-serif text-3xl sm:text-4xl font-normal text-[#e5c158]">
            Son Yazılar & Araştırmalar
          </h2>
        </div>
        <a
          href="/blog"
          class="font-mono text-xs text-[#e5c158] hover:text-[#f3e5ab] hover:underline font-medium flex items-center gap-1"
        >
          <span>tüm yazılar ({allPosts.length})</span>
          <span>→</span>
        </a>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
        {latestPosts.map((post) => (
          <article class="relative p-6 rounded-[22px] pcb-card group flex flex-col justify-between space-y-4 shadow-xl overflow-hidden">
            <div class="pcb-via pcb-via-tl"></div>
            <div class="pcb-via pcb-via-tr"></div>
            <div class="pcb-via pcb-via-bl"></div>
            <div class="pcb-via pcb-via-br"></div>
            <div class="pcb-bracket-tl"></div>
            <div class="pcb-bracket-tr"></div>
            <div class="pcb-bracket-bl"></div>
            <div class="pcb-bracket-br"></div>

            <a href={`/blog/${post.slug}`} class="block space-y-3">
              <div class="flex items-center justify-between font-mono text-[11px] text-[#c5cbd3]">
                <span class="px-2.5 py-0.5 rounded-full bg-[#190102] text-[#e5c158] border border-[#e5c158]/30">
                  {post.data.tags?.[0] || 'Teknoloji'}
                </span>
                <time datetime={post.data.pubDate.toISOString()}>
                  {formatDate(post.data.pubDate)}
                </time>
              </div>

              <h3 class="font-serif text-xl sm:text-2xl font-normal text-[#ffffff] group-hover:text-[#e5c158] transition-colors leading-[1.3]">
                {post.data.title}
              </h3>

              {post.data.description && (
                <p class="font-serif text-sm text-[#c5cbd3] line-clamp-2 leading-relaxed">
                  {post.data.description}
                </p>
              )}
            </a>

            <div class="pt-2 font-mono text-xs text-[#e5c158] group-hover:text-[#f3e5ab] flex items-center gap-1">
              <span>Makaleyi Oku</span>
              <span>→</span>
            </div>
          </article>
        ))}
      </div>
    </section>

    <!-- ================================================================= -->
    <!-- 5. SIGNATURE EXPLORE & CONNECT BAR (FAST ACCESS)                  -->
    <!-- ================================================================= -->
    <section class="rounded-[24px] bg-[#280205] border border-[#e5c158]/30 p-7 sm:p-10 flex flex-col md:flex-row items-start md:items-center justify-between gap-6 shadow-xl" aria-label="Derinlemesine İnceleme ve Bağlantılar">
      <div class="space-y-2">
        <span class="font-mono text-xs text-[#e5c158] uppercase font-semibold block">
          // AÇIK DOKÜMANTASYON & ARŞİV
        </span>
        <h3 class="font-serif text-2xl sm:text-3xl font-normal text-[#ffffff]">
          Sistemi Derinlemesine İnceleyin
        </h3>
        <p class="font-serif text-sm text-[#c5cbd3] max-w-xl">
          Tüm kaynak kodlar, YZ modelleri için bağlam şemaları ve mimari dokümantasyon herkese açık şekilde sunulmaktadır.
        </p>
      </div>

      <div class="flex flex-wrap items-center gap-x-6 gap-y-3 font-mono text-xs">
        <a
          href="/hakkimda"
          class="flex items-center gap-1.5 text-[#ffffff] hover:text-[#e5c158] hover:underline font-medium"
        >
          <span>Özgeçmiş</span>
          <span class="text-[#e5c158]">↗</span>
        </a>
        <a
          href="https://github.com/ozdil"
          target="_blank"
          rel="noopener noreferrer"
          class="flex items-center gap-1.5 text-[#ffffff] hover:text-[#e5c158] hover:underline font-medium"
        >
          <span>GitHub</span>
          <span class="text-[#e5c158]">↗</span>
        </a>
        <a
          href="/llms.txt"
          target="_blank"
          class="flex items-center gap-1.5 text-[#ffffff] hover:text-[#e5c158] hover:underline font-medium"
        >
          <span>llms.txt</span>
          <span class="text-[#e5c158]">↗</span>
        </a>
        <a
          href="/rss.xml"
          target="_blank"
          class="flex items-center gap-1.5 text-[#ffffff] hover:text-[#e5c158] hover:underline font-medium"
        >
          <span>RSS Akışı</span>
          <span class="text-[#e5c158]">↗</span>
        </a>
      </div>
    </section>

  </div>
</BaseLayout>
