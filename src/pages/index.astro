---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import galleryData from '../data/gallery.json';

// Fetch published blog posts and get the latest 4
const allPosts = await getCollection('blog', ({ data }) => !data.draft);
const latestPosts = allPosts
  .sort((a, b) => new Date(b.data.pubDate).getTime() - new Date(a.data.pubDate).getTime())
  .slice(0, 4);

// Format date utility
const formatDate = (date: Date) => {
  return new Intl.DateTimeFormat('tr-TR', {
    day: '2-digit',
    month: 'short',
    year: 'numeric'
  }).format(date);
};

// Curated featured / latest projects
const featuredProjects = [
  {
    name: 'kastamonu-akilli-sehir-platformu',
    title: 'Kastamonu Akıllı Şehir & Dijital Kurum Arşivi',
    desc: 'NATO STANAG ve DoD savunma standartlarında kurumsal siber güvenlik altyapısı. Two-Man Rule, NIST FIPS 204 kuantum sonrası kafes tabanlı şifreleme (ML-DSA), Bell-LaPadula MLS çok seviyeli gizlilik ve Merkle Tree WORM kriptografik değişmezlik zinciri.',
    lang: 'Rust / TypeScript',
    badge: 'DEFCON-1 Kamu Savunması',
    tags: ['siber-savunma', 'sifir-guven', 'kuantum-kriptografi', 'merkle-tree'],
    url: 'https://github.com/Kastamonu-Belediye-Baskanligi/kastamonu-akilli-sehir-platformu'
  },
  {
    name: 'omarchy-omastudio',
    title: 'Omarchy Linux & OmaStudio RAW Motoru',
    desc: 'Arch Linux tabanlı düşük gecikmeli çekirdek optimizasyonları (BORE/EEVDF). 16-bit orta format (Fujifilm GFX / Hasselblad) RAW görüntüleri sıfır kilitlenmeyle işleyen kalıcı Rust daemon motoru, DaVinci 3-Way renk tekerlekleri ve Slint Wayland grafik arayüzü.',
    lang: 'Rust / Slint / QML',
    badge: '16-Bit RAW Fotonik',
    tags: ['rust', 'wayland', 'medium-format', 'raw-engine'],
    url: 'https://github.com/ozdil/omarchy-omastudio'
  },
  {
    name: 'polycodex',
    title: 'PolyCodex — Evrensel PDF Çevirici',
    desc: 'Akademik makaleler ve teknik kitaplar için sayfa düzeni, mizanpaj, görsel ve tabloları 1:1 koruyan açık kaynaklı PDF çevirici. 5000 sayfaya kadar çoklu iş parçacığı desteği, Tz mikrotipografi ve yerel Ollama yapay zekâ motoru entegrasyonu.',
    lang: 'Rust / QML',
    badge: 'Mizanpaj Korumalı AI',
    tags: ['rust', 'quickshell', 'pdf', 'ollama', 'privacy'],
    url: 'https://github.com/ozdil/polycodex'
  },
  {
    name: 'quicknews',
    title: 'QuickNews — Saf Metin Haber Okuyucusu',
    desc: 'Modern masaüstü için %100 reklamsız, görsellerden arındırılmış, saf metin ve tipografi odaklı minimalist haber okuyucusu. Güncel RSS/Atom XML doğrulama kalkanı ve yerel yapay zekâ destekli anlık haber özetleme motoru.',
    lang: 'Rust / QML',
    badge: 'Minimalist & Reklamsız',
    tags: ['rust', 'rss', 'atom', 'adblock', 'ai-summary'],
    url: 'https://github.com/ozdil/quicknews'
  },
  {
    name: 'omarchy-omasend',
    title: 'OmaSend & OmaSend Android',
    desc: 'Linux masaüstü ile mobil cihazlar arasında AirDrop benzeri yerel P2P dosya aktarımı, sistem paylaşım menüsü ve Wayland pano eşitleme köprüsü. Kotlin Compose mimarisiyle Google Play Store üzerinde resmi olarak yayımlanmaktadır.',
    lang: 'Rust / Kotlin Compose',
    badge: 'P2P Yerel Ağ Köprüsü',
    tags: ['p2p', 'file-transfer', 'wayland', 'android', 'google-play'],
    url: 'https://github.com/ozdil/omarchy-omasend'
  },
  {
    name: 'kastamonuinciyurt-portal',
    title: 'Kastamonu İnci Yurt Web Platformu',
    desc: 'Cloudflare Edge mimarisi üzerinde sıfır sunucu maliyetiyle çalışan modern kurumsal platform. Yapay zekâ tarayıcıları ve web ajanları için llms.txt bağlam haritası, interaktif simülatör ve dinamik API mimarisi.',
    lang: 'Cloudflare Edge / TypeScript',
    badge: 'Sunucusuz Uç Bilişim',
    tags: ['cloudflare', 'workers-kv', 'llms-txt', 'serverless'],
    url: 'https://www.kastamonuinciyurt.com'
  }
];

// Curated 4 featured photo albums from galleryData
const featuredAlbumSlugs = ['mahmutbey-camii', 'agli-kalesi', 'cide-gideros-koyu', 'ilgaz-dagi-zirvesi'];
const featuredAlbums = featuredAlbumSlugs
  .map(slug => galleryData.albums.find(a => a.id === slug || a.slug === slug))
  .filter(Boolean);
---

<BaseLayout
  title="Sistem Mimarileri, Yazılım ve Dijital Hafıza — ozanozdil.com"
  description="Açık kaynak sistem mimarileri, yapay zekâ destekli otonom yazılım süreçleri, kurumsal kamu altyapıları ve orta format fotonik belgeleme arşivi."
  currentPath="/"
  maxWidthClass="max-w-5xl"
>
  <div class="space-y-18 sm:space-y-24 py-6 sm:py-10">

    <!-- ================================================================= -->
    <!-- 1. HERO: SADE, VURUCU VE SAKİN GİRİŞ                              -->
    <!-- ================================================================= -->
    <section class="space-y-6 pt-2 sm:pt-6" aria-label="Giriş ve Genel Bakış">
      <div class="flex flex-col items-start gap-4">
        <!-- Status Pill -->
        <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full text-xs font-mono bg-[#18181b] text-[#a1a1aa] border border-[#27272a] shadow-xs">
          <span class="w-2 h-2 rounded-full bg-[#52525b] animate-pulse"></span>
          <span class="tracking-widest">// SİSTEM MİMARİLERİ • YAZILIM • FOTONİK ARŞİV</span>
        </div>

        <!-- Headline -->
        <div class="space-y-3 max-w-4xl">
          <h1 class="font-serif text-4xl sm:text-6xl font-normal text-[#ffffff] leading-[1.15] tracking-tight">
            Sistem Mimarileri, Yazılım ve Dijital Hafıza
          </h1>
          <p class="font-serif text-lg sm:text-xl text-[#a1a1aa] font-normal leading-relaxed text-balance">
            Açık kaynak Linux ekosistemleri, yapay zekâ destekli otonom yazılım süreçleri, kurumsal kamu bilişim altyapıları ve orta format fotonik belgeleme üzerine bağımsız araştırmalar ve üretimler.
          </p>
        </div>

        <!-- Fast Links Row -->
        <div class="flex flex-wrap items-center gap-2 pt-2 font-mono text-xs">
          <a
            href="#son-yazilar"
            class="px-4 py-2 rounded-full bg-[#18181b] text-[#ffffff] border border-[#27272a] hover:border-[#52525b] transition-colors"
          >
            Son Yazılar ({allPosts.length}) ↓
          </a>
          <a
            href="#son-projeler"
            class="px-4 py-2 rounded-full bg-[#18181b] text-[#ffffff] border border-[#27272a] hover:border-[#52525b] transition-colors"
          >
            Son Projeler ({featuredProjects.length}) ↓
          </a>
          <a
            href="#son-galeriler"
            class="px-4 py-2 rounded-full bg-[#18181b] text-[#ffffff] border border-[#27272a] hover:border-[#52525b] transition-colors"
          >
            Son Galeriler ({galleryData.totalAlbums} Albüm) ↓
          </a>
          <a
            href="/llms.txt"
            target="_blank"
            class="px-3.5 py-2 rounded-full bg-[#18181b] text-[#a1a1aa] border border-[#27272a] hover:text-[#ffffff] hover:border-[#52525b] transition-colors flex items-center gap-1.5"
          >
            <span>llms.txt</span>
            <span>↗</span>
          </a>
          <a
            href="/hakkimda"
            class="px-3.5 py-2 rounded-full bg-[#18181b] text-[#71717a] border border-[#27272a] hover:text-[#ffffff] hover:border-[#52525b] transition-colors flex items-center gap-1.5"
          >
            <span>Hakkında</span>
            <span>→</span>
          </a>
        </div>
      </div>
    </section>

    <!-- ================================================================= -->
    <!-- 2. BÖLÜM: SON YAZILAR & ARAŞTIRMALAR                              -->
    <!-- ================================================================= -->
    <section id="son-yazilar" class="space-y-7" aria-label="Son Yazılar ve Araştırmalar">
      <div class="flex items-center justify-between pb-3.5 border-b border-[#27272a]">
        <div>
          <div class="font-mono text-xs text-[#71717a] uppercase tracking-wider font-semibold">
            // YAYINLAR & EDİTORYAL İNCELEMELER
          </div>
          <h2 class="font-serif text-2xl sm:text-3xl font-normal text-[#ffffff]">
            Son Yazılar & Araştırmalar
          </h2>
        </div>
        <a
          href="/blog"
          class="font-mono text-xs text-[#a1a1aa] hover:text-[#ffffff] hover:underline font-medium flex items-center gap-1"
        >
          <span>tüm yazılar ({allPosts.length})</span>
          <span>→</span>
        </a>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
        {latestPosts.map((post) => (
          <article class="relative p-6 rounded-[22px] clean-card bg-[#121215] border border-[#27272a] hover:border-[#3f3f46] group flex flex-col justify-between space-y-4 shadow-xl overflow-hidden transition-colors">
            <a href={`/blog/${post.slug}`} class="block space-y-3">
              <div class="flex items-center justify-between font-mono text-[11px] text-[#71717a]">
                <span class="px-2.5 py-0.5 rounded-full bg-[#18181b] text-[#d4d4d8] border border-[#27272a]">
                  {post.data.tags?.[0] || 'Teknoloji'}
                </span>
                <time datetime={post.data.pubDate.toISOString()}>
                  {formatDate(post.data.pubDate)}
                </time>
              </div>

              <h3 class="font-serif text-xl sm:text-2xl font-normal text-[#ffffff] group-hover:text-[#ffffff] transition-colors leading-[1.3]">
                {post.data.title}
              </h3>

              {post.data.description && (
                <p class="font-serif text-sm text-[#a1a1aa] line-clamp-2 leading-relaxed">
                  {post.data.description}
                </p>
              )}
            </a>

            <div class="pt-2 font-mono text-xs text-[#d4d4d8] group-hover:text-[#ffffff] flex items-center gap-1">
              <span>Makaleyi İncele</span>
              <span>→</span>
            </div>
          </article>
        ))}
      </div>
    </section>

    <!-- ================================================================= -->
    <!-- 3. BÖLÜM: SON PROJELER & SİSTEMLER                               -->
    <!-- ================================================================= -->
    <section id="son-projeler" class="space-y-7" aria-label="Son Projeler ve Açık Kaynak Sistemler">
      <div class="flex items-center justify-between pb-3.5 border-b border-[#27272a]">
        <div>
          <div class="font-mono text-xs text-[#71717a] uppercase tracking-wider font-semibold">
            // AÇIK KAYNAK & YAZILIM DEPOLARI
          </div>
          <h2 class="font-serif text-2xl sm:text-3xl font-normal text-[#ffffff]">
            Son Projeler & Sistemler
          </h2>
        </div>
        <a
          href="/projeler"
          class="font-mono text-xs text-[#a1a1aa] hover:text-[#ffffff] hover:underline font-medium flex items-center gap-1"
        >
          <span>tüm projeleri gör</span>
          <span>→</span>
        </a>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-5">
        {featuredProjects.map((proj) => (
          <article class="p-6 rounded-[22px] clean-card bg-[#121215] border border-[#27272a] hover:border-[#3f3f46] group flex flex-col justify-between space-y-4 shadow-xl transition-colors">
            <div class="space-y-3">
              <div class="flex items-center justify-between font-mono text-[11px]">
                <span class="px-2 py-0.5 rounded-full bg-[#18181b] text-[#ffffff] font-medium border border-[#27272a]">
                  {proj.lang}
                </span>
                <span class="text-[10px] text-[#71717a]">
                  {proj.badge}
                </span>
              </div>

              <h3 class="font-serif text-lg font-normal text-[#ffffff] leading-snug group-hover:text-[#ffffff] transition-colors">
                {proj.title}
              </h3>

              <p class="font-serif text-xs text-[#a1a1aa] leading-relaxed line-clamp-4">
                {proj.desc}
              </p>
            </div>

            <div class="pt-2 border-t border-[#27272a] flex items-center justify-between font-mono text-xs">
              <div class="flex flex-wrap gap-1 text-[10px] text-[#71717a]">
                {proj.tags.slice(0, 2).map((t) => (
                  <span>#{t}</span>
                ))}
              </div>
              <a
                href={proj.url}
                target={proj.url.startsWith('http') ? '_blank' : '_self'}
                rel="noopener noreferrer"
                class="text-[#d4d4d8] hover:text-[#ffffff] flex items-center gap-1 font-medium"
              >
                <span>İncele</span>
                <span>↗</span>
              </a>
            </div>
          </article>
        ))}
      </div>
    </section>

    <!-- ================================================================= -->
    <!-- 4. BÖLÜM: SON GALERİLER & FOTONİK ARŞİV                           -->
    <!-- ================================================================= -->
    <section id="son-galeriler" class="space-y-7" aria-label="Son Fotoğraf Galerileri">
      <div class="flex items-center justify-between pb-3.5 border-b border-[#27272a]">
        <div>
          <div class="font-mono text-xs text-[#71717a] uppercase tracking-wider font-semibold">
            // ORTA FORMAT FOTONİK ARŞİV
          </div>
          <h2 class="font-serif text-2xl sm:text-3xl font-normal text-[#ffffff]">
            Son Fotoğraf Galerileri
          </h2>
        </div>
        <a
          href="/galeri"
          class="font-mono text-xs text-[#a1a1aa] hover:text-[#ffffff] hover:underline font-medium flex items-center gap-1"
        >
          <span>tüm galeriyi gez ({galleryData.totalAlbums} albüm)</span>
          <span>→</span>
        </a>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-5">
        {featuredAlbums.map((album) => (
          <a
            href="/galeri"
            class="clean-card bg-[#121215] border border-[#27272a] hover:border-[#3f3f46] group rounded-[22px] overflow-hidden transition-all duration-300 flex flex-col justify-between shadow-xl block"
          >
            <!-- Image Area -->
            <div class="relative aspect-[16/11] w-full overflow-hidden bg-[#18181b]">
              <img
                src={album.coverPhoto}
                alt={`${album.title} serisi - Fotoğraf Arşivi`}
                loading="lazy"
                decoding="async"
                width="600"
                height="412"
                class="w-full h-full object-cover group-hover:scale-103 transition-transform duration-500 ease-out opacity-95 group-hover:opacity-100 pointer-events-none"
              />
              <div class="absolute inset-0 bg-gradient-to-t from-black/70 via-transparent to-transparent opacity-60 group-hover:opacity-40 transition-opacity pointer-events-none"></div>

              <!-- Badges on image -->
              <div class="absolute top-3 left-3 right-3 flex items-center justify-between font-mono text-[10px] z-20 pointer-events-none">
                <span class="glass-badge-dark px-2.5 py-1 rounded-full flex items-center gap-1 shadow-md">
                  <span>{album.location}</span>
                </span>
                <span class="glass-badge-dark px-2.5 py-1 rounded-full font-medium shadow-md">
                  <span>{album.photoCount} Kare</span>
                </span>
              </div>
            </div>

            <!-- Details -->
            <div class="p-4 space-y-2 flex-1 flex flex-col justify-between">
              <div>
                <div class="text-[10px] font-mono text-[#71717a] uppercase tracking-wider">
                  Fujifilm GFX • Orta Format
                </div>
                <h3 class="font-serif text-base font-normal text-[#ffffff] group-hover:text-[#ffffff] leading-snug mt-1">
                  {album.title}
                </h3>
              </div>

              <div class="pt-2 border-t border-[#27272a] flex items-center justify-between font-mono text-[11px] text-[#d4d4d8] group-hover:text-[#ffffff]">
                <span>Albüme Git</span>
                <span>→</span>
              </div>
            </div>
          </a>
        ))}
      </div>
    </section>

    <!-- ================================================================= -->
    <!-- 5. BÖLÜM: DERİNLEMESİNE İNCELEME & ARŞİV                          -->
    <!-- ================================================================= -->
    <section class="rounded-[24px] bg-[#121215] border border-[#27272a] p-6 sm:p-9 flex flex-col md:flex-row items-start md:items-center justify-between gap-6 shadow-xl" aria-label="Derinlemesine İnceleme ve Bağlantılar">
      <div class="space-y-1.5">
        <span class="font-mono text-xs text-[#71717a] uppercase font-semibold block">
          // AÇIK DOKÜMANTASYON & ARŞİV
        </span>
        <h3 class="font-serif text-xl sm:text-2xl font-normal text-[#ffffff]">
          Tüm Kaynaklar ve Veri Katalogları
        </h3>
        <p class="font-serif text-xs sm:text-sm text-[#a1a1aa] max-w-xl">
          Tüm kod depoları, YZ ajanları için biçimlendirilmiş llms.txt içerikleri ve açık veri katalogları herkese açık olarak sunulmaktadır.
        </p>
      </div>

      <div class="flex flex-wrap items-center gap-x-5 gap-y-2.5 font-mono text-xs">
        <a
          href="/projeler"
          class="text-[#a1a1aa] hover:text-[#ffffff] hover:underline font-medium"
        >
          Projeler ↗
        </a>
        <a
          href="/acik-veri"
          class="text-[#a1a1aa] hover:text-[#ffffff] hover:underline font-medium"
        >
          Açık Veri ↗
        </a>
        <a
          href="https://github.com/ozdil"
          target="_blank"
          rel="noopener noreferrer"
          class="text-[#a1a1aa] hover:text-[#ffffff] hover:underline font-medium"
        >
          GitHub ↗
        </a>
        <a
          href="/llms.txt"
          target="_blank"
          class="text-[#a1a1aa] hover:text-[#ffffff] hover:underline font-medium"
        >
          llms.txt ↗
        </a>
        <a
          href="/rss.xml"
          target="_blank"
          class="text-[#a1a1aa] hover:text-[#ffffff] hover:underline font-medium"
        >
          RSS ↗
        </a>
        <a
          href="/hakkimda"
          class="text-[#a1a1aa] hover:text-[#ffffff] hover:underline font-medium"
        >
          Hakkında →
        </a>
      </div>
    </section>

  </div>
</BaseLayout>
