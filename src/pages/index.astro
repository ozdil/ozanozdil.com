---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

// Fetch published blog posts and get the latest 4
const allPosts = await getCollection('blog', ({ data }) => !data.draft);
const latestPosts = allPosts
  .sort((a, b) => new Date(b.data.pubDate).getTime() - new Date(a.data.pubDate).getTime())
  .slice(0, 4);

// Hash tabanlı okunma sayısı algoritması (worker ile senkronize)
function getArticleBaseViews(slug: string): number {
  let hash = 0;
  for (let i = 0; i < slug.length; i++) {
    hash = ((hash << 5) - hash) + slug.charCodeAt(i);
    hash |= 0;
  }
  return 220 + (Math.abs(hash) % 480);
}

// En çok okunan ilk 4 yazı
const topPosts = [...allPosts]
  .map(post => ({
    ...post,
    views: getArticleBaseViews(post.slug)
  }))
  .sort((a, b) => b.views - a.views)
  .slice(0, 4);

const formatDate = (date: Date) => {
  return new Intl.DateTimeFormat('tr-TR', {
    day: '2-digit',
    month: 'short',
    year: 'numeric'
  }).format(date);
};
