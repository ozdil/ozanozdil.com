---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const allPosts = await getCollection('blog', ({ data }) => !data.draft);
const sortedPosts = allPosts.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()).slice(0, 6);

const featuredProjects = [
  {
    name: 'omarchy',
    desc: 'Arch Linux tabanlı, optimize edilmiş yüksek performanslı sistem yapılandırması.',
    lang: 'Shell',
    url: 'https://github.com/ozdil/omarchy'
  },
  {
    name: 'omarchy-cyber-sentinel',
    desc: 'Ağ trafiği izleme, anormallik tespiti ve proaktif sistem savunma modülü.',
    lang: 'Python / Bash',
    url: 'https://github.com/ozdil/omarchy-cyber-sentinel'
  },
  {
    name: 'omarchy-badusb-shield',
    desc: 'Donanımsal USB saldırılarına karşı dinamik aygıt yetkilendirme aracı.',
    lang: 'Shell',
    url: 'https://github.com/ozdil/omarchy-badusb-shield'
  },
  {
    name: 'omarchy-cve-radar',
    desc: 'Sistem paketleri ve bağımlılıklar için güvenlik açığı (CVE) denetleme aracı.',
    lang: 'Python',
    url: 'https://github.com/ozdil/omarchy-cve-radar'
  },
  {
    name: 'omarchy-omasend',
    desc: 'Yerel ağda uçtan uca şifreli, p2p dosya ve veri aktarım protokolü.',
    lang: 'Go / Shell',
    url: 'https://github.com/ozdil/omarchy-omasend'
  },
  {
    name: 'omarchy-omarank',
    desc: 'Linux çekirdeği ve donanım bileşenleri için sentetik performans kıyaslama paketi.',
    lang: 'Rust / C',
    url: 'https://github.com/ozdil/omarchy-omarank'
  }
];
---

<BaseLayout title="Ozan Özdil" currentPath="/">
  <!-- Giriş / Profil -->
  <section class="mb-16 pt-2 sm:pt-6">
    <div class="flex items-center gap-4 mb-6">
      <div class="w-16 h-16 sm:w-20 sm:h-20 rounded-full overflow-hidden border border-zinc-200 dark:border-zinc-800 flex-shrink-0 bg-zinc-100 dark:bg-zinc-800 shadow-xs">
        <img src="/avatar.jpg" alt="Ozan Özdil" class="w-full h-full object-cover" />
      </div>
      <div>
        <h1 class="text-2xl sm:text-3xl font-semibold tracking-tight text-zinc-950 dark:text-zinc-50">
          Ozan Özdil
        </h1>
        <p class="text-sm text-zinc-500 dark:text-zinc-400 mt-0.5 font-normal">
          Orman Mühendisi • Kastamonu, Türkiye
        </p>
      </div>
    </div>

    <div class="space-y-3 text-zinc-600 dark:text-zinc-400 text-base leading-relaxed max-w-2xl font-normal">
      <p>
        Orman mühendisiyim. Linux sistem mimarisi, açık kaynak yazılımlar ve dijital güvenlik üzerine çalışıyorum.
      </p>
      <p>
        Burada kişisel notlarımı, teknik araştırmalarımı ve geliştirdiğim açık kaynak araçları bulabilirsiniz.
      </p>
    </div>

    <div class="flex flex-wrap items-center gap-x-4 gap-y-2 pt-6 text-sm">
      <a href="/blog" class="text-zinc-900 dark:text-zinc-100 hover:underline underline-offset-4 font-medium">
        Yazılar ({allPosts.length})
      </a>
      <span class="text-zinc-300 dark:text-zinc-700">•</span>
      <a href="/projeler" class="text-zinc-900 dark:text-zinc-100 hover:underline underline-offset-4 font-medium">
        Projeler
      </a>
      <span class="text-zinc-300 dark:text-zinc-700">•</span>
      <a href="/hakkimda" class="text-zinc-900 dark:text-zinc-100 hover:underline underline-offset-4 font-medium">
        Hakkımda
      </a>
      <span class="text-zinc-300 dark:text-zinc-700">•</span>
      <a href="https://github.com/ozdil" target="_blank" rel="noopener noreferrer" class="text-zinc-500 dark:text-zinc-400 hover:text-zinc-900 dark:hover:text-zinc-100 transition-colors">
        GitHub
      </a>
      <span class="text-zinc-300 dark:text-zinc-700">•</span>
      <a href="https://nsosyal.com/ozanozdil" target="_blank" rel="noopener noreferrer" class="text-zinc-500 dark:text-zinc-400 hover:text-zinc-900 dark:hover:text-zinc-100 transition-colors">
        NSosyal
      </a>
      <span class="text-zinc-300 dark:text-zinc-700">•</span>
      <a href="https://www.flickr.com/photos/204447030@N04/" target="_blank" rel="noopener noreferrer" class="text-zinc-500 dark:text-zinc-400 hover:text-zinc-900 dark:hover:text-zinc-100 transition-colors">
        Flickr
      </a>
    </div>
  </section>

  <!-- Son Yazılar -->
  <section class="mb-16">
    <div class="flex items-baseline justify-between mb-6 pb-2 border-b border-zinc-200/80 dark:border-zinc-800/80">
      <h2 class="text-xs font-semibold tracking-wider uppercase text-zinc-500 dark:text-zinc-400 font-mono">
        Son Yazılar
      </h2>
      <a href="/blog" class="text-xs text-zinc-500 dark:text-zinc-400 hover:text-zinc-900 dark:hover:text-zinc-100 transition-colors">
        Tüm arşiv ({allPosts.length}) →
      </a>
    </div>

    <div class="divide-y divide-zinc-200/60 dark:divide-zinc-800/60">
      {sortedPosts.map((post) => (
        <article class="py-4 first:pt-0 group">
          <div class="flex flex-col sm:flex-row sm:items-baseline justify-between gap-1 mb-1">
            <h3 class="text-base font-medium">
              <a href={`/blog/${post.slug}`} class="text-zinc-950 dark:text-zinc-50 group-hover:text-blue-600 dark:group-hover:text-blue-400 transition-colors">
                {post.data.title}
              </a>
            </h3>
            <time datetime={post.data.pubDate.toISOString()} class="text-xs font-mono text-zinc-400 dark:text-zinc-500 flex-shrink-0">
              {post.data.pubDate.toLocaleDateString('tr-TR', { day: 'numeric', month: 'short', year: 'numeric' })}
            </time>
          </div>
          {post.data.description && (
            <p class="text-sm text-zinc-600 dark:text-zinc-400 line-clamp-2 leading-relaxed font-normal">
              {post.data.description}
            </p>
          )}
        </article>
      ))}
    </div>
  </section>

  <!-- Açık Kaynak Projeler -->
  <section>
    <div class="flex items-baseline justify-between mb-6 pb-2 border-b border-zinc-200/80 dark:border-zinc-800/80">
      <h2 class="text-xs font-semibold tracking-wider uppercase text-zinc-500 dark:text-zinc-400 font-mono">
        Açık Kaynak Projeler
      </h2>
      <a href="/projeler" class="text-xs text-zinc-500 dark:text-zinc-400 hover:text-zinc-900 dark:hover:text-zinc-100 transition-colors">
        Tüm projeler →
      </a>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
      {featuredProjects.map((p) => (
        <a
          href={p.url}
          target="_blank"
          rel="noopener noreferrer"
          class="group p-4 rounded-xl border border-zinc-200/80 dark:border-zinc-800/80 hover:border-zinc-300 dark:hover:border-zinc-700 bg-white/50 dark:bg-zinc-900/30 transition-all flex flex-col justify-between"
        >
          <div>
            <div class="flex items-center justify-between gap-2 mb-1.5">
              <span class="text-sm font-medium font-mono text-zinc-950 dark:text-zinc-50 group-hover:text-blue-600 dark:group-hover:text-blue-400 transition-colors truncate">
                {p.name}
              </span>
              <span class="text-xs font-mono text-zinc-400 dark:text-zinc-500 flex-shrink-0">
                {p.lang}
              </span>
            </div>
            <p class="text-xs text-zinc-600 dark:text-zinc-400 leading-relaxed font-normal">
              {p.desc}
            </p>
          </div>
        </a>
      ))}
    </div>
  </section>
</BaseLayout>
