---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

// Fetch published blog posts and get the latest 4
const allPosts = await getCollection('blog', ({ data }) => !data.draft);
const latestPosts = allPosts
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 4);

const featuredProjects = [
  {
    name: 'omarchy-omastudio',
    title: 'OmaStudio RAW Editor',
    desc: 'Lightroom kalitesinde, GPU ivmeli ve açık kaynak RAW fotoğraf stüdyosu.',
    lang: 'Rust / QML',
    url: 'https://github.com/ozdil/omarchy-omastudio'
  },
  {
    name: 'omarchy-security-sentinel',
    title: 'Cyber Sentinel',
    desc: 'Omarchy Linux için 9 modüllü yerel ağ ve aygıt savunma kalkanı.',
    lang: 'Rust / QML',
    url: 'https://github.com/ozdil/omarchy-security-sentinel'
  },
  {
    name: 'omarchy-omanotes',
    title: 'OmaNotes E2EE',
    desc: 'Google Keep tarzında, sıfır bilgi AES-256 şifreli güvenli not yöneticisi.',
    lang: 'Rust / QML',
    url: 'https://github.com/ozdil/omarchy-omanotes'
  },
  {
    name: 'omarchy-omasend',
    title: 'OmaSend P2P',
    desc: 'Linux ve Android arasında AirDrop benzeri yerel P2P dosya ve pano aktarımı.',
    lang: 'Rust / Android',
    url: 'https://github.com/ozdil/omarchy-omasend'
  }
];

const formatDate = (date: Date) => {
  return new Intl.DateTimeFormat('tr-TR', {
    day: '2-digit',
    month: 'short',
    year: 'numeric'
  }).format(date);
};
---

<BaseLayout
  title="Ozan Özdil — YZ Kodcusu & Açık Kaynak Geliştirici"
  description="Ozan Özdil: YZ Kodcusu. Açık kaynak sistem mimarileri, Omarchy ve CachyOS takibi, Steam Deck ile Linux oyunculuğu ve fotoğrafçılık."
  currentPath="/"
  maxWidthClass="max-w-3xl"
>
  <div class="py-6 sm:py-10 space-y-12 sm:space-y-14">
    
    <!-- BIO / HERO HEADER -->
    <section class="space-y-4" aria-label="Profil ve Tanıtım">
      <div class="flex items-center gap-4">
        <div class="w-16 h-16 sm:w-20 sm:h-20 rounded-2xl overflow-hidden border border-zinc-200 dark:border-zinc-800 bg-zinc-100 dark:bg-zinc-800 flex-shrink-0 p-0.5 shadow-sm">
          <img
            src="/avatar.webp"
            alt="Ozan Özdil"
            width="80"
            height="80"
            fetchpriority="high"
            decoding="async"
            class="w-full h-full object-cover rounded-xl"
          />
        </div>
        <div>
          <div class="flex flex-wrap items-center gap-2">
            <h1 class="text-2xl sm:text-3xl font-bold tracking-tight text-zinc-950 dark:text-zinc-50 font-sans">
              Ozan Özdil
            </h1>
            <span class="inline-flex items-center gap-1.5 px-2 py-0.5 rounded-full text-[11px] font-mono bg-emerald-500/10 text-emerald-700 dark:text-emerald-400 border border-emerald-500/20">
              <span class="w-1.5 h-1.5 rounded-full bg-emerald-500 animate-pulse"></span>
              açık kaynak
            </span>
          </div>
          <p class="text-xs sm:text-sm font-mono text-zinc-800 dark:text-[#00ffcc] font-medium mt-0.5">
            YZ Kodcusu • Açık Kaynak Geliştirici
          </p>
        </div>
      </div>

      <p class="text-sm sm:text-base text-zinc-600 dark:text-zinc-300 leading-relaxed font-sans max-w-2xl">
        Linux sistem mimarileri, CachyOS ve Omarchy ekosisteminde açık kaynak yazılımlar üretiyorum. Yerel ve bulut yapay zekâ modelleriyle kodlama süreçlerini yönetiyor; taşınabilir donanımlarda (Steam Deck) düşük gecikmeli oyun deneyimi üzerine optimizasyonlar yapıyorum.
      </p>

      <!-- Minimal Quick Links -->
      <div class="flex flex-wrap items-center gap-x-3 sm:gap-x-4 gap-y-2 pt-1 font-mono text-xs text-zinc-500 dark:text-zinc-400">
        <a
          href="https://github.com/ozdil"
          target="_blank"
          rel="noopener noreferrer"
          class="text-zinc-800 dark:text-zinc-300 hover:text-zinc-950 dark:hover:text-[#00ffcc] transition-colors flex items-center gap-1"
        >
          github ↗
        </a>
        <span class="text-zinc-300 dark:text-zinc-700 hidden xs:inline">•</span>
        <a
          href="https://steamcommunity.com/id/ozanozdil"
          target="_blank"
          rel="noopener noreferrer"
          class="text-zinc-800 dark:text-zinc-300 hover:text-zinc-950 dark:hover:text-[#00ffcc] transition-colors flex items-center gap-1"
        >
          steam ↗
        </a>
        <span class="text-zinc-300 dark:text-zinc-700 hidden xs:inline">•</span>
        <a
          href="https://nsosyal.com/ozanozdil"
          target="_blank"
          rel="noopener noreferrer"
          class="text-zinc-800 dark:text-zinc-300 hover:text-zinc-950 dark:hover:text-[#00ffcc] transition-colors flex items-center gap-1"
        >
          nsosyal ↗
        </a>
        <span class="text-zinc-300 dark:text-zinc-700 hidden xs:inline">•</span>
        <a
          href="https://buymeacoffee.com/ozdil"
          target="_blank"
          rel="noopener noreferrer"
          class="text-amber-600 dark:text-amber-400 hover:underline flex items-center gap-1 font-medium"
        >
          kahve ısmarla ☕
        </a>
        <span class="text-zinc-300 dark:text-zinc-700 hidden xs:inline">•</span>
        <a
          href="/rss.xml"
          target="_blank"
          class="text-zinc-500 hover:text-zinc-800 dark:hover:text-[#00ffcc] transition-colors"
        >
          rss ↗
        </a>
      </div>
    </section>

    <!-- FEATURED PROJECTS (Editorial Minimalist List) -->
    <section class="space-y-4" aria-label="Öne Çıkan Projeler">
      <div class="flex items-center justify-between pb-2 border-b border-zinc-200 dark:border-zinc-800">
        <h2 class="font-mono text-xs font-semibold text-zinc-500 dark:text-zinc-400 uppercase tracking-wider">
          // Öne Çıkan Çalışmalar
        </h2>
        <a href="/projeler" class="text-xs font-mono text-zinc-700 dark:text-[#00ffcc] hover:underline font-medium">
          tümünü gör (12) →
        </a>
      </div>

      <div class="divide-y divide-zinc-200 dark:divide-zinc-800/70">
        {featuredProjects.map((p) => (
          <a
            href={p.url}
            target="_blank"
            rel="noopener noreferrer"
            class="py-3.5 px-2 -mx-2 rounded-lg flex items-center justify-between gap-4 group hover:bg-zinc-100/70 dark:hover:bg-zinc-900/40 transition-colors"
          >
            <div class="space-y-1 min-w-0">
              <div class="flex items-center gap-2 font-mono text-xs">
                <span class="font-semibold text-zinc-900 dark:text-zinc-100 group-hover:text-zinc-950 dark:group-hover:text-[#00ffcc] transition-colors">
                  {p.name}
                </span>
                <span class="px-1.5 py-0.5 rounded bg-zinc-100 dark:bg-zinc-800 text-[10px] text-zinc-600 dark:text-zinc-400">
                  {p.lang}
                </span>
              </div>
              <p class="text-xs text-zinc-600 dark:text-zinc-400 font-sans leading-relaxed line-clamp-2 sm:line-clamp-none">
                {p.desc}
              </p>
            </div>
            <span class="text-zinc-400 group-hover:text-zinc-900 dark:group-hover:text-zinc-100 transition-transform group-hover:translate-x-1 font-mono text-xs flex-shrink-0">
              ↗
            </span>
          </a>
        ))}
      </div>
    </section>

    <!-- LATEST POSTS (Editorial Writing List) -->
    <section class="space-y-4" aria-label="Son Blog Yazıları">
      <div class="flex items-center justify-between pb-2 border-b border-zinc-200 dark:border-zinc-800">
        <h2 class="font-mono text-xs font-semibold text-zinc-500 dark:text-zinc-400 uppercase tracking-wider">
          // Son Yazılar
        </h2>
        <a href="/blog" class="text-xs font-mono text-zinc-700 dark:text-[#00ffcc] hover:underline font-medium">
          tüm yazılar ({allPosts.length}) →
        </a>
      </div>

      <div class="divide-y divide-zinc-200 dark:divide-zinc-800/70">
        {latestPosts.map((post) => (
          <a
            href={`/blog/${post.slug}`}
            class="py-3 px-2 -mx-2 rounded-lg flex flex-col sm:flex-row sm:items-center justify-between gap-1 sm:gap-4 group hover:bg-zinc-100/70 dark:hover:bg-zinc-900/40 transition-colors"
          >
            <span class="font-sans text-sm text-zinc-800 dark:text-zinc-200 group-hover:text-zinc-950 dark:group-hover:text-[#00ffcc] transition-colors font-medium">
              {post.data.title}
            </span>
            <span class="text-[11px] font-mono text-zinc-400 dark:text-zinc-500 flex-shrink-0">
              {formatDate(post.data.pubDate)}
            </span>
          </a>
        ))}
      </div>
    </section>

    <!-- EXPERIENCE & FORMATION -->
    <section class="space-y-4" aria-label="Deneyim ve Formasyon">
      <div class="flex items-center justify-between pb-2 border-b border-zinc-200 dark:border-zinc-800">
        <h2 class="font-mono text-xs font-semibold text-zinc-500 dark:text-zinc-400 uppercase tracking-wider">
          // Kısa Özgeçmiş & Deneyim
        </h2>
        <a href="/hakkimda" class="text-xs font-mono text-zinc-500 hover:text-zinc-800 dark:hover:text-zinc-200">
          detaylar →
        </a>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 gap-3.5 font-mono text-xs">
        <div class="p-4 rounded-xl border border-zinc-200 dark:border-zinc-800/80 bg-zinc-50/50 dark:bg-zinc-900/30 space-y-1">
          <div class="text-[10px] text-zinc-900 dark:text-[#00ffcc] font-semibold">2024 - Günümüz</div>
          <div class="text-sm font-sans font-bold text-zinc-900 dark:text-zinc-100">Ar-Ge, Bilgi İşlem & YZ</div>
          <p class="text-[11px] font-sans text-zinc-600 dark:text-zinc-400 leading-relaxed pt-0.5">
            Açık kaynak sistem mimarileri, Wayland masaüstü optimizasyonu ve yapay zekâ destekli kodlama.
          </p>
        </div>

        <div class="p-4 rounded-xl border border-zinc-200 dark:border-zinc-800/80 bg-zinc-50/50 dark:bg-zinc-900/30 space-y-1">
          <div class="text-[10px] text-zinc-500 font-semibold">2019 - 2024</div>
          <div class="text-sm font-sans font-bold text-zinc-900 dark:text-zinc-100">Belediye Başkan Danışmanlığı</div>
          <p class="text-[11px] font-sans text-zinc-600 dark:text-zinc-400 leading-relaxed pt-0.5">
            Kamu yönetimi, kurumsal iletişim stratejileri, kriz yönetimi ve dijital koordinasyon.
          </p>
        </div>

        <div class="p-4 rounded-xl border border-zinc-200 dark:border-zinc-800/80 bg-zinc-50/50 dark:bg-zinc-900/30 space-y-1">
          <div class="text-[10px] text-zinc-500 font-semibold">Sistem & Donanım</div>
          <div class="text-sm font-sans font-bold text-zinc-900 dark:text-zinc-100">Steam Deck & Linux Gaming</div>
          <p class="text-[11px] font-sans text-zinc-600 dark:text-zinc-400 leading-relaxed pt-0.5">
            SteamOS, Proton uyumluluk katmanı, MangoHud ve taşınabilir donanımlarda kare süresi optimizasyonu.
          </p>
        </div>

        <div class="p-4 rounded-xl border border-zinc-200 dark:border-zinc-800/80 bg-zinc-50/50 dark:bg-zinc-900/30 space-y-1">
          <div class="text-[10px] text-zinc-500 font-semibold">Görsel Kültür</div>
          <div class="text-sm font-sans font-bold text-zinc-900 dark:text-zinc-100">Fujifilm GFX Orta Format</div>
          <p class="text-[11px] font-sans text-zinc-600 dark:text-zinc-400 leading-relaxed pt-0.5">
            43.8×32.9mm sensör, kadim Karadeniz ahşap mimarisi ve belgesel odaklı görsel arşiv. <a href="/galeri" class="text-zinc-800 dark:text-[#00ffcc] hover:underline">Galeri ↗</a>
          </p>
        </div>
      </div>
    </section>

  </div>
</BaseLayout>
