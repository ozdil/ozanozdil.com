---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const allPosts = await getCollection('blog', ({ data }) => !data.draft);
const sortedPosts = allPosts.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()).slice(0, 6);

const featuredProjects = [
  {
    name: 'omarchy',
    desc: 'Arch Linux tabanlı, optimize edilmiş sistem yapılandırması.',
    lang: 'Shell',
    url: 'https://github.com/ozdil/omarchy'
  },
  {
    name: 'omarchy-cyber-sentinel',
    desc: 'Ağ trafiği izleme ve anormallik tespit aracı.',
    lang: 'Python / Bash',
    url: 'https://github.com/ozdil/omarchy-cyber-sentinel'
  },
  {
    name: 'omarchy-badusb-shield',
    desc: 'USB aygıt yetkilendirme ve bağlantı güvenliği aracı.',
    lang: 'Shell',
    url: 'https://github.com/ozdil/omarchy-badusb-shield'
  },
  {
    name: 'omarchy-cve-radar',
    desc: 'Sistem paketleri ve bağımlılıklar için güvenlik açığı denetleyici.',
    lang: 'Python',
    url: 'https://github.com/ozdil/omarchy-cve-radar'
  },
  {
    name: 'omarchy-omasend',
    desc: 'Yerel ağda şifreli dosya ve veri aktarım aracı.',
    lang: 'Go / Shell',
    url: 'https://github.com/ozdil/omarchy-omasend'
  },
  {
    name: 'omarchy-omarank',
    desc: 'Linux çekirdeği ve donanım performans kıyaslama paketi.',
    lang: 'Rust / C',
    url: 'https://github.com/ozdil/omarchy-omarank'
  }
];
---

<BaseLayout title="Ozan Özdil" currentPath="/" maxWidthClass="max-w-4xl">
  <div class="space-y-12 py-2 sm:py-4">
    <!-- Hero / Status Header -->
    <header class="pb-6 border-b border-zinc-200/80 dark:border-zinc-800/80">
      <p class="font-mono text-xs font-medium tracking-[0.18em] text-sky-600 dark:text-[#00ffcc] uppercase">
        ozanozdil.com
      </p>
      <h1 class="mt-2 text-3xl sm:text-4xl font-semibold tracking-tight text-zinc-950 dark:text-zinc-50 font-sans leading-tight">
        Ozan Özdil
      </h1>
      <p class="mt-2 text-base text-zinc-600 dark:text-zinc-400 leading-relaxed max-w-2xl font-sans">
        Orman Mühendisi • Linux, Açık Kaynak ve Fotoğraf
      </p>

      <div class="flex flex-wrap items-center gap-2 mt-3 text-xs font-mono text-zinc-500 dark:text-zinc-400">
        <span>{allPosts.length} yazı</span>
        <span>•</span>
        <span>{featuredProjects.length} açık kaynak proje</span>
      </div>
    </header>

    <!-- Recent Posts: Pure Omarchy.org/news/ style -->
    <section>
      <div class="flex items-baseline justify-between border-b border-zinc-200/80 dark:border-zinc-800/80 pb-3 mb-2">
        <h2 class="text-xl sm:text-2xl font-semibold tracking-tight text-zinc-950 dark:text-zinc-50 font-sans">
          Son Yazılar
        </h2>
        <a href="/blog" class="font-mono text-xs text-sky-600 dark:text-[#00ffcc] hover:underline flex items-center gap-1">
          Tüm Yazılar →
        </a>
      </div>

      <ul class="divide-y divide-zinc-200/80 dark:divide-zinc-800/80">
        {sortedPosts.map((post) => (
          <li>
            <a
              href={`/blog/${post.slug}`}
              class="group flex flex-col gap-1 py-4 transition-colors"
            >
              <time datetime={post.data.pubDate.toISOString()} class="font-mono text-xs text-zinc-500 dark:text-zinc-400">
                {post.data.pubDate.toLocaleDateString('tr-TR', { day: 'numeric', month: 'long', year: 'numeric' })}
              </time>
              <span class="flex items-baseline gap-2 font-sans text-base sm:text-lg font-medium text-zinc-950 dark:text-zinc-100 group-hover:text-sky-600 dark:group-hover:text-[#00ffcc] transition-colors">
                <span>{post.data.title}</span>
                <svg viewBox="0 0 24 24" fill="none" aria-hidden="true" class="w-4 h-4 shrink-0 self-center text-zinc-400 dark:text-zinc-500 transition-transform duration-150 ease-out group-hover:translate-x-1 group-hover:text-sky-600 dark:group-hover:text-[#00ffcc]">
                  <path d="M14 5.75L20.25 12L14 18.25" stroke="currentColor" stroke-width="1.5" stroke-linecap="square" />
                  <path d="M19.5 12H3.75" stroke="currentColor" stroke-width="1.5" stroke-linecap="square" />
                </svg>
              </span>
              {post.data.description && (
                <span class="text-xs sm:text-sm leading-relaxed text-zinc-600 dark:text-zinc-400 line-clamp-2">
                  {post.data.description}
                </span>
              )}
            </a>
          </li>
        ))}
      </ul>
    </section>

    <!-- Featured Projects -->
    <section>
      <div class="flex items-baseline justify-between border-b border-zinc-200/80 dark:border-zinc-800/80 pb-3 mb-4">
        <h2 class="text-xl sm:text-2xl font-semibold tracking-tight text-zinc-950 dark:text-zinc-50 font-sans">
          Projeler
        </h2>
        <a href="/projeler" class="font-mono text-xs text-sky-600 dark:text-[#00ffcc] hover:underline flex items-center gap-1">
          Tüm Projeler →
        </a>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 gap-3.5">
        {featuredProjects.map((p) => (
          <a
            href={p.url}
            target="_blank"
            rel="noopener noreferrer"
            class="group p-4 rounded-lg border border-zinc-200/80 dark:border-zinc-800 hover:border-sky-500/50 dark:hover:border-[#00ffcc]/50 bg-white dark:bg-[#0e1117] hover:bg-zinc-50/80 dark:hover:bg-[#12161f] transition-all flex flex-col justify-between"
          >
            <div>
              <div class="flex items-center justify-between gap-2 mb-1.5 font-mono text-xs">
                <span class="font-semibold text-zinc-950 dark:text-zinc-100 group-hover:text-sky-600 dark:group-hover:text-[#00ffcc] transition-colors truncate">
                  {p.name}
                </span>
                <span class="text-[10px] px-1.5 py-0.5 rounded bg-zinc-100 dark:bg-zinc-800 text-zinc-600 dark:text-zinc-400">
                  {p.lang}
                </span>
              </div>
              <p class="text-xs font-sans text-zinc-600 dark:text-zinc-400 leading-relaxed">
                {p.desc}
              </p>
            </div>
            <div class="mt-3 pt-2 border-t border-zinc-100 dark:border-zinc-800/60 flex items-center justify-end font-mono text-[10px] text-zinc-400 dark:text-zinc-500">
              <span class="group-hover:text-sky-600 dark:group-hover:text-[#00ffcc] transition-colors">GitHub →</span>
            </div>
          </a>
        ))}
      </div>
    </section>
  </div>
</BaseLayout>
