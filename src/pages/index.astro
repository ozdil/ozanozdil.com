  <!-- Ultra-Fast 0ms Client-Side Controller -->
  <script is:inline>
    (() => {
      // 1. Card Tab Switching (HUD vs QML)
      document.addEventListener('click', (e) => {
        const tabBtn = e.target.closest('.qs-tab-btn');
        if (tabBtn) {
          const card = tabBtn.closest('.qs-card');
          if (!card) return;
          const targetTab = tabBtn.dataset.tab;
          
          card.querySelectorAll('.qs-tab-btn').forEach(b => {
            b.classList.remove('active', 'bg-white', 'dark:bg-[#0c0e12]', 'text-zinc-950', 'dark:text-[#00ffcc]', 'font-semibold');
            b.classList.add('text-zinc-600', 'dark:text-zinc-400');
          });
          tabBtn.classList.add('active', 'bg-white', 'dark:bg-[#0c0e12]', 'text-zinc-950', 'dark:text-[#00ffcc]', 'font-semibold');
          tabBtn.classList.remove('text-zinc-600', 'dark:text-zinc-400');

          const hudView = card.querySelector('.qs-card-hud');
          const qmlView = card.querySelector('.qs-card-qml');
          if (targetTab === 'qml') {
            hudView?.classList.add('hidden');
            qmlView?.classList.remove('hidden');
          } else {
            hudView?.classList.remove('hidden');
            qmlView?.classList.add('hidden');
          }
          return;
        }

        // 2. Global Mode Switcher
        const globalBtn = e.target.closest('.qs-global-btn');
        if (globalBtn) {
          const mode = globalBtn.dataset.globalMode;
          document.querySelectorAll('.qs-global-btn').forEach(b => {
            b.classList.remove('active', 'bg-white', 'dark:bg-[#0c0e12]', 'text-zinc-950', 'dark:text-[#00ffcc]', 'shadow-2xs');
            b.classList.add('text-zinc-600', 'dark:text-zinc-400');
          });
          globalBtn.classList.add('active', 'bg-white', 'dark:bg-[#0c0e12]', 'text-zinc-950', 'dark:text-[#00ffcc]', 'shadow-2xs');
          globalBtn.classList.remove('text-zinc-600', 'dark:text-zinc-400');

          const root = document.getElementById('qs-desktop-root');
          if (!root) return;

          const topHud = root.querySelector('.qs-view-hud');
          const topQml = root.querySelector('.qs-view-qml');

          if (mode === 'qml') {
            topHud?.classList.add('hidden');
            topQml?.classList.remove('hidden');
            root.querySelectorAll('.qs-card').forEach(card => {
              card.querySelector('.qs-card-hud')?.classList.add('hidden');
              card.querySelector('.qs-card-qml')?.classList.remove('hidden');
              card.querySelectorAll('.qs-tab-btn').forEach(b => {
                const isQml = b.dataset.tab === 'qml';
                b.classList.toggle('active', isQml);
                b.classList.toggle('bg-white', isQml);
                b.classList.toggle('dark:bg-[#0c0e12]', isQml);
                b.classList.toggle('text-zinc-950', isQml);
                b.classList.toggle('dark:text-[#00ffcc]', isQml);
                b.classList.toggle('font-semibold', isQml);
              });
            });
          } else if (mode === 'hybrid') {
            topHud?.classList.remove('hidden');
            topQml?.classList.remove('hidden');
            root.querySelectorAll('.qs-card').forEach(card => {
              card.querySelector('.qs-card-hud')?.classList.remove('hidden');
              card.querySelector('.qs-card-qml')?.classList.remove('hidden');
            });
          } else {
            // Default HUD
            topHud?.classList.remove('hidden');
            topQml?.classList.add('hidden');
            root.querySelectorAll('.qs-card').forEach(card => {
              card.querySelector('.qs-card-hud')?.classList.remove('hidden');
              card.querySelector('.qs-card-qml')?.classList.add('hidden');
              card.querySelectorAll('.qs-tab-btn').forEach(b => {
                const isHud = b.dataset.tab === 'hud';
                b.classList.toggle('active', isHud);
                b.classList.toggle('bg-white', isHud);
                b.classList.toggle('dark:bg-[#0c0e12]', isHud);
                b.classList.toggle('text-zinc-950', isHud);
                b.classList.toggle('dark:text-[#00ffcc]', isHud);
                b.classList.toggle('font-semibold', isHud);
              });
            });
          }
          return;
        }

        // 3. Copy QML Buttons
        const copyBtn = e.target.closest('.qs-copy-btn, .qs-copy-card-btn');
        if (copyBtn) {
          const targetId = copyBtn.dataset.copyTarget || copyBtn.dataset.copySrc;
          const targetEl = document.getElementById(targetId);
          if (targetEl) {
            navigator.clipboard.writeText(targetEl.innerText).then(() => {
              const prevText = copyBtn.innerHTML;
              copyBtn.innerHTML = '<span class="text-[#00ffcc] font-mono text-[10px]">✓ Kopyalandı</span>';
              setTimeout(() => {
                copyBtn.innerHTML = prevText;
              }, 1800);
            });
          }
        }
      });
    })();
  </script>
</BaseLayout>
