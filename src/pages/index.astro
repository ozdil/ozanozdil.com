---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Ozan Özdil"
  description="Ozan Özdil: Orman Mühendisi. Linux, açık kaynak, sistem araçları, QuickShell ve orta format fotoğrafçılık."
  currentPath="/"
  maxWidthClass="max-w-[1720px]"
>
  <div class="space-y-6 py-2 sm:py-4" id="qs-desktop-root">
    <!-- Master QuickShell Control HUD & Mode Selector -->
    <div class="rounded-xl border border-zinc-200/90 dark:border-zinc-800/90 bg-white dark:bg-[#0c0e12] overflow-hidden shadow-2xs">
      <!-- Titlebar -->
      <div class="px-4 py-2.5 bg-zinc-50 dark:bg-[#12151d] border-b border-zinc-100 dark:border-zinc-800/80 flex flex-wrap items-center justify-between gap-2 font-mono text-[11px]">
        <div class="flex items-center gap-2">
          <span class="flex items-center gap-1.5 opacity-80">
            <span class="w-2 h-2 rounded-full bg-rose-500/80"></span>
            <span class="w-2 h-2 rounded-full bg-amber-500/80"></span>
            <span class="w-2 h-2 rounded-full bg-emerald-500/80"></span>
          </span>
          <span class="text-zinc-600 dark:text-zinc-300 font-bold ml-1">
            Quickshell Desktop Core // Omarchy IPC
          </span>
          <span class="hidden sm:inline text-zinc-400 dark:text-zinc-500">::</span>
          <span class="hidden sm:inline text-sky-600 dark:text-[#00ffcc] font-mono">
            qs://desktop/session.qml
          </span>
        </div>

        <!-- Global Mode Toggles (0ms Instant Switch) -->
        <div class="flex items-center gap-1 bg-zinc-200/60 dark:bg-[#161a24] p-0.5 rounded-lg border border-zinc-300/60 dark:border-zinc-700/60">
          <button
            type="button"
            data-global-mode="hud"
            class="qs-global-btn active px-2.5 py-1 rounded-md text-[10px] font-mono font-semibold transition-all cursor-pointer bg-white dark:bg-[#0c0e12] text-zinc-950 dark:text-[#00ffcc] shadow-2xs"
            title="Görsel QuickShell Arayüzü"
          >
            [01] HUD Arayüzü
          </button>
          <button
            type="button"
            data-global-mode="qml"
            class="qs-global-btn px-2.5 py-1 rounded-md text-[10px] font-mono font-semibold transition-all cursor-pointer text-zinc-600 dark:text-zinc-400 hover:text-zinc-950 dark:hover:text-zinc-100"
            title="Saf QML Kaynak Kodu"
          >
            [02] QML Kaynağı
          </button>
          <button
            type="button"
            data-global-mode="hybrid"
            class="qs-global-btn px-2.5 py-1 rounded-md text-[10px] font-mono font-semibold transition-all cursor-pointer text-zinc-600 dark:text-zinc-400 hover:text-zinc-950 dark:hover:text-zinc-100 hidden sm:inline-flex"
            title="Ayrık / Hibrit Görünüm"
          >
            [03] Ayrık Görünüm
          </button>
        </div>
      </div>

      <!-- Hero Header Content -->
      <div class="p-5 sm:p-7 lg:p-8">
        <!-- Rendered HUD View -->
        <div class="qs-view-hud flex flex-col lg:flex-row lg:items-center justify-between gap-6">
          <!-- Left: Identity -->
          <div class="flex flex-col sm:flex-row items-start sm:items-center gap-5">
            <div class="relative w-20 h-20 sm:w-24 sm:h-24 lg:w-26 lg:h-26 rounded-xl overflow-hidden border border-zinc-300 dark:border-zinc-700 flex-shrink-0 bg-zinc-100 dark:bg-zinc-800 shadow-xs p-0.5">
              <img src="/avatar.webp" alt="Ozan Özdil" width="104" height="104" fetchpriority="high" decoding="async" class="w-full h-full object-cover rounded-lg" />
              <span class="absolute bottom-1 right-1 w-3 h-3 rounded-full bg-emerald-500 border-2 border-white dark:border-[#0c0e12]"></span>
            </div>
            <div class="space-y-1.5">
              <div class="flex items-center gap-2">
                <span class="font-mono text-xs font-semibold tracking-[0.16em] text-sky-600 dark:text-[#00ffcc] uppercase">
                  Orman Mühendisi
                </span>
                <span class="text-zinc-400 text-xs hidden sm:inline">•</span>
                <span class="font-mono text-xs text-zinc-600 dark:text-zinc-400 hidden sm:inline">
                  Linux Mimarisi
                </span>
              </div>
              <h1 class="text-2xl sm:text-3xl lg:text-4xl font-bold tracking-tight text-zinc-950 dark:text-zinc-50 font-sans">
                Ozan Özdil
              </h1>
              <p class="text-sm sm:text-base text-zinc-600 dark:text-zinc-300 leading-relaxed font-sans max-w-xl">
                Linux, Omarchy, QuickShell, Açık Kaynak Sistem Mimarisi ve Orta Format Fotoğrafçılık.
              </p>
              <!-- QML Property Badges -->
              <div class="flex flex-wrap items-center gap-1.5 pt-1 text-xs font-mono">
                <span class="px-2 py-0.5 rounded bg-zinc-100 dark:bg-zinc-800/80 text-zinc-700 dark:text-zinc-300 border border-zinc-200/80 dark:border-zinc-700/80 text-[11px]">
                  Kastamonu, TR
                </span>
                <span class="px-2 py-0.5 rounded bg-emerald-50 dark:bg-emerald-950/40 text-emerald-700 dark:text-emerald-400 border border-emerald-200/60 dark:border-emerald-800/60 text-[11px]">
                  KTÜ Orman
                </span>
                <span class="px-2 py-0.5 rounded bg-cyan-50 dark:bg-cyan-950/40 text-cyan-700 dark:text-[#00ffcc] border border-cyan-200/60 dark:border-cyan-800/60 text-[11px]">
                  QuickShell / QML
                </span>
                <span class="px-2 py-0.5 rounded bg-rose-50 dark:bg-rose-950/40 text-rose-700 dark:text-rose-400 border border-rose-200/60 dark:border-rose-800/60 text-[11px]">
                  Linux Oyuncusu
                </span>
              </div>
            </div>
          </div>

          <!-- Right: System Telemetry Strip (Desktop) -->
          <div class="hidden lg:grid grid-cols-2 gap-2 font-mono text-[11px] min-w-[300px]">
            <div class="p-2.5 rounded-lg bg-zinc-50 dark:bg-[#12151d] border border-zinc-200/80 dark:border-zinc-800/80">
              <span class="text-zinc-600 dark:text-zinc-400 block text-[10px]">OS / Compositor</span>
              <span class="text-zinc-800 dark:text-zinc-200 font-semibold truncate block">Arch / Hyprland</span>
            </div>
            <div class="p-2.5 rounded-lg bg-zinc-50 dark:bg-[#12151d] border border-zinc-200/80 dark:border-zinc-800/80">
              <span class="text-zinc-600 dark:text-zinc-400 block text-[10px]">Kabuk Çekirdeği</span>
              <span class="text-[#00ffcc] font-semibold truncate block">QuickShell (C++/QML)</span>
            </div>
            <div class="p-2.5 rounded-lg bg-zinc-50 dark:bg-[#12151d] border border-zinc-200/80 dark:border-zinc-800/80">
              <span class="text-zinc-600 dark:text-zinc-400 block text-[10px]">Optik Sistem</span>
              <span class="text-zinc-800 dark:text-zinc-200 font-semibold truncate block">Fujifilm GFX Orta Format</span>
            </div>
            <div class="p-2.5 rounded-lg bg-zinc-50 dark:bg-[#12151d] border border-zinc-200/80 dark:border-zinc-800/80">
              <span class="text-zinc-600 dark:text-zinc-400 block text-[10px]">Tema Teorisi</span>
              <span class="text-purple-400 font-semibold truncate block">OLED #000000</span>
            </div>
          </div>
        </div>

        <!-- Pure QML Code View -->
        <div class="qs-view-qml hidden">
          <div class="relative rounded-lg bg-[#090b10] border border-zinc-800 p-4 font-mono text-xs text-zinc-300 overflow-x-auto leading-relaxed">
            <button
              type="button"
              class="qs-copy-btn absolute top-3 right-3 px-2 py-1 rounded bg-zinc-800 hover:bg-zinc-700 text-zinc-300 text-[10px] font-mono transition-all"
              data-copy-target="qml-session-code"
            >
              Kopyala
            </button>
            <pre id="qml-session-code" class="text-zinc-300"><code><span class="text-purple-400">import</span> Quickshell
<span class="text-purple-400">import</span> QtQuick
<span class="text-purple-400">import</span> QtQuick.Layouts

<span class="text-sky-400">Scope</span> &#123;
    <span class="text-amber-400">id</span>: <span class="text-[#00ffcc]">userSession</span>

    <span class="text-purple-400">property string</span> <span class="text-amber-300">user</span>: <span class="text-emerald-300">"Ozan Özdil"</span>
    <span class="text-purple-400">property string</span> <span class="text-amber-300">title</span>: <span class="text-emerald-300">"Orman Mühendisi (KTÜ)"</span>
    <span class="text-purple-400">property string</span> <span class="text-amber-300">status</span>: <span class="text-emerald-300">"ONLINE"</span>
    <span class="text-purple-400">property string</span> <span class="text-amber-300">location</span>: <span class="text-emerald-300">"Kastamonu, TR"</span>
    <span class="text-purple-400">property url</span> <span class="text-amber-300">avatar</span>: <span class="text-emerald-300">"https://ozanozdil.com/avatar.webp"</span>

    <span class="text-purple-400">readonly property var</span> <span class="text-amber-300">telemetry</span>: (&#123;
        <span class="text-sky-300">os</span>: <span class="text-emerald-300">"Arch Linux // Hyprland Wayland Compositor"</span>,
        <span class="text-sky-300">shellEngine</span>: <span class="text-emerald-300">"QuickShell (C++ / Reactive QML Engine)"</span>,
        <span class="text-sky-300">optics</span>: <span class="text-emerald-300">"Fujifilm GFX 50R + GF20-35mm + GF55mm f/1.7"</span>,
        <span class="text-sky-300">displayTheory</span>: <span class="text-emerald-300">"Pure OLED Black (#000000) High Contrast"</span>
    &#125;)
&#125;</code></pre>
          </div>
        </div>
      </div>
    </div>

    <!-- Main 12-Column Responsive Dashboard Layout -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-6 items-start">
      <!-- LEFT / MAIN CONTENT AREA (8 Cols on Desktop) -->
      <div class="lg:col-span-8 space-y-6">
        <!-- Biography Module: qs://desktop/biography.qml -->
        <article class="rounded-xl border border-zinc-200/90 dark:border-zinc-800/90 bg-white dark:bg-[#0c0e12] overflow-hidden shadow-2xs qs-card" data-card-id="biography">
          <!-- Titlebar -->
          <div class="px-4 py-2 bg-zinc-50 dark:bg-[#12151d] border-b border-zinc-100 dark:border-zinc-800/80 flex items-center justify-between font-mono text-[11px]">
            <div class="flex items-center gap-2">
              <span class="w-1.5 h-1.5 rounded-full bg-sky-500"></span>
              <h2 class="text-zinc-600 dark:text-zinc-300 font-medium">Biyografi // qs://desktop/biography.qml</h2>
            </div>
            <div class="flex items-center gap-2">
              <div class="flex items-center gap-1 bg-zinc-200/50 dark:bg-zinc-800/60 p-0.5 rounded">
                <button type="button" class="qs-tab-btn active px-2 py-0.5 rounded text-[10px] font-mono font-semibold text-zinc-950 dark:text-[#00ffcc] bg-white dark:bg-[#0c0e12]" data-tab="hud">HUD</button>
                <button type="button" class="qs-tab-btn px-2 py-0.5 rounded text-[10px] font-mono text-zinc-600 dark:text-zinc-400" data-tab="qml">QML</button>
              </div>
              <button type="button" class="qs-copy-card-btn text-zinc-400 hover:text-zinc-900 dark:hover:text-white p-1 rounded" title="QML Kodunu Kopyala" data-copy-src="qml-bio-code">
                <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect width="14" height="14" x="8" y="8" rx="2"/><path d="M4 16c-1.1 0-2-.9-2-2V4c0-1.1.9-2 2-2h10c1.1 0 2 .9 2 2"/></svg>
              </button>
            </div>
          </div>

          <!-- HUD Content -->
          <div class="qs-card-hud p-5 sm:p-6 space-y-4">
            <!-- Item 1: Academic -->
            <div class="p-4 rounded-lg bg-zinc-50/70 dark:bg-[#101319] border border-zinc-200/70 dark:border-zinc-800/70 space-y-1.5">
              <div class="flex items-center justify-between font-mono text-xs">
                <span class="text-sky-600 dark:text-[#00ffcc] font-semibold">[01 // AcademicFormation]</span>
                <span class="text-[10px] text-zinc-500 dark:text-zinc-400">KTÜ Orman</span>
              </div>
              <p class="font-sans text-sm sm:text-base text-zinc-700 dark:text-zinc-300 leading-relaxed">
                Karadeniz Teknik Üniversitesi Orman Fakültesi mezunuyum. Orman mühendisliği formasyonunun kazandırdığı ekosistem dinamikleri ve analitik bakış açısı, teknolojiye ve yazılım dünyasına yaklaşımımın da temelini oluşturuyor.
              </p>
            </div>

            <!-- Item 2: Public Sector -->
            <div class="p-4 rounded-lg bg-zinc-50/70 dark:bg-[#101319] border border-zinc-200/70 dark:border-zinc-800/70 space-y-1.5">
              <div class="flex items-center justify-between font-mono text-xs">
                <span class="text-emerald-600 dark:text-emerald-400 font-semibold">[02 // ExecutiveExperience]</span>
                <span class="text-[10px] text-zinc-500 dark:text-zinc-400">Yönetim & Bilişim</span>
              </div>
              <p class="font-sans text-sm sm:text-base text-zinc-700 dark:text-zinc-300 leading-relaxed">
                Kamu yönetimi, kurumsal iletişim ve yerel yönetim süreçlerinde görev aldım. Belediye başkan danışmanlığı ile Ar-Ge ve Bilgi İşlem yöneticiliği görevlerinde bulundum; dijital iletişim süreçleri, kriz yönetimi ve kurumsal bilişim altyapılarını koordine ettim.
              </p>
            </div>

            <!-- Item 3: System Architecture -->
            <div class="p-4 rounded-lg bg-zinc-50/70 dark:bg-[#101319] border border-zinc-200/70 dark:border-zinc-800/70 space-y-1.5">
              <div class="flex items-center justify-between font-mono text-xs">
                <span class="text-purple-600 dark:text-purple-400 font-semibold">[03 // SystemArchitecture]</span>
                <span class="text-[10px] text-zinc-500 dark:text-zinc-400">Omarchy / Wayland</span>
              </div>
              <p class="font-sans text-sm sm:text-base text-zinc-700 dark:text-zinc-300 leading-relaxed">
                Açık kaynak ekosisteminde Arch Linux tabanlı kişisel masaüstü yapılandırmam (<a href="https://github.com/ozdil/omarchy" target="_blank" rel="noopener noreferrer" class="text-sky-600 dark:text-[#00ffcc] font-medium underline underline-offset-4 hover:opacity-80">Omarchy</a>), C++/QML tabanlı QuickShell bileşenleri, Wayland katman protokolleri ve sistem güvenlik araçları geliştiriyorum.
              </p>
            </div>

            <!-- Item 4: Gaming Telemetry -->
            <div class="p-4 rounded-lg bg-zinc-50/70 dark:bg-[#101319] border border-zinc-200/70 dark:border-zinc-800/70 space-y-1.5">
              <div class="flex items-center justify-between font-mono text-xs">
                <span class="text-rose-600 dark:text-rose-400 font-semibold">[04 // LinuxGamingTelemetry]</span>
                <span class="text-[10px] text-zinc-500 dark:text-zinc-400">Wayland + Proton</span>
              </div>
              <p class="font-sans text-sm sm:text-base text-zinc-700 dark:text-zinc-300 leading-relaxed">
                Aynı zamanda bir Linux oyuncusu olarak Wayland ve Proton üzerinde düşük gecikmeli oyun deneyimi, simülasyon konfigürasyonları ve kare süresi (frametime) telemetrisi üzerine çalışıyorum.
              </p>
            </div>
          </div>

          <!-- QML View -->
          <div class="qs-card-qml hidden p-4 sm:p-6 bg-[#090b10] overflow-x-auto text-xs font-mono text-zinc-300 leading-relaxed">
            <pre id="qml-bio-code" class="text-zinc-300"><code><span class="text-purple-400">import</span> Quickshell
<span class="text-purple-400">import</span> QtQuick
<span class="text-purple-400">import</span> QtQuick.Layouts

<span class="text-sky-400">Scope</span> &#123;
    <span class="text-amber-400">id</span>: <span class="text-[#00ffcc]">biographyScope</span>
    <span class="text-purple-400">property string</span> <span class="text-amber-300">subject</span>: <span class="text-emerald-300">"Ozan Özdil"</span>

    <span class="text-sky-400">AcademicFormation</span> &#123;
        <span class="text-amber-300">faculty</span>: <span class="text-emerald-300">"Karadeniz Teknik Üniversitesi (KTÜ)"</span>
        <span class="text-amber-300">discipline</span>: <span class="text-emerald-300">"Orman Mühendisliği"</span>
        <span class="text-amber-300">perspective</span>: <span class="text-emerald-300">"Orman mühendisliği formasyonunun kazandırdığı ekosistem dinamikleri ve analitik bakış açısı, teknolojiye ve yazılım dünyasına yaklaşımımın da temelini oluşturuyor."</span>
    &#125;

    <span class="text-sky-400">ExecutiveExperience</span> &#123;
        <span class="text-amber-300">domain</span>: <span class="text-emerald-300">"Kamu Yönetimi, Kurumsal İletişim ve Yerel Yönetim"</span>
        <span class="text-amber-300">executiveRoles</span>: [<span class="text-emerald-300">"Belediye Başkan Danışmanlığı"</span>, <span class="text-emerald-300">"Ar-Ge & Bilgi İşlem Yöneticiliği"</span>]
        <span class="text-amber-300">narrative</span>: <span class="text-emerald-300">"Kamu yönetimi, kurumsal iletişim ve yerel yönetim süreçlerinde görev aldım. Belediye başkan danışmanlığı ile Ar-Ge ve Bilgi İşlem yöneticiliği görevlerinde bulundum; dijital iletişim süreçleri, kriz yönetimi ve kurumsal bilişim altyapılarını koordine ettim."</span>
    &#125;

    <span class="text-sky-400">SystemArchitecture</span> &#123;
        <span class="text-amber-300">distribution</span>: <span class="text-emerald-300">"Omarchy (Arch Linux Based)"</span>
        <span class="text-amber-300">stack</span>: [<span class="text-emerald-300">"C++"</span>, <span class="text-emerald-300">"QuickShell"</span>, <span class="text-emerald-300">"Wayland Protocols"</span>, <span class="text-emerald-300">"QML Layers"</span>]
        <span class="text-amber-300">narrative</span>: <span class="text-emerald-300">"Açık kaynak ekosisteminde Arch Linux tabanlı kişisel masaüstü yapılandırmam (Omarchy), C++/QML tabanlı QuickShell bileşenleri, Wayland katman protokolleri ve sistem güvenlik araçları geliştiriyorum."</span>
    &#125;

    <span class="text-sky-400">GamingTelemetry</span> &#123;
        <span class="text-amber-300">platform</span>: <span class="text-emerald-300">"Linux Gaming // Wayland + Proton"</span>
        <span class="text-amber-300">metrics</span>: [<span class="text-emerald-300">"Düşük Gecikme"</span>, <span class="text-emerald-300">"Frametime Telemetrisi"</span>, <span class="text-emerald-300">"Simülasyon Ayarları"</span>]
        <span class="text-amber-300">narrative</span>: <span class="text-emerald-300">"Aynı zamanda bir Linux oyuncusu olarak Wayland ve Proton üzerinde düşük gecikmeli oyun deneyimi, simülasyon konfigürasyonları ve kare süresi (frametime) telemetrisi üzerine çalışıyorum."</span>
    &#125;
&#125;</code></pre>
          </div>
        </article>

        <!-- Focus & Skills Applets: qs://desktop/focus.qml -->
        <article class="rounded-xl border border-zinc-200/90 dark:border-zinc-800/90 bg-white dark:bg-[#0c0e12] overflow-hidden shadow-2xs qs-card" data-card-id="focus">
          <!-- Titlebar -->
          <div class="px-4 py-2 bg-zinc-50 dark:bg-[#12151d] border-b border-zinc-100 dark:border-zinc-800/80 flex items-center justify-between font-mono text-[11px]">
            <div class="flex items-center gap-2">
              <span class="w-1.5 h-1.5 rounded-full bg-[#00ffcc]"></span>
              <h2 class="text-zinc-600 dark:text-zinc-300 font-medium">İlgi Alanları & Odaklar // qs://desktop/focus.qml</h2>
            </div>
            <div class="flex items-center gap-2">
              <div class="flex items-center gap-1 bg-zinc-200/50 dark:bg-zinc-800/60 p-0.5 rounded">
                <button type="button" class="qs-tab-btn active px-2 py-0.5 rounded text-[10px] font-mono font-semibold text-zinc-950 dark:text-[#00ffcc] bg-white dark:bg-[#0c0e12]" data-tab="hud">HUD</button>
                <button type="button" class="qs-tab-btn px-2 py-0.5 rounded text-[10px] font-mono text-zinc-600 dark:text-zinc-400" data-tab="qml">QML</button>
              </div>
              <button type="button" class="qs-copy-card-btn text-zinc-400 hover:text-zinc-900 dark:hover:text-white p-1 rounded" title="QML Kodunu Kopyala" data-copy-src="qml-focus-code">
                <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect width="14" height="14" x="8" y="8" rx="2"/><path d="M4 16c-1.1 0-2-.9-2-2V4c0-1.1.9-2 2-2h10c1.1 0 2 .9 2 2"/></svg>
              </button>
            </div>
          </div>

          <!-- HUD Content -->
          <div class="qs-card-hud p-5 sm:p-6 grid grid-cols-1 sm:grid-cols-2 gap-3.5">
            <!-- Applet 1 -->
            <div class="p-4 rounded-lg border border-zinc-200/80 dark:border-zinc-800/80 bg-zinc-50/50 dark:bg-[#101319] hover:border-sky-500/60 dark:hover:border-[#00ffcc]/60 transition-colors">
              <div class="flex items-center gap-2 mb-2">
                <span class="text-xs font-mono text-sky-600 dark:text-[#00ffcc] font-bold">[SHELL]</span>
                <h3 class="text-sm font-semibold text-zinc-950 dark:text-zinc-100 font-sans">QuickShell & QML</h3>
              </div>
              <p class="text-xs sm:text-sm text-zinc-600 dark:text-zinc-400 leading-relaxed font-sans">
                Wayland katmanları, reaktif QML widget'ları, tek süreçli masaüstü kabuğu ve Omarchy arayüzleri.
              </p>
            </div>

            <!-- Applet 2 -->
            <div class="p-4 rounded-lg border border-zinc-200/80 dark:border-zinc-800/80 bg-zinc-50/50 dark:bg-[#101319] hover:border-sky-500/60 dark:hover:border-[#00ffcc]/60 transition-colors">
              <div class="flex items-center gap-2 mb-2">
                <span class="text-xs font-mono text-emerald-600 dark:text-emerald-400 font-bold">[SEC]</span>
                <h3 class="text-sm font-semibold text-zinc-950 dark:text-zinc-100 font-sans">Sistem Güvenliği</h3>
              </div>
              <p class="text-xs sm:text-sm text-zinc-600 dark:text-zinc-400 leading-relaxed font-sans">
                BadUSB Shield, paket güvenlik açığı taramaları (CVE Radar) ve yerel ağ denetim araçları.
              </p>
