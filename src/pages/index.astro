---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

// Fetch published blog posts and get the latest 4
const allPosts = await getCollection('blog', ({ data }) => !data.draft);
const latestPosts = allPosts
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 4);

const formatDate = (date: Date) => {
  return new Intl.DateTimeFormat('tr-TR', {
    day: '2-digit',
    month: 'short',
    year: 'numeric'
  }).format(date);
};
---

<BaseLayout
  title="Ozan Özdil — YZ Kodcusu & Açık Kaynak Geliştirici"
  description="Ozan Özdil: YZ Kodcusu. Açık kaynak sistem mimarileri, Omarchy ve CachyOS takibi, Steam Deck ile Linux oyunculuğu ve orta format fotoğrafçılık."
  currentPath="/"
  maxWidthClass="max-w-5xl"
>
  <div class="space-y-20 sm:space-y-32 py-8 sm:py-16">

    <!-- ================================================================= -->
    <!-- BLOCK 1: EDITORIAL HERO (AIRY, CENTRED, REFINED)                 -->
    <!-- ================================================================= -->
    <section class="text-center space-y-8 sm:space-y-12 pt-4 sm:pt-8" aria-label="Giriş ve Kimlik">
      <!-- Minimal Identity Badge -->
      <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full text-xs font-mono bg-[#F5F0E4] dark:bg-[#1f1a17] text-[#5D524B] dark:text-[#a89f91] border border-[#ead9d2]/80 dark:border-[#2d2521]">
        <span class="w-2 h-2 rounded-full bg-[#e1734b] dark:bg-[#e59a7a] animate-pulse"></span>
        <span class="tracking-widest">// AÇIK KAYNAK • YZ KODCUSU • SİSTEM MİMARİSİ</span>
      </div>

      <!-- Main Headline (Editorial Serif Display) -->
      <div class="space-y-6 max-w-3xl mx-auto">
        <h1 class="font-serif text-5xl sm:text-7xl lg:text-8xl font-normal text-[#2d2724] dark:text-[#fef9ed] leading-[1.12]">
          Ozan Özdil
        </h1>
        <p class="font-serif text-xl sm:text-2xl text-[#5D524B] dark:text-[#a89f91] leading-relaxed font-normal">
          Yapay zekâ destekli kodlama süreçleri, açık kaynak sistem mimarileri ve dijital egemenlik üzerine çalışan bağımsız bir araştırmacı.
        </p>
      </div>

      <!-- Metadata Tags -->
      <div class="flex flex-wrap items-center justify-center gap-2 pt-2 font-mono text-xs text-[#8C7E74] dark:text-[#a89f91]">
        <span class="px-3 py-1 rounded-full bg-[#F5F0E4] dark:bg-[#1f1a17] border border-[#ead9d2] dark:border-[#2d2521]">
          Kastamonu, TR
        </span>
        <span class="px-3 py-1 rounded-full bg-[#F5F0E4] dark:bg-[#1f1a17] border border-[#ead9d2] dark:border-[#2d2521]">
          Omarchy & CachyOS
        </span>
        <span class="px-3 py-1 rounded-full bg-[#F5F0E4] dark:bg-[#1f1a17] border border-[#ead9d2] dark:border-[#2d2521]">
          Steam Deck
        </span>
        <span class="px-3 py-1 rounded-full bg-[#F5F0E4] dark:bg-[#1f1a17] border border-[#ead9d2] dark:border-[#2d2521]">
          16-Bit Orta Format
        </span>
      </div>

      <!-- Hero Visual Frame (Editorial Art Frame) -->
      <div class="pt-6 max-w-4xl mx-auto">
        <div class="relative rounded-[26px] sm:rounded-[32px] overflow-hidden border border-[#ead9d2]/80 dark:border-[#2d2521] bg-[#F5F0E4] dark:bg-[#1f1a17] aspect-[16/8] sm:aspect-[21/9] shadow-sm group">
          <img
            src="/images/xiaomi-18-ultra-hero.webp"
            alt="Ozan Özdil Mühendislik ve Teknoloji Çalışmaları"
            width="1920"
            height="820"
            fetchpriority="high"
            decoding="async"
            class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-700 ease-out"
          />
          <div class="absolute inset-0 bg-gradient-to-t from-[#2d2724]/65 via-transparent to-transparent flex items-end p-6 sm:p-8 text-left">
            <div class="space-y-1">
              <span class="font-mono text-xs text-[#fef9ed]/80 uppercase tracking-widest">
                // Donanım & Fotonik Analizleri
              </span>
              <p class="font-serif text-base sm:text-xl text-[#fef9ed] font-normal">
                Pazarlama illüzyonlarını yıkan saf donanım ve katı hal elektroniği araştırmaları.
              </p>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- ================================================================= -->
    <!-- BLOCK 2: ALTERNATING SPLIT FEATURE ROWS                          -->
    <!-- ================================================================= -->
    <section class="space-y-20 sm:space-y-32" aria-label="Öne Çıkan Mimariler">
      
      <!-- Feature 1: Omarchy Linux Araçları (Image Left, Text Right) -->
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-14 items-center">
        <div class="lg:col-span-7">
          <div class="relative rounded-[24px] overflow-hidden border border-[#ead9d2]/80 dark:border-[#2d2521] bg-[#F5F0E4] dark:bg-[#1f1a17] p-2.5 sm:p-3 shadow-xs">
            <img
              src="/images/quickshell/omastudio-preview.png"
              alt="Omarchy Linux ve OmaStudio RAW Editor"
              width="800"
              height="450"
              loading="lazy"
              decoding="async"
              class="w-full h-auto rounded-[18px] object-cover"
            />
          </div>
        </div>

        <div class="lg:col-span-5 space-y-5 text-left">
          <div class="font-mono text-xs text-[#e1734b] dark:text-[#e59a7a] uppercase tracking-wider font-semibold">
            // Açık Kaynak Ekosistemi
          </div>
          <h2 class="font-serif text-3xl sm:text-4xl font-normal text-[#2d2724] dark:text-[#fef9ed] leading-[1.25]">
            Omarchy Linux: Hızlı ve Açık Kaynak Araç Ekosistemi
          </h2>
          <p class="font-serif text-base sm:text-lg text-[#5D524B] dark:text-[#a89f91] leading-relaxed">
            Wayland tabanlı modern masaüstü için geliştirdiğim açık kaynak araç takımı: <strong>OmaStudio</strong> (16-bit orta format RAW motoru), <strong>Cyber Sentinel</strong> (cihaz savunma kalkanı), <strong>OmaNotes</strong> (E2EE not yöneticisi) ve <strong>OmaSend</strong> (P2P aktarım).
          </p>
          <div class="flex flex-wrap items-center gap-4 pt-2 font-mono text-xs">
            <a
              href="https://github.com/ozdil/omarchy-omastudio"
              target="_blank"
              rel="noopener noreferrer"
              class="px-3.5 py-1.5 rounded-full bg-[#FBF4E5] dark:bg-[#26201c] text-[#2d2724] dark:text-[#fef9ed] border border-[#ead9d2] dark:border-[#2d2521] hover:border-[#5D524B]/30 flex items-center gap-1.5 transition-colors"
            >
              <span>GitHub Kod Deposu</span>
              <span class="text-[#a67c52]">↗</span>
            </a>
            <a
              href="/blog/omastudio-16-bit-orta-format-ve-rust-daemon-mimarisi"
              class="px-3.5 py-1.5 rounded-full text-[#5D524B] dark:text-[#a89f91] hover:text-[#2d2724] dark:hover:text-[#fef9ed] transition-colors"
            >
              Mimari İnceleme →
            </a>
          </div>
        </div>
      </div>

      <!-- Feature 2: Kastamonu İnci Yurt Web Platformu (Text Left, Image Right) -->
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-14 items-center flex-col-reverse lg:flex-row">
        <div class="lg:col-span-5 space-y-5 text-left order-2 lg:order-1">
          <div class="font-mono text-xs text-[#6e8f7c] dark:text-[#82b09a] uppercase tracking-wider font-semibold">
            // Kurumsal Dijital Dönüşüm
          </div>
          <h2 class="font-serif text-3xl sm:text-4xl font-normal text-[#2d2724] dark:text-[#fef9ed] leading-[1.25]">
            Kastamonu İnci Yurt Platformu & Yönetim Portalı
          </h2>
          <p class="font-serif text-base sm:text-lg text-[#5D524B] dark:text-[#a89f91] leading-relaxed">
            Cloudflare Edge mimarisi üzerinde sıfır sunucu maliyetiyle koşan modern web platformu. Yapay zekâ tarayıcıları için <code class="px-1.5 py-0.5 rounded bg-[#F5F0E4] dark:bg-[#26201c] font-mono text-xs">llms.txt</code> bağlam haritası, interaktif tasarruf simülatörü ve çok dilli öğrenci kayıt portalı.
          </p>
          <div class="flex flex-wrap items-center gap-4 pt-2 font-mono text-xs">
            <a
              href="https://www.kastamonuinciyurt.com"
              target="_blank"
              rel="noopener noreferrer"
              class="px-3.5 py-1.5 rounded-full bg-[#FBF4E5] dark:bg-[#26201c] text-[#2d2724] dark:text-[#fef9ed] border border-[#ead9d2] dark:border-[#2d2521] hover:border-[#5D524B]/30 flex items-center gap-1.5 transition-colors"
            >
              <span>Canlı Platformu İncele</span>
              <span class="text-[#a67c52]">↗</span>
            </a>
            <a
              href="/blog/kastamonu-inci-yurt-web-platformu-ve-yonetim-portali-dijital-donusum"
              class="px-3.5 py-1.5 rounded-full text-[#5D524B] dark:text-[#a89f91] hover:text-[#2d2724] dark:hover:text-[#fef9ed] transition-colors"
            >
              Dönüşüm Raporu →
            </a>
          </div>
        </div>

        <div class="lg:col-span-7 order-1 lg:order-2">
          <div class="relative rounded-[24px] overflow-hidden border border-[#ead9d2]/80 dark:border-[#2d2521] bg-[#F5F0E4] dark:bg-[#1f1a17] p-2.5 sm:p-3 shadow-xs">
            <img
              src="/images/kastamonuinciyurt-preview.webp"
              alt="Kastamonu İnci Yurt Web Platformu"
              width="800"
              height="450"
              loading="lazy"
              decoding="async"
              class="w-full h-auto rounded-[18px] object-cover"
            />
          </div>
        </div>
      </div>

    </section>

    <!-- ================================================================= -->
    <!-- BLOCK 3: THE STATEMENT WASH (FULL-WIDTH MANIFESTO)                -->
    <!-- ================================================================= -->
    <section class="relative -mx-4 sm:-mx-6 lg:-mx-8 py-20 sm:py-32 statement-wash overflow-hidden" aria-label="Manifesto">
      <div class="max-w-3xl mx-auto px-6 text-center space-y-6">
        <div class="font-mono text-xs uppercase tracking-widest text-[#8C7E74] dark:text-[#a89f91]">
          // DİJİTAL EGEMENLİK & İNSAN MERKEZLİ YZ
        </div>
        <blockquote class="font-serif text-2xl sm:text-4xl lg:text-5xl text-[#2d2724] dark:text-[#fef9ed] font-normal leading-[1.35] text-balance">
          “Teknoloji kapalı bahçelerin ve gözetim kapitalizminin tekelinde olmak zorunda değil; açık kaynak kod ve yerel yapay zekâ, insan aklının ve kişisel egemenliğin en güçlü kaldıraçlarıdır.”
        </blockquote>
        <div class="font-mono text-xs text-[#8C7E74] dark:text-[#a89f91] pt-2">
          — Ozan Özdil
        </div>
      </div>
    </section>

    <!-- ================================================================= -->
    <!-- BLOCK 4: SİSTEM & MİMARİ ANALİZİ MATRİSİ                          -->
    <!-- ================================================================= -->
    <section class="space-y-8" aria-label="Mimari ve Yetkinlik Kıyaslaması">
      <div class="text-center space-y-3 max-w-2xl mx-auto">
        <div class="font-mono text-xs text-[#e1734b] dark:text-[#e59a7a] uppercase tracking-wider font-semibold">
          // SİSTEM & MİMARİ ANALİZİ
        </div>
        <h2 class="font-serif text-3xl sm:text-4xl font-normal text-[#2d2724] dark:text-[#fef9ed] leading-[1.25]">
          Sistem ve Donanım Yetkinlik Matrisi
        </h2>
        <p class="font-serif text-base text-[#5D524B] dark:text-[#a89f91]">
          Geleneksel hantal yaklaşımlar ile geliştirdiğim açık kaynak ve uç bilişim çözümlerinin karşılaştırmalı analizi.
        </p>
      </div>

      <div class="overflow-x-auto rounded-[22px] border border-[#ead9d2]/80 dark:border-[#2d2521] bg-[#fef9ed] dark:bg-[#141210] shadow-2xs">
        <table class="matrix-bench font-mono text-xs">
          <thead>
            <tr>
              <th scope="col" class="c-cat w-32 sm:w-44">Kategori</th>
              <th scope="col" class="w-36 sm:w-48 text-left">Metrik / Alan</th>
              <th scope="col" class="c-highlight text-left">Ozan Özdil Mimarisi</th>
              <th scope="col" class="text-left text-[#8C7E74]">Geleneksel Yaklaşım</th>
            </tr>
          </thead>
          <tbody>
            <tr>
              <td class="c-cat font-semibold">Yapay Zekâ</td>
              <td>Kodlama & Ajan Otonomisi</td>
              <td class="c-highlight font-medium">Antigravity CLI + Claude Code + Çoklu Ajan</td>
              <td class="text-[#8C7E74]">Manuel iskele & tekil web istemcileri</td>
            </tr>
            <tr>
              <td class="c-cat font-semibold">İşletim Sistemi</td>
              <td>Çekirdek Gecikmesi</td>
              <td class="c-highlight font-medium">Omarchy Linux (BORE/EEVDF &lt; 1.2ms)</td>
              <td class="text-[#8C7E74]">Standart genel amaçlı şişkin masaüstü</td>
            </tr>
            <tr>
              <td class="c-cat font-semibold">Görsel İşleme</td>
              <td>16-Bit RAW / Hafıza</td>
              <td class="c-highlight font-medium">OmaStudio (Rust Motoru + Sıfır Kilitlenme)</td>
              <td class="text-[#8C7E74]">Kapalı lisanslı ağır masaüstü yazılımları</td>
            </tr>
            <tr>
              <td class="c-cat font-semibold">Mobil Donanım</td>
              <td>Kare Süresi Kararlılığı</td>
              <td class="c-highlight font-medium">Steam Deck + MangoHud Düşük Gecikme</td>
              <td class="text-[#8C7E74]">Müdahale edilemeyen varsayılan konsollar</td>
            </tr>
            <tr>
              <td class="c-cat font-semibold">Web Altyapısı</td>
              <td>Uç Dağıtım & LLM</td>
              <td class="c-highlight font-medium">Cloudflare Edge + llms.txt + Workers AI</td>
              <td class="text-[#8C7E74]">Ağır monolit sanal sunucular</td>
            </tr>
          </tbody>
        </table>
      </div>
    </section>

    <!-- ================================================================= -->
    <!-- BLOCK 5: DERİNLEMESİNE İNCELE VE AKSİYON KARTLARI                 -->
    <!-- ================================================================= -->
    <section class="space-y-8" aria-label="Derinlemesine İncele ve Aksiyonlar">
      <!-- Signature Dig Deeper Bar -->
      <div class="rounded-[22px] bg-[#FBF4E5] dark:bg-[#1f1a17] border border-[#ead9d2]/80 dark:border-[#2d2521] p-6 sm:p-8 flex flex-col md:flex-row items-start md:items-center justify-between gap-6 shadow-2xs">
        <div class="space-y-1">
          <h3 class="font-serif text-2xl font-normal text-[#2d2724] dark:text-[#fef9ed]">
            Derinlemesine İnceleyin
          </h3>
          <p class="font-serif text-sm text-[#8C7E74] dark:text-[#a89f91]">
            Teknik dokümantasyon, yapay zekâ bağlam şemaları ve kaynak kodlar.
          </p>
        </div>

        <div class="flex flex-wrap items-center gap-x-6 gap-y-3 font-mono text-xs">
          <a
            href="/hakkimda"
            class="flex items-center gap-1.5 text-[#2d2724] dark:text-[#fef9ed] hover:underline"
          >
            <span>Teknik Özgeçmiş</span>
            <span class="text-[#a67c52]">↗</span>
          </a>
          <a
            href="https://github.com/ozdil"
            target="_blank"
            rel="noopener noreferrer"
            class="flex items-center gap-1.5 text-[#2d2724] dark:text-[#fef9ed] hover:underline"
          >
            <span>GitHub Kodları</span>
            <span class="text-[#a67c52]">↗</span>
          </a>
          <a
            href="/llms.txt"
            target="_blank"
            class="flex items-center gap-1.5 text-[#2d2724] dark:text-[#fef9ed] hover:underline"
          >
            <span>LLM Context (llms.txt)</span>
            <span class="text-[#a67c52]">↗</span>
          </a>
          <a
            href="/rss.xml"
            target="_blank"
            class="flex items-center gap-1.5 text-[#2d2724] dark:text-[#fef9ed] hover:underline"
          >
            <span>RSS Akışı</span>
            <span class="text-[#a67c52]">↗</span>
          </a>
        </div>
      </div>

      <!-- Action Cards (Side-by-side) -->
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        <!-- Card 1: Ozan AI Assistant -->
        <div class="rounded-[22px] bg-[#F5F0E4] dark:bg-[#1c1815] border border-[#ead9d2]/80 dark:border-[#2d2521] p-7 sm:p-8 flex flex-col justify-between space-y-6 shadow-2xs">
          <div class="space-y-3">
            <div class="flex items-center justify-between">
              <span class="font-mono text-xs text-[#e1734b] dark:text-[#e59a7a] uppercase font-semibold">
                // Etkileşimli Ajan
              </span>
              <span class="px-2.5 py-0.5 rounded-full text-[10px] font-mono bg-[#EAEFE1] dark:bg-[#1c2b23] text-[#2E4D4D] dark:text-[#82b09a]">
                Llama 3.1 8B Edge
              </span>
            </div>
            <h3 class="font-serif text-2xl sm:text-3xl font-normal text-[#2d2724] dark:text-[#fef9ed] leading-snug">
              Ozan AI (Dijital İkiz)
            </h3>
            <p class="font-serif text-sm sm:text-base text-[#5D524B] dark:text-[#a89f91] leading-relaxed">
              Bu sitedeki tüm teknik makaleler, açık kaynak mimarileri ve donanım rehberleri hakkında merak ettiklerinizi yapay zekâ asistanına doğrudan sorun.
            </p>
          </div>

          <div>
            <button
              type="button"
              id="hero-chat-trigger"
              onclick="document.getElementById('ai-chat-btn')?.click()"
              class="w-full sm:w-auto px-5 py-2.5 rounded-full bg-[#2d2724] dark:bg-[#fef9ed] text-[#fef9ed] dark:text-[#2d2724] font-mono text-xs font-medium hover:opacity-90 transition-opacity flex items-center justify-center gap-2 cursor-pointer shadow-xs"
            >
              <span>🤖 Ozan AI ile Sohbeti Başlat</span>
              <span>↗</span>
            </button>
          </div>
        </div>

        <!-- Card 2: Gallery / Visual Archive -->
        <div class="rounded-[22px] bg-[#F5F0E4] dark:bg-[#1c1815] border border-[#ead9d2]/80 dark:border-[#2d2521] p-7 sm:p-8 flex flex-col justify-between space-y-6 shadow-2xs">
          <div class="space-y-3">
            <div class="flex items-center justify-between">
              <span class="font-mono text-xs text-[#6e8f7c] dark:text-[#82b09a] uppercase font-semibold">
                // Görsel Kültür & Belgesel
              </span>
              <span class="px-2.5 py-0.5 rounded-full text-[10px] font-mono bg-[#FBD3BE]/60 dark:bg-[#3a261c] text-[#4D2A33] dark:text-[#fef9ed]">
                Fujifilm GFX 50R
              </span>
            </div>
            <h3 class="font-serif text-2xl sm:text-3xl font-normal text-[#2d2724] dark:text-[#fef9ed] leading-snug">
              Kadim Ahşap Mimarisi Galerisi
            </h3>
            <p class="font-serif text-sm sm:text-base text-[#5D524B] dark:text-[#a89f91] leading-relaxed">
              Kastamonu ve Karadeniz havzasındaki çivisiz çantı camileri, yaşayan ahşap konaklar ve kaybolan somut kültürel mirasın orta format dijital arşivi.
            </p>
          </div>

          <div>
            <a
              href="/galeri"
              class="inline-flex items-center justify-center w-full sm:w-auto px-5 py-2.5 rounded-full bg-[#FBF4E5] dark:bg-[#26201c] text-[#2d2724] dark:text-[#fef9ed] border border-[#ead9d2] dark:border-[#2d2521] font-mono text-xs font-medium hover:border-[#5D524B]/30 transition-colors gap-2"
            >
              <span>Fotoğraf Galerisini Gez</span>
              <span>→</span>
            </a>
          </div>
        </div>
      </div>
    </section>

    <!-- ================================================================= -->
    <!-- BLOCK 6: FEATURED STORIES (SON BLOG YAZILARI)                     -->
    <!-- ================================================================= -->
    <section class="space-y-8" aria-label="Son Makaleler">
      <div class="flex items-center justify-between pb-4 border-b border-[#ead9d2]/80 dark:border-[#2d2521]">
        <div>
          <div class="font-mono text-xs text-[#8C7E74] dark:text-[#a89f91] uppercase tracking-wider font-semibold">
            // Editoryal İncelemeler & Araştırmalar
          </div>
          <h2 class="font-serif text-3xl sm:text-4xl font-normal text-[#2d2724] dark:text-[#fef9ed]">
            Son Yazılar
          </h2>
        </div>
        <a
          href="/blog"
          class="font-mono text-xs text-[#e1734b] dark:text-[#e59a7a] hover:underline font-medium flex items-center gap-1"
        >
          <span>tüm yazılar ({allPosts.length})</span>
          <span>→</span>
        </a>
      </div>

      <div class="divide-y divide-[#ead9d2]/70 dark:divide-[#2d2521]">
        {latestPosts.map((post) => (
          <article class="py-6 -mx-3 px-3 rounded-2xl hover:bg-[#F5F0E4]/60 dark:hover:bg-[#1c1815]/60 transition-colors group">
            <a href={`/blog/${post.slug}`} class="block space-y-3">
              <div class="flex items-center gap-3 font-mono text-[11px] text-[#8C7E74] dark:text-[#a89f91]">
                <span class="px-2.5 py-0.5 rounded-full bg-[#F5F0E4] dark:bg-[#26201c] text-[#5D524B] dark:text-[#a89f91] border border-[#ead9d2]/60 dark:border-[#2d2521]">
                  {post.data.tags?.[0] || 'Teknoloji'}
                </span>
                <span>•</span>
                <time datetime={post.data.pubDate.toISOString()}>
                  {formatDate(post.data.pubDate)}
                </time>
              </div>

              <h3 class="font-serif text-xl sm:text-2xl font-normal text-[#2d2724] dark:text-[#fef9ed] group-hover:text-[#e1734b] dark:group-hover:text-[#e59a7a] transition-colors leading-[1.3]">
                {post.data.title}
              </h3>

              {post.data.description && (
                <p class="font-serif text-sm sm:text-base text-[#5D524B] dark:text-[#a89f91] line-clamp-2 leading-relaxed">
                  {post.data.description}
                </p>
              )}
            </a>
          </article>
        ))}
      </div>
    </section>

  </div>
</BaseLayout>
