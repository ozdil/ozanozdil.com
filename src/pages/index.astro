---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

// Fetch published blog posts and get the latest 4
const allPosts = await getCollection('blog', ({ data }) => !data.draft);
const latestPosts = allPosts
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 4);

const formatDate = (date: Date) => {
  return new Intl.DateTimeFormat('tr-TR', {
    day: '2-digit',
    month: 'short',
    year: 'numeric'
  }).format(date);
};
---

<BaseLayout
  title="Ozan Özdil — YZ Kodcusu & Açık Kaynak Sistem Mimarı"
  description="Ozan Özdil: Yapay zekâ destekli otonom kodlama süreçleri, açık kaynak sistem mimarileri, Omarchy Linux, kurumsal hafıza ve dijital egemenlik araştırmaları."
  currentPath="/"
  maxWidthClass="max-w-6xl"
>
  <div class="space-y-20 sm:space-y-28 py-6 sm:py-12">

    <!-- ================================================================= -->
    <!-- 1. HERO: TİPOGRAFİK, HAVADAR VE YÜKSEK OKUNABİLİRLİK              -->
    <!-- ================================================================= -->
    <section class="space-y-8 pt-4 sm:pt-8" aria-label="Giriş ve Vizyon">
      <div class="flex flex-col items-start gap-4">
        <!-- Live Status Pill -->
        <div class="inline-flex items-center gap-2.5 px-3.5 py-1.5 rounded-full text-xs font-mono bg-[#18181b] text-[#a1a1aa] border border-[#27272a] shadow-xs">
          <span class="w-2 h-2 rounded-full bg-[#52525b] animate-pulse"></span>
          <span class="tracking-widest">// OTONOM SİSTEMLER • YZ KODCUSU • SİSTEM MİMARİSİ</span>
        </div>

        <!-- Main Display Headline -->
        <div class="space-y-4 max-w-4xl">
          <h1 class="font-serif text-5xl sm:text-7xl lg:text-8xl font-normal text-[#ffffff] leading-[1.1] tracking-tight">
            Ozan Özdil
          </h1>
          <p class="font-serif text-xl sm:text-2xl lg:text-3xl text-[#a1a1aa] font-normal leading-relaxed text-balance">
            Yapay zekâ destekli otonom kodlama süreçleri, açık kaynak sistem mimarileri ve kurumsal hafıza üzerine çalışan bağımsız sistem araştırmacısı.
          </p>
        </div>

        <!-- Quick Metadata Badges -->
        <div class="flex flex-wrap items-center gap-2 pt-1 font-mono text-xs text-[#71717a]">
          <span class="px-3 py-1 rounded-full bg-[#18181b] border border-[#27272a]">
            Kastamonu, TR
          </span>
          <span class="px-3 py-1 rounded-full bg-[#18181b] border border-[#27272a]">
            Kastamonu Belediyesi (2019 — Günümüz)
          </span>
          <span class="px-3 py-1 rounded-full bg-[#18181b] border border-[#27272a]">
            KTÜ Orman Fakültesi
          </span>
          <span class="px-3 py-1 rounded-full bg-[#18181b] border border-[#3f3f46] text-[#ffffff]">
            Omarchy Linux
          </span>
          <span class="px-3 py-1 rounded-full bg-[#18181b] border border-[#27272a]">
            Cloudflare Edge & Workers KV
          </span>
        </div>

        <!-- Action Buttons (Pill Group) -->
        <div class="flex flex-wrap items-center gap-3 pt-4 font-mono text-xs">
          <button
            type="button"
            onclick="document.getElementById('ai-chat-btn')?.click()"
            class="px-5 py-2.5 rounded-full bg-[#ffffff] text-[#09090b] font-semibold hover:bg-[#e4e4e7] transition-all flex items-center gap-2 shadow-md cursor-pointer"
          >
            <span>Ozan AI ile Konuş</span>
            <span>↗</span>
          </button>
          <a
            href="/hakkimda"
            class="px-5 py-2.5 rounded-full bg-[#18181b] text-[#ffffff] border border-[#27272a] hover:border-[#52525b] transition-colors"
          >
            Teknik Özgeçmiş →
          </a>
          <a
            href="https://github.com/ozdil"
            target="_blank"
            rel="noopener noreferrer"
            class="px-5 py-2.5 rounded-full bg-[#18181b] text-[#a1a1aa] border border-[#27272a] hover:text-[#ffffff] hover:border-[#52525b] transition-colors flex items-center gap-1.5"
          >
            <span>GitHub</span>
            <span>↗</span>
          </a>
          <a
            href="/llms.txt"
            target="_blank"
            class="px-5 py-2.5 rounded-full bg-[#18181b] text-[#a1a1aa] border border-[#27272a] hover:text-[#ffffff] hover:border-[#52525b] transition-colors flex items-center gap-1.5"
          >
            <span>llms.txt</span>
            <span>↗</span>
          </a>
        </div>
      </div>

      <!-- Developer Terminal Showcase -->
      <div class="relative clean-card bg-[#121215] border border-[#27272a] rounded-[24px] p-5 sm:p-7 space-y-4 font-mono text-xs overflow-hidden shadow-xl">
        <div class="flex items-center justify-between border-b border-[#27272a] pb-3">
          <div class="flex items-center gap-2">
            <div class="flex items-center gap-1.5 mr-2">
              <span class="w-2.5 h-2.5 rounded-full bg-[#27272a]"></span>
              <span class="w-2.5 h-2.5 rounded-full bg-[#27272a]"></span>
              <span class="w-2.5 h-2.5 rounded-full bg-[#27272a]"></span>
            </div>
            <span class="text-[#71717a] text-[11px]">antigravity@ozanozdil: ~/cluster</span>
          </div>
          <div class="flex items-center gap-2 text-[11px] text-[#a1a1aa]">
            <span class="w-2 h-2 rounded-full bg-[#52525b] animate-pulse"></span>
            <span>SYSTEM ACTIVE // REV 2026.9</span>
          </div>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-4 pt-1 text-[12px] leading-relaxed">
          <div class="relative space-y-1.5 p-3.5 rounded-xl bg-[#18181b] border border-[#27272a]">
            <div class="flex items-center justify-between text-[#71717a] font-semibold">
              <span>// YZ & KODLAMA AJANLARI</span>
              <span class="text-[9px] font-mono text-[#52525b]">[01]</span>
            </div>
            <div class="text-[#ffffff] font-medium">Antigravity CLI + Claude Code</div>
            <div class="text-[#a1a1aa] text-[11px]">Çoklu ajan orkestrasyonu, Llama 3.1 8B Edge ve yerel LLM iş akışları.</div>
          </div>

          <div class="relative space-y-1.5 p-3.5 rounded-xl bg-[#18181b] border border-[#27272a]">
            <div class="flex items-center justify-between text-[#71717a] font-semibold">
              <span>// AÇIK KAYNAK ÇEKİRDEK</span>
              <span class="text-[9px] font-mono text-[#52525b]">[02]</span>
            </div>
            <div class="text-[#ffffff] font-medium">Omarchy Linux & BORE/EEVDF</div>
            <div class="text-[#a1a1aa] text-[11px]">Düşük gecikmeli çekirdek zamanlayıcısı, Rust IPC ve OmaStudio RAW motoru.</div>
          </div>

          <div class="relative space-y-1.5 p-3.5 rounded-xl bg-[#18181b] border border-[#27272a]">
            <div class="flex items-center justify-between text-[#71717a] font-semibold">
              <span>// UÇ DAĞITIM & GÜVENLİK</span>
              <span class="text-[9px] font-mono text-[#52525b]">[03]</span>
            </div>
            <div class="text-[#ffffff] font-medium">Cloudflare Edge + Workers KV</div>
            <div class="text-[#a1a1aa] text-[11px]">Canlı popülarite ölçümü, RFC 9421 Bot Auth ve sıfır sunucu maliyeti.</div>
          </div>
        </div>
      </div>
    </section>

    <!-- ================================================================= -->
    <!-- 2. ÖNE ÇIKAN SİSTEMLER VE PROJELER (BENTO SHOWCASE)               -->
    <!-- ================================================================= -->
    <section class="space-y-10" aria-label="Öne Çıkan Mimariler ve Sistemler">
      <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-4 pb-4 border-b border-[#27272a]">
        <div>
          <div class="font-mono text-xs text-[#71717a] uppercase tracking-wider font-semibold">
            // MİMARİ VİTRİN
          </div>
          <h2 class="font-serif text-3xl sm:text-4xl lg:text-5xl font-normal text-[#ffffff]">
            Öne Çıkan Sistemler & Projeler
          </h2>
        </div>
        <p class="font-serif text-sm sm:text-base text-[#a1a1aa] max-w-md">
          Yüksek performanslı masaüstü ekosistemleri, yapay zekâ entegrasyonları ve kurumsal dijital altyapılar.
        </p>
      </div>

      <!-- Bento Grid (2 Large + 2 Medium) -->
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-6">

        <!-- Card 1: Omarchy Linux & OmaStudio (Large - 7 cols) -->
        <div class="relative lg:col-span-7 rounded-[26px] clean-card bg-[#121215] border border-[#27272a] p-6 sm:p-8 flex flex-col justify-between space-y-6 shadow-xl group hover:border-[#3f3f46] transition-colors overflow-hidden">
          <div class="space-y-4">
            <div class="flex items-center justify-between">
              <span class="font-mono text-xs text-[#71717a] uppercase font-semibold flex items-center gap-2">
                <span>// Açık Kaynak İşletim Sistemi</span>
                <span class="text-[9px] text-[#52525b]">[01]</span>
              </span>
              <span class="px-2.5 py-0.5 rounded-full text-[10px] font-mono bg-[#18181b] text-[#d4d4d8] border border-[#27272a]">
                Rust + Slint + Wayland
              </span>
            </div>
            <h3 class="font-serif text-2xl sm:text-3xl font-normal text-[#ffffff] leading-snug">
              Omarchy Linux & OmaStudio RAW Motoru
            </h3>
            <p class="font-serif text-sm sm:text-base text-[#a1a1aa] leading-relaxed">
              Arch Linux çekirdek optimizasyonları (BORE/EEVDF düşük gecikme) üzerine kurulu dağıtım mimarisi. 16-bit orta format RAW görüntüleri sıfır kilitlenmeyle işleyen Rust tabanlı kalıcı daemon motoru ve Quickshell Wayland masaüstü araç seti.
            </p>
          </div>

          <div class="rounded-[18px] overflow-hidden border border-[#27272a] bg-[#18181b] aspect-[16/9]">
            <img
              src="/images/quickshell/omastudio-preview.png"
              alt="OmaStudio RAW Motoru Arayüzü"
              width="800"
              height="450"
              loading="lazy"
              decoding="async"
              class="w-full h-full object-cover group-hover:scale-[1.02] transition-transform duration-500 ease-out"
            />
          </div>

          <div class="flex flex-wrap items-center gap-4 pt-1 font-mono text-xs">
            <a
              href="https://github.com/ozdil/omarchy"
              target="_blank"
              rel="noopener noreferrer"
              class="px-4 py-2 rounded-full bg-[#ffffff] text-[#09090b] font-semibold hover:bg-[#e4e4e7] transition-all flex items-center gap-1.5"
            >
              <span>GitHub Kod Deposu</span>
              <span>↗</span>
            </a>
            <a
              href="/blog/omastudio-16-bit-orta-format-ve-rust-daemon-mimarisi"
              class="text-[#a1a1aa] hover:text-[#ffffff] font-medium transition-colors"
            >
              Mimari Raporu →
            </a>
          </div>
        </div>

        <!-- Card 2: Kastamonu İnci Yurt Platformu (Medium - 5 cols) -->
        <div class="relative lg:col-span-5 rounded-[26px] clean-card bg-[#121215] border border-[#27272a] p-6 sm:p-8 flex flex-col justify-between space-y-6 shadow-xl group hover:border-[#3f3f46] transition-colors overflow-hidden">
          <div class="space-y-4">
            <div class="flex items-center justify-between">
              <span class="font-mono text-xs text-[#71717a] uppercase font-semibold flex items-center gap-2">
                <span>// Uç Bilişim & AI Entegrasyonu</span>
                <span class="text-[9px] text-[#52525b]">[02]</span>
              </span>
              <span class="px-2.5 py-0.5 rounded-full text-[10px] font-mono bg-[#18181b] text-[#d4d4d8] border border-[#27272a]">
                Cloudflare Edge
              </span>
            </div>
            <h3 class="font-serif text-2xl sm:text-3xl font-normal text-[#ffffff] leading-snug">
              Kastamonu İnci Yurt Web Platformu
            </h3>
            <p class="font-serif text-sm text-[#a1a1aa] leading-relaxed">
              Cloudflare Edge mimarisi üzerinde sıfır sunucu maliyetiyle koşan kurumsal platform. Yapay zekâ tarayıcıları için <code class="px-1.5 py-0.5 rounded bg-[#18181b] text-[#ffffff] font-mono text-[11px] border border-[#27272a]">llms.txt</code> bağlam haritası, interaktif simülatör ve dinamik API mimarisi.
            </p>
          </div>

          <div class="rounded-[18px] overflow-hidden border border-[#27272a] bg-[#18181b] aspect-[16/9]">
            <img
              src="/images/kastamonuinciyurt-preview.webp"
              alt="Kastamonu İnci Yurt Platformu Önizlemesi"
              width="800"
              height="450"
              loading="lazy"
              decoding="async"
              class="w-full h-full object-cover group-hover:scale-[1.02] transition-transform duration-500 ease-out"
            />
          </div>

          <div class="flex flex-wrap items-center gap-4 pt-1 font-mono text-xs">
            <a
              href="https://www.kastamonuinciyurt.com"
              target="_blank"
              rel="noopener noreferrer"
              class="px-4 py-2 rounded-full bg-[#ffffff] text-[#09090b] font-semibold hover:bg-[#e4e4e7] transition-all flex items-center gap-1.5"
            >
              <span>Canlı Platformu Gez</span>
              <span>↗</span>
            </a>
            <a
              href="/blog/kastamonu-inci-yurt-web-platformu-ve-yonetim-portali-dijital-donusum"
              class="text-[#a1a1aa] hover:text-[#ffffff] font-medium transition-colors"
            >
              Dönüşüm Yazısı →
            </a>
          </div>
        </div>

        <!-- Card 3: Kurumsal Hafıza & Kamu Deneyimi (Medium - 6 cols) -->
        <div class="relative lg:col-span-6 rounded-[26px] clean-card bg-[#121215] border border-[#27272a] p-6 sm:p-8 flex flex-col justify-between space-y-6 shadow-xl group hover:border-[#3f3f46] transition-colors overflow-hidden">
          <div class="space-y-4">
            <div class="flex items-center justify-between">
              <span class="font-mono text-xs text-[#71717a] uppercase font-semibold flex items-center gap-2">
                <span>// Kamu Yönetimi & Kurumsal Hafıza</span>
                <span class="text-[9px] text-[#52525b]">[03]</span>
              </span>
              <span class="px-2.5 py-0.5 rounded-full text-[10px] font-mono bg-[#18181b] text-[#d4d4d8] border border-[#27272a]">
                2019 — Günümüz
              </span>
            </div>
            <h3 class="font-serif text-2xl sm:text-3xl font-normal text-[#ffffff] leading-snug">
              Kastamonu Belediyesi Deneyimi
            </h3>
            <p class="font-serif text-sm sm:text-base text-[#a1a1aa] leading-relaxed">
              2019 yerel seçim stratejisinden Başkan Danışmanlığı'na, Ar-Ge ve Bilgi İşlem yöneticiliğinden (3 ayda 25M+ organik kitle erişimi, sunucu altyapı modernizasyonu) günümüz kurumsal hafıza ve arşiv araştırmacılığına uzanan kamu disiplini.
            </p>
            <ul class="space-y-2 font-mono text-xs text-[#a1a1aa]">
              <li class="flex items-center gap-2">
                <span class="w-1.5 h-1.5 rounded-full bg-[#52525b]"></span>
                <span>Resmi dokümantasyon, kentsel bellek ve kamu arşiv araştırmacılığı</span>
              </li>
              <li class="flex items-center gap-2">
                <span class="w-1.5 h-1.5 rounded-full bg-[#52525b]"></span>
                <span>Kriz yönetimi, kitle iletişimi ve veri analitiği liderliği</span>
              </li>
            </ul>
          </div>

          <div class="pt-2 font-mono text-xs">
            <a
              href="/hakkimda"
              class="inline-flex items-center gap-1.5 text-[#ffffff] hover:text-[#a1a1aa] font-medium transition-colors"
            >
              <span>Kariyer Zaman Çizelgesini İnceleyin</span>
              <span>→</span>
            </a>
          </div>
        </div>

        <!-- Card 4: Fotonik & Kadim Ahşap Arşivi (Medium - 6 cols) -->
        <div class="relative lg:col-span-6 rounded-[26px] clean-card bg-[#121215] border border-[#27272a] p-6 sm:p-8 flex flex-col justify-between space-y-6 shadow-xl group hover:border-[#3f3f46] transition-colors overflow-hidden">
          <div class="space-y-4">
            <div class="flex items-center justify-between">
              <span class="font-mono text-xs text-[#71717a] uppercase font-semibold flex items-center gap-2">
                <span>// Fotonik & Kültürel Miras</span>
                <span class="text-[9px] text-[#52525b]">[04]</span>
              </span>
              <span class="px-2.5 py-0.5 rounded-full text-[10px] font-mono bg-[#18181b] text-[#d4d4d8] border border-[#27272a]">
                Fujifilm GFX Orta Format
              </span>
            </div>
            <h3 class="font-serif text-2xl sm:text-3xl font-normal text-[#ffffff] leading-snug">
              Kadim Ahşap Mimarisi Belgesel Arşivi
            </h3>
            <p class="font-serif text-sm sm:text-base text-[#a1a1aa] leading-relaxed">
              Kastamonu ve Karadeniz havzasındaki çivisiz ahşap çantı camileri, kündekari kapıları ve kaybolan somut mirasın 16-bit sıkıştırmasız RAW dinamikleriyle yüksek çözünürlüklü fotonik belgelenmesi.
            </p>
            <ul class="space-y-2 font-mono text-xs text-[#a1a1aa]">
              <li class="flex items-center gap-2">
                <span class="w-1.5 h-1.5 rounded-full bg-[#52525b]"></span>
                <span>43.8×32.9mm geniş sensör alanı ve GF optik analizleri</span>
              </li>
              <li class="flex items-center gap-2">
                <span class="w-1.5 h-1.5 rounded-full bg-[#52525b]"></span>
                <span>Kültürel hafızanın yüksek sadakatli dijital korunumu</span>
              </li>
            </ul>
          </div>

          <div class="pt-2 font-mono text-xs">
            <a
              href="/galeri"
              class="inline-flex items-center gap-1.5 text-[#ffffff] hover:text-[#a1a1aa] font-medium transition-colors"
            >
              <span>Fotoğraf Galerisini Gezin</span>
              <span>→</span>
            </a>
          </div>
        </div>

      </div>
    </section>

    <!-- ================================================================= -->
    <!-- 3. MANİFESTO BÖLÜMÜ                                              -->
    <!-- ================================================================= -->
    <section class="relative -mx-4 sm:-mx-6 lg:-mx-8 py-16 sm:py-24 overflow-hidden border-y border-[#27272a] bg-[#121215]" aria-label="Manifesto">
      <div class="max-w-4xl mx-auto px-6 text-center space-y-6">
        <div class="font-mono text-xs uppercase tracking-widest text-[#71717a]">
          // DİJİTAL EGEMENLİK VE AÇIK KAYNAK
        </div>
        <blockquote class="font-serif text-2xl sm:text-4xl lg:text-5xl text-[#ffffff] font-normal leading-[1.3] text-balance">
          “Teknoloji kapalı bahçelerin ve gözetim kapitalizminin tekelinde olmak zorunda değil; açık kaynak kod ve yerel yapay zekâ, insan aklının ve kişisel egemenliğin en güçlü kaldıraçlarıdır.”
        </blockquote>
        <div class="font-mono text-xs text-[#71717a] pt-1">
          — Ozan Özdil
        </div>
      </div>
    </section>

    <!-- ================================================================= -->
    <!-- 4. SON YAZILAR & ARAŞTIRMALAR                                    -->
    <!-- ================================================================= -->
    <section class="space-y-8" aria-label="Son Araştırmalar ve Makaleler">
      <div class="flex items-center justify-between pb-4 border-b border-[#27272a]">
        <div>
          <div class="font-mono text-xs text-[#71717a] uppercase tracking-wider font-semibold">
            // EDİTORYAL İNCELEMELER & ANALİZLER
          </div>
          <h2 class="font-serif text-3xl sm:text-4xl font-normal text-[#ffffff]">
            Son Yazılar & Araştırmalar
          </h2>
        </div>
        <a
          href="/blog"
          class="font-mono text-xs text-[#a1a1aa] hover:text-[#ffffff] hover:underline font-medium flex items-center gap-1"
        >
          <span>tüm yazılar ({allPosts.length})</span>
          <span>→</span>
        </a>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
        {latestPosts.map((post) => (
          <article class="relative p-6 rounded-[22px] clean-card bg-[#121215] border border-[#27272a] hover:border-[#3f3f46] group flex flex-col justify-between space-y-4 shadow-xl overflow-hidden transition-colors">
            <a href={`/blog/${post.slug}`} class="block space-y-3">
              <div class="flex items-center justify-between font-mono text-[11px] text-[#71717a]">
                <span class="px-2.5 py-0.5 rounded-full bg-[#18181b] text-[#d4d4d8] border border-[#27272a]">
                  {post.data.tags?.[0] || 'Teknoloji'}
                </span>
                <time datetime={post.data.pubDate.toISOString()}>
                  {formatDate(post.data.pubDate)}
                </time>
              </div>

              <h3 class="font-serif text-xl sm:text-2xl font-normal text-[#ffffff] group-hover:text-[#ffffff] transition-colors leading-[1.3]">
                {post.data.title}
              </h3>

              {post.data.description && (
                <p class="font-serif text-sm text-[#a1a1aa] line-clamp-2 leading-relaxed">
                  {post.data.description}
                </p>
              )}
            </a>

            <div class="pt-2 font-mono text-xs text-[#d4d4d8] group-hover:text-[#ffffff] flex items-center gap-1">
              <span>Makaleyi Oku</span>
              <span>→</span>
            </div>
          </article>
        ))}
      </div>
    </section>

    <!-- ================================================================= -->
    <!-- 5. DERİNLEMESİNE İNCELEME & BAĞLANTILAR BAR                       -->
    <!-- ================================================================= -->
    <section class="rounded-[24px] bg-[#121215] border border-[#27272a] p-7 sm:p-10 flex flex-col md:flex-row items-start md:items-center justify-between gap-6 shadow-xl" aria-label="Derinlemesine İnceleme ve Bağlantılar">
      <div class="space-y-2">
        <span class="font-mono text-xs text-[#71717a] uppercase font-semibold block">
          // AÇIK DOKÜMANTASYON & ARŞİV
        </span>
        <h3 class="font-serif text-2xl sm:text-3xl font-normal text-[#ffffff]">
          Sistemi Derinlemesine İnceleyin
