---
import BaseLayout from '../layouts/BaseLayout.astro';

const timeline = [
  {
    period: '2024 — Günümüz',
    role: 'Bağımsız YZ Kodcusu & Açık Kaynak Sistem Mimarı',
    org: 'Omarchy Linux Ekosistemi & Ar-Ge',
    badge: 'Aktif Ar-Ge',
    badgeColor: 'bg-[#eaefe1] text-[#2e4d4d] dark:bg-[#1c2b23] dark:text-[#82b09a]',
    description:
      'Arch Linux tabanlı Omarchy dağıtım mimarisi, Wayland/Hyprland masaüstü entegrasyonu, OmaStudio 16-bit orta format RAW işleme motoru, Cyber Sentinel donanım savunması ve Antigravity CLI / Claude Code otonom yapay zekâ kodlama ajanları ile bağımsız Ar-Ge üretimi.',
    highlights: [
      'Omarchy Linux sistem optimizasyonları ve BORE/EEVDF düşük gecikmeli çekirdek takibi',
      'OmaStudio: Rust ve Slint/QML mimarisinde 16-bit orta format RAW motoru',
      'Uç bilişim (Cloudflare Edge) ve yapay zekâ entegrasyonları (llms.txt, Workers AI)'
    ]
  },
  {
    period: '2022 — 2023',
    role: 'Ar-Ge & Bilgi İşlem Yöneticiliği',
    org: 'Kastamonu Belediyesi',
    badge: 'Kurumsal Teknoloji',
    badgeColor: 'bg-[#f5f0e4] text-[#5d524b] dark:bg-[#26201c] dark:text-[#a89f91]',
    description:
      'Belediye bünyesindeki tüm kurumsal bilişim altyapısının, sunucu sistemlerinin ve veri güvenliği protokollerinin modernizasyonu; dijital dönüşüm süreçlerinin ve teknolojik Ar-Ge projelerinin sevk ve idaresi.',
    highlights: [
      'Kurumsal sunucu altyapısı, ağ topolojisi ve veri güvenliği yönetimi',
      'Belediye hizmetlerinin dijitalleştirilmesi ve vatandaş odaklı e-belediye çözümleri',
      'Birimler arası veri entegrasyonu ve kurumsal bilişim standartlarının inşası'
    ]
  },
  {
    period: '2019 — 2022',
    role: 'Belediye Başkan Danışmanlığı & Medya Koordinatörlüğü',
    org: 'Kastamonu Belediyesi',
    badge: 'Kamu Yönetimi & Medya',
    badgeColor: 'bg-[#fbd3be]/60 text-[#4d2a33] dark:bg-[#3a261c] dark:text-[#fef9ed]',
    description:
      'Belediye başkanlığı makamında stratejik danışmanlık, basın-yayın, halkla ilişkiler ve dijital kitle iletişimi süreçlerinin liderliği. 3 ay gibi rekor bir sürede 25 milyondan fazla organik erişim sağlayan medya operasyonunun yönetimi.',
    highlights: [
      'Basın-yayın, sosyal medya ve kitle iletişimi süreçlerinin uçtan uca koordinasyonu',
      'Kriz iletişimi, saha nabzı analitiği ve kamuoyu beklenti yönetimi',
      'Kurumsal temsil, protokol ilişkileri ve belediye vizyon projelerinin tanıtımı'
    ]
  },
  {
    period: '2019',
    role: 'Siyasal İletişim & Seçim Koordinasyonu',
    org: 'MHP Kastamonu Yerel Seçim Kampanyası',
    badge: 'Strateji & Saha',
    badgeColor: 'bg-[#f5f0e4] text-[#5d524b] dark:bg-[#26201c] dark:text-[#a89f91]',
    description:
      'Kastamonu yerel seçim zaferiyle taçlanan kampanya sürecinde; saha veri analitiği, siyasal kitle iletişimi, görsel prodüksiyon ve kampanya liderliği.',
    highlights: [
      'Seçmen dinamikleri analitiği ve mikro hedefli kitle iletişimi',
      'Çok kanallı görsel prodüksiyon, miting ve saha yayıncılığı yönetimi',
      'Seçim koordinasyon merkezinin stratejik iletişim yürütücülüğü'
    ]
  },
  {
    period: 'Lisans Eğitimi',
    role: 'Orman Mühendisliği Lisans Derecesi',
    org: 'Karadeniz Teknik Üniversitesi (KTÜ) — Orman Fakültesi',
    badge: 'Sistem & Kök Bilinci',
    badgeColor: 'bg-[#eaefe1] text-[#2e4d4d] dark:bg-[#1c2b23] dark:text-[#82b09a]',
    description:
      'Karmaşık ekolojik ağlar, çok değişkenli canlı sistemler ve döngüsel sistem mühendisliği formasyonu. Teknolojik mimarilere ve siber sistemlere bakışımın analitik ve kök temelini oluşturan mühendislik eğitimi.',
    highlights: [
      'Karmaşık ekosistem modellemesi ve döngüsel denge analitiği',
      'Doğal kaynak planlaması, coğrafi bilgi sistemleri (CBS) ve veri haritalama'
    ]
  }
];

const competencies = [
  {
    category: 'Kamu Stratejisi & İletişim',
    items: [
      'Belediye Başkan Danışmanlığı',
      'Basın-Yayın & Halkla İlişkiler',
      'Kriz Yönetimi & Kitle İletişimi',
      'Siyasal Kampanya Koordinasyonu',
      'Kurumsal Temsil & Protokol'
    ]
  },
  {
    category: 'Sistem Mimarisi & Linux',
    items: [
      'Arch Linux & Omarchy Ekosistemi',
      'BORE & EEVDF Çekirdek Zamanlayıcıları',
      'Wayland / Hyprland IPC Entegrasyonu',
      'Sistem Optimizasyonu & Düşük Gecikme',
      'Steam Deck & SteamOS İnce Ayarları'
    ]
  },
  {
    category: 'Yapay Zekâ & Otonom Kodlama',
    items: [
      'Antigravity CLI & Claude Code Orkestrasyonu',
      'Çoklu Ajan (Multi-Agent) Mimarileri',
      'Yerel LLM (Ollama, Llama 3.1 Edge AI)',
      'Prompt Mühendisliği & Bağlam Mimarisi',
      'llms.txt Standartlaştırması'
    ]
  },
  {
    category: 'Görsel Kültür & Fotonik',
    items: [
      'Fujifilm GFX 50R/100 16-Bit Orta Format',
      'OmaStudio RAW Motoru (Rust/Slint)',
      'Kadim Ahşap Mimarisi Belgesel Arşivi',
      'Renk Teorisi & Fotonik Sensör Analizi'
    ]
  }
];
---

<BaseLayout
  title="Hakkımda & Teknik Özgeçmiş — Ozan Özdil"
  description="Ozan Özdil: KTÜ Orman Mühendisliği kökeni, Kastamonu Belediyesi Başkan Danışmanlığı, Ar-Ge & Bilgi İşlem Yöneticiliği, 2019 seçim stratejisi, Omarchy Linux ve YZ kodculuğu."
  currentPath="/hakkimda"
  maxWidthClass="max-w-4xl"
>
  <div class="space-y-16 sm:space-y-24 py-8 sm:py-16">

    <!-- ================================================================= -->
    <!-- BÖLÜM 1: PROFİL KARTI & EDİTORYAL HERO                            -->
    <!-- ================================================================= -->
    <header class="space-y-8" aria-label="Profil ve Tanıtım">
      <div class="flex flex-col sm:flex-row items-start sm:items-center gap-6 sm:gap-8 pb-8 border-b border-[#ead9d2]/80 dark:border-[#2d2521]">
        <!-- Avatar -->
        <div class="relative w-28 h-28 sm:w-36 sm:h-36 rounded-3xl overflow-hidden border border-[#ead9d2] dark:border-[#2d2521] bg-[#F5F0E4] dark:bg-[#1f1a17] shadow-sm flex-shrink-0">
          <img
            src="/avatar.webp"
            alt="Ozan Özdil"
            width="144"
            height="144"
            fetchpriority="high"
            decoding="async"
            class="w-full h-full object-cover"
          />
        </div>

        <!-- Name & Badges -->
        <div class="space-y-3 min-w-0">
          <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full text-xs font-mono bg-[#F5F0E4] dark:bg-[#1f1a17] text-[#5D524B] dark:text-[#a89f91] border border-[#ead9d2]/80 dark:border-[#2d2521]">
            <span class="w-2 h-2 rounded-full bg-[#e1734b] dark:bg-[#e59a7a] animate-pulse"></span>
            <span>HAKKIMDA & TEKNİK ÖZGEÇMİŞ</span>
          </div>

          <h1 class="font-serif text-4xl sm:text-5xl lg:text-6xl font-normal text-[#2d2724] dark:text-[#fef9ed] leading-tight">
            Ozan Özdil
          </h1>

          <p class="font-serif text-lg sm:text-xl text-[#5D524B] dark:text-[#a89f91] font-normal leading-relaxed">
            Orman Mühendisi • Eski Başkan Danışmanı & Bilgi İşlem Yöneticisi • Açık Kaynak Sistem Mimarı
          </p>

          <!-- Quick Metadata Chips -->
          <div class="flex flex-wrap items-center gap-2 pt-1 font-mono text-xs text-[#8C7E74] dark:text-[#a89f91]">
            <span class="px-3 py-1 rounded-full bg-[#F5F0E4] dark:bg-[#1f1a17] border border-[#ead9d2] dark:border-[#2d2521]">
              📍 Kastamonu, TR
            </span>
            <span class="px-3 py-1 rounded-full bg-[#F5F0E4] dark:bg-[#1f1a17] border border-[#ead9d2] dark:border-[#2d2521]">
              🌲 KTÜ Orman Fakültesi
            </span>
            <span class="px-3 py-1 rounded-full bg-[#F5F0E4] dark:bg-[#1f1a17] border border-[#ead9d2] dark:border-[#2d2521]">
              🏛️ Kastamonu Belediyesi (2019–2024)
            </span>
            <span class="px-3 py-1 rounded-full bg-[#F5F0E4] dark:bg-[#1f1a17] border border-[#ead9d2] dark:border-[#2d2521]">
              ⚡ Omarchy & Arch Linux
            </span>
          </div>
        </div>
      </div>
    </header>

    <!-- ================================================================= -->
    <!-- BÖLÜM 2: BİYOGRAFİ & VİZYON MANİFESTOSU                           -->
    <!-- ================================================================= -->
    <section class="space-y-6" aria-label="Biyografi ve Vizyon">
      <div class="font-mono text-xs text-[#e1734b] dark:text-[#e59a7a] uppercase tracking-wider font-semibold">
        // KÖK BİLİNCİ & YOLCULUK
      </div>
      <h2 class="font-serif text-3xl sm:text-4xl font-normal text-[#2d2724] dark:text-[#fef9ed] leading-snug">
        Ormanın Bilgeliğinden Dijital Egemenliğe
      </h2>

      <div class="space-y-5 font-serif text-base sm:text-lg text-[#5D524B] dark:text-[#a89f91] leading-relaxed">
        <p>
          Karadeniz Teknik Üniversitesi (KTÜ) Orman Fakültesi'nden aldığım mühendislik formasyonu; yalnızca ağaçları ve ormanları değil, birbiriyle sürekli iletişim hâlindeki karmaşık ekosistemleri, döngüsel dengeleri ve kök bilincini okumayı öğretti. Canlı bir ormanın bütünselliği neyse, modern bilişim mimarileri ve toplumların kitle iletişimi de benim için aynı kökten beslenen birer dinamik sistemdir.
        </p>
        <p>
          Kariyerimin dönüm noktalarından birini kamu yönetimi, yerel siyaset stratejisi ve kitle iletişimi teşkil etti. 2019 yerel seçim sürecinde Kastamonu'da zaferle sonuçlanan kampanya stratejisini, saha veri analitiğini ve iletişim liderliğini yürüttüm. Akabinde <strong>Kastamonu Belediyesi Başkan Danışmanlığı</strong> ile <strong>Ar-Ge ve Bilgi İşlem Yöneticiliği</strong> görevlerinde bulundum. Bu süreçte basın-yayın ve halkla ilişkiler mekanizmalarını baştan yapılandırarak 3 ayda <strong>25 milyondan fazla organik erişim</strong> sağlayan bir kitle iletişimi rekoru kırdık; kriz yönetiminden belediye sunucu ve bilişim altyapısının modernizasyonuna kadar çok yönlü kurumsal sorumluluklar üstlendik.
        </p>
        <p>
          Bugün arşivin sükûnetinde; edindiğimiz kamu disiplinini ve sistem analitiğini açık kaynak dünyasıyla birleştiriyorum. <a href="https://github.com/ozdil/omarchy" target="_blank" rel="noopener noreferrer" class="text-[#2d2724] dark:text-[#fef9ed] underline decoration-[#e1734b] underline-offset-4 font-medium hover:text-[#e1734b]">Omarchy Linux</a> çatısı altında Arch Linux çekirdek optimizasyonları, <strong>OmaStudio</strong> ile 16-bit orta format RAW motorları, <strong>Cyber Sentinel</strong> ile donanımsal güvenlik kalkanları ve otonom yapay zekâ kodlama ajanları (Antigravity CLI / Claude Code) geliştirerek bağımsız teknoloji üretimine devam ediyorum.
        </p>
        <p>
          Aynı zamanda Fujifilm GFX orta format sistemleriyle Karadeniz'in çivisiz ahşap çantı camilerini, kündekari sanatını ve kaybolan somut kültürel mirasını yüksek çözünürlüklü bir görsel arşive dönüştürüyorum.
        </p>
      </div>
    </section>

    <!-- ================================================================= -->
    <!-- BÖLÜM 3: KRONOLOJİK DENEYİM & KAMU YÖNETİMİ (ZAMAN ÇİZELGESİ)     -->
    <!-- ================================================================= -->
    <section class="space-y-8" aria-label="Kronolojik Deneyim">
      <div class="flex items-center justify-between pb-4 border-b border-[#ead9d2]/80 dark:border-[#2d2521]">
        <div>
          <div class="font-mono text-xs text-[#e1734b] dark:text-[#e59a7a] uppercase tracking-wider font-semibold">
            // KARİYER & TECRÜBE
          </div>
          <h2 class="font-serif text-3xl sm:text-4xl font-normal text-[#2d2724] dark:text-[#fef9ed]">
            Yolculuk & Kamu Yönetimi Deneyimi
          </h2>
        </div>
      </div>

      <div class="relative border-l border-[#ead9d2] dark:border-[#2d2521] ml-4 sm:ml-6 space-y-10 sm:space-y-12 pl-6 sm:pl-8">
        {timeline.map((item) => (
          <div class="relative group">
            <!-- Timeline Dot Indicator -->
            <div class="absolute -left-[31px] sm:-left-[39px] top-1.5 w-3 h-3 rounded-full bg-[#e1734b] dark:bg-[#e59a7a] ring-4 ring-[#fef9ed] dark:ring-[#141210]"></div>

            <div class="space-y-3">
              <!-- Period & Badge -->
              <div class="flex flex-wrap items-center justify-between gap-2">
                <span class="font-mono text-xs font-semibold text-[#8C7E74] dark:text-[#a89f91]">
                  {item.period}
                </span>
                <span class={`px-2.5 py-0.5 rounded-full font-mono text-[11px] border border-[#ead9d2]/60 dark:border-[#2d2521] ${item.badgeColor}`}>
                  {item.badge}
                </span>
              </div>

              <!-- Role & Organization -->
              <div>
                <h3 class="font-serif text-xl sm:text-2xl font-normal text-[#2d2724] dark:text-[#fef9ed]">
                  {item.role}
                </h3>
                <div class="font-mono text-xs sm:text-sm text-[#e1734b] dark:text-[#e59a7a] font-medium mt-0.5">
                  {item.org}
                </div>
              </div>

              <!-- Description -->
              <p class="font-serif text-sm sm:text-base text-[#5D524B] dark:text-[#a89f91] leading-relaxed">
                {item.description}
              </p>

              <!-- Highlights -->
              {item.highlights && item.highlights.length > 0 && (
                <ul class="space-y-1.5 pt-1">
                  {item.highlights.map((hl) => (
                    <li class="flex items-start gap-2 text-xs sm:text-sm text-[#5D524B] dark:text-[#a89f91] font-sans">
                      <span class="text-[#e1734b] dark:text-[#e59a7a] font-mono select-none">›</span>
                      <span>{hl}</span>
                    </li>
                  ))}
                </ul>
              )}
            </div>
          </div>
        ))}
      </div>
    </section>

    <!-- ================================================================= -->
    <!-- BÖLÜM 4: YETKİNLİK & MİMARİ MATRİSİ                              -->
    <!-- ================================================================= -->
    <section class="space-y-8" aria-label="Uzmanlık ve Yetkinlikler">
      <div class="space-y-2">
        <div class="font-mono text-xs text-[#e1734b] dark:text-[#e59a7a] uppercase tracking-wider font-semibold">
          // YETKİNLİK ALANLARI
        </div>
        <h2 class="font-serif text-3xl sm:text-4xl font-normal text-[#2d2724] dark:text-[#fef9ed]">
          Teknik ve İdari Yetkinlikler
        </h2>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 sm:gap-6">
        {competencies.map((comp) => (
          <div class="p-6 rounded-[22px] bg-[#F5F0E4] dark:bg-[#1c1815] border border-[#ead9d2]/80 dark:border-[#2d2521] space-y-4 shadow-2xs">
            <h3 class="font-serif text-xl font-normal text-[#2d2724] dark:text-[#fef9ed] border-b border-[#ead9d2]/60 dark:border-[#2d2521] pb-2.5">
              {comp.category}
            </h3>
            <ul class="space-y-2 font-mono text-xs text-[#5D524B] dark:text-[#a89f91]">
              {comp.items.map((item) => (
                <li class="flex items-center gap-2">
                  <span class="w-1.5 h-1.5 rounded-full bg-[#e1734b] dark:bg-[#e59a7a]"></span>
                  <span>{item}</span>
                </li>
              ))}
            </ul>
          </div>
        ))}
      </div>
    </section>

    <!-- ================================================================= -->
    <!-- BÖLÜM 5: ÇALIŞMA ORTAMI & DONANIM LAB                            -->
    <!-- ================================================================= -->
    <section class="space-y-8" aria-label="Çalışma Ortamı ve Donanım">
      <div class="space-y-2">
        <div class="font-mono text-xs text-[#e1734b] dark:text-[#e59a7a] uppercase tracking-wider font-semibold">
          // DONANIM & LAB
        </div>
        <h2 class="font-serif text-3xl sm:text-4xl font-normal text-[#2d2724] dark:text-[#fef9ed]">
          Çalışma Ortamı & Araç Takımı
        </h2>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
        <div class="p-5 rounded-[20px] bg-[#FBF4E5] dark:bg-[#1f1a17] border border-[#ead9d2]/80 dark:border-[#2d2521] space-y-2">
          <span class="font-mono text-[11px] text-[#8C7E74] dark:text-[#a89f91] block">
            İşletim Sistemi
          </span>
          <div class="font-serif text-lg text-[#2d2724] dark:text-[#fef9ed] font-normal">
            Omarchy Linux
          </div>
          <p class="font-sans text-xs text-[#5D524B] dark:text-[#a89f91] leading-relaxed">
            Arch Linux tabanlı, Hyprland Wayland IPC, klavye odaklı pencere yönetimi ve BORE çekirdek zamanlayıcısı.
          </p>
        </div>

        <div class="p-5 rounded-[20px] bg-[#FBF4E5] dark:bg-[#1f1a17] border border-[#ead9d2]/80 dark:border-[#2d2521] space-y-2">
          <span class="font-mono text-[11px] text-[#8C7E74] dark:text-[#a89f91] block">
            YZ & Geliştirme
          </span>
          <div class="font-serif text-lg text-[#2d2724] dark:text-[#fef9ed] font-normal">
            Antigravity & Claude Code
          </div>
          <p class="font-sans text-xs text-[#5D524B] dark:text-[#a89f91] leading-relaxed">
            Otonom çoklu ajan orkestrasyonu, Rust, Go, Python, Cloudflare Workers ve yerel Llama 3.1 modelleri.
          </p>
        </div>

        <div class="p-5 rounded-[20px] bg-[#FBF4E5] dark:bg-[#1f1a17] border border-[#ead9d2]/80 dark:border-[#2d2521] space-y-2">
          <span class="font-mono text-[11px] text-[#8C7E74] dark:text-[#a89f91] block">
            Optik & Belgesel
          </span>
          <div class="font-serif text-lg text-[#2d2724] dark:text-[#fef9ed] font-normal">
            Fujifilm GFX Orta Format
          </div>
          <p class="font-sans text-xs text-[#5D524B] dark:text-[#a89f91] leading-relaxed">
            43.8×32.9mm geniş sensör alanı, GF50mm / GF63mm optikler ve 16-bit sıkıştırmasız RAW renk dinamikleri.
          </p>
        </div>
      </div>
    </section>

    <!-- ================================================================= -->
    <!-- BÖLÜM 6: BAĞLANTILAR & İLETİŞİM                                  -->
    <!-- ================================================================= -->
    <section class="space-y-6 pt-8 border-t border-[#ead9d2]/80 dark:border-[#2d2521]" aria-label="Bağlantılar ve İletişim">
      <div class="space-y-2">
        <div class="font-mono text-xs text-[#8C7E74] dark:text-[#a89f91] uppercase tracking-wider">
          // DİJİTAL BAĞLANTILAR
        </div>
        <h2 class="font-serif text-2xl sm:text-3xl font-normal text-[#2d2724] dark:text-[#fef9ed]">
          İletişim & Ağlar
        </h2>
      </div>

      <div class="grid grid-cols-2 sm:grid-cols-4 gap-3 font-mono text-xs">
        <a
          href="https://github.com/ozdil"
          target="_blank"
          rel="noopener noreferrer"
          class="p-4 rounded-[18px] bg-[#F5F0E4] dark:bg-[#1c1815] border border-[#ead9d2] dark:border-[#2d2521] hover:border-[#2d2724] dark:hover:border-[#fef9ed] transition-colors text-center group"
        >
          <span class="text-[11px] text-[#8C7E74] dark:text-[#a89f91] block mb-1">Kod Deposu</span>
          <span class="text-sm font-semibold text-[#2d2724] dark:text-[#fef9ed] group-hover:text-[#e1734b] transition-colors">GitHub ↗</span>
        </a>

        <a
          href="https://nsosyal.com/ozanozdil"
          target="_blank"
          rel="noopener noreferrer"
          class="p-4 rounded-[18px] bg-[#F5F0E4] dark:bg-[#1c1815] border border-[#ead9d2] dark:border-[#2d2521] hover:border-[#2d2724] dark:hover:border-[#fef9ed] transition-colors text-center group"
        >
          <span class="text-[11px] text-[#8C7E74] dark:text-[#a89f91] block mb-1">Sosyal Profil</span>
          <span class="text-sm font-semibold text-[#2d2724] dark:text-[#fef9ed] group-hover:text-[#e1734b] transition-colors">NSosyal ↗</span>
        </a>

        <a
          href="https://steamcommunity.com/id/ozanozdil"
          target="_blank"
          rel="noopener noreferrer"
          class="p-4 rounded-[18px] bg-[#F5F0E4] dark:bg-[#1c1815] border border-[#ead9d2] dark:border-[#2d2521] hover:border-[#2d2724] dark:hover:border-[#fef9ed] transition-colors text-center group"
        >
