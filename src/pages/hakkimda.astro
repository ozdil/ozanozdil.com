---
import BaseLayout from '../layouts/BaseLayout.astro';

const timeline = [
  {
    period: '2024 — Günümüz',
    role: 'Kurumsal Bilgi Yönetimi & Arşiv Araştırmacılığı',
    org: 'Kastamonu Belediyesi',
    badge: 'Kamu Görevi & Kurumsal Hafıza',
    badgeColor: 'bg-[#18181b] text-[#d4d4d8] border-[#27272a]',
    description:
      'Kastamonu Belediyesi bünyesinde kurumsal hafızanın korunması, resmi evrak sistemleri, kentsel dokümantasyon ve kamu arşivinin tasnif, muhafaza ve araştırma süreçlerinin yürütülmesi. Yılların getirdiği belediyecilik, bilgi işlem ve başkan danışmanlığı birikiminin kurumsal arşiv disipliniyle buluşturulması.',
    highlights: [
      'Kurumsal hafızanın korunması, kentsel bellek ve resmi dokümantasyon yönetimi',
      'Kamu mevzuatı, idari süreçler ve evrak akış güvenliği',
      'Belediye hizmet süreçlerinde devamlılık ve kamu ciddiyetiyle kurumsal katkı'
    ]
  },
  {
    period: '2024 — Günümüz',
    role: 'Bağımsız YZ Kodcusu & Açık Kaynak Sistem Mimarı',
    org: 'Omarchy Linux Ekosistemi & Ar-Ge',
    badge: 'Bağımsız Ar-Ge',
    badgeColor: 'bg-[#18181b] text-[#ffffff] border-[#3f3f46]',
    description:
      'Arch Linux tabanlı Omarchy dağıtım mimarisi, Wayland/Hyprland masaüstü entegrasyonu, OmaStudio 16-bit orta format RAW işleme motoru, Cyber Sentinel donanım savunması ve Antigravity CLI / Claude Code otonom yapay zekâ kodlama ajanları ile bağımsız Ar-Ge üretimi.',
    highlights: [
      'Omarchy Linux sistem optimizasyonları ve BORE/EEVDF düşük gecikmeli çekirdek takibi',
      'OmaStudio: Rust ve Slint/QML mimarisinde 16-bit orta format RAW motoru',
      'Uç bilişim (Cloudflare Edge) ve yapay zekâ entegrasyonları (llms.txt, Workers AI)'
    ]
  },
  {
    period: '2022 — 2024',
    role: 'Ar-Ge & Bilgi İşlem Yöneticiliği',
    org: 'Kastamonu Belediyesi',
    badge: 'Kurumsal Teknoloji',
    badgeColor: 'bg-[#18181b] text-[#d4d4d8] border-[#27272a]',
    description:
      'Belediye bünyesindeki tüm kurumsal bilişim altyapısının, sunucu sistemlerinin ve veri güvenliği protokollerinin modernizasyonu; dijital dönüşüm süreçlerinin ve teknolojik Ar-Ge projelerinin sevk ve idaresi.',
    highlights: [
      'Kurumsal sunucu altyapısı, ağ topolojisi ve veri güvenliği yönetimi',
      'Belediye hizmetlerinin dijitalleştirilmesi ve vatandaş odaklı e-belediye çözümleri',
      'Birimler arası veri entegrasyonu ve kurumsal bilişim standartlarının inşası'
    ]
  },
  {
    period: '2019 — 2022',
    role: 'Belediye Başkan Danışmanlığı & Medya Koordinatörlüğü',
    org: 'Kastamonu Belediyesi',
    badge: 'Kamu Yönetimi & Medya',
    badgeColor: 'bg-[#18181b] text-[#d4d4d8] border-[#27272a]',
    description:
      'Belediye başkanlığı makamında stratejik danışmanlık, basın-yayın, halkla ilişkiler ve dijital kitle iletişimi süreçlerinin liderliği. 3 ay gibi rekor bir sürede 25 milyondan fazla organik erişim sağlayan medya operasyonunun yönetimi.',
    highlights: [
      'Basın-yayın, sosyal medya ve kitle iletişimi süreçlerinin uçtan uca koordinasyonu',
      'Kriz iletişimi, saha nabzı analitiği ve kamuoyu beklenti yönetimi',
      'Kurumsal temsil, protokol ilişkileri ve belediye vizyon projelerinin tanıtımı'
    ]
  },
  {
    period: '2019',
    role: 'Siyasal İletişim & Seçim Koordinasyonu',
    org: 'MHP Kastamonu Yerel Seçim Kampanyası',
    badge: 'Strateji & Saha',
    badgeColor: 'bg-[#18181b] text-[#d4d4d8] border-[#27272a]',
    description:
      'Kastamonu yerel seçim zaferiyle taçlanan kampanya sürecinde; saha veri analitiği, siyasal kitle iletişimi, görsel prodüksiyon ve kampanya liderliği.',
    highlights: [
      'Seçmen dinamikleri analitiği ve mikro hedefli kitle iletişimi',
      'Çok kanallı görsel prodüksiyon, miting ve saha yayıncılığı yönetimi',
      'Seçim koordinasyon merkezinin stratejik iletişim yürütücülüğü'
    ]
  },
  {
    period: 'Lisans Eğitimi',
    role: 'Orman Mühendisliği Lisans Derecesi',
    org: 'Karadeniz Teknik Üniversitesi (KTÜ) — Orman Fakültesi',
    badge: 'Sistem & Kök Bilinci',
    badgeColor: 'bg-[#18181b] text-[#d4d4d8] border-[#27272a]',
    description:
      'Karmaşık ekolojik ağlar, çok değişkenli canlı sistemler ve döngüsel sistem mühendisliği formasyonu. Teknolojik mimarilere ve siber sistemlere bakışımın analitik ve kök temelini oluşturan mühendislik eğitimi.',
    highlights: [
      'Karmaşık ekosistem modellemesi ve döngüsel denge analitiği',
      'Doğal kaynak planlaması, coğrafi bilgi sistemleri (CBS) ve veri haritalama'
    ]
  }
];

const competencies = [
  {
    category: 'Kamu Stratejisi & Kurumsal Yönetim',
    items: [
      'Belediye Başkan Danışmanlığı',
      'Kurumsal Arşiv & Bilgi Yönetimi',
      'Basın-Yayın & Halkla İlişkiler',
      'Kriz Yönetimi & Kitle İletişimi',
      'Siyasal Kampanya Koordinasyonu',
      'Kurumsal Temsil & Protokol'
    ]
  },
  {
    category: 'Sistem Mimarisi & Linux',
    items: [
      'Arch Linux & Omarchy Ekosistemi',
      'BORE & EEVDF Çekirdek Zamanlayıcıları',
      'Wayland / Hyprland IPC Entegrasyonu',
      'Sistem Optimizasyonu & Düşük Gecikme',
      'Steam Deck & SteamOS İnce Ayarları'
    ]
  },
  {
    category: 'Yapay Zekâ & Otonom Kodlama',
    items: [
      'Antigravity CLI & Claude Code Orkestrasyonu',
      'Çoklu Ajan (Multi-Agent) Mimarileri',
      'Yerel LLM (Ollama, Llama 3.1 Edge AI)',
      'Prompt Mühendisliği & Bağlam Mimarisi',
      'llms.txt Standartlaştırması'
    ]
  },
  {
    category: 'Görsel Kültür & Fotonik',
    items: [
      'Fujifilm GFX 50R/100 16-Bit Orta Format',
      'OmaStudio RAW Motoru (Rust/Slint)',
      'Kadim Ahşap Mimarisi Belgesel Arşivi',
      'Renk Teorisi & Fotonik Sensör Analizi'
    ]
  }
];
---

<BaseLayout
  title="Hakkımda & Teknik Özgeçmiş — Ozan Özdil"
  description="Ozan Özdil: KTÜ Orman Mühendisliği formasyonu, Kastamonu Belediyesi kurumsal tecrübesi (Başkan Danışmanlığı, Bilgi İşlem, Kurumsal Hafıza & Arşiv), Omarchy Linux ve bağımsız YZ sistem mimarisi."
  currentPath="/hakkimda"
  maxWidthClass="max-w-5xl"
>
  <div class="space-y-16 sm:space-y-24 py-8 sm:py-16">

    <!-- ================================================================= -->
    <!-- BÖLÜM 1: EDİTORYAL HERO (PROFİL FOTOĞRAFSIZ, NET VE TİPOGRAFİK)   -->
    <!-- ================================================================= -->
    <header class="relative clean-card rounded-[24px] p-6 sm:p-10 shadow-xl overflow-hidden border border-[#27272a] bg-[#121215]" aria-label="Profil ve Tanıtım">
      <div class="flex items-center justify-between pb-5 border-b border-[#27272a] font-mono text-[11px] text-[#71717a]">
        <div class="flex items-center gap-2">
          <span class="w-2 h-2 rounded-full bg-[#52525b] animate-pulse"></span>
          <span>SİSTEM MİMARI // YZ KODCUSU</span>
        </div>
        <div class="hidden sm:flex items-center gap-3 text-[#71717a]">
          <span>KASTAMONU, TR</span>
          <span class="text-[#3f3f46]">|</span>
          <span>AÇIK KAYNAK</span>
        </div>
      </div>

      <div class="space-y-4 pt-6">
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full text-xs font-mono bg-[#18181b] text-[#a1a1aa] border border-[#27272a]">
          <span class="w-1.5 h-1.5 rounded-full bg-[#52525b]"></span>
          <span>HAKKIMDA & TEKNİK ÖZGEÇMİŞ</span>
        </div>

        <h1 class="font-serif text-4xl sm:text-5xl lg:text-6xl font-normal text-[#ffffff] leading-tight">
          Ozan Özdil
        </h1>

        <p class="font-serif text-lg sm:text-xl text-[#d4d4d8] font-normal leading-relaxed">
          Orman Mühendisi • Kastamonu Belediyesi • Açık Kaynak Sistem Mimarı
        </p>

        <!-- Metadata Chips -->
        <div class="flex flex-wrap items-center gap-2 pt-2 font-mono text-xs text-[#a1a1aa]">
          <span class="px-3 py-1 rounded-full bg-[#18181b] border border-[#27272a]">
            Kastamonu, TR
          </span>
          <span class="px-3 py-1 rounded-full bg-[#18181b] border border-[#27272a]">
            KTÜ Orman Fakültesi
          </span>
          <span class="px-3 py-1 rounded-full bg-[#18181b] border border-[#27272a]">
            Kastamonu Belediyesi (2019 — Günümüz)
          </span>
          <span class="px-3 py-1 rounded-full bg-[#18181b] border border-[#3f3f46] text-[#ffffff]">
            Omarchy & Arch Linux
          </span>
        </div>
      </div>
    </header>

    <!-- ================================================================= -->
    <!-- BÖLÜM 2: BİYOGRAFİ & VİZYON MANİFESTOSU                           -->
    <!-- ================================================================= -->
    <section class="space-y-6" aria-label="Biyografi ve Vizyon">
      <div class="font-mono text-xs text-[#71717a] uppercase tracking-wider font-semibold">
        // SİSTEM MİMARİSİ & YOLCULUK
      </div>
      <h2 class="font-serif text-3xl sm:text-4xl font-normal text-[#ffffff] leading-snug">
        Sistem Mühendisliğinden Kurumsal Hafıza ve Dijital Egemenliğe
      </h2>

      <div class="space-y-5 font-serif text-base sm:text-lg text-[#d4d4d8] leading-relaxed">
        <p>
          Karadeniz Teknik Üniversitesi (KTÜ) bünyesinde edindiğim mühendislik formasyonu; karmaşık dinamik sistemleri, döngüsel dengeleri ve analitik problem çözme disiplinini kazandırdı. Modern bilişim altyapıları, kurumsal evrak sistemleri ve kitle iletişimi benim için aynı analitik titizlikle ele alınan birer dinamik sistemdir.
        </p>
        <p>
          Kariyerimin önemli bir eksenini kamu yönetimi, yerel siyaset stratejisi ve kurumsal iletişim teşkil etti. 2019 yerel seçim sürecinde Kastamonu'da zaferle sonuçlanan kampanya stratejisini, saha veri analitiğini ve iletişim liderliğini yürüttüm. Akabinde <strong class="text-[#ffffff]">Kastamonu Belediyesi Başkan Danışmanlığı</strong> ile <strong class="text-[#ffffff]">Ar-Ge ve Bilgi İşlem Yöneticiliği</strong> görevlerinde bulundum. Bu süreçte basın-yayın ve halkla ilişkiler mekanizmalarını baştan yapılandırarak 3 ayda <strong class="text-[#ffffff]">25 milyondan fazla organik erişim</strong> sağlayan bir kitle iletişimi rekoru kırdık; kriz yönetiminden belediye sunucu ve bilişim altyapısının modernizasyonuna kadar kurumsal sorumluluklar üstlendik.
        </p>
        <p>
          Halen Kastamonu Belediyesi bünyesinde kurumsal hafızanın korunması, kentsel bellek araştırmaları ve resmi evrak arşiv sistematiği alanındaki kamu görevimi sürdürüyorum. Yılların getirdiği kamu yönetimi, bilgi işlem ve saha tecrübesini; kurumsal arşivin gerektirdiği titizlik, resmiyet ve devlet disipliniyle birleştirerek kentin idari hafızasına katkı sunmaya devam ediyorum.
        </p>
        <p>
          Mesai dışındaki bağımsız Ar-Ge çalışmalarımda ise sistem analitiğini modern yazılım dünyasıyla buluşturuyorum. <a href="https://github.com/ozdil/omarchy" target="_blank" rel="noopener noreferrer" class="text-[#ffffff] underline decoration-[#52525b] underline-offset-4 font-medium hover:text-[#a1a1aa]">Omarchy Linux</a> çatısı altında Arch Linux çekirdek optimizasyonları, <strong class="text-[#ffffff]">OmaStudio</strong> ile 16-bit orta format RAW işleme motoru, <strong class="text-[#ffffff]">Cyber Sentinel</strong> ile donanımsal güvenlik kalkanları ve otonom yapay zekâ kodlama ajanları (Antigravity CLI / Claude Code) geliştirerek dijital egemenlik odaklı bağımsız teknoloji üretiyorum.
        </p>
        <p>
          Aynı zamanda Fujifilm GFX orta format sistemleriyle Karadeniz'in çivisiz ahşap çantı camilerini, kündekari sanatını ve kaybolan somut kültürel mirasını yüksek çözünürlüklü bir görsel arşive dönüştürüyorum.
        </p>
      </div>
    </section>

    <!-- ================================================================= -->
    <!-- BÖLÜM 3: KRONOLOJİK DENEYİM & KAMU YÖNETİMİ (ZAMAN ÇİZELGESİ)     -->
    <!-- ================================================================= -->
    <section class="space-y-8" aria-label="Kronolojik Deneyim">
      <div class="flex items-center justify-between pb-4 border-b border-[#27272a]">
        <div>
          <div class="font-mono text-xs text-[#71717a] uppercase tracking-wider font-semibold">
            // KAMU YÖNETİMİ & KARİYER İZİ
          </div>
          <h2 class="font-serif text-3xl sm:text-4xl font-normal text-[#ffffff]">
            Deneyim & Zaman Çizelgesi
          </h2>
        </div>
      </div>

      <div class="relative border-l-2 border-[#27272a] ml-4 sm:ml-6 space-y-8 pl-6 sm:pl-8">
        {timeline.map((item) => (
          <div class="relative group clean-card bg-[#121215] border border-[#27272a] rounded-2xl p-5 sm:p-7 space-y-3 overflow-hidden">
            <!-- Timeline Dot -->
            <div class="absolute -left-[33px] sm:-left-[41px] top-6 w-4 h-4 rounded-full bg-[#09090b] border-2 border-[#52525b] flex items-center justify-center">
              <div class="w-1.5 h-1.5 rounded-full bg-[#a1a1aa]"></div>
            </div>

            <!-- Period & Badge -->
            <div class="flex flex-wrap items-center justify-between gap-2">
              <span class="font-mono text-xs font-semibold text-[#ffffff]">
                {item.period}
              </span>
              <span class={`px-2.5 py-0.5 rounded-full font-mono text-[11px] border ${item.badgeColor}`}>
                {item.badge}
              </span>
            </div>

            <!-- Role & Organization -->
            <div>
              <h3 class="font-serif text-xl sm:text-2xl font-normal text-[#ffffff]">
                {item.role}
              </h3>
              <div class="font-mono text-xs sm:text-sm text-[#a1a1aa] font-medium mt-0.5">
                {item.org}
              </div>
            </div>

            <!-- Description -->
            <p class="font-serif text-sm sm:text-base text-[#d4d4d8] leading-relaxed">
              {item.description}
            </p>

            <!-- Highlights -->
            {item.highlights && item.highlights.length > 0 && (
              <ul class="space-y-1.5 pt-1">
                {item.highlights.map((hl) => (
                  <li class="flex items-start gap-2 text-xs sm:text-sm text-[#d4d4d8] font-sans">
                    <span class="text-[#71717a] font-mono select-none">›</span>
                    <span>{hl}</span>
                  </li>
                ))}
              </ul>
            )}
          </div>
        ))}
      </div>
    </section>

    <!-- ================================================================= -->
    <!-- BÖLÜM 4: YETKİNLİK & MİMARİ MATRİSİ                              -->
    <!-- ================================================================= -->
    <section class="space-y-8" aria-label="Uzmanlık ve Yetkinlikler">
      <div class="space-y-2">
        <div class="font-mono text-xs text-[#71717a] uppercase tracking-wider font-semibold">
          // YETKİNLİK ALANLARI
        </div>
        <h2 class="font-serif text-3xl sm:text-4xl font-normal text-[#ffffff]">
          Teknik ve İdari Yetkinlikler
        </h2>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 sm:gap-6">
        {competencies.map((comp) => (
          <div class="clean-card bg-[#121215] border border-[#27272a] p-6 rounded-[22px] space-y-4 shadow-lg">
            <h3 class="font-serif text-xl font-normal text-[#ffffff] border-b border-[#27272a] pb-2.5">
              {comp.category}
            </h3>
            <ul class="space-y-2 font-mono text-xs text-[#a1a1aa]">
              {comp.items.map((item) => (
                <li class="flex items-center gap-2">
                  <span class="w-1.5 h-1.5 rounded-full bg-[#52525b]"></span>
                  <span>{item}</span>
                </li>
              ))}
            </ul>
          </div>
        ))}
      </div>
    </section>

    <!-- ================================================================= -->
    <!-- BÖLÜM 5: ÇALIŞMA ORTAMI & DONANIM LAB                            -->
    <!-- ================================================================= -->
    <section class="space-y-8" aria-label="Çalışma Ortamı ve Donanım">
      <div class="space-y-2">
        <div class="font-mono text-xs text-[#71717a] uppercase tracking-wider font-semibold">
          // DONANIM & LAB
        </div>
        <h2 class="font-serif text-3xl sm:text-4xl font-normal text-[#ffffff]">
          Çalışma Ortamı & Araç Takımı
        </h2>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
        <div class="clean-card bg-[#121215] border border-[#27272a] p-5 rounded-[20px] space-y-2 shadow-lg">
          <span class="font-mono text-[11px] text-[#71717a] block">
            İşletim Sistemi
          </span>
          <div class="font-serif text-lg text-[#ffffff] font-normal">
            Omarchy Linux
          </div>
          <p class="font-sans text-xs text-[#a1a1aa] leading-relaxed">
            Arch Linux tabanlı, Hyprland Wayland IPC, klavye odaklı pencere yönetimi ve BORE çekirdek zamanlayıcısı.
          </p>
        </div>

        <div class="clean-card bg-[#121215] border border-[#27272a] p-5 rounded-[20px] space-y-2 shadow-lg">
          <span class="font-mono text-[11px] text-[#71717a] block">
            YZ & Geliştirme
          </span>
          <div class="font-serif text-lg text-[#ffffff] font-normal">
            Antigravity & Claude Code
          </div>
          <p class="font-sans text-xs text-[#a1a1aa] leading-relaxed">
            Otonom çoklu ajan orkestrasyonu, Rust, Go, Python, Cloudflare Workers ve yerel Llama 3.1 modelleri.
          </p>
        </div>

        <div class="clean-card bg-[#121215] border border-[#27272a] p-5 rounded-[20px] space-y-2 shadow-lg">
          <span class="font-mono text-[11px] text-[#71717a] block">
            Optik & Belgesel
          </span>
          <div class="font-serif text-lg text-[#ffffff] font-normal">
            Fujifilm GFX Orta Format
          </div>
          <p class="font-sans text-xs text-[#a1a1aa] leading-relaxed">
            43.8×32.9mm geniş sensör alanı, GF50mm / GF63mm optikler ve 16-bit sıkıştırmasız RAW renk dinamikleri.
          </p>
        </div>
      </div>
    </section>

    <!-- ================================================================= -->
    <!-- BÖLÜM 6: BAĞLANTILAR & İLETİŞİM                                  -->
    <!-- ================================================================= -->
    <section class="space-y-6 pt-8 border-t border-[#27272a]" aria-label="Bağlantılar ve İletişim">
      <div class="space-y-2">
        <div class="font-mono text-xs text-[#71717a] uppercase tracking-wider">
          // DİJİTAL BAĞLANTILAR
        </div>
        <h2 class="font-serif text-2xl sm:text-3xl font-normal text-[#ffffff]">
          İletişim & Ağlar
        </h2>
      </div>

      <div class="grid grid-cols-2 sm:grid-cols-4 gap-3 font-mono text-xs">
        <a
          href="https://github.com/ozdil"
          target="_blank"
          rel="noopener noreferrer"
          class="p-4 rounded-[18px] bg-[#121215] border border-[#27272a] hover:border-[#52525b] hover:bg-[#18181b] transition-colors text-center group shadow-md"
        >
          <span class="text-[11px] text-[#71717a] block mb-1">Kod Deposu</span>
          <span class="text-sm font-semibold text-[#ffffff] group-hover:text-[#e4e4e7] transition-colors">GitHub ↗</span>
        </a>

        <a
          href="https://nsosyal.com/ozanozdil"
          target="_blank"
          rel="noopener noreferrer"
          class="p-4 rounded-[18px] bg-[#121215] border border-[#27272a] hover:border-[#52525b] hover:bg-[#18181b] transition-colors text-center group shadow-md"
        >
          <span class="text-[11px] text-[#71717a] block mb-1">Sosyal Profil</span>
          <span class="text-sm font-semibold text-[#ffffff] group-hover:text-[#e4e4e7] transition-colors">NSosyal ↗</span>
        </a>

        <a
          href="https://steamcommunity.com/id/ozanozdil"
          target="_blank"
          rel="noopener noreferrer"
          class="p-4 rounded-[18px] bg-[#121215] border border-[#27272a] hover:border-[#52525b] hover:bg-[#18181b] transition-colors text-center group shadow-md"
        >
          <span class="text-[11px] text-[#71717a] block mb-1">Oyun & Donanım</span>
          <span class="text-sm font-semibold text-[#ffffff] group-hover:text-[#e4e4e7] transition-colors">Steam ↗</span>
        </a>

        <a
          href="https://buymeacoffee.com/ozdil"
          target="_blank"
          rel="noopener noreferrer"
          class="p-4 rounded-[18px] bg-[#121215] border border-[#27272a] hover:border-[#52525b] hover:bg-[#18181b] transition-colors text-center group shadow-md"
        >
          <span class="text-[11px] text-[#71717a] block mb-1">Açık Kaynak Katkı</span>
          <span class="text-sm font-semibold text-[#ffffff] group-hover:text-[#e4e4e7] transition-colors">Destek Ol ↗</span>
        </a>
