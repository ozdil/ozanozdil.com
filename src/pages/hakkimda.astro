---
import BaseLayout from '../layouts/BaseLayout.astro';

const timeline = [
  {
    period: '2024 — Günümüz',
    role: 'Açık Kaynak Sistem Mimarı & YZ Kodcusu',
    org: 'Omarchy Linux Ekosistemi & Bağımsız Yazılım Ar-Ge',
    badge: 'Çekirdek Ar-Ge & Sistem',
    badgeColor: 'bg-[#18181b] text-[#ffffff] border-[#3f3f46]',
    description:
      'Arch Linux tabanlı bağımsız Omarchy dağıtım mimarisi, Wayland/Hyprland masaüstü entegrasyonu, OmaStudio 16-bit orta format RAW işleme motoru (Rust & Slint), Cyber Sentinel donanım savunması ve Antigravity CLI / Claude Code otonom yapay zekâ kodlama ajanları ile modern sistem ve yazılım üretimi.',
    highlights: [
      'Omarchy Linux sistem optimizasyonları ve BORE/EEVDF düşük gecikmeli çekirdek takibi',
      'OmaStudio: Rust ve Slint/QML mimarisinde 16-bit orta format RAW fotoğraf motoru',
      'Otonom yapay zekâ kodlama ajanları, çoklu ajan (multi-agent) mimarileri ve bağlam yönetimi',
      'Uç bilişim (Cloudflare Edge, Workers KV) ve açık standartlar (llms.txt, WebMCP)'
    ]
  },
  {
    period: '2024 — Günümüz',
    role: 'Açık Kaynak Sistem Koordinasyonu & Kurumsal Bilişim Altyapısı',
    org: 'Kastamonu Belediyesi',
    badge: 'Kamu Bilişimi & Açık Kaynak',
    badgeColor: 'bg-[#18181b] text-[#d4d4d8] border-[#27272a]',
    description:
      'Kastamonu Belediyesi bünyesinde dijital altyapıların modernizasyonu, resmi GitHub açık kaynak organizasyonunun (Kastamonu-Belediye-Baskanligi) sevk ve idaresi, Araştırma ve Geliştirme (A&G) ile Bilgi İşlem (BİM) teknik yapılanmalarının koordinasyonu ve kurumsal dijital dönüşüm süreçleri.',
    highlights: [
      'Resmi GitHub organizasyonu (Kastamonu-Belediye-Baskanligi) ve açık kaynak birim altyapıları (A&G, BİM)',
      'Akıllı Şehir Platformu ve dijital kurum altyapıları için modern sistem mimarisi',
      'Kurumsal dijital dönüşüm, veri güvenliği ve kamu bilişim standartları',
      'Yılların idari ve teknolojik birikimiyle belediyecilik süreçlerinde bilişim devamlılığı'
    ]
  },
  {
    period: '2023 — 2024 (Mayıs)',
    role: 'Bilgi İşlem Müdürü & Ar-Ge Yöneticiliği',
    org: 'Kastamonu Belediyesi',
    badge: 'Kurumsal Teknoloji & BİM',
    badgeColor: 'bg-[#18181b] text-[#d4d4d8] border-[#27272a]',
    description:
      'Kastamonu Belediyesi Bilgi İşlem Müdürlüğü bünyesinde tüm kurumsal bilişim altyapısının, sunucu sistemlerinin ve veri güvenliği protokollerinin modernizasyonu; dijital dönüşüm süreçlerinin ve teknolojik Ar-Ge projelerinin sevk ve idaresi.',
    highlights: [
      'Kurumsal sunucu altyapısı, ağ topolojisi ve kurumsal veri güvenliği yönetimi',
      'Belediye hizmetlerinin dijitalleştirilmesi ve vatandaş odaklı e-belediye çözümleri',
      'Birimler arası veri entegrasyonu ve kamu bilişim standartlarının inşası'
    ]
  },
  {
    period: '2019 — 2022',
    role: 'Belediye Başkan Danışmanlığı & Medya Koordinatörlüğü',
    org: 'Kastamonu Belediyesi',
    badge: 'Kamu Yönetimi & Medya',
    badgeColor: 'bg-[#18181b] text-[#d4d4d8] border-[#27272a]',
    description:
      'Belediye başkanlığı makamında stratejik danışmanlık, basın-yayın, halkla ilişkiler ve dijital kitle iletişimi süreçlerinin liderliği. 3 ay gibi rekor bir sürede 25 milyondan fazla organik erişim sağlayan medya operasyonunun yönetimi.',
    highlights: [
      'Basın-yayın, sosyal medya ve kitle iletişimi süreçlerinin uçtan uca koordinasyonu',
      'Kriz iletişimi, saha nabzı analitiği ve kamuoyu beklenti yönetimi',
      'Kurumsal temsil, protokol ilişkileri ve belediye vizyon projelerinin tanıtımı'
    ]
  },
  {
    period: '2024',
    role: 'Şehir Projeleri Mimarlığı & Seçim Vizyonu',
    org: 'Kastamonu Yerel Seçim Projeleri',
    badge: 'Vizyon & Şehir Mimarisi',
    badgeColor: 'bg-[#18181b] text-[#d4d4d8] border-[#27272a]',
    description:
      '2024 yerel seçim döneminde Kastamonu için hazırlanan ve kamuoyuna sunulan çok sayıda kapsamlı vizyon, kentsel dönüşüm, bilişim ve akıllı şehir projelerinin mimarlığı; teknik fizibilite, projelendirme ve stratejik sunum süreçlerinin yönetimi.',
    highlights: [
      'Kapsamlı kentsel vizyon, teknoloji ve sosyal belediyecilik projelerinin teknik tasarımı',
      'Yayınlanan seçim projeleri konsept mimarisi, modelleme ve fizibilite raporlaması',
      'Saha beklentileri ile örtüşen kentsel kalkınma ve açık veri entegrasyonlu şehir vizyonu'
    ]
  },
  {
    period: '2019',
    role: 'Siyasal İletişim, Proje Mimarlığı & Seçim Koordinasyonu',
    org: 'MHP Kastamonu Yerel Seçim Kampanyası',
    badge: 'Strateji & Saha',
    badgeColor: 'bg-[#18181b] text-[#d4d4d8] border-[#27272a]',
    description:
      'Kastamonu yerel seçim zaferiyle taçlanan kampanya sürecinde; yayınlanan vizyon projelerinin projelendirilmesi, saha veri analitiği, siyasal kitle iletişimi, görsel prodüksiyon ve kampanya liderliği.',
    highlights: [
      'Seçim döneminde kamuoyuyla paylaşılan kentsel vizyon projelerinin hazırlanması ve sunumu',
      'Seçmen dinamikleri analitiği ve mikro hedefli kitle iletişimi',
      'Çok kanallı görsel prodüksiyon, miting ve saha yayıncılığı yönetimi',
      'Seçim koordinasyon merkezinin stratejik iletişim yürütücülüğü'
    ]
  },
  {
    period: 'Lisans Eğitimi',
    role: 'Orman Mühendisliği Lisans Derecesi',
    org: 'Karadeniz Teknik Üniversitesi (KTÜ) — Orman Fakültesi',
    badge: 'Sistem & Kök Bilinci',
    badgeColor: 'bg-[#18181b] text-[#d4d4d8] border-[#27272a]',
    description:
      'Karmaşık ekolojik ağlar, çok değişkenli canlı sistemler ve döngüsel sistem mühendisliği formasyonu. Teknolojik mimarilere ve siber sistemlere bakışımın analitik ve kök temelini oluşturan mühendislik eğitimi.',
    highlights: [
      'Karmaşık ekosistem modellemesi ve döngüsel denge analitiği',
      'Doğal kaynak planlaması, coğrafi bilgi sistemleri (CBS) ve veri haritalama'
    ]
  }
];

const competencies = [
  {
    category: 'Yazılım Geliştirme & YZ Kodlama',
    items: [
      'Rust, QML / Qt, TypeScript, Shell Scripting',
      'Antigravity CLI & Claude Code Orkestrasyonu',
      'Çoklu Ajan (Multi-Agent) Mimarileri',
      'Yerel LLM (Ollama, Llama 3.1 Edge AI)',
      'Slint GUI & Declarative UI Geliştirme',
      'llms.txt & WebMCP Standartlaştırması'
    ]
  },
  {
    category: 'Sistem Mimarisi & Linux',
    items: [
      'Arch Linux & Omarchy Dağıtım Ekosistemi',
      'BORE & EEVDF Çekirdek Zamanlayıcıları',
      'Wayland / Hyprland IPC & Pencere Yöneticileri',
      'Sistem Optimizasyonu & Düşük Gecikme',
      'Steam Deck & SteamOS İnce Ayarları',
      'Zero-Trust Siber Savunma Kalkanları'
    ]
  },
  {
    category: 'Kamu Stratejisi & Kurumsal Yönetim',
    items: [
      'Açık Kaynak Kamu Koordinasyonu (A&G / BİM)',
      'Belediye Başkan Danışmanlığı',
      'Ar-Ge ve Bilgi İşlem Yöneticiliği',
      'Kriz Yönetimi & Kitle İletişimi',
      'Siyasal Kampanya Koordinasyonu',
      'Kurumsal Temsil & Protokol'
    ]
  },
  {
    category: 'Görsel Kültür & Fotonik',
    items: [
      'Fujifilm GFX 50R/100 16-Bit Orta Format',
      'OmaStudio RAW Motoru Mimarisi',
      'Kadim Ahşap Mimarisi Belgesel Arşivi',
      'Renk Teorisi & Fotonik Sensör Analizi'
    ]
  }
];
---

<BaseLayout
  title="Hakkımda & Teknik Özgeçmiş — Ozan Özdil"
  description="Ozan Özdil: KTÜ Orman Mühendisliği formasyonu, Kastamonu Belediyesi kurumsal tecrübesi (Başkan Danışmanlığı, Bilgi İşlem), Omarchy Linux, yazılım geliştirme ve otonom YZ sistem mimarisi."
  currentPath="/hakkimda"
  maxWidthClass="max-w-5xl"
>
  <div class="space-y-16 sm:space-y-24 py-8 sm:py-16">

    <!-- ================================================================= -->
    <!-- BÖLÜM 1: EDİTORYAL HERO (PORTRE VE TİPOGRAFİK BAŞLIK)             -->
    <!-- ================================================================= -->
    <header class="relative clean-card rounded-[24px] p-6 sm:p-10 shadow-xl overflow-hidden border border-[#27272a] bg-[#121215]" aria-label="Profil ve Tanıtım">
      <div class="flex items-center justify-between pb-5 border-b border-[#27272a] font-mono text-[11px] text-[#71717a]">
        <div class="flex items-center gap-2">
          <span class="w-2 h-2 rounded-full bg-[#52525b] animate-pulse"></span>
          <span>SİSTEM MİMARI // YZ KODCUSU</span>
        </div>
        <div class="hidden sm:flex items-center gap-3 text-[#71717a]">
          <span>KASTAMONU, TR</span>
          <span class="text-[#3f3f46]">|</span>
          <span>AÇIK KAYNAK</span>
        </div>
      </div>

      <div class="pt-8 flex flex-col md:flex-row items-center md:items-start gap-8 lg:gap-10">
        <!-- Portre Fotoğrafı -->
        <div class="relative shrink-0 group">
          <div class="relative w-36 h-36 sm:w-44 sm:h-44 md:w-48 md:h-48 rounded-2xl overflow-hidden border border-[#3f3f46] bg-[#18181b] shadow-2xl transition-all duration-300 group-hover:border-[#71717a]">
            <img
              src="/images/ozan-ozdil-portrait.jpg"
              alt="Ozan Özdil"
              width="384"
              height="384"
              class="w-full h-full object-cover object-center grayscale contrast-[1.08] brightness-[0.98] transition-transform duration-500 group-hover:scale-105"
              loading="eager"
            />
            <div class="absolute inset-0 bg-gradient-to-t from-black/40 via-transparent to-transparent pointer-events-none"></div>
          </div>
          <div class="absolute -bottom-2.5 -right-2.5 px-2 py-0.5 rounded-md bg-[#18181b] border border-[#27272a] text-[10px] font-mono text-[#a1a1aa] shadow-md hidden sm:block">
            LEICA // MONO
          </div>
        </div>

        <!-- Başlık ve Künye Bilgileri -->
        <div class="space-y-4 text-center md:text-left flex-1 min-w-0">
          <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full text-xs font-mono bg-[#18181b] text-[#a1a1aa] border border-[#27272a]">
            <span class="w-1.5 h-1.5 rounded-full bg-[#52525b]"></span>
            <span>HAKKIMDA & TEKNİK ÖZGEÇMİŞ</span>
          </div>

          <h1 class="font-serif text-3xl sm:text-5xl lg:text-6xl font-normal text-[#ffffff] leading-tight">
            Ozan Özdil
          </h1>

          <p class="font-serif text-base sm:text-xl text-[#d4d4d8] font-normal leading-relaxed">
            Orman Mühendisi • Kastamonu Belediyesi • Açık Kaynak Sistem Mimarı
          </p>

          <!-- Metadata Chips -->
          <div class="flex flex-wrap items-center justify-center md:justify-start gap-2 pt-2 font-mono text-xs text-[#a1a1aa]">
            <span class="px-3 py-1 rounded-full bg-[#18181b] border border-[#27272a]">
              Kastamonu, TR
            </span>
            <span class="px-3 py-1 rounded-full bg-[#18181b] border border-[#27272a]">
              KTÜ Orman Fakültesi
            </span>
            <span class="px-3 py-1 rounded-full bg-[#18181b] border border-[#27272a]">
              Kastamonu Belediyesi (2019 — Günümüz)
            </span>
            <a
              href="https://github.com/Kastamonu-Belediye-Baskanligi"
              target="_blank"
              rel="noopener noreferrer"
              class="px-3 py-1 rounded-full bg-[#18181b] border border-[#27272a] hover:border-[#52525b] hover:text-[#ffffff] transition-colors"
            >
              Kastamonu Belediyesi GitHub (A&G // BİM) ↗
            </a>
            <span class="px-3 py-1 rounded-full bg-[#18181b] border border-[#3f3f46] text-[#ffffff]">
              Omarchy & Arch Linux
            </span>
          </div>
        </div>
      </div>
    </header>

    <!-- ================================================================= -->
    <!-- BÖLÜM 2: BİYOGRAFİ & VİZYON MANİFESTOSU                           -->
    <!-- ================================================================= -->
    <section class="space-y-6" aria-label="Biyografi ve Vizyon">
      <div class="font-mono text-xs text-[#71717a] uppercase tracking-wider font-semibold">
        // SİSTEM MİMARİSİ & YAZILIM YOLCULUĞU
      </div>
      <h2 class="font-serif text-3xl sm:text-4xl font-normal text-[#ffffff] leading-snug">
        Sistem Mühendisliğinden Otonom Kodlamaya ve Dijital Egemenliğe
      </h2>

      <div class="space-y-5 font-serif text-base sm:text-lg text-[#d4d4d8] leading-relaxed">
        <p>
          Karadeniz Teknik Üniversitesi (KTÜ) bünyesinde edindiğim mühendislik formasyonu; karmaşık dinamik sistemleri, döngüsel dengeleri ve analitik problem çözme disiplinini kazandırdı. Modern bilişim altyapıları, yazılım mimarileri ve otonom sistemler benim için aynı mühendislik titizliğiyle ele alınan yaşayan ekosistemlerdir.
        </p>
        <p>
          Kamu tecrübemin merkezinde dijital dönüşüm, bilişim altyapı yönetimi ve kentsel proje mimarlığı yer aldı. Son iki yerel seçim döneminde (2019 ve 2024) Kastamonu için hazırladığım, kamuoyuna sunulan ve geniş yankı uyandıran çok sayıda vizyon projesinin teknik tasarımını, şehir mimarisini ve iletişim liderliğini yürüttüm. Akabinde <strong class="text-[#ffffff]">Kastamonu Belediyesi Başkan Danışmanlığı</strong> ve <strong class="text-[#ffffff]">Bilgi İşlem Müdürlüğü</strong> görevlerini üstlendim. Bu süreçte belediye sunucu ve ağ altyapısının modernizasyonu, veri güvenliği protokolleri ve 3 ayda <strong class="text-[#ffffff]">25 milyondan fazla organik erişim</strong> sağlayan dijital iletişim mimarisini hayata geçirdik.
        </p>
        <p>
          Halen Kastamonu Belediyesi bünyesinde kurumsal açık kaynak bilişim vizyonu doğrultusunda resmi <a href="https://github.com/Kastamonu-Belediye-Baskanligi" target="_blank" rel="noopener noreferrer" class="text-[#ffffff] underline decoration-[#52525b] underline-offset-4 font-medium hover:text-[#a1a1aa]">GitHub organizasyonu (Kastamonu-Belediye-Baskanligi)</a> altyapısını, <strong class="text-[#ffffff]">Araştırma ve Geliştirme Müdürlüğü (A&G)</strong> ile <strong class="text-[#ffffff]">Bilgi İşlem Müdürlüğü (BİM)</strong> teknik yapılanmalarını koordine ediyorum. NATO STANAG / DEFCON-1 askeri siber savunma ve kuantum sonrası kriptografi standartlarında açık veri ve akıllı şehir platformu mimarileri geliştiriyorum.
        </p>
        <p>
          Bağımsız yazılım geliştirme ve sistem mimarisi çalışmalarımda ise tüm üretimimi modern teknolojilerle buluşturuyorum. <a href="/projeler" class="text-[#ffffff] underline decoration-[#52525b] underline-offset-4 font-medium hover:text-[#a1a1aa]">Omarchy Linux</a> çatısı altında Arch Linux çekirdek optimizasyonları, <a href="https://github.com/ozdil/omarchy-omastudio" target="_blank" rel="noopener noreferrer" class="text-[#ffffff] underline decoration-[#52525b] underline-offset-4 font-medium hover:text-[#a1a1aa]">OmaStudio</a> ile Rust ve Slint mimarisinde 16-bit orta format RAW işleme motoru, <a href="https://github.com/ozdil/omarchy-security-sentinel" target="_blank" rel="noopener noreferrer" class="text-[#ffffff] underline decoration-[#52525b] underline-offset-4 font-medium hover:text-[#a1a1aa]">Cyber Sentinel</a> ile donanımsal güvenlik kalkanları ve otonom yapay zekâ kodlama ajanları (Antigravity CLI / Claude Code) geliştirerek dijital egemenlik odaklı yazılım ekosistemleri üretiyorum.
        </p>
        <p>
          Aynı zamanda Fujifilm GFX orta format sistemleriyle Karadeniz'in çivisiz ahşap çantı camilerini, kündekari sanatını ve kaybolan somut kültürel mirasını yüksek çözünürlüklü bir görsel belgesele dönüştürüyorum.
        </p>
      </div>
    </section>

    <!-- ================================================================= -->
    <!-- BÖLÜM 3: KRONOLOJİK DENEYİM & YAZILIM YOLCULUĞU (ZAMAN ÇİZELGESİ) -->
    <!-- ================================================================= -->
    <section class="space-y-8" aria-label="Kronolojik Deneyim">
      <div class="flex items-center justify-between pb-4 border-b border-[#27272a]">
        <div>
          <div class="font-mono text-xs text-[#71717a] uppercase tracking-wider font-semibold">
            // YAZILIM MİMARİSİ & KARİYER İZİ
          </div>
          <h2 class="font-serif text-3xl sm:text-4xl font-normal text-[#ffffff]">
            Deneyim & Zaman Çizelgesi
          </h2>
        </div>
      </div>

      <div class="relative border-l-2 border-[#27272a] ml-4 sm:ml-6 space-y-8 pl-6 sm:pl-8">
        {timeline.map((item) => (
          <div class="relative group clean-card bg-[#121215] border border-[#27272a] rounded-2xl p-5 sm:p-7 space-y-3 overflow-hidden">
            <!-- Timeline Dot -->
            <div class="absolute -left-[33px] sm:-left-[41px] top-6 w-4 h-4 rounded-full bg-[#09090b] border-2 border-[#52525b] flex items-center justify-center">
              <div class="w-1.5 h-1.5 rounded-full bg-[#a1a1aa]"></div>
            </div>

            <!-- Period & Badge -->
            <div class="flex flex-wrap items-center justify-between gap-2">
              <span class="font-mono text-xs font-semibold text-[#ffffff]">
                {item.period}
              </span>
              <span class={`px-2.5 py-0.5 rounded-full font-mono text-[11px] border ${item.badgeColor}`}>
                {item.badge}
              </span>
            </div>

            <!-- Role & Organization -->
            <div>
              <h3 class="font-serif text-xl sm:text-2xl font-normal text-[#ffffff]">
                {item.role}
              </h3>
              <div class="font-mono text-xs sm:text-sm text-[#a1a1aa] font-medium mt-0.5">
                {item.org}
              </div>
            </div>

            <!-- Description -->
            <p class="font-serif text-sm sm:text-base text-[#d4d4d8] leading-relaxed">
              {item.description}
            </p>

            <!-- Highlights -->
            {item.highlights && item.highlights.length > 0 && (
              <ul class="space-y-1.5 pt-1">
                {item.highlights.map((hl) => (
                  <li class="flex items-start gap-2 text-xs sm:text-sm text-[#d4d4d8] font-sans">
                    <span class="text-[#71717a] font-mono select-none">›</span>
                    <span>{hl}</span>
                  </li>
                ))}
              </ul>
            )}
          </div>
        ))}
      </div>
    </section>

    <!-- ================================================================= -->
    <!-- BÖLÜM 4: YETKİNLİK & MİMARİ MATRİSİ                              -->
    <!-- ================================================================= -->
    <section class="space-y-8" aria-label="Uzmanlık ve Yetkinlikler">
      <div class="space-y-2">
        <div class="font-mono text-xs text-[#71717a] uppercase tracking-wider font-semibold">
          // YETKİNLİK ALANLARI
        </div>
        <h2 class="font-serif text-3xl sm:text-4xl font-normal text-[#ffffff]">
          Teknik ve İdari Yetkinlikler
        </h2>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 sm:gap-6">
        {competencies.map((comp) => (
          <div class="clean-card bg-[#121215] border border-[#27272a] p-6 rounded-[22px] space-y-4 shadow-lg">
            <h3 class="font-serif text-xl font-normal text-[#ffffff] border-b border-[#27272a] pb-2.5">
              {comp.category}
            </h3>
            <ul class="space-y-2 font-mono text-xs text-[#a1a1aa]">
              {comp.items.map((item) => (
                <li class="flex items-center gap-2">
                  <span class="w-1.5 h-1.5 rounded-full bg-[#52525b]"></span>
                  <span>{item}</span>
                </li>
              ))}
            </ul>
          </div>
        ))}
      </div>
    </section>

    <!-- ================================================================= -->
    <!-- BÖLÜM 5: ÇALIŞMA ORTAMI & DONANIM LAB                            -->
    <!-- ================================================================= -->
    <section class="space-y-8" aria-label="Çalışma Ortamı ve Donanım">
      <div class="space-y-2">
        <div class="font-mono text-xs text-[#71717a] uppercase tracking-wider font-semibold">
          // DONANIM & LAB
        </div>
        <h2 class="font-serif text-3xl sm:text-4xl font-normal text-[#ffffff]">
          Çalışma Ortamı & Araç Takımı
        </h2>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
        <div class="clean-card bg-[#121215] border border-[#27272a] p-5 rounded-[20px] space-y-2 shadow-lg">
          <span class="font-mono text-[11px] text-[#71717a] block">
            İşletim Sistemi
          </span>
          <div class="font-serif text-lg text-[#ffffff] font-normal">
            Omarchy Linux
          </div>
          <p class="font-sans text-xs text-[#a1a1aa] leading-relaxed">
