---
import BaseLayout from '../layouts/BaseLayout.astro';

const repositories = [
  {
    name: 'omarchy-omanotes',
    desc: 'Omarchy Linux için Google Keep tarzında, Zero-Knowledge AES-256-GCM uçtan uca şifreli (E2EE) ve Google Drive/Git bulut senkronizasyonlu not yöneticisi.',
    lang: 'Rust / QML',
    langColor: '#dea584',
    tags: ['quickshell', 'rust', 'e2ee', 'google-keep', 'cloud-sync'],
    url: 'https://github.com/ozdil/omarchy-omanotes'
  },
  {
    name: 'omarchy-shell',
    desc: 'Quickshell tabanlı, Qt/QML çekirdekli modern Wayland masaüstü kabuğu.',
    lang: 'QML / C++',
    langColor: '#00ffcc',
    tags: ['quickshell', 'qml', 'wayland', 'omarchy'],
    url: 'https://github.com/ozdil/omarchy'
  },
  {
    name: 'quickshell-oled-themes',
    desc: 'Omarchy ve Quickshell için 4K OLED optimize tema motoru ve renk paletleri.',
    lang: 'QML',
    langColor: '#2b5b84',
    tags: ['quickshell', 'oled', 'themes', 'catppuccin'],
    url: 'https://github.com/ozdil/omarchy-turkiye-theme'
  },
  {
    name: 'quickshell-game-hud',
    desc: 'Linux oyuncuları için tam ekran Game Mode ve OSD durum ve performans paneli.',
    lang: 'QML / Shell',
    langColor: '#a855f7',
    tags: ['quickshell', 'gaming', 'steam', 'osd'],
    url: 'https://github.com/ozdil/omarchy'
  },
  {
    name: 'omarchy',
    desc: 'Arch Linux tabanlı, optimize edilmiş sistem yapılandırması.',
    lang: 'Shell',
    langColor: '#89e051',
    tags: ['arch-linux', 'hyprland', 'dotfiles'],
    url: 'https://github.com/ozdil/omarchy'
  },
  {
    name: 'omarchy-cyber-sentinel',
    desc: 'Ağ trafiği izleme ve anormallik tespit aracı.',
    lang: 'Python / Bash',
    langColor: '#3572A5',
    tags: ['security', 'network', 'sentinel'],
    url: 'https://github.com/ozdil/omarchy-cyber-sentinel'
  },
  {
    name: 'omarchy-badusb-shield',
    desc: 'USB aygıt yetkilendirme ve bağlantı güvenliği aracı.',
    lang: 'Shell',
    langColor: '#89e051',
    tags: ['badusb', 'hardware-sec', 'linux'],
    url: 'https://github.com/ozdil/omarchy-badusb-shield'
  },
  {
    name: 'omarchy-cve-radar',
    desc: 'Linux sistem paketleri için güvenlik açığı (CVE) denetleyici.',
    lang: 'Python',
    langColor: '#3572A5',
    tags: ['cve', 'vulnerability-scanner'],
    url: 'https://github.com/ozdil/omarchy-cve-radar'
  },
  {
    name: 'omarchy-omarank',
    desc: 'Linux donanım ve çekirdek performans kıyaslama aracı.',
    lang: 'Rust / C',
    langColor: '#dea584',
    tags: ['benchmark', 'performance'],
    url: 'https://github.com/ozdil/omarchy-omarank'
  },
  {
    name: 'omarchy-omasend',
    desc: 'Yerel ağda şifreli dosya ve veri aktarım aracı.',
    lang: 'Go / Shell',
    langColor: '#00ADD8',
    tags: ['p2p', 'file-transfer', 'go'],
    url: 'https://github.com/ozdil/omarchy-omasend'
  },
  {
    name: 'omarchy-auth-watch',
    desc: 'Yetkisiz oturum açma ve SSH denemelerini izleme aracı.',
    lang: 'Shell',
    langColor: '#89e051',
    tags: ['security', 'auth', 'audit'],
    url: 'https://github.com/ozdil/omarchy-auth-watch'
  },
  {
    name: 'omarchy-ghost-mac',
    desc: 'Kablosuz ağ MAC adreslerini dinamik olarak anonimleştiren gizlilik aracı.',
    lang: 'Shell',
    langColor: '#89e051',
    tags: ['privacy', 'wifi', 'opsec'],
    url: 'https://github.com/ozdil/omarchy-ghost-mac'
  },
  {
    name: 'omarchy-dns-leak-guard',
    desc: 'DNS sızıntılarını denetleyen ve şifreli DNS tünellemesini doğrulayan araç.',
    lang: 'Shell',
    langColor: '#89e051',
    tags: ['dns', 'privacy', 'network'],
    url: 'https://github.com/ozdil/omarchy-dns-leak-guard'
  },
  {
    name: 'omarchy-tripwire-vault',
    desc: 'Dosya sistemi üzerinde yetkisiz erişim tespit aracı.',
    lang: 'Shell',
    langColor: '#89e051',
    tags: ['honeypot', 'security'],
    url: 'https://github.com/ozdil/omarchy-tripwire-vault'
  },
  {
    name: 'omarchy-turkiye-theme',
    desc: 'OLED uyumlu, ergonomik sistem arayüz teması.',
    lang: 'CSS / Shell',
    langColor: '#563d7c',
    tags: ['theme', 'hyprland', 'oled'],
    url: 'https://github.com/ozdil/omarchy-turkiye-theme'
  }
];
---

<BaseLayout
  title="Projeler — Ozan Özdil"
  description="Ozan Özdil tarafından geliştirilen açık kaynak projeler ve araçlar."
  currentPath="/projeler"
  maxWidthClass="max-w-[1720px]"
>
  <div class="py-2 sm:py-4 space-y-6">
    <!-- Header -->
    <header class="rounded-xl border border-zinc-200 dark:border-zinc-800 bg-white dark:bg-[#0c0e12] p-5 sm:p-7 text-center">
      <div class="inline-flex items-center gap-2 font-mono text-xs text-zinc-900 dark:text-[#00ffcc] uppercase tracking-wider mb-2">
        <span class="w-2 h-2 rounded-full bg-zinc-900 dark:bg-[#00ffcc]"></span>
        <span>// açık kaynak projeler</span>
      </div>
      <h1 class="text-2xl sm:text-3xl lg:text-4xl font-semibold tracking-tight text-zinc-950 dark:text-zinc-50 font-sans">
        Açık Kaynak Projeler
      </h1>
      <p class="mt-2 text-sm sm:text-base text-zinc-600 dark:text-zinc-400 max-w-lg mx-auto">
        Linux, sistem araçları, C++/QML kabuk bileşenleri ve açık kaynak çalışmalarım.
      </p>
    </header>

    <!-- Repositories Grid: Clean 1px stroke border cards -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 2xl:grid-cols-5 gap-4">
      {repositories.map((repo) => (
        <article class="rounded-xl border border-zinc-200 dark:border-zinc-800 bg-white dark:bg-[#0c0e12] hover:border-zinc-400 dark:hover:border-[#00ffcc]/60 transition-all p-4 sm:p-5 flex flex-col justify-between group">
          <div class="space-y-2.5">
            <!-- Top Language & Status Line -->
            <div class="flex items-center justify-between text-[11px] font-mono pb-2 border-b border-zinc-100 dark:border-zinc-800/60">
              <span class="text-zinc-900 dark:text-[#00ffcc] font-medium">
                {repo.lang}
              </span>
              <span class="text-zinc-600 dark:text-[#00ffcc] text-[10px]">
                ● aktif
              </span>
            </div>

            <!-- Title -->
            <h2 class="font-sans font-bold text-base text-zinc-950 dark:text-zinc-100 group-hover:text-zinc-950 dark:group-hover:text-[#00ffcc] transition-colors truncate">
              {repo.name}
            </h2>

            <!-- Description -->
            <p class="text-xs text-zinc-600 dark:text-zinc-400 leading-relaxed font-sans line-clamp-3">
              {repo.desc}
            </p>
          </div>

          <!-- Tags & Action -->
          <div class="pt-3 mt-3 border-t border-zinc-100 dark:border-zinc-800/60 space-y-2">
            <div class="flex flex-wrap gap-1 font-mono text-[10px]">
              {repo.tags.slice(0, 3).map((tag) => (
                <span class="px-1.5 py-0.5 rounded bg-zinc-100 dark:bg-zinc-800/60 text-zinc-500 dark:text-zinc-400 border border-zinc-200/60 dark:border-zinc-800">
                  #{tag}
                </span>
              ))}
            </div>

            <div class="pt-1 flex justify-end">
              <a
                href={repo.url}
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex items-center gap-1 font-mono text-xs text-zinc-700 dark:text-[#00ffcc] font-medium group-hover:underline"
              >
                <span>Depoya Git</span>
                <span>↗</span>
              </a>
            </div>
          </div>
        </article>
      ))}
    </div>
  </div>
</BaseLayout>
