---
import BaseLayout from '../layouts/BaseLayout.astro';

const repositories = [
  {
    name: 'omarchy',
    desc: 'Arch Linux tabanlı, optimize edilmiş yüksek performanslı sistem ekosistemi ve mimari yapılandırma paketi.',
    lang: 'Shell',
    langColor: '#89e051',
    tags: ['arch-linux', 'hyprland', 'system-craft'],
    url: 'https://github.com/ozdil/omarchy'
  },
  {
    name: 'omarchy-cyber-sentinel',
    desc: 'Canlı ağ trafiği analizi, tehdit tespiti ve proaktif sistem savunma modülü.',
    lang: 'Python / Bash',
    langColor: '#3572A5',
    tags: ['cybersecurity', 'network', 'sentinel'],
    url: 'https://github.com/ozdil/omarchy-cyber-sentinel'
  },
  {
    name: 'omarchy-badusb-shield',
    desc: 'Donanımsal USB ve harici çevre birimi tabanlı saldırılara karşı dinamik yetkilendirme ve port koruması.',
    lang: 'Shell',
    langColor: '#89e051',
    tags: ['badusb', 'hardware-sec', 'linux'],
    url: 'https://github.com/ozdil/omarchy-badusb-shield'
  },
  {
    name: 'omarchy-cve-radar',
    desc: 'Linux sistem paketleri ve uygulama bağımlılıkları için güvenlik açığı (CVE) denetleme aracı.',
    lang: 'Python',
    langColor: '#3572A5',
    tags: ['cve', 'vulnerability-scanner'],
    url: 'https://github.com/ozdil/omarchy-cve-radar'
  },
  {
    name: 'omarchy-omarank',
    desc: 'Linux çekirdeği ve donanım bileşenleri için sentetik kıyaslama (benchmark) ve performans analiz paketi.',
    lang: 'Rust / C',
    langColor: '#dea584',
    tags: ['benchmark', 'performance'],
    url: 'https://github.com/ozdil/omarchy-omarank'
  },
  {
    name: 'omarchy-omasend',
    desc: 'Yerel ağ üzerinde uçtan uca şifreli, yüksek hızlı p2p dosya ve veri aktarım protokolü.',
    lang: 'Go / Shell',
    langColor: '#00ADD8',
    tags: ['p2p', 'file-transfer', 'go'],
    url: 'https://github.com/ozdil/omarchy-omasend'
  },
  {
    name: 'omarchy-auth-watch',
    desc: 'Yetkisiz oturum açma ve SSH sızma girişimlerini anlık takip edip engelleyen kimlik doğrulama bekçisi.',
    lang: 'Shell',
    langColor: '#89e051',
    tags: ['security', 'auth', 'audit'],
    url: 'https://github.com/ozdil/omarchy-auth-watch'
  },
  {
    name: 'omarchy-ghost-mac',
    desc: 'Kablosuz ağ donanım adreslerini (MAC) ağ bazlı dinamik ve güvenli biçimde anonimleştiren gizlilik aracı.',
    lang: 'Shell',
    langColor: '#89e051',
    tags: ['privacy', 'wifi', 'opsec'],
    url: 'https://github.com/ozdil/omarchy-ghost-mac'
  },
  {
    name: 'omarchy-dns-leak-guard',
    desc: 'Ağ üzerinde DNS sızıntılarını denetleyen ve şifreli DNS (DoH/DoT) tünellemesini güvenceye alan araç.',
    lang: 'Shell',
    langColor: '#89e051',
    tags: ['dns', 'privacy', 'network'],
    url: 'https://github.com/ozdil/omarchy-dns-leak-guard'
  },
  {
    name: 'omarchy-tripwire-vault',
    desc: 'Tuzak belirteçler (canary tokens) ile dosya sistemi üzerinde yetkisiz erişim tespit mekanizması.',
    lang: 'Shell',
    langColor: '#89e051',
    tags: ['honeypot', 'security'],
    url: 'https://github.com/ozdil/omarchy-tripwire-vault'
  },
  {
    name: 'omarchy-turkiye-theme',
    desc: 'Göz yormayan, OLED uyumlu, fonksiyonel ve ergonomik sistem arayüz teması.',
    lang: 'CSS / Shell',
    langColor: '#563d7c',
    tags: ['theme', 'hyprland', 'oled'],
    url: 'https://github.com/ozdil/omarchy-turkiye-theme'
  }
];
---

<BaseLayout
  title="Projeler & Servisler — Ozan Özdil"
  description="Ozan Özdil tarafından geliştirilen açık kaynak sistem mimarileri, Omarchy Linux servisleri ve siber savunma kalkanları."
  currentPath="/projeler"
  maxWidthClass="max-w-5xl"
>
  <div class="space-y-6">
    <!-- QuickShell Header Window -->
    <div class="qs-window">
      <div class="qs-titlebar">
        <div class="flex items-center gap-2">
          <span class="text-sky-600 dark:text-[#00ffcc] font-semibold text-[11px] select-none">[systemctl]</span>
          <span class="text-zinc-300 dark:text-zinc-700">/</span>
          <span class="text-zinc-800 dark:text-zinc-200 font-medium">unit-files.target (Sistem Servisleri)</span>
        </div>
        <div class="flex items-center gap-2.5 text-[11px] text-zinc-400 dark:text-zinc-500 font-mono">
          <span>{repositories.length} AKTİF SERVİS</span>
          <span class="text-zinc-300 dark:text-zinc-700">|</span>
          <span class="px-1.5 py-0.5 rounded bg-zinc-200/60 dark:bg-zinc-800 text-[10px] text-zinc-600 dark:text-zinc-300 uppercase tracking-wider font-mono">systemd</span>
        </div>
      </div>

      <div class="p-4 sm:p-6 font-mono text-xs">
        <div class="flex items-center gap-2 text-emerald-600 dark:text-[#00ffcc] font-semibold mb-2">
          <span>$</span>
          <span>systemctl list-units --type=service --all</span>
        </div>
        <p class="font-sans text-xs sm:text-sm text-zinc-600 dark:text-zinc-400 leading-relaxed">
          Omarchy Linux ekosistemi, ağ trafiği anomalisi izleme, USB donanım kalkanları, p2p veri aktarımı ve sentetik çekirdek kıyaslama araçları.
        </p>
      </div>
    </div>

    <!-- Services Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-3.5">
      {repositories.map((repo) => (
        <div class="qs-window hover:border-sky-500/50 dark:hover:border-[#00ffcc]/40 transition-all flex flex-col justify-between">
          <!-- Card Titlebar -->
          <div class="qs-titlebar py-1.5 px-3 bg-zinc-50 dark:bg-[#12161e]">
            <div class="flex items-center gap-1.5 truncate">
              <span class="w-1.5 h-1.5 rounded-full bg-emerald-500 animate-pulse"></span>
              <span class="font-mono text-xs text-zinc-900 dark:text-zinc-200 font-semibold truncate">
                {repo.name}.service
              </span>
            </div>
            <span class="text-[10px] font-mono px-1.5 py-0.5 rounded bg-zinc-200/80 dark:bg-zinc-800 text-zinc-600 dark:text-zinc-400 flex-shrink-0">
              {repo.lang}
            </span>
          </div>

          <div class="p-4 flex-grow flex flex-col justify-between">
            <p class="text-xs sm:text-sm text-zinc-600 dark:text-zinc-300 leading-relaxed mb-4">
              {repo.desc}
            </p>

            <div class="space-y-3 pt-2 border-t border-zinc-200/60 dark:border-zinc-800/60">
              <div class="flex flex-wrap gap-1 font-mono text-[10px]">
                {repo.tags.map((tag) => (
                  <span class="px-1.5 py-0.5 rounded bg-zinc-100 dark:bg-[#141820] text-zinc-500 dark:text-zinc-400 border border-zinc-200 dark:border-zinc-800">
                    --{tag}
                  </span>
                ))}
              </div>

              <div class="flex items-center justify-between font-mono text-[11px] pt-1">
                <span class="text-emerald-600 dark:text-emerald-400 text-[10px]">
                  ● active (running)
                </span>
                <a
                  href={repo.url}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="qs-btn py-1 px-2.5 text-[11px]"
                >
                  <span>git repo</span>
                  <span>→</span>
                </a>
              </div>
            </div>
          </div>
        </div>
      ))}
    </div>
  </div>
</BaseLayout>
