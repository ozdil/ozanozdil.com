---
import BaseLayout from '../layouts/BaseLayout.astro';

const repositories = [
  {
    name: 'omarchy',
    desc: 'Arch Linux tabanlı, optimize edilmiş sistem yapılandırması.',
    lang: 'Shell',
    langColor: '#89e051',
    tags: ['arch-linux', 'hyprland', 'dotfiles'],
    url: 'https://github.com/ozdil/omarchy'
  },
  {
    name: 'omarchy-cyber-sentinel',
    desc: 'Ağ trafiği izleme ve anormallik tespit aracı.',
    lang: 'Python / Bash',
    langColor: '#3572A5',
    tags: ['security', 'network', 'sentinel'],
    url: 'https://github.com/ozdil/omarchy-cyber-sentinel'
  },
  {
    name: 'omarchy-badusb-shield',
    desc: 'USB aygıt yetkilendirme ve bağlantı güvenliği aracı.',
    lang: 'Shell',
    langColor: '#89e051',
    tags: ['badusb', 'hardware-sec', 'linux'],
    url: 'https://github.com/ozdil/omarchy-badusb-shield'
  },
  {
    name: 'omarchy-cve-radar',
    desc: 'Linux sistem paketleri için güvenlik açığı (CVE) denetleyici.',
    lang: 'Python',
    langColor: '#3572A5',
    tags: ['cve', 'vulnerability-scanner'],
    url: 'https://github.com/ozdil/omarchy-cve-radar'
  },
  {
    name: 'omarchy-omarank',
    desc: 'Linux donanım ve çekirdek performans kıyaslama aracı.',
    lang: 'Rust / C',
    langColor: '#dea584',
    tags: ['benchmark', 'performance'],
    url: 'https://github.com/ozdil/omarchy-omarank'
  },
  {
    name: 'omarchy-omasend',
    desc: 'Yerel ağda şifreli dosya ve veri aktarım aracı.',
    lang: 'Go / Shell',
    langColor: '#00ADD8',
    tags: ['p2p', 'file-transfer', 'go'],
    url: 'https://github.com/ozdil/omarchy-omasend'
  },
  {
    name: 'omarchy-auth-watch',
    desc: 'Yetkisiz oturum açma ve SSH denemelerini izleme aracı.',
    lang: 'Shell',
    langColor: '#89e051',
    tags: ['security', 'auth', 'audit'],
    url: 'https://github.com/ozdil/omarchy-auth-watch'
  },
  {
    name: 'omarchy-ghost-mac',
    desc: 'Kablosuz ağ MAC adreslerini dinamik olarak anonimleştiren gizlilik aracı.',
    lang: 'Shell',
    langColor: '#89e051',
    tags: ['privacy', 'wifi', 'opsec'],
    url: 'https://github.com/ozdil/omarchy-ghost-mac'
  },
  {
    name: 'omarchy-dns-leak-guard',
    desc: 'DNS sızıntılarını denetleyen ve şifreli DNS tünellemesini doğrulayan araç.',
    lang: 'Shell',
    langColor: '#89e051',
    tags: ['dns', 'privacy', 'network'],
    url: 'https://github.com/ozdil/omarchy-dns-leak-guard'
  },
  {
    name: 'omarchy-tripwire-vault',
    desc: 'Dosya sistemi üzerinde yetkisiz erişim tespit aracı.',
    lang: 'Shell',
    langColor: '#89e051',
    tags: ['honeypot', 'security'],
    url: 'https://github.com/ozdil/omarchy-tripwire-vault'
  },
  {
    name: 'omarchy-turkiye-theme',
    desc: 'OLED uyumlu, ergonomik sistem arayüz teması.',
    lang: 'CSS / Shell',
    langColor: '#563d7c',
    tags: ['theme', 'hyprland', 'oled'],
    url: 'https://github.com/ozdil/omarchy-turkiye-theme'
  }
];
---

<BaseLayout
  title="Projeler — Ozan Özdil"
  description="Ozan Özdil tarafından geliştirilen açık kaynak projeler ve araçlar."
  currentPath="/projeler"
  maxWidthClass="max-w-4xl"
>
  <div class="py-2 sm:py-4">
    <!-- Header: Omarchy / QuickShell Style -->
    <header class="pb-8 text-center">
      <p class="font-mono text-xs font-medium tracking-[0.18em] text-sky-600 dark:text-[#00ffcc] uppercase sm:text-sm">
        Projeler
      </p>
      <h1 class="mt-2 text-2xl sm:text-3xl font-semibold tracking-tight text-zinc-950 dark:text-zinc-50 font-sans">
        Açık Kaynak Projeler
      </h1>
      <p class="mt-2 text-sm text-zinc-600 dark:text-zinc-400 max-w-lg mx-auto">
        Linux, sistem araçları ve açık kaynak çalışmalarım.
      </p>
    </header>

    <!-- Services Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
      {repositories.map((repo) => (
        <div class="p-5 rounded-lg border border-zinc-200/80 dark:border-zinc-800 bg-white dark:bg-[#0e1117] hover:border-sky-500/50 dark:hover:border-[#00ffcc]/50 transition-all flex flex-col justify-between group">
          <div>
            <div class="flex items-center justify-between gap-2 mb-2">
              <span class="font-sans font-semibold text-base text-zinc-950 dark:text-zinc-100 group-hover:text-sky-600 dark:group-hover:text-[#00ffcc] transition-colors truncate">
                {repo.name}
              </span>
              <span class="font-mono text-[10px] px-2 py-0.5 rounded bg-zinc-100 dark:bg-zinc-800 text-zinc-600 dark:text-zinc-400">
                {repo.lang}
              </span>
            </div>
            <p class="text-xs sm:text-sm text-zinc-600 dark:text-zinc-400 leading-relaxed mb-4">
              {repo.desc}
            </p>
          </div>

          <div class="space-y-3 pt-3 border-t border-zinc-100 dark:border-zinc-800/80">
            <div class="flex flex-wrap gap-1 font-mono text-[10px]">
              {repo.tags.map((tag) => (
                <span class="px-1.5 py-0.5 rounded bg-zinc-100 dark:bg-zinc-800/60 text-zinc-500 dark:text-zinc-400 border border-zinc-200/60 dark:border-zinc-800">
                  #{tag}
                </span>
              ))}
            </div>

            <div class="flex items-center justify-between font-mono text-[11px]">
              <span class="inline-flex items-center gap-1.5 text-emerald-600 dark:text-emerald-400 text-[10px]">
                <span class="w-1.5 h-1.5 rounded-full bg-emerald-500"></span>
                <span>active</span>
              </span>
              <a
                href={repo.url}
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex items-center gap-1 text-xs text-zinc-600 dark:text-zinc-400 group-hover:text-sky-600 dark:group-hover:text-[#00ffcc] transition-colors"
              >
                <span>git repo</span>
                <span>→</span>
              </a>
            </div>
          </div>
        </div>
      ))}
    </div>
  </div>
</BaseLayout>
