  { id: 'rust', label: 'Rust' },
  { id: 'quickshell', label: 'Quickshell / Wayland' },
  { id: 'security', label: 'Siber Savunma' },
  { id: 'ai', label: 'Yapay Zekâ' },
  { id: 'audio', label: 'Ses & Fotonik' }
