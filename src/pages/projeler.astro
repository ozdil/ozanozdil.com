---
import BaseLayout from '../layouts/BaseLayout.astro';

const repositories = [
  {
    name: 'omarchy',
    desc: 'Arch Linux tabanlı, estetik, yüksek performanslı ve modern sistem ekosistemi ve dotfiles mimarisi.',
    lang: 'Shell',
    langColor: '#89e051',
    tags: ['arch-linux', 'hyprland', 'system-craft'],
    url: 'https://github.com/ozdil/omarchy'
  },
  {
    name: 'omarchy-cyber-sentinel',
    desc: '🛡️ Canlı ağ trafiği analizi, siber saldırı tespiti ve proaktif sistem savunma modülü.',
    lang: 'Python / Bash',
    langColor: '#3572A5',
    tags: ['cybersecurity', 'network', 'sentinel'],
    url: 'https://github.com/ozdil/omarchy-cyber-sentinel'
  },
  {
    name: 'omarchy-badusb-shield',
    desc: '⚡ Donanımsal USB saldırılarına (Rubber Ducky, BadUSB) karşı dinamik port denetimi ve kalkan.',
    lang: 'Shell',
    langColor: '#89e051',
    tags: ['badusb', 'hardware-sec', 'linux'],
    url: 'https://github.com/ozdil/omarchy-badusb-shield'
  },
  {
    name: 'omarchy-cve-radar',
    desc: '🛡️ Arch Linux kurulu paketlerdeki güncel CVE açıklarını takip eden otomatik radar motoru.',
    lang: 'Python',
    langColor: '#3572A5',
    tags: ['cve', 'vulnerability-scanner'],
    url: 'https://github.com/ozdil/omarchy-cve-radar'
  },
  {
    name: 'omarchy-omarank',
    desc: '📊 Arch Linux çekirdek ve donanım bileşenleri için sentetik performans benchmark paketi.',
    lang: 'Rust / C',
    langColor: '#dea584',
    tags: ['benchmark', 'performance'],
    url: 'https://github.com/ozdil/omarchy-omarank'
  },
  {
    name: 'omarchy-omasend',
    desc: '🚀 Cihazlar arası yüksek hızlı, uçtan uca şifreli kablosuz dosya transfer aracı (AirBridge).',
    lang: 'Go / Shell',
    langColor: '#00ADD8',
    tags: ['p2p', 'file-transfer', 'go'],
    url: 'https://github.com/ozdil/omarchy-omasend'
  },
  {
    name: 'omarchy-auth-watch',
    desc: '🚨 Başarısız SSH ve oturum açma girişimlerini izleyip anında bloklayan güvenlik bekçisi.',
    lang: 'Shell',
    langColor: '#89e051',
    tags: ['security', 'auth', 'audit'],
    url: 'https://github.com/ozdil/omarchy-auth-watch'
  },
  {
    name: 'omarchy-ghost-mac',
    desc: '🎭 Wi-Fi donanım adreslerini (MAC) ağ bazlı dinamik ve güvenli biçimde gizleyen anonimlik aracı.',
    lang: 'Shell',
    langColor: '#89e051',
    tags: ['privacy', 'wifi', 'opsec'],
    url: 'https://github.com/ozdil/omarchy-ghost-mac'
  },
  {
    name: 'omarchy-dns-leak-guard',
    desc: '🌐 Canlı DNS sızıntılarını denetleyen ve şifreli DNS (DoH/DoT) tünellemesini güvenceye alan araç.',
    lang: 'Shell',
    langColor: '#89e051',
    tags: ['dns', 'privacy', 'network'],
    url: 'https://github.com/ozdil/omarchy-dns-leak-guard'
  },
  {
    name: 'omarchy-tripwire-vault',
    desc: '🪤 Honey-token ve tuzak dosyalarla dosya sistemi yetkisiz erişim alarm mekanizması.',
    lang: 'Shell',
    langColor: '#89e051',
    tags: ['honeypot', 'security'],
    url: 'https://github.com/ozdil/omarchy-tripwire-vault'
  },
  {
    name: 'omarchy-turkiye-theme',
    desc: '🇹🇷 Göz yormayan, OLED dostu, milli ve kültürel motiflerle bezenmiş sistem teması.',
    lang: 'CSS / Shell',
    langColor: '#563d7c',
    tags: ['theme', 'hyprland', 'oled'],
    url: 'https://github.com/ozdil/omarchy-turkiye-theme'
  }
];
---

<BaseLayout
  title="Açık Kaynak Projeler (Repositories) — Ozan Özdil"
  description="Ozan Özdil tarafından geliştirilen açık kaynak Linux, siber güvenlik ve sistem araçları deposu."
  currentPath="/projeler"
>
  <div class="mb-6">
    <div class="flex items-center justify-between pb-4 border-b border-gh-border">
      <div>
        <h1 class="text-xl font-bold text-gh-text flex items-center gap-2">
          <span>Açık Kaynak Projeler & Araçlar</span>
          <span class="text-xs font-mono font-normal px-2 py-0.5 rounded-full bg-gh-badge text-gh-textMuted border border-gh-border">
            {repositories.length} repo
          </span>
        </h1>
        <p class="text-xs text-gh-textMuted mt-1">
          Arch Linux, siber savunma, otonom yapay zekâ ve sistem güvenliği alanında geliştirdiğimiz açık kaynak projeler.
        </p>
      </div>
    </div>
  </div>

  <!-- Repositories List (GitHub Style) -->
  <div class="space-y-4">
    {repositories.map((repo) => (
      <div class="p-5 rounded-md border border-gh-border bg-gh-bg hover:border-gh-textMuted transition-colors flex flex-col justify-between">
        <div class="flex flex-col sm:flex-row sm:items-baseline justify-between gap-2 mb-2">
          <div class="flex items-center space-x-2">
            <svg class="w-4 h-4 text-gh-textMuted flex-shrink-0" viewBox="0 0 16 16" fill="currentColor">
              <path d="M2 2.5A2.5 2.5 0 0 1 4.5 0h8.75a.75.75 0 0 1 .75.75v12.5a.75.75 0 0 1-.75.75h-2.5a.75.75 0 0 1 0-1.5h1.75v-2h-8a1 1 0 0 0-.714 1.7.75.75 0 1 1-1.072 1.05A2.495 2.495 0 0 1 2 11.5Zm10.5-1h-8a1 1 0 0 0-1 1v6.708A2.486 2.486 0 0 1 4.5 9h8ZM5 12.25a.25.25 0 0 1 .25-.25h3.5a.25.25 0 0 1 .25.25v3.25a.25.25 0 0 1-.4.2l-1.6-1.2-1.6 1.2a.25.25 0 0 1-.4-.2Z"></path>
            </svg>
            <a
              href={repo.url}
              target="_blank"
              rel="noopener noreferrer"
              class="text-base font-semibold text-gh-link hover:underline font-mono"
            >
              {repo.name}
            </a>
            <span class="text-[10px] font-mono px-2 py-0.5 rounded-full border border-gh-border text-gh-textMuted bg-gh-subtle">
              Public
            </span>
          </div>
        </div>

        <p class="text-xs text-gh-textMuted mb-4 leading-relaxed">
          {repo.desc}
        </p>

        <div class="flex flex-wrap items-center gap-x-4 gap-y-2 text-xs text-gh-textMuted font-mono">
          <span class="flex items-center space-x-1.5">
            <span class="w-2.5 h-2.5 rounded-full" style={`background-color: ${repo.langColor}`}></span>
            <span>{repo.lang}</span>
          </span>

          <div class="flex flex-wrap gap-1">
            {repo.tags.map((tag) => (
              <span class="text-[10px] px-1.5 py-0.5 rounded bg-gh-subtle border border-gh-border">
                {tag}
              </span>
            ))}
          </div>
        </div>
      </div>
    ))}
  </div>
</BaseLayout>
