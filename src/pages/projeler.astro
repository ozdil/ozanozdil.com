---
import BaseLayout from '../layouts/BaseLayout.astro';

const repositories = [
  {
    name: 'omarchy',
    desc: 'Arch Linux tabanlı, optimize edilmiş yüksek performanslı sistem ekosistemi ve mimari yapılandırma paketi.',
    lang: 'Shell',
    langColor: '#89e051',
    tags: ['arch-linux', 'hyprland', 'system-craft'],
    url: 'https://github.com/ozdil/omarchy'
  },
  {
    name: 'omarchy-cyber-sentinel',
    desc: 'Canlı ağ trafiği analizi, tehdit tespiti ve kurumsal düzeyde proaktif sistem savunma modülü.',
    lang: 'Python / Bash',
    langColor: '#3572A5',
    tags: ['cybersecurity', 'network', 'sentinel'],
    url: 'https://github.com/ozdil/omarchy-cyber-sentinel'
  },
  {
    name: 'omarchy-badusb-shield',
    desc: 'Donanımsal USB ve harici çevre birimi tabanlı saldırılara karşı dinamik yetkilendirme ve port kalkanı.',
    lang: 'Shell',
    langColor: '#89e051',
    tags: ['badusb', 'hardware-sec', 'linux'],
    url: 'https://github.com/ozdil/omarchy-badusb-shield'
  },
  {
    name: 'omarchy-cve-radar',
    desc: 'Linux sistem paketleri ve uygulama bağımlılıkları için gerçek zamanlı güvenlik açığı (CVE) denetim motoru.',
    lang: 'Python',
    langColor: '#3572A5',
    tags: ['cve', 'vulnerability-scanner'],
    url: 'https://github.com/ozdil/omarchy-cve-radar'
  },
  {
    name: 'omarchy-omarank',
    desc: 'Linux çekirdeği ve donanım bileşenleri için kapsamlı sentetik kıyaslama (benchmark) ve performans analiz paketi.',
    lang: 'Rust / C',
    langColor: '#dea584',
    tags: ['benchmark', 'performance'],
    url: 'https://github.com/ozdil/omarchy-omarank'
  },
  {
    name: 'omarchy-omasend',
    desc: 'Yerel ağ üzerinde uçtan uca şifreli, yüksek hızlı p2p dosya ve veri aktarım protokolü (AirBridge).',
    lang: 'Go / Shell',
    langColor: '#00ADD8',
    tags: ['p2p', 'file-transfer', 'go'],
    url: 'https://github.com/ozdil/omarchy-omasend'
  },
  {
    name: 'omarchy-auth-watch',
    desc: 'Yetkisiz oturum açma ve SSH sızma girişimlerini anlık takip edip engelleyen kimlik doğrulama bekçisi.',
    lang: 'Shell',
    langColor: '#89e051',
    tags: ['security', 'auth', 'audit'],
    url: 'https://github.com/ozdil/omarchy-auth-watch'
  },
  {
    name: 'omarchy-ghost-mac',
    desc: 'Kablosuz ağ donanım adreslerini (MAC) ağ bazlı dinamik ve güvenli biçimde anonimleştiren gizlilik aracı.',
    lang: 'Shell',
    langColor: '#89e051',
    tags: ['privacy', 'wifi', 'opsec'],
    url: 'https://github.com/ozdil/omarchy-ghost-mac'
  },
  {
    name: 'omarchy-dns-leak-guard',
    desc: 'Ağ üzerinde DNS sızıntılarını denetleyen ve şifreli DNS (DoH/DoT) tünellemesini güvenceye alan araç.',
    lang: 'Shell',
    langColor: '#89e051',
    tags: ['dns', 'privacy', 'network'],
    url: 'https://github.com/ozdil/omarchy-dns-leak-guard'
  },
  {
    name: 'omarchy-tripwire-vault',
    desc: 'Tuzak belirteçler (canary tokens) ile dosya sistemi üzerinde yetkisiz erişim tespit mekanizması.',
    lang: 'Shell',
    langColor: '#89e051',
    tags: ['honeypot', 'security'],
    url: 'https://github.com/ozdil/omarchy-tripwire-vault'
  },
  {
    name: 'omarchy-turkiye-theme',
    desc: 'Göz yormayan, OLED uyumlu, fonksiyonel ve ergonomik sistem arayüz teması.',
    lang: 'CSS / Shell',
    langColor: '#563d7c',
    tags: ['theme', 'hyprland', 'oled'],
    url: 'https://github.com/ozdil/omarchy-turkiye-theme'
  }
];
---

<BaseLayout
  title="Açık Kaynak Projeler — Ozan Özdil"
  description="Ozan Özdil tarafından geliştirilen açık kaynak sistem yazılımları, ağ savunma ve Linux mimari araçları."
  currentPath="/projeler"
>
  <!-- Page Header -->
  <div class="mb-10 pb-6 border-b border-zinc-200/80 dark:border-zinc-800/80">
    <div class="flex flex-wrap items-center gap-2.5 mb-2">
      <h1 class="text-2xl sm:text-3xl font-bold tracking-tight text-zinc-950 dark:text-zinc-50">
        Açık Kaynak Projeler & Araçlar
      </h1>
      <span class="text-xs font-mono px-2.5 py-0.5 rounded-full bg-zinc-100 dark:bg-zinc-800 text-zinc-600 dark:text-zinc-400 border border-zinc-200/80 dark:border-zinc-700/80">
        {repositories.length} Depo
      </span>
    </div>
    <p class="text-sm text-zinc-600 dark:text-zinc-400 max-w-2xl leading-relaxed">
      Arch Linux, Omarchy mimarisi, proaktif ağ savunması, BadUSB kalkanları ve donanım optimizasyonu alanında geliştirdiğimiz açık kaynak yazılım araçları.
    </p>
  </div>

  <!-- Repositories Grid -->
  <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
    {repositories.map((repo) => (
      <div class="p-5 sm:p-6 rounded-2xl border border-zinc-200/80 dark:border-zinc-800/80 bg-white/70 dark:bg-zinc-900/50 hover:border-zinc-300 dark:hover:border-zinc-700 transition-all duration-200 hover:-translate-y-0.5 flex flex-col justify-between">
        <div>
          <div class="flex items-center justify-between mb-2.5">
            <a
              href={repo.url}
              target="_blank"
              rel="noopener noreferrer"
              class="text-base font-semibold font-mono text-zinc-950 dark:text-zinc-50 hover:text-blue-600 dark:hover:text-blue-400 transition-colors flex items-center gap-1.5"
            >
              <span>{repo.name}</span>
              <svg class="w-3.5 h-3.5 text-zinc-400 opacity-60 group-hover:opacity-100" viewBox="0 0 16 16" fill="currentColor">
                <path fill-rule="evenodd" d="M8.636 3.5a.5.5 0 0 0-.5-.5H1.5A1.5 1.5 0 0 0 0 4.5v10A1.5 1.5 0 0 0 1.5 16h10a1.5 1.5 0 0 0 1.5-1.5V7.864a.5.5 0 0 0-1 0V14.5a.5.5 0 0 1-.5.5h-10a.5.5 0 0 1-.5-.5v-10a.5.5 0 0 1 .5-.5h6.636a.5.5 0 0 0 .5-.5Z"/>
                <path fill-rule="evenodd" d="M16 .5a.5.5 0 0 0-.5-.5h-5a.5.5 0 0 0 0 1h3.793L6.146 9.146a.5.5 0 1 0 .708.708L15 1.707V5.5a.5.5 0 0 0 1 0v-5Z"/>
              </svg>
            </a>
            <span class="text-[10px] font-mono px-2 py-0.5 rounded-full border border-zinc-200 dark:border-zinc-800 text-zinc-500 dark:text-zinc-400 bg-zinc-50 dark:bg-zinc-950">
              Açık Kaynak
            </span>
          </div>

          <p class="text-xs sm:text-sm text-zinc-600 dark:text-zinc-400 mb-4 leading-relaxed font-normal">
            {repo.desc}
          </p>
        </div>

        <div class="flex flex-wrap items-center gap-x-4 gap-y-2 text-xs font-mono text-zinc-500 dark:text-zinc-400 pt-3 border-t border-zinc-100 dark:border-zinc-800/60">
          <span class="flex items-center space-x-1.5">
            <span class="w-2.5 h-2.5 rounded-full" style={`background-color: ${repo.langColor}`}></span>
            <span>{repo.lang}</span>
          </span>

          <div class="flex flex-wrap gap-1">
            {repo.tags.map((tag) => (
              <span class="text-[10px] px-2 py-0.5 rounded-md bg-zinc-100 dark:bg-zinc-800 text-zinc-600 dark:text-zinc-400 border border-zinc-200/60 dark:border-zinc-700/60">
                #{tag}
              </span>
            ))}
          </div>
        </div>
      </div>
    ))}
  </div>
</BaseLayout>
