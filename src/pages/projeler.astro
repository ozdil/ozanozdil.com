---

<BaseLayout
  title="Projeler — Ozan Özdil"
  description="Ozan Özdil tarafından geliştirilen açık kaynak projeler ve araçlar."
  currentPath="/projeler"
  maxWidthClass="max-w-[1720px]"
>
  <div class="py-2 sm:py-4 space-y-6">
    <!-- Header -->
    <header class="rounded-2xl border border-[#ead9d2] dark:border-[#2d2521] bg-[#F5F0E4] dark:bg-[#1f1a17] p-6 sm:p-8 text-center shadow-2xs">
      <div class="inline-flex items-center gap-2 font-mono text-xs text-[#e1734b] dark:text-[#e59a7a] uppercase tracking-wider mb-2 font-semibold">
        <span class="w-2 h-2 rounded-full bg-[#e1734b] dark:bg-[#e59a7a]"></span>
        <span>// AÇIK KAYNAK REPOLAR & SİSTEMLER</span>
      </div>
      <h1 class="text-3xl sm:text-4xl lg:text-5xl font-serif font-semibold tracking-tight text-[#2d2724] dark:text-[#fef9ed]">
        Açık Kaynak Projeler
      </h1>
      <p class="mt-2 text-sm sm:text-base text-[#5D524B] dark:text-[#a89f91] max-w-lg mx-auto font-sans">
        Linux, sistem mimarileri, Rust/QML kabuk bileşenleri ve açık kaynak çalışmalarım.
      </p>
    </header>

    <!-- Repositories Grid: Clean MAI cards -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 2xl:grid-cols-5 gap-4">
      {repositories.map((repo) => (
        <article class="rounded-[18px] border border-[#ead9d2] dark:border-[#2d2521] bg-[#F5F0E4]/60 dark:bg-[#1f1a17]/80 hover:border-[#5D524B]/30 dark:hover:border-[#ead9d2]/40 transition-all p-5 flex flex-col justify-between group shadow-2xs">
          <div class="space-y-3">
            <!-- Top Language & Status Line -->
            <div class="flex items-center justify-between text-[11px] font-mono pb-2 border-b border-[#ead9d2]/60 dark:border-[#2d2521]">
              <span class="text-[#e1734b] dark:text-[#e59a7a] font-medium">
                {repo.lang}
              </span>
              <span class="text-[#6e8f7c] dark:text-[#82b09a] text-[10px]">
                ● aktif
              </span>
            </div>

            <!-- Title -->
            <h2 class="text-base sm:text-lg font-semibold text-[#2d2724] dark:text-[#fef9ed] font-serif group-hover:text-[#e1734b] dark:group-hover:text-[#e59a7a] transition-colors">
              <a href={repo.url} target="_blank" rel="noopener noreferrer" class="focus:outline-none flex items-center justify-between">
                <span>{repo.name}</span>
                <span class="text-xs text-[#a67c52] transition-transform group-hover:translate-x-0.5 font-mono">↗</span>
              </a>
            </h2>

            <!-- Description -->
            <p class="text-xs text-[#5D524B] dark:text-[#a89f91] leading-relaxed font-sans line-clamp-3">
              {repo.desc}
            </p>
          </div>

          <!-- Tags & Action -->
          <div class="pt-3 mt-3 border-t border-[#ead9d2]/60 dark:border-[#2d2521] space-y-2">
            <div class="flex flex-wrap gap-1 font-mono text-[10px]">
              {repo.tags.slice(0, 3).map((tag) => (
                <span class="px-1.5 py-0.5 rounded bg-zinc-100 dark:bg-zinc-800/60 text-zinc-500 dark:text-zinc-400 border border-zinc-200/60 dark:border-zinc-800">
                  #{tag}
                </span>
              ))}
            </div>

            <div class="pt-1 flex justify-end">
              <a
                href={repo.url}
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex items-center gap-1 font-mono text-xs text-zinc-700 dark:text-[#00ffcc] font-medium group-hover:underline"
              >
                <span>Depoya Git</span>
                <span>↗</span>
              </a>
            </div>
          </div>
        </article>
      ))}
    </div>
  </div>
</BaseLayout>
