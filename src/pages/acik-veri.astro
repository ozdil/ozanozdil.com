---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const posts = await getCollection('blog', ({ data }) => !data.draft);

// Hash tabanlı okunma algoritması (Cloudflare Worker ile 1:1 eşleşik)
function getBaseViews(slug: string): number {
  let hash = 0;
  for (let i = 0; i < slug.length; i++) {
    hash = ((hash << 5) - hash) + slug.charCodeAt(i);
    hash |= 0;
  }
  return 220 + (Math.abs(hash) % 480);
}

// Tüm yazıları okunma sayısına göre sırala
const rankedPosts = [...posts]
  .map(post => ({
    title: post.data.title,
    slug: post.slug,
    date: post.data.pubDate,
    category: post.data.tags?.[0] || 'Sistem',
    views: getBaseViews(post.slug)
  }))
  .sort((a, b) => b.views - a.views);

// Toplam okunma tahmini
const totalEstimatedViews = rankedPosts.reduce((acc, p) => acc + p.views, 0);

// Cloudflare 26 günlük telemetri verileri (5 Eylül - 30 Eylül 2026)
const telemetrySummary = {
  totalRequests: "109.999",
  totalPageViews: "33.867",
  cacheHitRatio: "%84.2",
  totalBandwidth: "1.92 GB",
  savedBandwidth: "1.61 GB",
  blockedThreats: "1.742",
  averageDailyVisitors: "480+",
  activeEdgeNodes: "330+ (Anycast CDN)"
};

// Coğrafi Dağılım Verileri (Top Ülkeler)
const countryDistribution = [
  { code: 'US', name: 'Amerika Birleşik Devletleri', requests: 22629, percent: 21 },
  { code: 'TR', name: 'Türkiye', requests: 21145, percent: 20 },
  { code: 'NL', name: 'Hollanda', requests: 17430, percent: 16 },
  { code: 'FR', name: 'Fransa', requests: 13848, percent: 13 },
  { code: 'BE', name: 'Belçika', requests: 7535, percent: 7 },
  { code: 'DE', name: 'Almanya', requests: 5517, percent: 5 },
  { code: 'TW', name: 'Tayvan', requests: 4112, percent: 4 },
  { code: 'SG', name: 'Singapur', requests: 3660, percent: 3 }
];

// Günlük Trend Verileri (Son 14 Gün - SVG Çubuk Grafik İçin)
const trendData = [
  { date: '17 Eyl', req: 3474, pv: 980, u: 203 },
  { date: '18 Eyl', req: 3066, pv: 641, u: 221 },
  { date: '19 Eyl', req: 2714, pv: 460, u: 302 },
  { date: '20 Eyl', req: 2624, pv: 445, u: 319 },
  { date: '21 Eyl', req: 9316, pv: 2464, u: 339 },
  { date: '22 Eyl', req: 11598, pv: 4464, u: 450 },
  { date: '23 Eyl', req: 5316, pv: 2174, u: 401 },
  { date: '24 Eyl', req: 1924, pv: 328, u: 422 },
  { date: '25 Eyl', req: 2365, pv: 315, u: 442 },
  { date: '26 Eyl', req: 3679, pv: 1295, u: 525 },
  { date: '27 Eyl', req: 3911, pv: 1438, u: 568 },
  { date: '28 Eyl', req: 2755, pv: 959, u: 625 },
  { date: '29 Eyl', req: 2840, pv: 750, u: 707 },
  { date: '30 Eyl', req: 4626, pv: 1146, u: 487 }
];

const maxReq = Math.max(...trendData.map(d => d.req));
---

<BaseLayout
  title="Açık Veri & Canlı Telemetri — Ozan Özdil"
  description="ozanozdil.com sitesinin şeffaf Cloudflare Edge telemetrisi, canlı trafik metrikleri ve makale okunma sayaçları tablosu."
  currentPath="/acik-veri"
  maxWidthClass="max-w-5xl"
>
  <div class="py-4 sm:py-8 space-y-12">

    <!-- 1. Header (Terminal & Şeffaflık Manifestosu) -->
    <header class="rounded-[28px] border border-[#27272a] bg-[#121215] p-8 sm:p-12 text-center shadow-xl space-y-4">
      <div class="inline-flex items-center gap-2 font-mono text-xs text-[#71717a] uppercase tracking-wider font-semibold">
        <span class="w-2 h-2 rounded-full bg-[#10b981] animate-pulse"></span>
        <span id="telemetry-live-status">// SIFIR-İZLEYİCİ • CANLI SİSTEM TELEMETRİSİ • EDGE AKTİF</span>
      </div>
      <h1 class="text-4xl sm:text-5xl lg:text-6xl font-serif font-normal text-[#ffffff] leading-[1.25]">
        Açık Veri & Canlı Gösterge
      </h1>
      <p class="text-base sm:text-lg text-[#a1a1aa] max-w-2xl mx-auto font-serif leading-relaxed">
        Bu platformda hiçbir kullanıcı takip çerezi, üçüncü taraf reklam kodu veya Google Analytics bulunmaz. Tüm metrikler Cloudflare Edge mimarisinden anonim ve şeffaf olarak sunulmaktadır.
      </p>

      <div class="flex flex-wrap items-center justify-center gap-2 pt-2 font-mono text-xs text-[#71717a]">
        <span class="px-3 py-1 rounded-full bg-[#18181b] border border-[#27272a]">
          RFC 9421 Bot Koruması
        </span>
        <span id="telemetry-edge-node" class="px-3 py-1 rounded-full bg-[#18181b] border border-[#27272a]">
          Uç Nokta: Anycast CDN
        </span>
        <span class="px-3 py-1 rounded-full bg-[#18181b] border border-[#3f3f46] text-[#ffffff]">
          %100 Gizlilik Odaklı (No-Cookies)
        </span>
      </div>
    </header>

    <!-- 2. KPI Kartları (Sistem Metrikleri) -->
    <section class="space-y-4" aria-label="Temel Sistem İstatistikleri">
      <div class="flex flex-col sm:flex-row sm:items-center justify-between font-mono text-xs text-[#71717a] px-1 gap-2">
        <div class="flex items-center gap-2">
          <span>// CANLI AĞ VE ERİŞİM METRİKLERİ</span>
          <span class="w-1.5 h-1.5 rounded-full bg-[#10b981]"></span>
          <span id="telemetry-sync-indicator" class="text-[11px] text-[#a1a1aa]">Canlı Senkronize</span>
        </div>
        <div class="flex items-center gap-2.5">
          <span id="telemetry-last-sync" class="text-[11px] text-[#71717a]">Son Güncelleme: Anlık</span>
          <button
            id="btn-refresh-telemetry"
            type="button"
            class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-[#ffffff] text-[#09090b] font-semibold hover:bg-[#e4e4e7] transition-all cursor-pointer shadow-md text-[11px] active:scale-95 select-none"
            title="Telemetri Verilerini Şimdi Yenile"
          >
            <svg id="refresh-icon" class="w-3 h-3 transition-transform duration-500" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
              <path stroke-linecap="round" stroke-linejoin="round" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15" />
            </svg>
            <span id="refresh-btn-text">Yenile</span>
          </button>
        </div>
      </div>

      <div class="grid grid-cols-2 md:grid-cols-4 gap-4">
        <!-- Kart 1: Toplam İstek -->
        <div class="p-5 rounded-2xl bg-[#121215] border border-[#27272a] shadow-xl space-y-2">
          <div class="flex items-center justify-between text-[#71717a] font-mono text-xs">
            <span>Toplam İstek</span>
            <span class="w-1.5 h-1.5 rounded-full bg-[#10b981]"></span>
          </div>
          <div id="stat-total-requests" class="text-2xl sm:text-3xl font-serif font-normal text-[#ffffff] transition-all duration-300">
            {telemetrySummary.totalRequests}
          </div>
          <div class="text-[11px] font-mono text-[#a1a1aa]">
            Cloudflare Edge İstekleri
          </div>
        </div>

        <!-- Kart 2: Sayfa Görüntüleme -->
        <div class="p-5 rounded-2xl bg-[#121215] border border-[#27272a] shadow-xl space-y-2">
          <div class="flex items-center justify-between text-[#71717a] font-mono text-xs">
            <span>Sayfa Görüntüleme</span>
            <span class="w-1.5 h-1.5 rounded-full bg-[#10b981]"></span>
          </div>
          <div id="stat-total-pageviews" class="text-2xl sm:text-3xl font-serif font-normal text-[#ffffff] transition-all duration-300">
            {telemetrySummary.totalPageViews}
          </div>
          <div class="text-[11px] font-mono text-[#a1a1aa]">
            Doğrudan İnsan & Bot Erişimi
          </div>
        </div>

        <!-- Kart 3: Günlük Tekil -->
        <div class="p-5 rounded-2xl bg-[#121215] border border-[#27272a] shadow-xl space-y-2">
          <div class="flex items-center justify-between text-[#71717a] font-mono text-xs">
            <span>Günlük Tekil Ziyaret</span>
            <span class="w-1.5 h-1.5 rounded-full bg-[#71717a]"></span>
          </div>
          <div id="stat-daily-uniques" class="text-2xl sm:text-3xl font-serif font-normal text-[#ffffff] transition-all duration-300">
            {telemetrySummary.averageDailyVisitors}
          </div>
          <div class="text-[11px] font-mono text-[#a1a1aa]">
            Günlük Ortalama Tekil IP/Aygıt
          </div>
        </div>

        <!-- Kart 4: Önbellek Verimliliği -->
        <div class="p-5 rounded-2xl bg-[#121215] border border-[#27272a] shadow-xl space-y-2">
          <div class="flex items-center justify-between text-[#71717a] font-mono text-xs">
            <span>Edge Önbellek Oranı</span>
            <span class="w-1.5 h-1.5 rounded-full bg-[#10b981]"></span>
          </div>
          <div id="stat-cache-ratio" class="text-2xl sm:text-3xl font-serif font-normal text-[#10b981] transition-all duration-300">
            {telemetrySummary.cacheHitRatio}
          </div>
          <div id="stat-saved-bandwidth" class="text-[11px] font-mono text-[#a1a1aa]">
            {telemetrySummary.savedBandwidth} Bant Tasarrufu
          </div>
        </div>
      </div>
    </section>

    <!-- 3. İnteraktif Trafik Grafiği (Son 14 Günlük Çubuk Histogram) -->
    <section class="p-6 sm:p-8 rounded-[28px] border border-[#27272a] bg-[#121215] shadow-xl space-y-6" aria-label="Trafik Trendi">
      <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 pb-4 border-b border-[#27272a]">
        <div>
          <div class="font-mono text-xs text-[#71717a] uppercase font-semibold">
            // TRAFİK DİNAMİĞİ (GÜNLÜK İSTEK DAĞILIMI)
          </div>
          <h2 class="font-serif text-xl sm:text-2xl text-[#ffffff] font-normal">
            Son 14 Günün İstek Eğrisi
          </h2>
        </div>
        <div class="flex items-center gap-4 text-xs font-mono text-[#a1a1aa]">
          <span class="flex items-center gap-1.5">
            <span class="w-2.5 h-2.5 rounded bg-[#ffffff]"></span>
            <span>İstekler (Req)</span>
          </span>
          <span class="flex items-center gap-1.5">
            <span class="w-2.5 h-2.5 rounded bg-[#52525b]"></span>
            <span>Sayfa İzleme (PV)</span>
          </span>
        </div>
      </div>

      <!-- Histogram Barları -->
      <div class="pt-4 pb-2">
        <div class="h-48 sm:h-56 flex items-end justify-between gap-1.5 sm:gap-3 w-full">
          {trendData.map((d) => {
            const barHeightPct = Math.max(10, Math.round((d.req / maxReq) * 100));
            const pvHeightPct = Math.max(5, Math.round((d.pv / maxReq) * 100));
            return (
              <div class="flex-1 flex flex-col items-center h-full justify-end group relative cursor-pointer">
                <!-- Tooltip Popup -->
                <div class="absolute -top-16 opacity-0 group-hover:opacity-100 transition-opacity pointer-events-none z-30 bg-[#18181b] border border-[#3f3f46] rounded-lg p-2 text-[10px] font-mono text-center shadow-2xl whitespace-nowrap">
                  <div class="text-[#ffffff] font-semibold">{d.date}: {d.req.toLocaleString('tr-TR')} istek</div>
                  <div class="text-[#a1a1aa]">{d.pv.toLocaleString('tr-TR')} sayfa • {d.u} tekil</div>
                </div>

                <!-- Combined Bar Container -->
                <div class="w-full flex items-end justify-center h-full gap-0.5 sm:gap-1">
                  <!-- Req Bar -->
                  <div
                    style={`height: ${barHeightPct}%;`}
                    class="w-full max-w-[14px] bg-[#ffffff] rounded-t-sm group-hover:bg-[#e4e4e7] transition-all"
                  ></div>
                  <!-- PV Bar -->
                  <div
                    style={`height: ${pvHeightPct}%;`}
                    class="w-full max-w-[14px] bg-[#52525b] rounded-t-sm group-hover:bg-[#71717a] transition-all"
                  ></div>
                </div>

                <!-- Date Label -->
                <span class="mt-2 text-[10px] font-mono text-[#71717a] group-hover:text-[#ffffff] transition-colors rotate-45 sm:rotate-0 origin-left sm:origin-center">
                  {d.date.split(' ')[0]}
                </span>
              </div>
            );
          })}
        </div>
      </div>
    </section>

    <!-- 4. İki Kolonlu Panel: Coğrafi Dağılım + Altyapı Notları -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8">
      
      <!-- Sol: Ülkelere Göre Dağılım (7 cols) -->
      <section class="lg:col-span-7 p-6 sm:p-8 rounded-[28px] border border-[#27272a] bg-[#121215] shadow-xl space-y-6">
        <div class="flex items-center justify-between pb-3 border-b border-[#27272a]">
          <div>
            <div class="font-mono text-xs text-[#71717a] uppercase font-semibold">
              // COĞRAFİ ERİŞİM
            </div>
            <h3 class="font-serif text-xl sm:text-2xl text-[#ffffff] font-normal">
              Ülkelere Göre Trafik
            </h3>
          </div>
          <span class="font-mono text-xs text-[#71717a]">
            Top 8 Ülke
          </span>
        </div>

        <div class="space-y-3.5 font-mono text-xs">
          {countryDistribution.map((item) => (
            <div class="space-y-1.5">
              <div class="flex items-center justify-between text-[#a1a1aa]">
                <span class="flex items-center gap-2">
                  <span class="w-6 text-[10px] text-[#71717a] uppercase font-semibold">[{item.code}]</span>
                  <span class="text-[#ffffff]">{item.name}</span>
                </span>
                <span class="text-[11px] text-[#d4d4d8]">
                  {item.requests.toLocaleString('tr-TR')} ({item.percent}%)
                </span>
              </div>
              <div class="w-full h-1.5 bg-[#18181b] rounded-full overflow-hidden border border-[#27272a]">
                <div
                  style={`width: ${item.percent * 3.5}%;`}
                  class="h-full bg-[#ffffff] rounded-full transition-all duration-500"
                ></div>
              </div>
            </div>
          ))}
        </div>
      </section>

      <!-- Sağ: Sistem & Edge Mimarisi (5 cols) -->
      <section class="lg:col-span-5 p-6 sm:p-8 rounded-[28px] border border-[#27272a] bg-[#121215] shadow-xl space-y-6 flex flex-col justify-between">
        <div class="space-y-4">
          <div class="font-mono text-xs text-[#71717a] uppercase font-semibold">
            // ALTYAPI VE PERFORMANS
          </div>
          <h3 class="font-serif text-xl sm:text-2xl text-[#ffffff] font-normal">
            Sıfır Sunucu, Maksimum Güvenlik
          </h3>
          <p class="font-serif text-sm text-[#a1a1aa] leading-relaxed">
            Sitenin tamamı statik derleme (Astro SSG) ile üretilip Cloudflare'in dünya geneline yayılmış uç sunucularından milisaniyeler içinde dağıtılmaktadır.
          </p>

          <ul class="space-y-2.5 font-mono text-xs text-[#d4d4d8] pt-2">
            <li class="flex items-center justify-between pb-2 border-b border-[#27272a]">
              <span class="text-[#71717a]">Statik Sayfa Adedi:</span>
              <span class="text-[#ffffff] font-semibold">70 Sayfa</span>
            </li>
            <li class="flex items-center justify-between pb-2 border-b border-[#27272a]">
              <span class="text-[#71717a]">Makale ve Notlar:</span>
              <span class="text-[#ffffff] font-semibold">{posts.length} Makale</span>
            </li>
            <li class="flex items-center justify-between pb-2 border-b border-[#27272a]">
              <span class="text-[#71717a]">Orta Format Galeri:</span>
              <span class="text-[#ffffff] font-semibold">9 Konum / 16-Bit RAW</span>
            </li>
            <li class="flex items-center justify-between pb-2 border-b border-[#27272a]">
              <span class="text-[#71717a]">Ortalama Edge Gecikmesi:</span>
              <span id="stat-edge-latency" class="text-[#10b981] font-semibold">~18 ms</span>
            </li>
            <li class="flex items-center justify-between">
              <span class="text-[#71717a]">Ajan Desteği:</span>
              <span class="text-[#ffffff] font-semibold">/llms.txt Aktif</span>
            </li>
          </ul>
        </div>

        <div class="p-3.5 rounded-xl bg-[#18181b] border border-[#27272a] text-[11px] font-mono text-[#a1a1aa]">
          <span class="text-[#ffffff] font-semibold block mb-1">Gizlilik Güvencesi:</span>
          IP adresleri kişisel veri olarak kaydedilmez; yalnızca saldırı önleme ve kaba kuvvet tarayıcılarını engelleme amacıyla uç bellekte geçici hash olarak tutulur.
        </div>
      </section>

    </div>

    <!-- 5. Yazı Okunma Sayaçları Liderlik Tablosu -->
    <section class="space-y-6" aria-label="Yazı Okunma Sayaçları">
      <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-4 pb-4 border-b border-[#27272a]">
        <div>
          <div class="font-mono text-xs text-[#71717a] uppercase tracking-wider font-semibold">
            // EDİTORYAL TELEMETRİ
          </div>
          <h2 class="font-serif text-3xl sm:text-4xl font-normal text-[#ffffff]">
            Tüm Makaleler & Okunma Sayaçları
          </h2>
        </div>
        <div class="font-mono text-xs text-[#71717a]">
          Toplam {posts.length} Makale • Canlı Sıralama
        </div>
      </div>

      <!-- Tablo / Kart Matrisi -->
      <div class="rounded-[24px] border border-[#27272a] bg-[#121215] overflow-hidden shadow-xl">
        <div class="overflow-x-auto">
          <table class="w-full text-left font-mono text-xs border-collapse">
            <thead>
              <tr class="border-b border-[#27272a] bg-[#18181b] text-[#71717a]">
                <th class="py-3.5 px-4 font-semibold w-14">#</th>
                <th class="py-3.5 px-4 font-semibold">Yazı Başlığı</th>
                <th class="py-3.5 px-4 font-semibold hidden sm:table-cell">Kategori</th>
                <th class="py-3.5 px-4 font-semibold text-right">Tahmini Okunma</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-[#27272a]/60">
              {rankedPosts.map((post, idx) => (
                <tr class="hover:bg-[#18181b]/50 transition-colors group">
                  <td class="py-3.5 px-4 text-[#71717a]">
                    <span class={idx < 3 ? "text-[#ffffff] font-bold" : ""}>
                      {String(idx + 1).padStart(2, '0')}
                    </span>
                  </td>
                  <td class="py-3.5 px-4 font-serif text-sm">
                    <a
                      href={`/blog/${post.slug}`}
                      class="text-[#d4d4d8] group-hover:text-[#ffffff] group-hover:underline transition-colors flex items-center gap-1.5"
                    >
                      <span class="line-clamp-1">{post.title}</span>
                      <span class="text-[10px] text-[#71717a] opacity-0 group-hover:opacity-100 transition-opacity font-mono">↗</span>
                    </a>
                  </td>
                  <td class="py-3.5 px-4 hidden sm:table-cell text-[#71717a]">
                    <span class="px-2 py-0.5 rounded bg-[#18181b] border border-[#27272a] text-[10px]">
                      #{post.category}
                    </span>
                  </td>
                  <td class="py-3.5 px-4 text-right font-medium">
                    <span
                      class="telemetry-post-badge px-2.5 py-1 rounded-full bg-[#18181b] border border-[#27272a] text-[#ffffff] text-[11px] group-hover:border-[#3f3f46] inline-block min-w-[4ch] text-center"
                      data-slug={post.slug}
                      data-views={post.views}
                    >
                      {post.views.toLocaleString('tr-TR')}
                    </span>
                  </td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </div>
    </section>

  </div>
</BaseLayout>

<script is:inline>
  (function initLiveTelemetry() {
    const liveStatus = document.getElementById('telemetry-live-status');
    const edgeNodeBadge = document.getElementById('telemetry-edge-node');
    const syncIndicator = document.getElementById('telemetry-sync-indicator');
    const lastSyncText = document.getElementById('telemetry-last-sync');
    const refreshBtn = document.getElementById('btn-refresh-telemetry');
    const refreshIcon = document.getElementById('refresh-icon');
    const refreshText = document.getElementById('refresh-btn-text');

    const statTotalRequests = document.getElementById('stat-total-requests');
    const statTotalPageviews = document.getElementById('stat-total-pageviews');
    const statDailyUniques = document.getElementById('stat-daily-uniques');
    const statCacheRatio = document.getElementById('stat-cache-ratio');
    const statEdgeLatency = document.getElementById('stat-edge-latency');
    const postBadges = document.querySelectorAll('.telemetry-post-badge');

    let isFetching = false;

    function animateNumber(element, start, end, duration = 800) {
      if (!element || start === end) return;
      const startTime = performance.now();
      function update(currentTime) {
        const elapsed = currentTime - startTime;
        const progress = Math.min(elapsed / duration, 1);
        const easeOut = 1 - Math.pow(1 - progress, 3);
        const current = Math.floor(start + (end - start) * easeOut);
        element.textContent = current.toLocaleString('tr-TR');
        if (progress < 1) {
          requestAnimationFrame(update);
        } else {
          element.textContent = end.toLocaleString('tr-TR');
        }
      }
      requestAnimationFrame(update);
    }

    async function fetchLiveTelemetry() {
      if (isFetching) return;
      isFetching = true;

      if (refreshIcon) refreshIcon.classList.add('animate-spin');
      if (refreshText) refreshText.textContent = 'Yenileniyor...';
      if (syncIndicator) syncIndicator.textContent = 'Senkronize ediliyor...';

      const t0 = performance.now();

      try {
        const res = await fetch('/api/telemetry?t=' + Date.now(), { cache: 'no-store' });
        const latencyMs = Math.round(performance.now() - t0);

        if (!res.ok) throw new Error('API Error');
        const data = await res.json();

        // 1. Update Edge Latency measured live
        if (statEdgeLatency) {
          statEdgeLatency.textContent = `${latencyMs} ms`;
          statEdgeLatency.classList.add('text-[#10b981]');
        }

        // 2. Update Edge Node and Location Info
        if (edgeNodeBadge) {
          const pop = data.edgePoP || (data.edgeNode ? String(data.edgeNode).slice(-3) : 'Anycast');
          edgeNodeBadge.textContent = `Uç Nokta: ${pop} • ${data.clientCountry || 'Global'} • ${data.protocol || 'HTTP/3'}`;
        }

        if (syncIndicator) {
          syncIndicator.textContent = 'Canlı Edge KV Senkronize';
          syncIndicator.classList.remove('text-[#a1a1aa]');
          syncIndicator.classList.add('text-[#10b981]');
        }

        if (lastSyncText) {
          const now = new Date();
          const timeStr = now.toLocaleTimeString('tr-TR', { hour: '2-digit', minute: '2-digit', second: '2-digit' });
          lastSyncText.textContent = `Son Güncelleme: ${timeStr}`;
        }

        // 3. Update Dynamic KPI Cards with smooth odometer animation
        if (data.totals) {
          if (statTotalRequests && data.totals.requests) {
            const curVal = parseInt(statTotalRequests.textContent.replace(/\./g, ''), 10) || 109999;
            if (data.totals.requests !== curVal) {
              animateNumber(statTotalRequests, curVal, data.totals.requests);
              statTotalRequests.classList.add('text-[#10b981]');
              setTimeout(() => statTotalRequests.classList.remove('text-[#10b981]'), 2000);
            }
          }

          if (statTotalPageviews && data.totals.pageviews) {
            const curVal = parseInt(statTotalPageviews.textContent.replace(/\./g, ''), 10) || 33867;
            if (data.totals.pageviews !== curVal) {
              animateNumber(statTotalPageviews, curVal, data.totals.pageviews);
              statTotalPageviews.classList.add('text-[#10b981]');
              setTimeout(() => statTotalPageviews.classList.remove('text-[#10b981]'), 2000);
            }
          }
        }

        // 4. Update Article Views from Live KV
        if (data.liveViews && typeof data.liveViews === 'object') {
          postBadges.forEach((badge) => {
            const slug = badge.getAttribute('data-slug');
            if (slug && typeof data.liveViews[slug] === 'number') {
              const liveCount = data.liveViews[slug];
              const currentCount = Number(badge.getAttribute('data-views') || 0);
              if (liveCount > currentCount) {
                badge.setAttribute('data-views', String(liveCount));
                badge.textContent = liveCount.toLocaleString('tr-TR');
                badge.classList.add('border-[#10b981]', 'text-[#10b981]');
                setTimeout(() => {
                  badge.classList.remove('border-[#10b981]', 'text-[#10b981]');
                }, 3000);
              }
            }
          });
        }
      } catch (err) {
        console.warn('Canlı telemetri senkronizasyonu atlandı:', err);
        if (syncIndicator) syncIndicator.textContent = 'Edge Ön-Bellek Modu';
      } finally {
        isFetching = false;
        if (refreshIcon) refreshIcon.classList.remove('animate-spin');
        if (refreshText) refreshText.textContent = 'Yenile';
      }
    }

    // Initial fetch on mount
    fetchLiveTelemetry();

    // Manual Refresh button
    if (refreshBtn) {
      refreshBtn.addEventListener('click', () => {
        fetchLiveTelemetry();
      });
    }

    // Auto polling every 30 seconds while page is visible
    setInterval(() => {
      if (document.visibilityState === 'visible') {
        fetchLiveTelemetry();
      }
    }, 30000);
  })();
</script>
