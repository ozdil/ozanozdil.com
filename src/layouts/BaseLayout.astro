---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  currentPath?: string;
  type?: 'website' | 'article';
  article?: {
    pubDate?: Date;
    updatedDate?: Date;
    tags?: string[];
  };
  maxWidthClass?: string;
}

const {
  title = 'Ozan Özdil',
  description = 'Orman Mühendisi (KTÜ). Açık kaynak sistemler, Linux mimarisi, QuickShell ve orta format fotoğrafçılık üzerine araştırmalar ve kişisel notlar.',
  image = '/avatar.jpg',
  type = 'website',
  article,
  maxWidthClass = 'max-w-4xl',
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site || 'https://ozanozdil.com');
const currentPath = Astro.url.pathname;
const ogImageURL = new URL(image, canonicalURL);

const jsonLd = type === 'article' && article?.pubDate ? {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  'headline': title,
  'description': description,
  'datePublished': article.pubDate.toISOString(),
  'dateModified': (article.updatedDate || article.pubDate).toISOString(),
  'author': {
    '@type': 'Person',
    'name': 'Ozan Özdil',
    'url': 'https://ozanozdil.com',
    'sameAs': [
      'https://github.com/ozdil',
      'https://steamcommunity.com/id/ozanozdil',
      'https://nsosyal.com/ozanozdil'
    ]
  },
  'publisher': {
    '@type': 'Person',
    'name': 'Ozan Özdil',
    'url': 'https://ozanozdil.com',
    'logo': {
      '@type': 'ImageObject',
      'url': 'https://ozanozdil.com/icon-512.png'
    }
  },
  'image': ogImageURL.toString(),
  'mainEntityOfPage': {
    '@type': 'WebPage',
    '@id': canonicalURL.toString()
  },
  'keywords': article.tags?.join(', ')
} : {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebSite',
      '@id': 'https://ozanozdil.com/#website',
      'url': 'https://ozanozdil.com',
      'name': 'Ozan Özdil',
      'description': description,
      'publisher': {
        '@id': 'https://ozanozdil.com/#person'
      }
    },
    {
      '@type': 'Person',
      '@id': 'https://ozanozdil.com/#person',
      'name': 'Ozan Özdil',
      'url': 'https://ozanozdil.com',
      'image': 'https://ozanozdil.com/avatar.jpg',
      'jobTitle': 'Orman Mühendisi & Bağımsız Araştırmacı',
      'description': description,
      'sameAs': [
        'https://github.com/ozdil',
        'https://steamcommunity.com/id/ozanozdil',
        'https://nsosyal.com/ozanozdil'
      ]
    }
  ]
};
---

<!doctype html>
<html lang="tr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <!-- Favicon & Touch Icons -->
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" type="image/png" sizes="48x48" href="/favicon-48x48.png" />
    <link rel="icon" type="image/png" sizes="96x96" href="/favicon-96x96.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="theme-color" content="#090a0f" />
    <link rel="canonical" href={canonicalURL} />
    <meta name="generator" content={Astro.generator} />

    <!-- Google Fonts: Inter & JetBrains Mono (Non-render-blocking) -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link rel="preload" as="style" href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=JetBrains+Mono:ital,wght@0,400;0,500;0,600;1,400&display=swap">
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=JetBrains+Mono:ital,wght@0,400;0,500;0,600;1,400&display=swap" media="print" onload="this.media='all'">
    <noscript>
      <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=JetBrains+Mono:ital,wght@0,400;0,500;0,600;1,400&display=swap">
    </noscript>

    <!-- Primary Meta Tags -->
    <title>{title}</title>
    <meta name="title" content={title} />
    <meta name="description" content={description} />
    <meta name="author" content="Ozan Özdil" />

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content={type} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImageURL} />

    {type === 'article' && article?.pubDate && (
      <>
        <meta property="article:published_time" content={article.pubDate.toISOString()} />
        {article.updatedDate && (
          <meta property="article:modified_time" content={article.updatedDate.toISOString()} />
        )}
        <meta property="article:author" content="Ozan Özdil" />
        {article.tags?.map((tag) => (
          <meta property="article:tag" content={tag} />
        ))}
      </>
    )}

    <!-- Twitter -->
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:url" content={canonicalURL} />
    <meta property="twitter:title" content={title} />
    <meta property="twitter:description" content={description} />
    <meta property="twitter:image" content={ogImageURL} />

    <!-- JSON-LD Structured Data for Google SEO -->
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

    <!-- RSS & Sitemap -->
    <link rel="alternate" type="application/rss+xml" title="Ozan Özdil RSS Feed" href="/rss.xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <!-- Inline script to prevent theme flash -->
    <script is:inline>
      const theme = (() => {
        if (typeof localStorage !== 'undefined' && localStorage.getItem('theme')) {
          return localStorage.getItem('theme');
        }
        if (window.matchMedia('(prefers-color-scheme: dark)').matches) {
          return 'dark';
        }
        return 'light';
      })();
      if (theme === 'dark') {
        document.documentElement.classList.add('dark');
      } else {
        document.documentElement.classList.remove('dark');
      }
    </script>
  </head>
  <body class="min-h-screen flex flex-col bg-[#f8fafc] dark:bg-[#08090b] qs-grid-bg text-zinc-900 dark:text-zinc-100 selection:bg-zinc-900 selection:text-white dark:selection:bg-[#00ffcc] dark:selection:text-[#08090b] font-sans antialiased transition-colors duration-200 pt-14">
    <Header currentPath={currentPath} />

    <main class={`flex-grow w-full mx-auto px-4 sm:px-6 lg:px-8 py-8 sm:py-12 ${maxWidthClass}`}>
      <slot />
    </main>

    <Footer />
  </body>
</html>
