---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import AiChatModal from '../components/AiChatModal.astro';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  currentPath?: string;
  type?: 'website' | 'article';
  article?: {
    pubDate?: Date;
    updatedDate?: Date;
    tags?: string[];
  };
  maxWidthClass?: string;
}

const {
  title = 'Ozan Özdil',
  description = 'YZ Kodcusu. Açık kaynak sistem okuryazarlığı, Omarchy ve CachyOS takibi, Steam Deck ile Linux oyunculuğu ve orta format fotoğrafçılık.',
  image = '/avatar.jpg',
  type = 'website',
  article,
  maxWidthClass = 'max-w-4xl',
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site || 'https://ozanozdil.com');
const currentPath = Astro.url.pathname;
const ogImageURL = new URL(image, canonicalURL);

// Breadcrumb items calculation
const breadcrumbItems = [
  {
    '@type': 'ListItem',
    'position': 1,
    'name': 'Ana Sayfa',
    'item': 'https://ozanozdil.com',
  },
];

if (type === 'article' && article?.pubDate) {
  breadcrumbItems.push(
    {
      '@type': 'ListItem',
      'position': 2,
      'name': 'Yazılar',
      'item': 'https://ozanozdil.com/blog',
    },
    {
      '@type': 'ListItem',
      'position': 3,
      'name': title.replace(/ — Ozan Özdil$/, ''),
      'item': canonicalURL.toString(),
    }
  );
} else if (currentPath.startsWith('/blog')) {
  breadcrumbItems.push({
    '@type': 'ListItem',
    'position': 2,
    'name': 'Yazılar',
    'item': 'https://ozanozdil.com/blog',
  });
} else if (currentPath.startsWith('/projeler')) {
  breadcrumbItems.push({
    '@type': 'ListItem',
    'position': 2,
    'name': 'Projeler',
    'item': 'https://ozanozdil.com/projeler',
  });
} else if (currentPath.startsWith('/galeri')) {
  breadcrumbItems.push({
    '@type': 'ListItem',
    'position': 2,
    'name': 'Fotoğraf Galerisi',
    'item': 'https://ozanozdil.com/galeri',
  });
} else if (currentPath.startsWith('/hakkimda')) {
  breadcrumbItems.push({
    '@type': 'ListItem',
    'position': 2,
    'name': 'Hakkımda',
    'item': 'https://ozanozdil.com/hakkimda',
  });
}

const personEntity = {
  '@type': 'Person',
  '@id': 'https://ozanozdil.com/#person',
  'name': 'Ozan Özdil',
  'alternateName': ['ozdil', 'Ozan Ozdil'],
  'url': 'https://ozanozdil.com',
  'image': 'https://ozanozdil.com/avatar.jpg',
  'jobTitle': 'YZ Kodcusu, Sistem Araştırmacısı & Fotoğrafçı',
  'description': 'Açık kaynak sistem okuryazarlığı, Omarchy ve CachyOS takibi, Steam Deck ile Linux oyunculuğu ve orta format fotoğrafçılık.',
  'knowsAbout': [
    'Linux',
    'Open Source Software',
    'Artificial Intelligence',
    'Large Language Models',
    'AI Agents & Workflows',
    'Arch Linux',
    'CachyOS',
    'Steam Deck',
    'Wayland Architecture',
    'Medium Format Photography',
    'Cybersecurity',
    'Digital Sovereignty'
  ],
  'sameAs': [
    'https://github.com/ozdil',
    'https://steamcommunity.com/id/ozanozdil',
    'https://nsosyal.com/ozanozdil'
  ]
};

const websiteEntity = {
  '@type': 'WebSite',
  '@id': 'https://ozanozdil.com/#website',
  'url': 'https://ozanozdil.com',
  'name': 'Ozan Özdil',
  'description': 'YZ Kodcusu. Açık kaynak sistem okuryazarlığı, Omarchy ve CachyOS takibi, Steam Deck ile Linux oyunculuğu ve orta format fotoğrafçılık.',
  'inLanguage': 'tr-TR',
  'publisher': {
    '@id': 'https://ozanozdil.com/#person'
  },
  'potentialAction': {
    '@type': 'SearchAction',
    'target': {
      '@type': 'EntryPoint',
      'urlTemplate': 'https://ozanozdil.com/blog?q={search_term_string}'
    },
    'query-input': 'required name=search_term_string'
  }
};

const breadcrumbEntity = {
  '@type': 'BreadcrumbList',
  '@id': `${canonicalURL.toString()}#breadcrumb`,
  'itemListElement': breadcrumbItems
};

const graphElements: any[] = [websiteEntity, personEntity, breadcrumbEntity];

if (type === 'article' && article?.pubDate) {
  graphElements.push({
    '@type': 'BlogPosting',
    '@id': `${canonicalURL.toString()}#article`,
    'isPartOf': {
      '@id': 'https://ozanozdil.com/#website'
    },
    'headline': title.replace(/ — Ozan Özdil$/, ''),
    'description': description,
    'datePublished': article.pubDate.toISOString(),
    'dateModified': (article.updatedDate || article.pubDate).toISOString(),
    'mainEntityOfPage': {
      '@type': 'WebPage',
      '@id': canonicalURL.toString()
    },
    'author': {
      '@id': 'https://ozanozdil.com/#person'
    },
    'publisher': {
      '@id': 'https://ozanozdil.com/#person'
    },
    'image': ogImageURL.toString(),
    'inLanguage': 'tr-TR',
    'keywords': article.tags?.join(', '),
    'articleSection': article.tags?.[0] || 'Teknoloji'
  });
}

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': graphElements
};
---

<!doctype html>
<html lang="tr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <!-- Favicon & Touch Icons -->
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" type="image/png" sizes="48x48" href="/favicon-48x48.png" />
    <link rel="icon" type="image/png" sizes="96x96" href="/favicon-96x96.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="theme-color" content="#09090b" />
    <link rel="canonical" href={canonicalURL} />
    <meta name="generator" content={Astro.generator} />

    <!-- Bradford LL Local Font Preloads (As used in Microsoft AI design) -->
    <link rel="preload" href="/fonts/BradfordLL-Regular.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/BradfordLL-Italic.woff2" as="font" type="font/woff2" crossorigin />

    <!-- Typography: JetBrains Mono & Newsreader (Non-blocking async load with DNS prefetch) -->
    <link rel="dns-prefetch" href="https://fonts.googleapis.com" />
    <link rel="dns-prefetch" href="https://fonts.gstatic.com" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;500;600&family=Newsreader:ital,opsz,wght@0,6..72,400;1,6..72,400&display=swap" media="print" onload="this.media='all'" />
    <noscript>
      <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;500;600&family=Newsreader:ital,opsz,wght@0,6..72,400;1,6..72,400&display=swap" />
    </noscript>

    <!-- Search Engine & AI Crawler Directives -->
    <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />
    <meta name="googlebot" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />
    <meta name="bingbot" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />
    <meta http-equiv="content-language" content="tr" />

    <!-- Primary Meta Tags -->
    <title>{title}</title>
    <meta name="title" content={title} />
    <meta name="description" content={description} />
    <meta name="author" content="Ozan Özdil" />
    {article?.tags && article.tags.length > 0 && (
      <meta name="keywords" content={article.tags.join(', ')} />
    )}

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content={type} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImageURL} />
    <meta property="og:site_name" content="Ozan Özdil" />
    <meta property="og:locale" content="tr_TR" />

    {type === 'article' && article?.pubDate && (
      <>
        <meta property="article:published_time" content={article.pubDate.toISOString()} />
        {article.updatedDate && (
          <meta property="article:modified_time" content={article.updatedDate.toISOString()} />
        )}
        <meta property="article:author" content="Ozan Özdil" />
        {article.tags?.map((tag) => (
          <meta property="article:tag" content={tag} />
        ))}
      </>
    )}

    <!-- Twitter -->
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:url" content={canonicalURL} />
    <meta property="twitter:title" content={title} />
    <meta property="twitter:description" content={description} />
    <meta property="twitter:image" content={ogImageURL} />
    <meta property="twitter:site" content="@ozdil" />
    <meta property="twitter:creator" content="@ozdil" />

    <!-- JSON-LD Structured Data for Google SEO & AI Knowledge Graph -->
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

    <!-- RSS, Sitemap, AI Catalogs & LLM Endpoints -->
    <link rel="alternate" type="application/rss+xml" title="Ozan Özdil RSS Feed" href="/rss.xml" />
    <link rel="alternate" type="text/plain" href="/llms.txt" title="LLM Context (llms.txt)" />
    <link rel="alternate" type="text/plain" href="/llms-full.txt" title="Full LLM Documentation (llms-full.txt)" />
    <link rel="help" href="/llms.txt" title="AI Agent Guidelines" />
    <link rel="sitemap" type="application/xml" title="Sitemap" href="/sitemap-index.xml" />
    <link rel="ai-catalog" type="application/json" href="/.well-known/ai-catalog.json" />
    <link rel="api-catalog" type="application/linkset+json" href="/.well-known/api-catalog" />
    <link rel="service-desc" type="application/json" href="/.well-known/ai-catalog.json" />

    <!-- WebMCP: W3C Web Machine Learning Context Protocol Tool Registration -->
    <script is:inline>
      (function initWebMCP() {
        let isRegistered = false;

        function registerOn(ctx) {
          if (!ctx || typeof ctx.registerTool !== 'function' || isRegistered) return false;
          try {
            ctx.registerTool({
              name: 'search_articles',
              description: 'Search technical articles, Linux tutorials, and system architecture notes on ozanozdil.com.',
              inputSchema: {
                type: 'object',
                properties: {
                  query: {
                    type: 'string',
                    description: 'Search term or keyword to find relevant articles'
                  }
                },
                required: ['query']
              },
              execute: async function({ query }) {
                return {
                  content: [{
                    type: 'text',
                    text: 'Search results for "' + (query || '') + '": https://www.ozanozdil.com/blog?q=' + encodeURIComponent(query || '')
                  }]
                };
              }
            });

            ctx.registerTool({
              name: 'get_author_info',
              description: 'Get background, open source projects, and contact info for Ozan Özdil.',
              inputSchema: { type: 'object', properties: {} },
              execute: async function() {
                return {
                  content: [{
                    type: 'text',
                    text: JSON.stringify({
                      name: 'Ozan Özdil',
                      role: 'YZ Kodcusu, Sistem Araştırmacısı & Fotoğrafçı',
                      website: 'https://www.ozanozdil.com',
                      projects: 'https://www.ozanozdil.com/projeler',
                      llms: 'https://www.ozanozdil.com/llms.txt'
                    })
                  }]
                };
              }
            });

            if (typeof ctx.provideContext === 'function') {
              ctx.provideContext({
                tools: [
                  {
                    name: 'search_articles',
                    description: 'Search technical articles, Linux tutorials, and system architecture notes on ozanozdil.com.'
                  },
                  {
                    name: 'get_author_info',
                    description: 'Get background, open source projects, and contact info for Ozan Özdil.'
                  }
                ]
              });
            }

            isRegistered = true;
            return true;
          } catch (e) {
            return false;
          }
        }

        function checkAndRegister() {
          if (isRegistered) return true;
          if (typeof document !== 'undefined' && document.modelContext && registerOn(document.modelContext)) return true;
          if (typeof navigator !== 'undefined' && navigator.modelContext && registerOn(navigator.modelContext)) return true;
          if (typeof window !== 'undefined' && window.modelContext && registerOn(window.modelContext)) return true;
          return false;
        }

        if (!checkAndRegister()) {
          if (typeof document !== 'undefined') {
            document.addEventListener('DOMContentLoaded', checkAndRegister, { once: true });
          }
          if (typeof window !== 'undefined') {
            window.addEventListener('load', checkAndRegister, { once: true });
            setTimeout(checkAndRegister, 1000);
          }
        }
      })();
    </script>

    <!-- Inline script to prevent theme flash - Default dark theme -->
    <script is:inline>
      const theme = (() => {
        if (typeof localStorage !== 'undefined' && localStorage.getItem('theme')) {
          return localStorage.getItem('theme');
        }
        return 'dark';
      })();
      if (theme === 'dark') {
        document.documentElement.classList.add('dark');
      } else {
        document.documentElement.classList.remove('dark');
      }
    </script>

  </head>
  <body class="min-h-screen flex flex-col bg-[#09090b] text-[#f4f4f5] selection:bg-[#3f3f46] selection:text-[#ffffff] font-sans antialiased transition-colors duration-200 relative overflow-x-clip">
    <Header currentPath={currentPath} />

    <main class={`flex-grow w-full mx-auto px-4 sm:px-6 lg:px-8 py-8 sm:py-12 relative z-10 ${maxWidthClass}`}>
      <slot />
    </main>

    <Footer />
    <AiChatModal />
  </body>
</html>
